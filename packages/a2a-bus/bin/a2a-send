#!/usr/bin/env bash
# a2a-send — написать другому агенту ЭТОЙ машины и показать это владельцу.
#
# ЗАЧЕМ. Шина A2A внутри одной машины: агенты пишут друг другу напрямую, без посредника
# на другой машине. Владелец при этом видит переписку в своих личных чатах —
# у каждого агента свой бот, и каждый агент пишет только от своего имени.
#
# УСТРОЙСТВО ОТПРАВКИ
#   1. письмо кладётся в ящик получателя /var/spool/a2a/<его-пользователь>/
#   2. строка «→ кому» уходит в СВОЙ чат владельца через tell-owner
# Переносом письма в собственность получателя занимается почтальон (отдельная
# служба, раз в 5 с). Здесь только «положить в прорезь».
#
# 🔴 ПОЧЕМУ ИМЯ ПИШЕТСЯ ЧЕРЕЗ ТОЧКУ, А ПОТОМ ПЕРЕИМЕНОВЫВАЕТСЯ
# Почтальон обходит ящик каждые 5 секунд и всё, что начинается с точки,
# пропускает (так он отличает свои временные файлы). Пиши мы сразу под
# окончательным именем — он подхватил бы письмо, дописанное наполовину,
# и получатель прочёл бы обрубок. Переименование внутри каталога атомарно.
#
# 🔴 ОКНО ДО ПЕРЕНОСА ЗАКРЫВАЕТСЯ ЗДЕСЬ, А НЕ У ПОЧТАЛЬОНА
# Пока письмо принадлежит отправителю, права на него раздаёт отправитель.
# umask 077 — единственное место, где это окно закрывается; почтальону там
# сделать нечего, он приходит позже.
#
# ЧЕГО ЭТОТ ИНСТРУМЕНТ НЕ ДЕЛАЕТ
# — не доставляет письмо В ХОД получателя: это дело модуля связи;
# — не шифрует: письмо лежит в файловой системе, защита — правами;
# — не подтверждает прочтение: доставлено = лежит у получателя;
# — не пишет от чужого имени: бот определяется вызвавшим пользователем,
#   подменить его отсюда нельзя (это свойство tell-owner, не наше);
# — не отменяет доставку письма из-за неисправного чата: видимость вторична.
#
# 🔴 ПРИВАТНОЕ ПИСЬМО ПОДАВАЙТЕ ЧЕРЕЗ СТАНДАРТНЫЙ ВВОД, А НЕ АРГУМЕНТОМ
# Замер 29.08.2026, A/B на живой машине:
#   a2a-send <agent> "текст"          → текст ВИДЕН в /proc/<pid>/cmdline
#                                         любому пользователю машины (2 из 2)
#   printf 'текст' | a2a-send <agent> → не виден (0 из 2)
# Внутрь tell-owner текст уходит через stdin в обоих случаях — это закрыто
# здесь. Но собственную командную строку инструмент закрыть не может: её задаёт
# вызывающий. Окно короткое (доли секунды), однако для переписки двух агентов
# оно настоящее.
#
# КОДЫ: 0 письмо доставлено и владелец увидел | 1 письмо НЕ доставлено
#       3 ошибка вызова или получателя | 4 письмо доставлено, видимость НЕ ушла
set -uo pipefail

KOREN="${A2A_KOREN:-/var/spool/a2a}"
# В чат идёт видимость переписки, а не её хранилище: письмо целиком лежит
# у получателя. Предел нужен, чтобы длинное письмо не выпало из чата целиком
# по ограничению телеграма (4096) — обрезанное с пометкой лучше пропавшего.
PREDEL_V_CHAT="${A2A_PREDEL_V_CHAT:-900}"
TELL="${A2A_TELL_BIN:-/usr/local/bin/tell-owner}"
REESTR="${A2A_REESTR_BIN:-/usr/local/bin/agent-registry}"

bez_kopii=0
argv=()
for a in "$@"; do
  case "$a" in
    --bez-kopii) bez_kopii=1 ;;   # служебное: подтверждения, техническое
    *) argv+=("$a") ;;
  esac
done

if [ "${#argv[@]}" -lt 1 ]; then
  echo "a2a-send: a2a-send <агент> [текст] [--bez-kopii]" >&2
  echo "          приватное письмо — через ввод: printf '%s' \"текст\" | a2a-send <агент>" >&2
  echo "          агенты этой машины: $("$REESTR" list 2>/dev/null | grep -oE '^[a-z0-9_-]+' | tr '\n' ' ')" >&2
  exit 3
fi

komu="${argv[0]}"

# 🔴 ДОВОД, ПОХОЖИЙ НА КЛЮЧ, НЕ УЕЗЖАЕТ КАК ТЕКСТ (02.09.2026, живьём).
# Было: `a2a-send <agent> -f файл` — ключа -f здесь нет, и строка «-f /tmp/...»
# ушла адресату КАК ТЕКСТ ПИСЬМА, 20 байт вместо 10828. Код 0, доклад бодрый,
# получатель получил мусор. Поймала по числу байт в собственном выводе.
# Класс злее обычного «неизвестный ключ игнорируется»: там довод пропадает,
# здесь он СТАНОВИТСЯ ДАННЫМИ и выглядит как замысел отправителя.
# Граница: ловим только начало текста, не весь. Письмо, НАЧИНАЮЩЕЕСЯ с дефиса
# по замыслу, придётся слать через ввод — цена невелика, а тихая подмена дороже.
if [ "${#argv[@]}" -gt 1 ]; then
  case "${argv[1]}" in
    -*) echo "a2a-send: «${argv[1]}» похоже на ключ, а стоит на месте ТЕКСТА." >&2
        echo "          Здесь нет ключей кроме --bez-kopii. Порядок: a2a-send <агент> [текст]" >&2
        echo "          Файл шлите через ввод: cat файл | a2a-send <агент>" >&2
        exit 2 ;;
  esac
fi

tekst="${argv[*]:1}"
[ -z "$tekst" ] && tekst="$(cat)"

# 🔴 ПРЕДЕЛ ДЛИНЫ ДЛЯ АРГУМЕНТА (02.09.2026, перенесено с парной машины, где он
# стоит с 14.08). Замер 29.08 в шапке показал: текст, поданный аргументом, ВИДЕН
# в /proc/<pid>/cmdline любому пользователю машины (2 из 2), поданный через stdin —
# не виден (0 из 2). Окно короткое, доли секунды, но настоящее.
#
# 🔴 ПОЧЕМУ ПРЕДЕЛ, А НЕ ЗАПРЕТ. Полный запрет argv закрыл бы штатный путь соседям,
# у которых инлайн прописан в наставлениях, — ради окна в доли секунды, где видна
# СЛУЖЕБНАЯ переписка между нашими же учётками. Это была бы защита от воображаемого
# при живом непроверенном. Лечим настоящее: длинный текст в argv и виден дольше,
# и содержательнее — его и отсекаем.
#
# ГДЕ НЕ ПРИМЕНЯЕТСЯ:
#   * к коротким служебным строкам — они проходят аргументом и это штатно;
#   * к тексту из stdin — там ограничения нет вовсе, окна тоже нет;
#   * 🔴 НЕ ЗАЩИЩАЕТ ОТ УТЕЧКИ СЕКРЕТА и не для того заведён: секреты в письма не
#     кладутся ВООБЩЕ, в переписке бывают только пути в хранилище. Прочитавший
#     замер и решивший «значит через argv можно слать секреты покороче» ошибётся.
PREDEL_ARGV="${A2A_PREDEL_ARGV:-500}"
if [ "${#argv[@]}" -gt 1 ]; then
  znakov_argv="$(printf '%s' "$tekst" | python3 -c 'import sys; print(len(sys.stdin.read()))' 2>/dev/null || echo 0)"
  if [ "$znakov_argv" -gt "$PREDEL_ARGV" ]; then
    echo "a2a-send: письмо $znakov_argv знаков аргументом — ЗАПРЕЩЕНО (предел $PREDEL_ARGV)." >&2
    echo "  Аргумент виден в /proc/<pid>/cmdline любому на машине, пока идёт вызов." >&2
    echo "  Подайте через стандартный ввод:  printf '%s' \"\$TEXT\" | a2a-send $komu" >&2
    echo "  или из файла:                    cat письмо.txt | a2a-send $komu" >&2
    exit 3
  fi
fi
if [ -z "${tekst//[[:space:]]/}" ]; then
  # Пустое письмо — почти наверняка оборванный конвейер, а не замысел.
  echo "a2a-send: пустое письмо — не отправляю" >&2
  exit 3
fi

# Получатель берётся ИЗ РЕЕСТРА, своего перечня агентов здесь нет: иначе он
# разошёлся бы с реестром молча при заведении одиннадцатого.
polzovatel="$("$REESTR" pole "$komu" polzovatel --json 2>/dev/null | tr -d '"')"
if [ -z "$polzovatel" ]; then
  echo "a2a-send: 🔴 в реестре нет агента «$komu» либо у него не задан пользователь — письмо НЕ отправлено" >&2
  exit 3
fi

yashchik="$KOREN/$polzovatel"
if [ ! -d "$yashchik" ]; then
  # Агент в реестре есть, а ящика нет — расхождение намерения и факта.
  echo "a2a-send: 🔴 ящик $yashchik не существует (агент $komu в реестре есть) — письмо НЕ отправлено" >&2
  exit 1
fi

# Своё ИМЯ агента здесь не нужно и не спрашивается: получателю о том, кто
# написал, скажет почтальон — он берёт это ФАКТОМ, по владельцу файла.
# Имя, вписанное отправителем, было бы его же утверждением о себе.
ya_polzovatel="$(id -un)"

metka="$(date -u '+%Y%m%dT%H%M%SZ')"
sluchajnoe="$(od -An -N4 -tx4 /dev/urandom 2>/dev/null | tr -d ' \n')"
[ -z "$sluchajnoe" ] && sluchajnoe="$$"
imya="${metka}-${ya_polzovatel}-${sluchajnoe}.txt"

# 🔴 umask ставится ЗДЕСЬ и только на запись письма: до переноса права раздаёт
# отправитель, и это единственная точка, где окно закрывается.
staryj_umask="$(umask)"
umask 077
vremennoe="$yashchik/.$imya"
if ! printf '%s\n' "$tekst" > "$vremennoe" 2>/dev/null; then
  umask "$staryj_umask"
  echo "a2a-send: 🔴 не удалось записать письмо в $yashchik — письмо НЕ отправлено" >&2
  exit 1
fi
if ! mv -n "$vremennoe" "$yashchik/$imya" 2>/dev/null; then
  umask "$staryj_umask"
  rm -f "$vremennoe" 2>/dev/null
  echo "a2a-send: 🔴 не удалось переименовать письмо в $yashchik — письмо НЕ отправлено" >&2
  exit 1
fi
umask "$staryj_umask"

# Проверка ОТДЕЛЬНЫМ действием: запись прошла — но легло ли то, что задумано.
# Читать содержимое нельзя (после переноса оно уже не наше), поэтому судим
# по факту существования и размеру.
if [ ! -e "$yashchik/$imya" ]; then
  # Мог успеть сработать почтальон — тогда письмо на месте, но уже не наше.
  echo "a2a-send: письмо $imya передано (проверить содержимое нельзя: перенесено получателю)"
else
  razmer="$(stat -c '%s' "$yashchik/$imya" 2>/dev/null || echo 0)"
  if [ "$razmer" -eq 0 ]; then
    echo "a2a-send: 🔴 письмо легло пустым — отправка не удалась" >&2
    exit 1
  fi
fi

echo "a2a-send: письмо $imya → $komu ($polzovatel), $(printf '%s' "$tekst" | wc -c) Б"

[ "$bez_kopii" -eq 1 ] && exit 0

# ── ВИДИМОСТЬ ВЛАДЕЛЬЦУ
# 🔴 СЧЁТ И ОБРЕЗКА — ТОЛЬКО ПО ЗНАКАМ, НЕ ПО БАЙТАМ (замерено 29.08.2026).
# `cut -c` в GNU coreutils режет БАЙТЫ: «cut -c1-50» на кириллице отдаёт 25
# знаков и может разрубить символ пополам, отдав в чат битый хвост. Число в
# пометке при этом врало бы вдвое. python3 знает знаки в любой локали, а юнит
# ходит с пустым окружением, где локаль C.
znakov="$(printf '%s' "$tekst" | python3 -c 'import sys; print(len(sys.stdin.read()))')"
if [ "$znakov" -gt "$PREDEL_V_CHAT" ]; then
  # 🔴 Обрезка НАЗЫВАЕТСЯ вслух: молча обрезанное письмо владелец прочтёт как
  # письмо целиком и решит, что видел всё.
  vidno="$(printf '%s' "$tekst" | python3 -c 'import sys; print(sys.stdin.read()[:int(sys.argv[1])], end="")' "$PREDEL_V_CHAT")"
  hvost="

… показано $PREDEL_V_CHAT из $znakov знаков, письмо целиком у получателя: $imya"
else
  vidno="$tekst"
  hvost=""
fi

# 🔴 Причина отказа берётся из ЭТОГО вызова, а не вторым «пробным»: пробный
# вызов отправил бы владельцу лишнее сообщение ради текста ошибки.
# 🔴 Текст подаётся через стандартный ВВОД, не аргументом: командную строку
# процесса (/proc/<pid>/cmdline) читает любой пользователь машины, и письмо
# было бы видно постороннему в момент отправки. tell-owner читает stdin.
otvet="$(printf '%s' "→ $komu: $vidno$hvost" | "$TELL" 2>&1)"
kod_chata=$?
[ "$kod_chata" -eq 0 ] && exit 0
# Письмо УЖЕ доставлено. Отдельный код, а не 1: «доставлено, но владелец не
# увидел» и «не доставлено» — разные новости, и сливать их нельзя.
echo "a2a-send: ⚠️ письмо доставлено, но копия владельцу НЕ ушла: ${otvet:-причина не названа}" >&2
exit 4
