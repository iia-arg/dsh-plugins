#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""agent-registry — читатель реестра агентов машины.

  list     показать намерение по агентам
  sluzhby  напечатать службы агентов и их зависимостей — для потребителей,
           чтобы им не заводить свой список
  pole     agent-registry pole <агент> <поле> [--json] — одно поле намерения.
           --json даёт машинную форму: оболочка берёт jq и не разбирает
           вывод регулярками. Вложенности через точку НЕТ намеренно —
           причина в теле cmd_pole, там же замер.
           🔴 В конвейере код возврата берите через PIPESTATUS или
           set -o pipefail: `... --json | jq ...` отдаёт код jq, а тот
           на пустом входе равен 0. Отказ инструмента при этом не
           виден вовсе — измеряется не та команда.
  mashina  agent-registry mashina [--json] — свойства самой машины: путь ключа
           GPG, путь хранилища секретов, куда и куда локально едет копия, канал
           тревог. Только ПУТИ — значений секретов в реестре нет и не будет,
           раздел безопасно печатать целиком.
           🔴 Заведено 25.08 по находке при установке приёмки копии: путь ключа
           жил в реестре КОММЕНТАРИЕМ, то есть был виден человеку и невидим
           машине, и потребитель завёл его своей переменной у себя.
  obshchee agent-registry obshchee [--json] — общемашинное: пути, которые нужны
           для восстановления ЛЮБОГО агента и не принадлежат ни одному.
           🔴 Заведено 24.08 по находке при установке сторожа покрытия: раздела
           не было видно ни одной подкомандой, и потребителю пришлось завести
           свой список внутри кода — ровно то, против чего реестр и заводился.
           Причина оказалась не в небрежности потребителя, а в немоте читателя.
  pokrytie --json --s-nepolnymi — отдельный вход: карта полных записей и
           nepolnye поимённо; код 0 только при полной рамке, код 4 при неполной.
           Код 4 НЕ разрешает считать копию полной. Старый вход ниже неизменён.
  pokrytie agent-registry pokrytie [--json] — ВСЯ рамка покрытия копии одним
           вызовом: корни обхода, дома, общемашинное в копию и не в копию,
           разметка комнат по каждому агенту. Заведено для сторожа покрытия,
           чтобы у него не осталось ни одного своего списка — включая рамку
           собственного обхода. Любого раздела нет — ОТКАЗ 3, не пустота.
  Коды pokrytie (оба входа):
    0 — полная рамка успешно выдана.
    2 — загрузчик/реестр недоступен, не разбирается либо нет непустого списка агентов.
    3 — строгий вход не собрал рамку; либо отказ договора/аргументов нового входа.
    4 — только --json --s-nepolnymi: карта выдана, nepolnye непуст; это НЕ полная копия.
  Это не общий перечень всех подкоманд: verify использует также код 1 (расхождение).
  fakt     снять с машины то, что снимаемо ЭТОЙ рукой
  verify   сверить намерение с фактом. Расхождение => 1, слепота => 2
  sobrat   agent-registry sobrat [--kuda <каталог>] — собрать производные (D настройки компакта, H agent-tell,
           J v2-receivers) из реестра и сверить с боем; с --kuda — положить сборку кандидатом. В бой не пишет (B-H-081 Ш3-2)
           C — env шлюзов /etc/claude-oauth/instance-<имя>.env (B-H-081 Ш6). Подписка (GATEWAY_TOKEN_FILE): хозяин — env
           (переключатель pereklyuchatel-podpiski, /switch, у всех Claude-шлюзов разом); реестр номер НЕ хранит —
           namerenie.podpiska = obshchaya-claude (B-N-1457); новому агенту — общая живая у соседей. verify: «живое-C»
           (env ↔ процесс шлюза) и «подписка-общая» (env у всех Claude-шлюзов одинаков, файл токена есть).

🔴 ГРАНИЦЫ — читать до того, как положиться:
  * Инструмент НИЧЕГО не меняет. Ни одна подкоманда не правит файлы и не
    перезапускает служб.
  * Он не угадывает. Нет поля в реестре — громкий отказ и ненулевой код,
    а не умолчание. Имя службы, порт, дом и место модели берутся только из
    явных полей: на этой машине шаблон по имени агента уже ложен.
  * verify отвечает на вопрос «совпадает ли намерение с машиной», а НЕ
    «здоров ли агент». Живость — отдельная проверка, поле kak_proverit_zhiv.
  * 🔴 verify различает ТРИ исхода, а не два. «Не смогла проверить» — это не
    «сошлось». Известная граница (поле помечено snimaet: root, а рука иная)
    печатается как «граница» и код не поднимает: это записанное состояние,
    а не событие. НЕИЗВЕСТНАЯ слепота — поле помечено снимаемым этой рукой,
    а снять не вышло — даёт код 2. Иначе ежедневная тревога о заведомо
    непроверяемом приучит владельца не читать тревоги.
  * Тариф (подписка или поштучно) машиной не снимается вовсе: это уговор с
    поставщиком, а не свойство файловой системы. verify его не проверяет и
    честно говорит об этом, а не молчит.
  * Дом соседа из-под iskra не читается. Это не поломка и не расхождение.
"""
import hashlib
import json
import math
import hashlib
import tempfile
import os
import pwd
import re
import shlex
import stat
import subprocess
import sys
from urllib.parse import urlsplit

try:
    import yaml
except Exception as e:                                     # pragma: no cover
    print(f"agent-registry: нет python3-yaml — {e}", file=sys.stderr)
    sys.exit(2)

REESTR = os.environ.get("AGENTS_REGISTRY", "/etc/agent-registry/agents.yaml")
WATCHDOG_CONF = os.environ.get("WATCHDOG_CONF", "/etc/agent-watchdog/watchdog.conf")
# B-N-1890 (Михалыч 09.10): подмены ТОЛЬКО стенду реестра (stend-reestra-agentov.sh) для пробы «живое-C у гостя» —
# каталог env шлюзов и шаблон имени юнита шлюза ({} = имя агента). Без переменных — боевые /etc/claude-oauth и claude-oauth-gateway@.
KATALOG_C = os.environ.get("AGENT_REGISTRY_KATALOG_C", "/etc/claude-oauth")
YUNIT_C = os.environ.get("AGENT_REGISTRY_YUNIT_C", "claude-oauth-gateway@{}.service")

OK, RASH, SLEP = "ok", "расхождение", "СЛЕПОТА"


F_PROVENANCE = None


def zagruzit():
    global F_PROVENANCE
    try:
        with open(REESTR, encoding="utf-8", newline="") as f:
            tekst_f = f.read()
            d = yaml.safe_load(tekst_f)
    except FileNotFoundError:
        print(f"agent-registry: реестра нет — {REESTR}", file=sys.stderr)
        sys.exit(2)
    except Exception as e:
        print(f"agent-registry: реестр не разбирается — {e}", file=sys.stderr)
        sys.exit(2)
    if not isinstance(d, dict) or not isinstance(d.get("agenty"), list) or not d["agenty"]:
        print(f"agent-registry: в {REESTR} нет непустого списка agenty", file=sys.stderr)
        sys.exit(2)
    F_PROVENANCE = (d, {"path": REESTR, "sha256": hashlib.sha256(tekst_f.encode()).hexdigest()})
    return d


def sh(cmd, timeout=15):
    """Вернуть (код, вывод). Отказ запуска — код 127, а не исключение."""
    try:
        p = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, "таймаут"
    except Exception as e:
        return 127, str(e)


def pokazatel(unit, prop):
    _, out = sh(f"systemctl show {unit!r} -p {prop} --value")
    return out.strip()


def moya_ruka():
    """Кто спрашивает — по ДЕЙСТВУЮЩЕМУ пользователю процесса.

    🔴 Не из $USER: переменную окружения подставляет запускающий, и тогда
    инструмент назовёт руку, которой не является. Субъект проверки обязан
    браться из самой проверки, а не из окружения.
    """
    import pwd
    return pwd.getpwuid(os.geteuid()).pw_name


# ── чтение поля намерения ───────────────────────────────────────────────────
def namerenie(a):
    n = a.get("namerenie")
    if not isinstance(n, dict):
        print(f"agent-registry: у агента {a.get('imya')!r} нет блока namerenie", file=sys.stderr)
        sys.exit(2)
    return n


def obyazatelnoe(n, imya, klyuch):
    """Нет поля — отказ, а не умолчание."""
    if klyuch not in n:
        print(f"agent-registry: у агента {imya!r} нет поля {klyuch!r} — "
              f"выводить его по шаблону запрещено, дополните реестр", file=sys.stderr)
        print("agent-registry-error: field-not-found", file=sys.stderr)
        sys.exit(3)
    return n[klyuch]


# ── подкоманды ──────────────────────────────────────────────────────────────
def cmd_list(d):
    for a in d["agenty"]:
        n = namerenie(a)
        print(f"{a['imya']}  ({a.get('rol','?')})")
        for k in ("sluzhba", "polzovatel", "dom", "port", "provider", "model",
                  "reasoning", "tarif", "instrukciya", "kto_perezapuskaet"):
            if k in n:
                print(f"    {k:<18} {n[k] if n[k] is not None else '—'}")
        if n.get("zavisit_ot"):
            print(f"    {'zavisit_ot':<18} {' '.join(n['zavisit_ot'])}")
    return 0


def sluzhby_reestra(d):
    out = []
    for a in d["agenty"]:
        n = namerenie(a)
        out.append(obyazatelnoe(n, a["imya"], "sluzhba"))
        out += list(n.get("zavisit_ot") or [])
    # порядок сохраняем, дубли убираем
    vid, res = set(), []
    for s in out:
        if s not in vid:
            vid.add(s)
            res.append(s)
    return res


def cmd_sluzhby(d):
    print(" ".join(sluzhby_reestra(d)))
    return 0


def razdely_mashiny(d):
    """Общемашинные разделы рамки — без агентов. Единственное место их сборки.

    🔴 B-H-186 (#227-5): obshchee брал их через ramka(), а та отказывает кодом 3 на
    первом агенте без kopiya — общемашинное терялось из-за полноты, которая ему
    не нужна. Разделы и их отказ на пустоту остались прежними, ramka зовёт отсюда.
    """
    r = {}
    for klyuch, chelovecheski in (("korni_obhoda", "корни обхода"),
                                  ("obshchee", "общемашинное в копию"),
                                  ("obshchee_ne_v_kopiyu", "общемашинное не в копию")):
        v = d.get(klyuch)
        if not v:
            print(f"agent-registry: в реестре нет непустого раздела {klyuch!r} "
                  f"({chelovecheski}). Это ОТКАЗ, а не «его нет»: пустым он не "
                  f"бывает. Дополните {REESTR}", file=sys.stderr)
            sys.exit(3)
        r[klyuch] = v
    return r


def ramka(d):
    """Собрать рамку покрытия. Единственное место, где она собирается.

    🔴 Раздела нет — отказ, а не пустой ответ. Ни один из этих списков не бывает
    пуст на живой машине: нет корней обхода — нечего обходить; нет общемашинного
    — значит его не описали. Потребитель, получивший пустоту, промолчит и будет
    выглядеть исправным.
    """
    r = razdely_mashiny(d)
    doma, komnaty = {}, {}
    for a in d["agenty"]:
        imya = a["imya"]
        n = namerenie(a)
        doma[imya] = obyazatelnoe(n, imya, "dom")
        k = n.get("kopiya")
        if not isinstance(k, dict):
            print(f"agent-registry: у агента {imya!r} нет раздела kopiya — состав "
                  f"копии неизвестен. Это отказ: «неизвестно» не равно «ничего "
                  f"не нужно»", file=sys.stderr)
            sys.exit(3)
        komnaty[imya] = {"klast": list(k.get("klast") or []),
                         "ne_klast": dict(k.get("ne_klast_prichina") or {})}
    r["doma"] = doma
    r["komnaty"] = komnaty
    return r


def ramka_s_nepolnymi(d):
    """Новый договор: неизвестное названо, а не превращено в пустую политику.

    Код 4 означает неполную рамку, не разрешение делать полную копию.
    Исходный реестр не меняется; старые ramka/pokrytie сохраняют строгий отказ.
    """
    polnye, nepolnye, imena = [], [], set()
    for a in d["agenty"]:
        imya = a.get("imya") if isinstance(a, dict) else None
        if not isinstance(imya, str) or not imya.strip() or imya in imena:
            print("agent-registry: негодное или повторное имя агента — "
                  "неполную рамку нельзя выдать однозначно", file=sys.stderr)
            sys.exit(3)
        imena.add(imya)
        prichiny = []
        n = a.get("namerenie")
        if not isinstance(n, dict):
            prichiny.append("нет словаря namerenie")
        else:
            dom = n.get("dom")
            if not isinstance(dom, str) or not dom.strip():
                prichiny.append("нет непустого строкового namerenie.dom")
            k = n.get("kopiya")
            if not isinstance(k, dict):
                prichiny.append("нет словаря namerenie.kopiya")
            else:
                # Прежние необязательные поля остаются необязательными.
                # Полнота здесь структурная, не аудит фактических файлов дома.
                klast = k.get("klast")
                ne_klast = k.get("ne_klast_prichina")
                if klast is not None and (not isinstance(klast, list)
                        or any(not isinstance(x, str) for x in klast)):
                    prichiny.append("namerenie.kopiya.klast должен быть списком строк")
                if ne_klast is not None and (not isinstance(ne_klast, dict)
                        or any(not isinstance(key, str) or not isinstance(value, str)
                               for key, value in ne_klast.items())):
                    prichiny.append("namerenie.kopiya.ne_klast_prichina должен быть словарём строк")
        if prichiny:
            nepolnye.append({"imya": imya, "prichiny": prichiny})
        else:
            polnye.append(a)
    # Общемашинные поля и форма полных записей собираются ПРЕЖНИМ способом.
    # Негода общемашинной рамки остаётся общим отказом, а не частичным успехом.
    tolko_polnye = dict(d)
    tolko_polnye["agenty"] = polnye
    r = ramka(tolko_polnye)
    r.update({"format": "pokrytie-s-nepolnymi-v1",
              "polnoe": not nepolnye, "nepolnye": nepolnye})
    return r


def cmd_pokrytie(d, argv):
    if "--s-nepolnymi" in argv:
        if sorted(argv) != ["--json", "--s-nepolnymi"]:
            print("agent-registry: новый режим требует ровно pokrytie --json "
                  "--s-nepolnymi, без дополнительных ключей", file=sys.stderr)
            return 3
        r = ramka_s_nepolnymi(d)
        json.dump(r, sys.stdout, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
        if r["nepolnye"]:
            print("agent-registry: неполная рамка; не описаны полностью: "
                  + ", ".join(x["imya"] for x in r["nepolnye"]), file=sys.stderr)
            return 4
        return 0
    r = ramka(d)
    if "--json" in argv:
        json.dump(r, sys.stdout, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    print("корни обхода:")
    for x in r["korni_obhoda"]:
        m = ",".join(x.get("maski") or []) or "без маски"
        print(f"  {x.get('put')}   [{m}]   {x.get('zachem','')}")
    print("дома:")
    for i, dm in r["doma"].items():
        k = r["komnaty"][i]
        print(f"  {i:<12} {dm}   klast {len(k['klast'])}, не класть {len(k['ne_klast'])}")
    print(f"общемашинное в копию: {len(r['obshchee'])}")
    print(f"общемашинное НЕ в копию: {len(r['obshchee_ne_v_kopiyu'])}")
    return 0


def cmd_obshchee(d, argv):
    """Общемашинное: путь + зачем. --json — машинная форма.

    🔴 Пустой раздел — ОТКАЗ, а не пустой список. Общемашинное на этой машине
    есть заведомо (реестры, сторожа, полка скиллов); ответ «ничего нет» здесь
    означает не факт о машине, а то, что читать было нечего. Потребитель,
    получивший пустоту, решит «покрывать нечего» и промолчит — тихий ноль.
    """
    kak_json = "--json" in argv
    # Через razdely_mashiny(), а не своим чтением: два места сборки одного списка
    # разошлись бы молча — ровно то, от чего заведён сам реестр. Не через ramka():
    # та требует полноты агентов, которая общемашинному не нужна (B-H-186).
    lst = razdely_mashiny(d)["obshchee"]
    if kak_json:
        json.dump(lst, sys.stdout, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    for x in lst:
        put = x.get("put", "?") if isinstance(x, dict) else str(x)
        zachem = x.get("zachem", "") if isinstance(x, dict) else ""
        print(f"{put}")
        if zachem:
            print(f"    {zachem}")
    return 0


def cmd_mashina(d, argv):
    """Свойства САМОЙ машины: где ключ, где хранилище секретов, куда едет копия.

    Заведено 25.08.2026 по находке при установке приёмки копии: путь ключа
    существовал в реестре только КОММЕНТАРИЕМ рядом с hranilishche_sekretov,
    то есть был записан для человека и невидим машине. Потребитель
    (proverka-kopii.sh) из-за этого держал оба пути своими переменными внутри
    себя и честно назвал это своим списком. Тот же случай был 24.08 с obshchee:
    причина не в небрежности потребителя, а в НЕМОТЕ читателя.

    🔴 Два ключа обязательны: klyuch_gpg и hranilishche_sekretov. Их отсутствие —
    ОТКАЗ 3, а не пустой ответ. Приёмка копии, получив пустоту, проверила бы
    несуществующие пути и сказала «ключа в копии нет» — вердикт о копии по
    дефекту реестра, то есть красивый неверный ответ вместо отказа.

    🔴 ЧЕГО ЗДЕСЬ НЕТ: значений секретов. В реестре только пути, и так будет
    всегда. Раздел безопасно печатать целиком и класть в отчёт.
    """
    kak_json = "--json" in argv
    m = d.get("mashina")
    if not isinstance(m, dict) or not m:
        print("agent-registry: в реестре нет непустого раздела 'mashina'. Это ОТКАЗ, "
              f"а не «его нет»: пустым он не бывает. Дополните {REESTR}", file=sys.stderr)
        return 3
    net = [k for k in ("klyuch_gpg", "hranilishche_sekretov") if not m.get(k)]
    if net:
        print(f"agent-registry: в разделе 'mashina' нет обязательных полей: "
              f"{', '.join(net)}. Без них приёмку копии не выполнить: хранилище "
              f"без ключа — мёртвый груз, ключ без хранилища — нечего открывать. "
              f"Дополните {REESTR}", file=sys.stderr)
        return 3
    if kak_json:
        json.dump(m, sys.stdout, ensure_ascii=False, sort_keys=True)
        sys.stdout.write("\n")
        return 0
    for k, v in m.items():
        if isinstance(v, dict):
            print(f"{k}")
            for a, b in v.items():
                print(f"    {a:22} {b}")
        elif isinstance(v, list):
            print(f"{k}")
            for x in v:
                print(f"    {x}")
        else:
            print(f"{k:24} {v}")
    return 0


def cmd_pole(d, argv):
    """Отдать одно поле намерения. --json — машинная форма для оболочки.

    🔴 ВЛОЖЕННОСТЬ ЧЕРЕЗ ТОЧКУ ЗДЕСЬ НЕ ДЕЛАЕТСЯ, И ЭТО РЕШЕНИЕ, А НЕ ПРОПУСК.
    Напрашивается `pole iskra kopiya.klast`, и на большинстве данных это
    работало бы. Но в ЭТОМ реестре уже есть ключи, содержащие точку в самом
    имени: `app.rc8-20260821`, `.npm/.cache`, `.claude/projects`, `.cache/.npm`.
    Разбор по точке пойдёт искать в них ключ `app`, не найдёт — и отдаст
    «у агента нет такого поля». То есть на СУЩЕСТВУЮЩЕЕ поле придёт отказ,
    неотличимый от штатного отказа реестра: правдоподобный неверный ответ,
    а не громкая ошибка. Замерено на настоящих данных 24.08.2026.
    Годный путь — `--json | jq '.ne_klast_prichina["app.rc8-20260821"]'`:
    jq берёт ключ с точкой явными скобками, а `jq -e` держит границу
    «нет ключа => ненулевой код». Свой разбор путей был бы хуже jq.
    """
    argv = list(argv)
    kak_json = False
    for flag in ("--json",):
        while flag in argv:
            argv.remove(flag)
            kak_json = True
    if len(argv) != 2:
        print("agent-registry pole <агент> <поле> [--json]", file=sys.stderr)
        return 3
    imya, klyuch = argv
    for a in d["agenty"]:
        if a["imya"] == imya:
            if "." in klyuch and klyuch not in namerenie(a):
                # 🔴 Без этой подсказки отказ был бы неотличим от штатного
                # «нет такого поля», и спросивший решил бы, что дополнять надо
                # реестр, а дополнять надо вызов. Отказ обязан называть свою
                # настоящую причину, иначе он уводит в сторону вежливо.
                print(f"agent-registry: в имени поля {klyuch!r} есть точка. "
                      f"Вложенность через точку НЕ поддерживается намеренно: "
                      f"в этом реестре точка встречается внутри самих имён "
                      f"ключей, и разбор по ней отказал бы на существующем "
                      f"поле. Возьмите: agent-registry pole {imya} "
                      f"{klyuch.split('.')[0]} --json | jq ...", file=sys.stderr)
                return 3
            # obyazatelnoe сам отказывает и выходит с кодом 3, если поля нет.
            # 🔴 Граница сохраняется и в --json: отсутствующее поле НЕ
            # превращается в null. null означает «поле есть, значение пусто» —
            # это разные вещи, и сливать их значит вернуть молчаливую пустоту.
            v = obyazatelnoe(namerenie(a), imya, klyuch)
            if kak_json:
                json.dump(v, sys.stdout, ensure_ascii=False, sort_keys=True)
                sys.stdout.write("\n")
            else:
                # Человеческая форма. Для скаляра — голое значение; для списка
                # и словаря — питоновский литерал: он для ГЛАЗ, не для разбора.
                # Машине разбирать его регулярками не надо, есть --json.
                print("" if v is None else v)
            return 0
    print(f"agent-registry: агента {imya!r} в реестре НЕТ. Свой список заводить "
          f"нельзя — либо запись в {REESTR}, либо отказ.", file=sys.stderr)
    print("agent-registry-error: agent-not-found", file=sys.stderr)
    return 3


def snyat_fakt(a):
    """Что снимаемо этой рукой. Возвращает словарь поле -> (значение, беда)."""
    n = namerenie(a)
    imya = a["imya"]
    f = {}
    sluzhba = obyazatelnoe(n, imya, "sluzhba")
    f["sluzhba_load"] = (pokazatel(sluzhba, "LoadState"), None)
    f["sluzhba_active"] = (pokazatel(sluzhba, "ActiveState"), None)
    f["polzovatel"] = (pokazatel(sluzhba, "User"), None)
    f["execstart"] = (pokazatel(sluzhba, "ExecStart"), None)
    f["mainpid"] = (pokazatel(sluzhba, "MainPID"), None)
    dom = obyazatelnoe(n, imya, "dom")
    f["dom_est"] = ("да" if os.path.isdir(dom) else "нет", None)
    zav = []
    for u in (n.get("zavisit_ot") or []):
        zav.append(f"{u}={pokazatel(u, 'ActiveState') or 'нет-юнита'}")
    f["zavisimosti"] = (" ".join(zav) if zav else "—", None)
    # модель — только если рука вправе читать источник
    ist = n.get("istochnik_modeli") or {}
    put = ist.get("fajl")
    if put and os.access(put, os.R_OK):
        # B-N-738 k6 (находка 8 репетиции Д10): в A «0.2» вложенный пресет несёт теги !!js — safe_load падал ConstructorError,
        #   а ошибка уходила в «(пусто)» и читалась расхождением модели. Разбор — терпимый (как _yaml_terpimyj), отказ — названный.
        kod, out = sh(f"python3 - <<'EOF'\n"
                      f"import yaml,sys\n"
                      f"class L(yaml.SafeLoader): pass\n"
                      f"L.add_multi_constructor('', lambda l, s, n: None)\n"
                      f"L.add_multi_constructor('tag:yaml.org,2002:js', lambda l, s, n: None)\n"
                      f"d=yaml.load(open({put!r},encoding='utf-8'),Loader=L)\n"
                      f"v=[x for x in (d or []) if isinstance(x,dict) and x.get('id')=={ist.get('id')!r}]\n"
                      f"c=(v[0].get('config') or {{}}) if v else {{}}\n"
                      f"print(c.get('provider',''),c.get('model',''))\n"
                      f"EOF")
        f["model_v_faile"] = ((out, None) if kod == 0 else (None, f"источник не разобран (код {kod}): {out.strip()[-160:]}"))
    else:
        f["model_v_faile"] = (None, f"источник не читается этой рукой: {put}")
    return f


def cmd_kto(d, argv):
    """По СИСТЕМНОМУ пользователю отдать имя агента. --json — машинная форма.

    ЗАЧЕМ ОТДЕЛЬНАЯ ПОДКОМАНДА. Шине A2A нужен обратный путь: почтальон
    видит владельца письма как uid, а владельцу в чат надо написать
    «письмо от Искры», а не «от uid=1001». Без этого потребитель завёл бы
    у себя свой перечень «пользователь → имя», и он разошёлся бы с реестром
    молча в тот день, когда заведут одиннадцатого агента.

    Пользователь, которого в реестре нет, — отказ 3, а не пустая строка:
    пустота в чате читалась бы как «письмо ни от кого».
    """
    argv = list(argv)
    kak_json = "--json" in argv
    while "--json" in argv:
        argv.remove("--json")
    if len(argv) != 1:
        print("agent-registry kto <системный-пользователь> [--json]", file=sys.stderr)
        return 3
    polzovatel = argv[0]
    sovpadeniya = [a for a in d["agenty"] if namerenie(a).get("polzovatel") == polzovatel]
    if len(sovpadeniya) > 1:
        print(f"agent-registry: неоднозначная учётка {polzovatel!r}, "
              f"агенты: {', '.join(a['imya'] for a in sovpadeniya)}", file=sys.stderr)
        return 3
    if sovpadeniya:
        imya = sovpadeniya[0]["imya"]
        print(json.dumps(imya, ensure_ascii=False) if kak_json else imya)
        return 0
    print(
        f"agent-registry: пользователь {polzovatel!r} не значится ни за одним агентом",
        file=sys.stderr,
    )
    return 3


def cmd_fakt(d):
    ruka = moya_ruka()
    print(f"снято рукой: {ruka}")
    for a in d["agenty"]:
        print(f"\n{a['imya']}:")
        for k, (v, beda) in snyat_fakt(a).items():
            print(f"    {k:<16} {v if v is not None else '(не снято: ' + str(beda) + ')'}")
    return 0


# ── B-H-081 Ш1 (26.09.2026, Искра; решения Забавы 16:21Z/16:38Z): «один конфиг на агента» ──────────────
# Сверка ПРОИЗВОДНЫХ мест с ХОЗЯИНОМ значения. Хозяева: намерение — этот реестр (kompakt, kanal); порог и
# рубильник платформенного компакта — ПРЕСЕТ агента (профиль A патчит выключенную строку хоста: dsh-web-app
# cordis.patch.yml:379 disabled:true — dsh --dump-config 26.09); окно — contextWindow маршрута модели в профиле;
# Codex-пути — окружение шлюза. Пути выводятся из реестра и юнитов, не по шаблону.
# Известное расхождение — вердикт «известно» со сроком: не считается,
# но печатается; срок истёк — снова «расхождение» (ключ верхнего уровня реестра izvestnye_rashozhdeniya). ⚠️ НЕ ЛОВИТ: вторую беду в том же поле того же агента,
# пока пометка жива (пометка — на ПОЛЕ, не на пару значений); файлы, которые рука не прочла даже через sudo -n
# (это «граница», не счёт); порог SDK шлюза внутри хода; фактическое срабатывание компакта (только числа).
IZVESTNYE = []
TOKENY_POLZOVATELYA = {}  # пользователь → токены его агентов (agent-tell — файл на ПОЛЬЗОВАТЕЛЯ, а не на агента)


def _yaml_terpimyj(tekst):
    class L(yaml.SafeLoader):
        pass
    L.add_multi_constructor("", lambda l, sfx, node: None)
    L.add_multi_constructor("tag:yaml.org,2002:js", lambda l, sfx, node: None)
    return yaml.load(tekst, Loader=L)


def _prochest(put):
    """Текст файла: сам, иначе sudo -n cat. (текст, беда). Только НЕ секретные файлы."""
    try:
        with open(put, encoding="utf-8") as f:
            return f.read(), None
    except FileNotFoundError:
        return None, "файла нет"
    except PermissionError:
        # 04.10.2026 (обход стендов, Искра): НЕ через sh() — тот склеивает stderr и делает .strip(), срезая конечный
        # перевод строки; сборка-A закрытого дома (varvara, 700) тогда «≠ сборке» при побайтно равном файле. Как в
        # _prochest_a_dlya_porogov: сырой stdout, без stderr и без обрезки.
        try:
            r = subprocess.run(["sudo", "-n", "cat", "--", put], capture_output=True, text=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, f"не прочитан рукой {moya_ruka()} ({type(e).__name__})"
        return (r.stdout, None) if r.returncode == 0 else (None, f"не прочитан рукой {moya_ruka()} (sudo -n: код {r.returncode})")
    except OSError as e:
        return None, e.strerror


def _klyuchi_env(put, klyuchi):
    """Только названные ключи из файла окружения (в нём секреты — весь файл не читаем)."""
    obr = "|".join(klyuchi)
    kod, out = sh(f"sudo -n grep -E {shlex.quote('^(' + obr + ')=')} -- {shlex.quote(put)}", timeout=15)
    if kod not in (0, 1):
        return None
    d = {}
    for l in out.splitlines():
        k, _, v = l.partition("=")
        d[k.strip()] = v.strip().strip("'\"")
    return d


def _zapisi(derevo, uslovie):
    out = []
    def w(o):
        if isinstance(o, dict):
            if uslovie(o):
                out.append(o)
            for v in o.values():
                w(v)
        elif isinstance(o, list):
            for v in o:
                w(v)
    w(derevo)
    return out


def _izvestno(imya, pole):
    import datetime
    for z in IZVESTNYE:
        if not isinstance(z, dict) or z.get("pole") != pole:
            continue
        ag = z.get("agent", "*")
        if ag != "*" and imya not in (ag if isinstance(ag, list) else [ag]):
            continue
        do = str(z.get("do", ""))
        try:
            srok = datetime.date.fromisoformat(do)
        except ValueError:
            return None, f"пометка без годного срока «do» ({do!r}) — не принимаю"
        if datetime.date.today() > srok:
            return None, f"срок пометки истёк {do} ({z.get('lechitsya', '')})"
        return f"до {do}, {z.get('lechitsya', '')}", None
    return None, None


def _user_potrebitelya_d(unit):
    """Учётка из загруженного юнита, не из предположения по имени агента."""
    if not isinstance(unit, str) or not unit.endswith(".service"):
        return None, f"негодный юнит {unit!r}"
    try:
        r = subprocess.run(["systemctl", "show", "--property=LoadState,User,DynamicUser", "--", unit],
                           capture_output=True, text=True, timeout=5)
        props = dict(line.split("=", 1) for line in r.stdout.splitlines() if "=" in line)
        if r.returncode or props.get("LoadState") != "loaded":
            return None, f"юнит {unit} не прочитан/не загружен (код {r.returncode})"
        if props.get("DynamicUser") != "no" or "User" not in props:
            return None, f"юнит {unit}: постоянная учётка User не установлена"
        user = props["User"] or "root"  # пустой User загруженного системного юнита = root
        entry = pwd.getpwuid(int(user)) if user.isdecimal() else pwd.getpwnam(user)
        return entry.pw_name, None
    except (OSError, subprocess.TimeoutExpired, KeyError, ValueError) as e:
        return None, f"юнит {unit}: {type(e).__name__}: {e}"


def _proverit_chtenie_d(n, imya, put_d, sud):
    """Читают ли D User службы и объявленных зависимостей-шлюзов; 5 с на команду, без повторов.

    Это DAC/ACL учётки на файловой системе хоста, не проверка sandbox/capabilities юнита.
    """
    rash = slep = 0
    units = [n.get("sluzhba")] + (n.get("zavisit_ot") or [])
    for unit in dict.fromkeys(units):
        user, beda = _user_potrebitelya_d(unit)
        expected = f"{imya}: доступ User юнита {unit} к D на хосте (контекст юнита не проверен)"
        if beda:
            sud("чтение-D", SLEP, expected, beda); slep += 1
            continue
        try:
            cmd = ["/usr/bin/test", "-r", put_d]
            if pwd.getpwnam(user).pw_uid != os.geteuid():
                cmd = ["sudo", "-n", "-u", user, "--"] + cmd
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired, KeyError) as e:
            sud("чтение-D", SLEP, expected, f"User={user}, {put_d}: {type(e).__name__}"); slep += 1
            continue
        if r.returncode == 0:
            sud("чтение-D", OK, expected, f"User={user} читает {put_d}")
        elif r.returncode == 1 and not (r.stdout or r.stderr).strip():
            sud("чтение-D", RASH, expected, f"User={user} НЕ читает {put_d}"); rash += 1
        else:
            sud("чтение-D", SLEP, expected, f"User={user}, {put_d}: проба не выполнена, код {r.returncode}: {(r.stderr or r.stdout).strip()[:160]}"); slep += 1
    return rash, slep


def sverit_proizvodnye(n, imya, sud):
    rash = slep = 0

    def rashozhdenie(pole, ozhid, fakt):
        nonlocal rash
        izv, beda = _izvestno(imya, pole)
        if izv:
            sud(pole, "известно", ozhid, f"{fakt} [{izv}]")
        else:
            sud(pole, RASH, ozhid, fakt + (f" [{beda}]" if beda else "")); rash += 1

    # A — профиль (путь уже в реестре: istochnik_modeli.fajl), B — пресет по его «preset:»
    put_a = (n.get("istochnik_modeli") or {}).get("fajl")
    ta, beda_a = _prochest(put_a) if put_a else (None, "istochnik_modeli.fajl не заявлен")
    a = _yaml_terpimyj(ta) if ta else None
    presety = {x.get("preset") for x in _zapisi(a, lambda o: isinstance(o.get("preset"), str))} if a else set()
    b = put_b = None
    # B-N-738 k6 (находка 8): раскладка DSH 0.2 узнаётся ПО САМОМУ A — строка '@deepseek-ai/dsh-agent-preset' (в A 0.1 её нет:
    #   замер 29.09 21:4xZ — 0 у 9 боевых A, 1 у 9 сборок 0.2). Каталога .agent-presets тогда нет (Ш9 п.4) — пресет вложен в A.
    vlozh = _zapisi(a, lambda o: o.get("name") == "@deepseek-ai/dsh-agent-preset") if a else []
    # B-N-1198: расхождение по пресету НЕ обрывает сверки агента — одно красное не прячет остальные (ранний выход — только без A).
    if vlozh:
        # B-N-1499: у гостя с SAJT_CHAT второй вложенный пресет «<имя>-site». Свой — config.id == имя агента, ровно один;
        #   прочие допустимы только «<имя>-…» — иначе расхождение (защита от дубля пресета остаётся).
        svoj = [x for x in vlozh if (x.get("config") or {}).get("id") == imya]
        lishnie = [x for x in vlozh if x not in svoj and not str((x.get("config") or {}).get("id")).startswith(imya + "-")]
        if len(svoj) != 1 or lishnie:
            sud("пресет", RASH, "ровно один вложенный пресет агента (DSH 0.2), прочие — только «<имя>-…»",
                f"своих {len(svoj)}, чужих {len(lishnie)} из {len(vlozh)} в {put_a}"); rash += 1
        else:
            b = svoj[0].get("config") or {}
            put_b = f"{put_a} (вложенный {svoj[0].get('id')}, DSH 0.2)"
            if presety and b.get("id") not in presety:
                rashozhdenie("пресет", f"вложен пресет, названный профилем {sorted(presety)}", f"вложен {b.get('id')!r} ({put_a})")
    elif a is not None:
        # B-H-081 Ш4 (слово владельца 30.09 03:28 МСК: обновления dsh односторонние): путь 0.1 (пресет B каталогом) снят.
        sud("пресет", RASH, "вложенный '@deepseek-ai/dsh-agent-preset' (DSH 0.2)", f"в {put_a} его нет — раскладка 0.1 не поддерживается"); rash += 1
    kat = os.path.join(n["dom"], ".dsh", ".agent-presets")
    try:
        os.lstat(kat)
        sud("пресет", RASH, f"{kat} нет (DSH 0.2)", "есть — раскладка 0.1 не поддерживается"); rash += 1
    except FileNotFoundError:
        pass
    except PermissionError:
        # Ш4-граница (боевой прогон 02:21Z рукой iskra: 5 закрытых домов → код 2): stat не пускает этой рукой — «граница»,
        # не слепота, как у модели/ящика/токена. Прочие ошибки ОС (ENOTDIR, EIO…) — по-прежнему слепота.
        sud("пресет", "граница", f"{kat} нет (DSH 0.2)", f"не виден руке {moya_ruka()}")
    except OSError as e:
        sud("пресет", SLEP, f"{kat} нет (DSH 0.2)", f"не проверен ({e.strerror})"); slep += 1
    if a is None:
        sud("пресет", "граница", "профиль и пресет", beda_a)
        return rash, slep
    # B-N-1198: пресет не определён (расхождение названо выше) — сверки, которым он нужен, называются границей, прочие идут.
    bez_b = b is None
    if bez_b:
        b = {}

    # B-N-1454 (замечание Вениамина 02.10 15:19Z): с 1.5.58 служебные тревоги telegram-multiagent идут ТОЛЬКО владельцу —
    #   mergeChatIntoA2A, если он же в allowedUsers; иначе пакет молчит наружу (одна строка журнала без читателя).
    #   Правило то же, что в пакете (Number(...) — целое > 0, ∈ Set(allowedUsers.map(Number))).
    def _celoe(v):
        if isinstance(v, bool):
            return None
        if isinstance(v, int):
            return v if v > 0 else None
        if isinstance(v, str) and v.strip().isdigit():
            return int(v.strip()) or None
        return None
    tg = _zapisi(a, lambda o: "allowedUsers" in o)
    if not tg:
        rashozhdenie("владелец-тревог", "mergeChatIntoA2A ∈ allowedUsers (B-N-1454)", f"в {put_a} нет настройки с allowedUsers")
    for o in tg:
        m = _celoe(o.get("mergeChatIntoA2A"))
        dop = {_celoe(x) for x in (o.get("allowedUsers") or [])} if isinstance(o.get("allowedUsers"), list) else set()
        if m is not None and m in dop:
            sud("владелец-тревог", OK, "mergeChatIntoA2A ∈ allowedUsers (B-N-1454)", f"владелец {m}")
        else:
            rashozhdenie("владелец-тревог", "mergeChatIntoA2A ∈ allowedUsers (B-N-1454)",
                         f"mergeChatIntoA2A={o.get('mergeChatIntoA2A')!r} не в allowedUsers ({put_a}) — тревоги не дойдут никому")

    cb_b = [x for x in _zapisi(b, lambda o: o.get("id") == "compaction-basic") if not x.get("disabled")]
    v_b = {id(x) for x in _zapisi(b, lambda o: True)} if vlozh else set()   # k6: строки вложенного пресета — не «строки A»
    cb_a = [x for x in _zapisi(a, lambda o: o.get("id") == "compaction-basic") if id(x) not in v_b]
    selected_policy = None
    try:
        compiled = vychislit_porogi(ta, imya)
        route = compiled["defaultRoute"]
        selected_policy = next(r for r in compiled["routes"] if (r["provider"], r["model"]) == (route["provider"], route["model"]))
    except (ValueError, TypeError, yaml.YAMLError) as e:
        sud("порог-A", SLEP, f"{imya}: вычисляемая политика A", str(e)); slep += 1
    porog_b = selected_policy["ratio"] if selected_policy else None

    # D — настройка компакта: имя из KOMPAKT_AGENT (окружение шлюза, иначе службы)
    env = _okruzhenie_kompakta(n)  # B-H-081 Ш3-2: общий с sobrat помощник
    ka = n.get("kompakt_agent")  # Ш3-3 (в): имя — из реестра; окружение юнита обязано совпасть
    if env.get("KOMPAKT_AGENT") != ka:
        rashozhdenie("kompakt_agent", f"реестр {ka or '—'}", f"KOMPAKT_AGENT окружения {env.get('KOMPAKT_AGENT') or '—'}")
    else:
        sud("kompakt_agent", OK, f"реестр {ka}", "KOMPAKT_AGENT окружения совпадает")
    de = None
    if ka:
        # B-H-081 Ш4: только внешний D; E не маскирует отсутствие или порчу D.
        put_d = os.path.join(PUT_D, f"{ka}.json")
        td, beda_d = _prochest(put_d)
        if td is None:
            status = RASH if beda_d == "файла нет" else SLEP
            sud("настройка-компакта", status, f"внешний D агента {imya}", f"{put_d}: {beda_d}")
            if status == RASH:
                rash += 1
            else:
                slep += 1
        else:
            try:
                de = json.loads(td)
                if not isinstance(de, dict):
                    raise ValueError("нужен JSON-объект")
            except ValueError as e:
                de = None
                sud("настройка-компакта", RASH, f"внешний D агента {imya}", f"{put_d}: {e}"); rash += 1
        r_d, s_d = _proverit_chtenie_d(n, imya, put_d, sud)
        rash += r_d
        slep += s_d

    # раскладка компакта
    kmp = n.get("kompakt")
    if not kmp:
        sud("раскладка", "не заявлено", "—", "поля kompakt нет")
    elif kmp == "platformennyj":
        if bez_b:
            sud("раскладка", "граница", "platformennyj: compaction-basic в пресете", "пресет не определён (см. «пресет») — не сверено")
        elif not cb_b:
            sud("раскладка", RASH, "platformennyj: compaction-basic в пресете", f"нет/выключен в {put_b}"); rash += 1
        elif de is not None and de.get("kompaktShlyuzovoj") is not False:
            sud("раскладка", RASH, "флаг компакта kompaktShlyuzovoj=false", f"шлюз={de.get('kompaktShlyuzovoj')}"); rash += 1
        elif de is not None and "kompaktPlatformennyj" in de:
            # B-H-081 Ш2: рубильник платформенного — compaction-basic пресета; флаг в настройке — объявление без действия
            sud("раскладка", RASH, "поля kompaktPlatformennyj в настройке нет (устарело, Ш2)", f"kompaktPlatformennyj={de['kompaktPlatformennyj']}"); rash += 1
        else:
            sud("раскладка", OK, "platformennyj", "compaction-basic в пресете" + ("; флаги компакта согласны" if de is not None else "; настройки компакта нет"))
    else:
        sud("раскладка", SLEP, "platformennyj", f"значение {kmp!r} сверять не умею"); slep += 1

    # порог: хозяин — пресет B. B-H-081 Ш2 (хвост, 26.09.2026): в профиле A строки порога быть НЕ ДОЛЖНО — хостовый
    #   compaction-basic выключен dsh-web-app (dump-config: disabled: true), читатели (dsh-compact-watch, kontekst-zamer, storozha,
    #   компакт a31) переведены на пресет 26.09 18:15Z. Строка в A — вторая правда, которая протухнет; есть — расхождение.
    pa = [x["config"].get("thresholdRatio") for x in cb_a if isinstance(x.get("config"), dict)]
    pa = [x for x in pa if x is not None]
    if pa:
        rashozhdenie("порог-профиль", "строки порога в профиле нет (порог — только пресет)", f"thresholdRatio {pa} в {put_a}")
    else:
        sud("порог-профиль", OK, "строки порога в профиле нет", "порог — только пресет" + (f" ({porog_b})" if porog_b is not None else ""))
    if porog_b is not None:
        # B-H-081 Ш2: компакт берёт долю ТОЛЬКО из пресета (porogIzPreseta); доля в настройке — устаревшая копия
        if de is not None:
            ustar = [k for k in ("dolyaPoroga", "dolyaPorogaPlatformy") if k in de]
            if ustar:
                rashozhdenie("порог-компакт", "доли в настройке нет (порог — из пресета, Ш2)", ", ".join(f"{k}={de[k]}" for k in ustar))
            else:
                sud("порог-компакт", OK, f"доля пресета {porog_b}", "в настройке доли нет — компакт берёт из пресета")

    # окно (B-H-081 Ш2): окно АГЕНТА для порога — contextWindow профиля (компакт читает сам); окно СУММАТОРА — oknoSvodki.
    # Старое oknoModeli держало оба смысла — в настройке его быть не должно.
    ok_a = [selected_policy["window"]] if selected_policy else []
    if de is not None:
        if "oknoModeli" in de:
            rashozhdenie("окно", "oknoModeli нет (устарело → oknoSvodki, Ш2)", f"oknoModeli={de['oknoModeli']}")
        else:
            sud("окно", OK, f"агента {ok_a[0] if ok_a else 'умолчание адаптера'}", f"сумматора oknoSvodki={de.get('oknoSvodki', '—')}")

    # канал: tokenFile/spoolDir плагина telegram (профиль и пресет) против kanal реестра
    k = n.get("kanal") or {}
    tg = _zapisi([a, b], lambda o: "telegram-multiagent" in str(o.get("name", "")) and isinstance(o.get("config"), dict))
    for pole_r, pole_c, imya_p in (("token_fajl", "tokenFile", "токен-DSH"), ("yashchik", "spoolDir", "ящик-DSH")):
        vals = {x["config"].get(pole_c) for x in tg if x["config"].get(pole_c)}
        if k.get(pole_r) and vals:
            if vals != {k[pole_r]}:
                rashozhdenie(imya_p, k[pole_r], f"{pole_c} {sorted(vals)}")
            else:
                sud(imya_p, OK, k[pole_r], f"{pole_c} совпадает")

    # Codex: окружение шлюза (хозяин) против настройки компакта (читает telegram-статус)
    if de is not None:
        for pe, pd in (("CODEX_HOME", "domZhurnalaSessij"), ("GATEWAY_BAZA_SESSIJ", "bazaSessij")):
            if de.get(pd) and env.get(pe) and de[pd] != env[pe]:
                rashozhdenie("codex-" + pd, f"{pe} {env[pe]}", de[pd])
            elif de.get(pd) and env.get(pe):
                sud("codex-" + pd, OK, env[pe], "совпадает")
    # третий механизм — собственный автокомпакт Codex: только сведения, кто первым по числам
    if env.get("CODEX_HOME") and porog_b is not None:
        tc, _ = _prochest(os.path.join(env["CODEX_HOME"], "config.toml"))
        lim = None
        for l in (tc or "").splitlines():
            if l.strip().startswith("model_auto_compact_token_limit"):
                try:
                    lim = int(l.split("=", 1)[1].split("#")[0].strip())
                except ValueError:
                    pass
        if lim and ok_a:
            plat = selected_policy["nominalThreshold"]
            sud("компакт-Codex", "сведения", f"номинальный A {porog_b}×{selected_policy['window']}={plat}", f"Codex {lim} — первым по числам: {'платформа' if plat < lim else 'Codex'}")

    # agent-tell (H) против реестра: /etc/agent-tell/<пользователь>.conf
    put_h = f"/etc/agent-tell/{n.get('polzovatel')}.conf"
    if os.path.exists(put_h) and k.get("token_fajl"):
        th, _ = _prochest(put_h)
        tfh = None
        for l in (th or "").splitlines():
            if l.startswith("TOKEN_FILE="):
                tfh = l.split("=", 1)[1].strip().strip("'\"")
        svoi = TOKENY_POLZOVATELYA.get(n.get("polzovatel"), {k["token_fajl"]})
        if tfh and tfh not in svoi:
            rashozhdenie("токен-tell", sorted(svoi), f"TOKEN_FILE {tfh}")
        elif tfh and len(svoi) > 1:
            sud("токен-tell", OK, f"один из {len(svoi)} агентов пользователя {n.get('polzovatel')}", f"TOKEN_FILE {tfh} (общий файл)")
        elif tfh:
            sud("токен-tell", OK, k["token_fajl"], "TOKEN_FILE совпадает")
    return rash, slep


def sverit(a, ruka, stroki):
    """Одна запись. Возвращает (расхождений, неизвестной_слепоты)."""
    n = namerenie(a)
    imya = a["imya"]
    f = snyat_fakt(a)
    rash = slep = 0

    def sud(pole, verdikt, ozhid, fakt):
        stroki.append(f"  {imya:<10} {pole:<16} {verdikt:<12} ждали={ozhid} машина={fakt}")

    if f["sluzhba_load"][0] != "loaded":
        sud("служба", RASH, "loaded", f["sluzhba_load"][0] or "(пусто)"); rash += 1
    elif f["sluzhba_active"][0] != "active":
        sud("служба", RASH, "active", f["sluzhba_active"][0]); rash += 1
    else:
        sud("служба", OK, n["sluzhba"], f"loaded/active pid={f['mainpid'][0]}")

    ozh_u = obyazatelnoe(n, imya, "polzovatel")
    if f["polzovatel"][0] != ozh_u:
        sud("пользователь", RASH, ozh_u, f["polzovatel"][0] or "(пусто)"); rash += 1
    else:
        sud("пользователь", OK, ozh_u, f["polzovatel"][0])

    dom = n["dom"]
    if f["dom_est"][0] != "да":
        sud("дом", RASH, dom, "каталога нет"); rash += 1
    elif dom not in f["execstart"][0]:
        # связь намерения с тем, ЧТО ИМЕННО запущено, а не просто «каталог есть»
        sud("дом", RASH, f"{dom} в ExecStart", f["execstart"][0][:70]); rash += 1
    else:
        sud("дом", OK, dom, "есть и назван в ExecStart")

    for z in (f["zavisimosti"][0].split() if f["zavisimosti"][0] != "—" else []):
        if not z.endswith("=active"):
            sud("зависимость", RASH, "active", z); rash += 1
        else:
            sud("зависимость", OK, z.split("=")[0], "active")

    # живость: команда взята из реестра целиком, не собирается по шаблону
    if "kak_proverit_zhiv" in n and n["kak_proverit_zhiv"]:
        kod, out = sh(n["kak_proverit_zhiv"])
        if kod == 0:
            sud("живость", OK, f"порт {n.get('port','?')}", "платформа отвечает 200")
        else:
            sud("живость", RASH, "ответ 200", f"код {kod} {out[:40]}"); rash += 1
    else:
        sud("живость", SLEP, "команда в реестре", "поля нет"); slep += 1

    # модель и провайдер
    ist = n.get("istochnik_modeli") or {}
    snimaet = ist.get("snimaet")
    znach, beda = f["model_v_faile"]
    ozh = f"{n.get('provider')} {n.get('model')}"
    if znach is None:
        if snimaet and snimaet != ruka:
            sud("модель", "граница", ozh, f"снимаемо рукой {snimaet}, я {ruka}")
        else:
            sud("модель", SLEP, ozh, beda or "не снято"); slep += 1
    elif znach.strip() != ozh.strip():
        sud("модель", RASH, ozh, znach or "(пусто)"); rash += 1
    else:
        sud("модель", OK, ozh, znach)

    # тариф машиной не снимается вовсе — говорим это, а не молчим
    sud("тариф", "не снимаемо", n.get("tarif", "—"), "уговор с поставщиком, не свойство машины")

    r, s = sverit_kanal(n, imya, sud)
    r2, s2 = sverit_proizvodnye(n, imya, sud)  # B-H-081 Ш1
    return rash + r + r2, slep + s + s2


def chitaet_li(polz, put):
    """Читает ли файл учётка polz — БЕЗ чтения значения (test -r её именем). True/False; None — не этой рукой."""
    if moya_ruka() == polz:
        return os.access(put, os.R_OK)
    if os.geteuid() == 0:
        pered = f"runuser -u {shlex.quote(polz)} --"
    elif sh(f"sudo -n -u {shlex.quote(polz)} true")[0] == 0:
        pered = f"sudo -n -u {shlex.quote(polz)}"
    else:
        return None
    return sh(f"{pered} test -r {shlex.quote(put)}")[0] == 0


# B-N-1446: one byte-level pin in agents.yaml; never read token files or linked aliases.
_DOSTAVKA_READER = r"""
import hashlib, json, os, stat, sys
MAX = 1048576

def read(p):
    if not os.path.isabs(p) or not p.endswith('.json'):
        return {'status':'mismatch','reason':'нужен абсолютный путь .json'}
    if os.path.realpath(p) != os.path.abspath(p):
        return {'status':'mismatch','reason':'ссылки запрещены'}
    fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            return {'status':'mismatch','reason':'нужен обычный файл без hardlink'}
        if before.st_size > MAX:
            return {'status':'mismatch','reason':'JSON больше 1048576 байт'}
        data = stream.read(MAX + 1)
        after = os.fstat(stream.fileno())
        current = os.stat(p, follow_symlinks=False)
    fields = lambda x: (x.st_dev,x.st_ino,x.st_size,x.st_mtime_ns,x.st_ctime_ns,x.st_nlink)
    if fields(before) != fields(after) or fields(after) != fields(current) or len(data) != before.st_size:
        return {'status':'blind','reason':'файл изменился при чтении'}
    def invalid_constant(_): raise ValueError('JSON constant')
    try:
        document = json.loads(data.decode('utf-8'), parse_constant=invalid_constant)
        if not isinstance(document, dict): raise ValueError('JSON object')
    except (ValueError, UnicodeError):
        return {'status':'mismatch','reason':'нужен корректный UTF-8 JSON-объект'}
    mode = document.get('deliveryMode', 'personal')
    if mode not in ('owner-all', 'personal', 'broadcast'):
        return {'status':'mismatch','reason':'deliveryMode должен быть owner-all, personal или broadcast'}
    return {'status':'ok','sha256':hashlib.sha256(data).hexdigest(),'deliveryMode':mode}
try:
    result=read(sys.argv[1])
except FileNotFoundError:
    result={'status':'mismatch','reason':'файла нет'}
except PermissionError:
    result={'status':'denied','reason':'нет доступа'}
except OSError:
    result={'status':'blind','reason':'ошибка чтения файла'}
print(json.dumps(result,ensure_ascii=False))
"""


def sverit_soderzhimoe_dostavki(k, sud):
    ds = k.get('nastrojka_dostavki')
    expected = k.get('nastrojka_dostavki_sha256')
    if 'nastrojka_dostavki' not in k:
        if 'nastrojka_dostavki_sha256' in k or 'rezhim_dostavki' in k:
            sud('доставка', RASH, 'путь .json', 'SHA или режим заданы без пути'); return 1, 0
        sud('доставка', 'не заявлено', '—', 'поля kanal.nastrojka_dostavki нет'); return 0, 0
    if not isinstance(ds, str) or not isinstance(expected, str) or not re.fullmatch('[0-9a-f]{64}', expected):
        sud('доставка', RASH, 'kanal.nastrojka_dostavki_sha256', 'нужны путь и явная SHA256 (64 hex)'); return 1, 0
    mode = k.get('rezhim_dostavki')
    if mode not in ('owner-all', 'personal', 'broadcast'):
        sud('доставка', RASH, 'kanal.rezhim_dostavki', 'нужен явный owner-all, personal или broadcast'); return 1, 0
    command = [sys.executable, '-I', '-S', '-c', _DOSTAVKA_READER, ds]
    def read(argv):
        try:
            p = subprocess.run(argv, capture_output=True, text=True, timeout=5)
            result = json.loads(p.stdout) if p.returncode == 0 else {}
            if isinstance(result, dict) and result.get('status') in {'ok','mismatch','blind','denied'}:
                return result
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        return {'status':'blind','reason':'чтение не подтверждено'}
    result = read(command)
    if result['status'] == 'denied' and os.geteuid() != 0:
        result = read(['sudo', '-n', *command])  # one privileged retry, same guarded reader; no raw content in stdout
    if result['status'] in {'blind','denied'}:
        sud('доставка', SLEP, ds, result['reason'] + ' (рука ' + moya_ruka() + ')'); return 0, 1
    if result['status'] != 'ok':
        sud('доставка', RASH, ds, result['reason']); return 1, 0
    actual = result.get('sha256')
    if actual != expected:
        sud('доставка', RASH, ds + ' SHA256=' + expected, 'SHA256=' + str(actual)); return 1, 0
    if result.get('deliveryMode') != mode:
        sud('доставка', RASH, 'kanal.rezhim_dostavki=' + mode, 'JSON deliveryMode=' + str(result.get('deliveryMode'))); return 1, 0
    sud('доставка', OK, ds, 'содержимое SHA256=' + actual); return 0, 0


def sverit_kanal(n, imya, sud):
    """B-D-008 (26.09.2026, Аврора; решение Забавы): адресация по полям, УЖЕ лежащим в записи (namerenie.kanal).

    Данные были, читателя не было: token_fajl и nastrojka_dostavki не читал никто, yashchik — только a2a-send.
    Поля нет — «не заявлено». Для ящика/токена stat сохраняет прежнюю «границу»;
    содержимое доставки без доступа — СЛЕПОТА, а не совпадение (B-N-1446).
    ⚠️ НЕ ЛОВИТ: верен ли токен (значение не читается), доходит ли доставка, живо ли почтовое колесо.
    """
    k = n.get("kanal") or {}
    polz = n.get("polzovatel")
    rash = 0

    def est(put):
        try:
            return os.stat(put)
        except FileNotFoundError:
            return False
        except OSError:
            return None

    y = k.get("yashchik")
    st = est(y) if y else None
    if not y:
        sud("ящик", "не заявлено", "—", "поля kanal.yashchik нет")
    elif st is None:
        sud("ящик", "граница", y, f"не виден руке {moya_ruka()}")
    elif st is False or not stat.S_ISDIR(st.st_mode):
        sud("ящик", RASH, y, "каталога нет"); rash += 1
    else:
        try:
            vladelec = pwd.getpwuid(st.st_uid).pw_name
        except KeyError:  # B-N-1066: uid без имени — расхождение, не трейсбек (как в sverit_obratno)
            vladelec = f"uid {st.st_uid} — имени нет"
        rezhim = stat.S_IMODE(st.st_mode)
        if rezhim != 0o1730 or vladelec != polz:
            sud("ящик", RASH, f"1730 {polz}", f"{rezhim:o} {vladelec}"); rash += 1
        else:
            sud("ящик", OK, y, f"1730 {vladelec}")

    t = k.get("token_fajl")
    st = est(t) if t else None
    if not t:
        sud("токен", "не заявлено", "—", "поля kanal.token_fajl нет")
    elif st is None:
        sud("токен", "граница", t, f"не виден руке {moya_ruka()}")
    elif st is False:
        sud("токен", RASH, t, "файла нет"); rash += 1
    else:
        chit = chitaet_li(polz, t)
        if chit is None:
            sud("токен", "граница", f"читает {polz}", f"проверить может root или {polz}, я {moya_ruka()}")
        elif not chit:
            sud("токен", RASH, f"читает {polz}", "не читается"); rash += 1
        else:
            sud("токен", OK, t, f"читается {polz}")

    r, slep = sverit_soderzhimoe_dostavki(k, sud)
    return rash + r, slep


def sverit_potrebitelya(d, stroki):
    """Свойство приёмки: сторож машины не должен иметь СВОЕГО списка агентов."""
    nuzhno = sluzhby_reestra(d)
    # 🔴 B-N-821 (24.09.2026, Аврора): СПИСОК — ТЕМ ЖЕ СПОСОБОМ, ЧТО У СТОРОЖА, А НЕ ПОДСТРОКОЙ ТЕКСТА.
    # Было `s not in text`: «spartak.service» находилось внутри «claude-oauth-gateway@spartak.service», «alfa.service» —
    # внутри «coder-gateway@alfa.service» и в строке КОММЕНТАРИЯ; снятый из SERVICES агент оставался «под наблюдением»
    # (порча 24.09: spartak.service убран — verify ok). Сторож (agent-watchdog.sh) делает `. "$CONF"` и `for s in $SERVICES` —
    # здесь то же: bash подключает файл и печатает слова SERVICES; сверка — по словам.
    # ⚠️ Граница доверия та же, что у сторожа: файл исполняется оболочкой (root:root 644).
    if not os.access(WATCHDOG_CONF, os.R_OK):
        stroki.append(f"  потребитель  сторож машины   {SLEP}      {WATCHDOG_CONF}: не читается этой рукой")
        return 0, 1
    kod, out = sh(f"env -i bash -c '. \"$1\" >/dev/null 2>&1; printf \"%s\\n\" $SERVICES' _ {WATCHDOG_CONF!r}")
    if kod != 0 or not out.strip():
        stroki.append(f"  потребитель  сторож машины   {SLEP}      {WATCHDOG_CONF}: SERVICES не снят (код {kod})")
        return 0, 1
    slova = set(out.split())
    net = [s for s in nuzhno if s not in slova]
    if net:
        stroki.append(f"  потребитель  сторож машины   {RASH}  нет в наблюдении: {' '.join(net)}")
        return 1, 0
    stroki.append(f"  потребитель  сторож машины   {OK}           все {len(nuzhno)} службы реестра под наблюдением")
    return 0, 0


def sverit_krome(d, stroki):
    """B-N-947 (25.09.2026): исключения из «не в копию» обязаны стоять в копии.

    Запись obshchee_ne_v_kopiyu — строка-причина ЛИБО {prichina: str, krome: [пути]}. krome — пути ВНУТРИ
    размеченного каталога, которые кладутся в копию. Без этой сверки строку obshchee для такого пути можно
    снять молча: сторож покрытия считает каталог покрытым целиком (размечен сам), приёмка копии читает тот же
    реестр и снятое не проверяет. ⚠️ НЕ ЛОВИТ: путь, который забыли внести в krome с самого начала.
    """
    ne_v = d.get("obshchee_ne_v_kopiyu") or {}
    v_kopiyu = {os.path.normpath(str(x.get("put"))) for x in (d.get("obshchee") or []) if isinstance(x, dict)}
    rash = 0
    vsego = 0
    for kat, zn in ne_v.items():
        if isinstance(zn, str):
            continue
        kat = os.path.normpath(str(kat))
        if not (isinstance(zn, dict) and isinstance(zn.get("prichina"), str) and zn["prichina"].strip()
                and isinstance(zn.get("krome"), list) and zn["krome"] and set(zn) <= {"prichina", "krome"}):
            stroki.append(f"  не в копию   {kat}   {RASH}  негодная форма: строка ЛИБО {{prichina, krome: [пути]}}")
            rash += 1
            continue
        for put in zn["krome"]:
            vsego += 1
            put = os.path.normpath(str(put))
            if not put.startswith(kat + os.sep):
                stroki.append(f"  не в копию   {kat}   {RASH}  krome {put}: не внутри каталога")
                rash += 1
            elif put not in v_kopiyu:
                stroki.append(f"  не в копию   {kat}   {RASH}  krome {put}: НЕТ в obshchee — в копию не попадёт")
                rash += 1
    if not rash:
        stroki.append(f"  не в копию   исключения     {OK}           все {vsego} путей krome стоят в obshchee")
    return rash, 0


def sverit_obratno(d, stroki):
    """B-D-008: машина → реестр. verify обходил только записи — агент БЕЗ записи не ловился (24.09 клоны
    стояли без записи ~2 ч). Корни — родители домов и ящиков ИЗ РЕЕСТРА, не свой список.
    Служба: <корень>/<x> — каталог и <x>.service загружен, а ни sluzhba, ни dom его не называют.
    Ящик: каталог в корне ящиков, не объявленный kanal.yashchik и не совпавший с polzovatel (a2a-zavesti
    называет ящик именем пользователя).
    ⚠️ НЕ ЛОВИТ: агента с домом вне этих корней или со службой под другим именем; ящик вне корней реестра.
    B-N-1481 (03.10.2026, Искра; наряд Забавы 17:24Z): служба машины, НЕ агент (socseti — соцслужба Варвары), с тем же
    устроем /opt/<x> + <x>.service — исключается ДАННЫМИ mashina.sluzhby_ne_agenty: {<x>: {prichina, hozyain}}, не
    списком в коде. Исключение без причины или хозяина — расхождение; исключение, у которого нет предмета (каталога
    <корень>/<x> с загруженной <x>.service), — тоже расхождение: иначе оно переживёт службу и спрячет будущего агента.
    ⚠️ НЕ ЛОВИТ: агента, которого заводящий сам вписал в исключения, — запись исключения ответственность заводящего.
    """
    n_ = [a.get("namerenie") or {} for a in d["agenty"]]
    ne_agenty = (d.get("mashina") or {}).get("sluzhby_ne_agenty") or {}
    vidimye = set()
    sluzhby = {n.get("sluzhba") for n in n_}
    doma = {os.path.normpath(str(n["dom"])) for n in n_ if n.get("dom")}
    polz = {n.get("polzovatel") for n in n_}
    yashch = {os.path.normpath(str((n.get("kanal") or {}).get("yashchik"))) for n in n_
              if (n.get("kanal") or {}).get("yashchik")}
    rash = slep = 0
    vsego_sl = vsego_ya = 0
    for koren in sorted({os.path.dirname(x) for x in doma}):
        try:
            imena = sorted(os.listdir(koren))
        except OSError as e:
            stroki.append(f"  обратно      {koren:<16} {SLEP}      не перечислить: {e.strerror}"); slep += 1
            continue
        for x in imena:
            put = os.path.join(koren, x)
            if not os.path.isdir(put) or pokazatel(f"{x}.service", "LoadState") != "loaded":
                continue
            vsego_sl += 1
            if x in ne_agenty:
                vidimye.add(x)
                ia = ne_agenty[x] if isinstance(ne_agenty[x], dict) else {}
                pr, hz = ia.get("prichina"), ia.get("hozyain")
                if not (isinstance(pr, str) and pr.strip() and isinstance(hz, str) and hz.strip()):
                    stroki.append(f"  обратно      служба           {RASH}  исключение {x} без причины или хозяина (mashina.sluzhby_ne_agenty)")
                    rash += 1
                else:
                    stroki.append(f"  обратно      служба           исключено   {x}: {pr} — хозяин {hz}")
                continue
            if f"{x}.service" not in sluzhby and put not in doma:
                stroki.append(f"  обратно      служба           {RASH}  {x}.service с домом {put} — записи в реестре нет")
                rash += 1
    for x in sorted(set(ne_agenty) - vidimye):
        stroki.append(f"  обратно      служба           {RASH}  исключение {x} без предмета: каталога с загруженной {x}.service нет — снять из mashina.sluzhby_ne_agenty")
        rash += 1
    for koren in sorted({os.path.dirname(y) for y in yashch}):
        try:
            imena = sorted(os.listdir(koren))
        except OSError as e:
            stroki.append(f"  обратно      {koren:<16} {SLEP}      не перечислить: {e.strerror}"); slep += 1
            continue
        for x in imena:
            put = os.path.join(koren, x)
            if not os.path.isdir(put):
                continue
            vsego_ya += 1
            if put not in yashch and x not in polz:
                try:
                    vl = pwd.getpwuid(os.stat(put).st_uid).pw_name
                except (OSError, KeyError):
                    vl = "?"
                stroki.append(f"  обратно      ящик             {RASH}  {put} (владелец {vl}) — записи в реестре нет")
                rash += 1
    if not rash:
        stroki.append(f"  обратно      машина→реестр    {OK}           служб с домом {vsego_sl}, ящиков {vsego_ya} — у всех есть запись")
    return rash, slep


# ── B-H-081 Ш3-2 (26.09.2026, Искра; слово Забавы 19:1xZ): СБОРКА ПРОИЗВОДНЫХ из agents.yaml ──────────────────────
# Производное собирается, а не правится руками: D /etc/dsh-pamyat/agenty/<KOMPAKT_AGENT>.json = mashina.kompakt_obshchee
