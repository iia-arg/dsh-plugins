# v2-receivers.json = агенты с kanal.v2_poluchatel. sobrat НИЧЕГО не пишет в боевые пути: печатает сверку или кладёт
# сборку в --kuda <каталог> кандидатом; ставит монтаж. verify сверяет по СМЫСЛУ (D — без ключей «_*», H — пары
# КЛЮЧ=значение без комментариев, J — JSON), расхождение — «≠ сборке», известное — «известно» с датой.
# ⚠️ НЕ ЛОВИТ: ручную правку производного между прогонами verify; поле, которого генератор не знает (оно не
# в сборке — появится в бою, verify покажет «≠ сборке», что и нужно); секреты и окружения шлюзов не собираются вовсе.
# ⚠️ В J метки «собрано» НЕТ: a2a-v2.py ищет маршрут по имени ключа — лишний ключ читался бы как агент.
PUT_D = "/etc/dsh-pamyat/agenty"
PUT_H = "/etc/agent-tell"
PUT_J = "/etc/a2a/v2-receivers.json"
PORYADOK_D = ("imya", "model", "hvostStrok", "oknoSvodki", "razmyshleniya", "kompaktShlyuzovoj", "adres", "imenaKlyucha",
              "domZhurnalaSessij", "bazaSessij", "ceny")   # A-N-1712: ceny — каталог цен сводки (strokiRashoda)


def _okruzhenie_kompakta(n):
    env = {}
    for u in (n.get("zavisit_ot") or []):
        for tok in pokazatel(u, "EnvironmentFiles").split():
            if tok.startswith("/"):
                env.update(_klyuchi_env(tok, ["KOMPAKT_AGENT", "CODEX_HOME", "GATEWAY_BAZA_SESSIJ"]) or {})
    if "KOMPAKT_AGENT" not in env:
        for tok in pokazatel(n["sluzhba"], "Environment").split():
            if tok.startswith("KOMPAKT_AGENT="):
                env["KOMPAKT_AGENT"] = tok.split("=", 1)[1]
    return env


def _shapka(zachem=None):
    # Без суммы реестра: сверка идёт по смыслу и шапку не читает — сумма устарела бы при
    # любой правке реестра молча (Ш3-4, Искра 26.09.2026).
    s = f"собрано agent-registry sobrat из {REESTR} — руками не править"
    return f"{s}; «зачем» по полям: {zachem}" if zachem else s


def _povtory_kompakt_agent(d):
    """B-N-1105 (находка Зари): одно имя настройки компакта у двух агентов — один файл D на двоих.
    [строка отказа] по каждому повтору; пусто — повторов нет."""
    kto = {}
    for a in d["agenty"]:
        ka = (a.get("namerenie") or {}).get("kompakt_agent")
        if ka:
            kto.setdefault(ka, []).append(a.get("imya"))
    return [f"kompakt_agent {ka} повторяется у {' и '.join(im)}" for ka, im in kto.items() if len(im) > 1]


# B-H-081 Ш3+Ш2: один вычислитель при сборке; потребители читают porogi из D.
POROGI_REVISION = "B-H-081-porogi-v1"


def _porogi_nodes(obj):
    if isinstance(obj, dict):
        # Условия чужих инструментов не относятся к ветке компакта и не исполняются.
        if not _zapisi(obj, lambda row: row.get("id") == "compaction-basic"):
            return
        disabled = obj.get("disabled", False)
        if not isinstance(disabled, bool):
            raise ValueError("disabled: нужен литерал boolean")
        if disabled:
            return
        yield obj
        for value in obj.values():
            yield from _porogi_nodes(value)
    elif isinstance(obj, list):
        for value in obj:
            yield from _porogi_nodes(value)


def _porogi_one(items, label):
    if len(items) != 1:
        raise ValueError(f"{label}: найдено {len(items)}, нужно 1")
    return items[0]


def _porogi_config(row, label):
    config = row.get("config", {})
    if not isinstance(config, dict) or "unresolved_yaml_tag" in config:
        raise ValueError(f"{label}.config: нужен явный объект")
    return config


def vychislit_porogi(tekst_a, imya=None):
    """Номинальная политика установленного/собираемого A, без выполнения YAML !!js.

    Binary64 multiply THEN floor, как DSH; не Decimal/дроби. Резерв запроса здесь неизвестен.
    Поддержаны объявленные models subscription и явные pi-ai окна (custom deepseek-direct
    наследует defaultContextWindow). Скрытые defaults/базовый каталог не угадываются.
    """
    class Loader(yaml.SafeLoader):
        pass
    Loader.add_multi_constructor("", lambda loader, tag, node: {"unresolved_yaml_tag": tag})
    tree = yaml.load(tekst_a, Loader=Loader)
    if not isinstance(tree, list):
        raise ValueError("A: нужен список патчей")
    rows = []
    for patch in tree:
        if not isinstance(patch, dict):
            raise ValueError("A: негодная строка патча")
        rows.append(patch)
        rows.extend(patch.get("insert") or [])
    rows = [r for r in rows if isinstance(r, dict) and not r.get("disabled", False)]
    default = _porogi_config(_porogi_one([r for r in rows if r.get("id") == "agent-default-model"], "default-модель"), "default-модель")
    route = {k: default.get(k) for k in ("provider", "model")}
    if not all(isinstance(v, str) and v for v in route.values()):
        raise ValueError("defaultRoute: нужны provider и model")
    # B-N-1499: при имени — только СВОЙ пресет агента (config.id == имя); «<имя>-site» гостя порогов не несёт.
    preset = _porogi_one([r for r in rows if r.get("name") == "@deepseek-ai/dsh-agent-preset"
                          and (imya is None or (r.get("config") or {}).get("id") == imya)], "вложенный пресет")
    basic = _porogi_config(_porogi_one([r for r in _porogi_nodes(_porogi_config(preset, "пресет")) if r.get("id") == "compaction-basic"], "compaction-basic"), "compaction-basic")
    overrides = basic.get("modelPolicies", [])
    if not isinstance(overrides, list):
        raise ValueError("modelPolicies: нужен список")
    by_route = {}
    for policy in overrides:
        if not isinstance(policy, dict) or not all(isinstance(policy.get(k), str) and policy[k] for k in ("provider", "model")):
            raise ValueError("modelPolicies: негодный маршрут")
        key = (policy["provider"], policy["model"])
        if key in by_route:
            raise ValueError(f"modelPolicies: повтор {key}")
        by_route[key] = policy
    catalogs = []
    for row in rows:
        if row.get("id") == "dsh-subscription-adapter" or row.get("name") == "dsh-subscription-adapter":
            catalogs.append(("claude-oauth", _porogi_config(row, "subscription"), "subscription"))
        if row.get("id") == "llm-pi-ai" or row.get("name") == "@deepseek-ai/dsh-llm-pi-ai":
            providers = _porogi_config(row, "llm-pi-ai").get("providers")
            if not isinstance(providers, dict):
                raise ValueError("llm-pi-ai.providers: нужен объект")
            for provider, catalog in providers.items():
                if not isinstance(provider, str) or not provider:
                    raise ValueError("llm-pi-ai.providers: негодное имя")
                catalogs.append((provider, catalog, "pi-ai"))
    result = []
    seen = set()
    for provider, catalog, adapter in catalogs:
        if not isinstance(catalog, dict) or not isinstance(catalog.get("models"), list):
            raise ValueError(f"{provider}: нужен явный models, скрытый каталог не поддержан")
        for model in catalog["models"]:
            if not isinstance(model, dict) or not isinstance(model.get("id"), str) or not model["id"]:
                raise ValueError(f"{provider}: модель без id")
            key = (provider, model["id"])
            if key in seen:
                raise ValueError(f"повтор маршрута {key}")
            seen.add(key)
            window = model.get("contextWindow")
            if window is None:
                if adapter == "subscription":
                    window = catalog.get("contextWindow")
                elif provider == "deepseek-direct":  # нет base модели в штатном каталоге pi-ai для этого custom id
                    window = catalog.get("defaultContextWindow")
            if type(window) is not int or not 0 < window <= 9007199254740991:
                raise ValueError(f"{key}: окно не объявлено или не целое положительное; defaults не угадываются")
            ratio = by_route.get(key, {}).get("thresholdRatio", basic.get("thresholdRatio", 0.8))
            if type(ratio) not in (int, float) or not 0 < ratio < 1 or not math.isfinite(ratio):
                raise ValueError(f"{key}: доля должна быть конечным числом в (0,1)")
            nominal = math.floor(float(window) * float(ratio))
            if nominal <= 0:
                raise ValueError(f"{key}: номинальный порог не положителен")
            result.append(dict(provider=provider, model=model["id"], window=window, ratio=ratio, nominalThreshold=nominal))
    if (route["provider"], route["model"]) not in seen:
        raise ValueError(f"defaultRoute {route} не объявлен в models")
    if set(by_route) - seen:
        raise ValueError("modelPolicies содержит неизвестный маршрут")
    return {"schema": 1, "defaultRoute": route, "routes": sorted(result, key=lambda r: (r["provider"], r["model"]))}


def chitat_porog_d(imya, provider=None, model=None, katalog=None):
    """Только чтение готового D. Полный контекст запроса не выводится из defaultRoute."""
    if not isinstance(imya, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", imya):
        raise ValueError("D: негодное имя агента")
    put = os.path.join(katalog or PUT_D, imya + ".json")
    try:
        with open(put, encoding="utf-8") as stream:
            policy = json.load(stream)["porogi"]
        if not isinstance(policy, dict) or set(policy) != {"schema", "defaultRoute", "routes"} or type(policy.get("schema")) is not int or policy["schema"] != 1:
            raise ValueError("неизвестная schema porogi")
        default = policy["defaultRoute"]
        if not isinstance(default, dict) or set(default) != {"provider", "model"} or not all(isinstance(default.get(k), str) and default[k] for k in ("provider", "model")):
            raise ValueError("негодный defaultRoute")
        if (provider is None) != (model is None):
            raise ValueError("неполная пара provider/model")
        source = "defaultRoute" if provider is None else "request"
        key = (default["provider"], default["model"]) if provider is None else (provider, model)
        routes = policy["routes"]
        if not isinstance(routes, list) or not routes:
            raise ValueError("пустые routes")
        seen = {}; chosen = None
        for r in routes:
            if not isinstance(r, dict) or set(r) != {"provider", "model", "window", "ratio", "nominalThreshold"} or not all(isinstance(r.get(k), str) and r[k] for k in ("provider", "model")):
                raise ValueError("негодный маршрут")
            pair = (r["provider"], r["model"])
            if pair in seen:
                raise ValueError("повтор маршрута")
            seen[pair] = True
            if type(r.get("window")) is not int or not 0 < r["window"] <= 9007199254740991 or type(r.get("nominalThreshold")) is not int or not 0 < r["nominalThreshold"] < r["window"]:
                raise ValueError("негодные окно/порог")
            if type(r.get("ratio")) not in (int, float) or not 0 < r["ratio"] < 1 or not math.isfinite(r["ratio"]):
                raise ValueError("негодная доля")
            if pair == key:
                chosen = r
        if (default["provider"], default["model"]) not in seen or chosen is None:
            raise ValueError(f"маршрут {key} не объявлен")
        return dict(chosen, routeSource=source, thresholdKind="nominal", path=put)
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise ValueError(f"{imya}: D {put}: {e}") from e


def zapisat_d_atomarno(put, tekst):
    """Целый D в новом inode, 0644. Вызывает sobrat после проверки области --kuda."""
    fd, tmp = tempfile.mkstemp(prefix=".D-", dir=os.path.dirname(put))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(tekst)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            os.fsync(stream.fileno())
        os.replace(tmp, put)
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def _prochest_a_dlya_porogov(put):
    """Текст A без CRLF-нормализации: _sources.A — сумма фактически прочитанных байтов."""
    try:
        with open(put, "rb") as stream:
            raw = stream.read()
    except PermissionError:
        try:
            result = subprocess.run(["sudo", "-n", "cat", "--", put], capture_output=True, timeout=15)
            if result.returncode:
                return None, f"A не прочитан (sudo код {result.returncode})"
            raw = result.stdout
        except (OSError, subprocess.TimeoutExpired) as e:
            return None, f"A не прочитан ({type(e).__name__})"
    except OSError as e:
        return None, f"A не прочитан ({e.strerror})"
    try:
        return raw.decode("utf-8"), None
    except UnicodeError:
        return None, "A не UTF-8"


def sobrat_d(d, a, tekst_a=None, beda_a=None):
    """(путь, текст) либо (None, причина)."""
    n = namerenie(a)
    ob = (d.get("mashina") or {}).get("kompakt_obshchee")
    if not isinstance(ob, dict):
        return None, "в реестре нет mashina.kompakt_obshchee"
    if not n.get("imya_vidimoe"):
        return None, "у агента нет imya_vidimoe"
    ka = n.get("kompakt_agent")  # Ш3-3 (в): из реестра, не из живых юнитов — клон собирает D до установки
    if not ka:
        return None, "у агента нет namerenie.kompakt_agent"
    env = _okruzhenie_kompakta(n)  # пути Codex — по-прежнему из окружения шлюза (хозяин C)
    zn = dict(ob, imya=n["imya_vidimoe"])
    # A-N-1712: цены переносятся в D только для ТОЙ модели, для которой сняты (ceny.model == model) — иначе деньги
    #   считались бы по чужому прайсу молча. Не та модель / не словарь — каталог НЕ переносится, причина — в stderr.
    if "ceny" in zn:
        _c = zn["ceny"]
        if not isinstance(_c, dict) or _c.get("model") != zn.get("model"):
            print(f"agent-registry sobrat: ⚠️ {n['imya_vidimoe']}: ceny для модели {(_c.get('model') if isinstance(_c, dict) else _c)!r} ≠ модель сводки "
                  f"{zn.get('model')!r} — каталог цен в D НЕ переносится (деньги «не считаю»)", file=sys.stderr)
            zn.pop("ceny")
    if env.get("CODEX_HOME"):  # пути Codex — только у Codex-агента: GATEWAY_BAZA_SESSIJ есть и у шлюзов SDK
        zn["domZhurnalaSessij"] = env["CODEX_HOME"]       # (zarya/avrora/spartak), но bazaSessij — карта «сессия → rollout Codex»
        if env.get("GATEWAY_BAZA_SESSIJ"):
            zn["bazaSessij"] = env["GATEWAY_BAZA_SESSIJ"]
    lishnie = sorted(set(zn) - set(PORYADOK_D))
    if lishnie:
        return None, f"поля, которых сборка не знает: {lishnie}"
    out = {"_sobrano": _shapka("/etc/agent-registry/istoriya-nastroek-kompakta.md")}
    for k in PORYADOK_D:
        if k in zn:
            out[k] = zn[k]
    put_a = (n.get("istochnik_modeli") or {}).get("fajl")
    if tekst_a is None and beda_a is None:
        tekst_a, beda_a = _prochest_a_dlya_porogov(put_a) if put_a else (None, "путь A не объявлен")
    try:
        if beda_a or tekst_a is None:
            raise ValueError(beda_a or "нет A")
        out["porogi"] = vychislit_porogi(tekst_a, a["imya"])
    except (ValueError, TypeError, yaml.YAMLError) as e:
        return None, f"{a['imya']}: porogi не собраны ({e})"
    # Происхождение — печатается, но верхние _* не участвуют в _smysl/verify.
    source_f = F_PROVENANCE[1] if F_PROVENANCE is not None and F_PROVENANCE[0] is d else {"path": REESTR, "sha256": None}
    out["_sources"] = {"F": source_f,
                       "A": {"path": put_a, "sha256": hashlib.sha256(tekst_a.encode()).hexdigest()}}
    out["_readerRevision"] = POROGI_REVISION
    return f"{PUT_D}/{ka}.json", json.dumps(out, ensure_ascii=False, indent=2) + "\n"


def sobrat_h(d):
    """[(путь, текст, [агенты])] либо беда строкой."""
    chat_fajl = ((d.get("mashina") or {}).get("kanal_trevog") or {}).get("chat_fajl")
    if not chat_fajl:
        return "в реестре нет mashina.kanal_trevog.chat_fajl"
    kod, chat = sh(f"sudo -n cat -- {shlex.quote(chat_fajl)}", timeout=15)
    chat = chat.strip()
    if kod != 0 or not chat:
        return f"{chat_fajl} не прочитан рукой {moya_ruka()} (sudo -n: код {kod})"
    po_polz = {}
    for a in d["agenty"]:
        n = namerenie(a)
        k = n.get("kanal") or {}
        if k.get("agent_tell"):
            if n.get("polzovatel") in po_polz:
                return f"agent_tell у двух агентов пользователя {n.get('polzovatel')} — файл один, токен должен быть один"
            po_polz[n.get("polzovatel")] = (a["imya"], k.get("token_fajl"))
    out = []
    for polz, (imya, tok) in sorted(po_polz.items()):
        if not tok:
            return f"у {imya} agent_tell без kanal.token_fajl"
        tekst = f"# {_shapka()}\nTOKEN_FILE={tok}\nCHAT_ID={chat}\n"
        out.append((f"{PUT_H}/{polz}.conf", tekst, [imya]))
    return out


def sobrat_j(d):
    mash = (d.get("mashina") or {}).get("imya")
    out = {}
    for a in d["agenty"]:
        n = namerenie(a)
        k = n.get("kanal") or {}
        if k.get("v2_poluchatel"):
            if not (k.get("yashchik") and n.get("dom") and mash):
                return None, f"у {a['imya']} v2_poluchatel без kanal.yashchik / dom / mashina.imya"
            out[a["imya"]] = {"machine": mash, "spool": k["yashchik"],
                              "ledger": os.path.join(n["dom"], "workspace", ".message-receipts", "receipts.sqlite")}
    return PUT_J, json.dumps(dict(sorted(out.items())), ensure_ascii=False, indent=2) + "\n"  # по имени, как в бою


# ── B-H-081 единый F · Ф2 (29.09.2026, Заря; схема — Искра; слово владельца 13:59 МСК (а)–(г)) ─────────────────────
# A (профиль <dom>/.dsh/profiles/web/cordis.patch.yml) и B (пресет <dom>/.dsh/.agent-presets/<имя>/agent.cordis.yml) —
# СБОРКА из шаблона семейства (mashina.raskladka_obshchee.shablony/<семейство>/{A,B}.tmpl) и реестра (namerenie.raskladka).
# Числа окна и порога — из основы (г); доля Codex — явным полем osnova.codex.dolya_platformy (A-N-1174). Личность — файл <dom>/.dsh/lichnost.md (б). История агента — <dom>/.dsh/
# istoriya-raskladki.md, в сборку не входит (а): сверка ПО СМЫСЛУ (YAML-дерево), комментарии вне сверки.
# ОТКАЗ (а не молчание): незнакомое семейство; klyuch — не ровно одно из pass|fajl; ключ otlichiya кроме prichina/parametry;
# отличие без причины; параметр, которого семейство не знает; метка шаблона без значения; незакрытый блок. (требования Искры)
# B-H-081 Ш5 (30.09, Заря; наряд Забавы 19:53:55Z): M (config.toml Codex, <CODEX_HOME> из собранного C) — сборка из шаблона codex/M.tmpl
# и F (_f_chisla_m), сверка ПО СМЫСЛУ (TOML-дерево); каталог моделей — только сверка процента (sverit_katalog_m). В бой M не пишется:
# sobrat кладёт его лишь в --kuda. Правка настроек самого Codex — только словом владельца (стоп 29.09 00:22 МСК в силе для config.toml).
# Петрович — semejstvo ne-generiruetsya (слово (в)): строки сборки нет.
F_METKA = re.compile(r'@@([A-Z0-9_]+)@@')
F_SEMEJSTVA = ("sdk-claude", "codex")
# B-N-codex-modeli: уровни рассуждений, которые шлюз передаёт Codex (gateway.mjs EFFORT_PO_VETKE.openai); иное шлюз молча не передаёт.
EFFORT_CODEX = ("minimal", "low", "medium", "high", "xhigh", "max", "ultra", "persistent")


def _f_chisla(sem, osn):
    """(числа, None) либо (None, беда)."""
    if sem == "sdk-claude":
        return {"DOLYA": str(osn["dolya"])}, None
    L = int(osn["predel_servera"])                                   # измеренный предел сервера
    # A-N-1174: доля — ЯВНОЕ поле (слово владельца), не формула auto/L − minus: Codex сжимает по своему счёту (разбор Беты).
    # Нет поля, не число, вне (0;1) — ОТКАЗ («не проверено»), запасной формулы нет.
    d = osn.get("dolya_platformy")
    if isinstance(d, bool) or not isinstance(d, (int, float)) or not 0 < d < 1:
        return None, f"osnova.codex.dolya_platformy — число в (0;1), а тут {d!r}"
    return {"OKNO": str(L), "DOLYA": str(d)}, None


def _f_chisla_m(osn):
    """B-H-081 Ш5: числа M (config.toml Codex) из F — (числа, None) либо (None, беда). Отдельно от _f_chisla: негодная доля
    каталога роняет только M, не A/B/C. Окно W = ⌈L/katalog_dolya⌉; порог Codex = L − prirost_max; Codex берёт min(порог, 90% W)
    (openai_models.rs:525) — порог выше ⌊0,9·W⌋ не действовал бы, это ОТКАЗ, а не молчание."""
    L, pr, k = osn.get("predel_servera"), osn.get("prirost_max"), osn.get("katalog_dolya")
    if isinstance(L, bool) or not isinstance(L, int) or L <= 0:
        return None, f"osnova.codex.predel_servera — целое > 0, а тут {L!r}"
    if isinstance(pr, bool) or not isinstance(pr, int) or not 0 < pr < L:
        return None, f"osnova.codex.prirost_max — целое в (0;{L}), а тут {pr!r}"
    if isinstance(k, bool) or not isinstance(k, (int, float)) or not 0 < k < 1:
        return None, f"osnova.codex.katalog_dolya — число в (0;1), а тут {k!r}"
    W = -(-L * 10**6 // round(k * 10**6))   # ⌈L/k⌉ целочисленно: без float-погрешности на границе
    auto, w90 = L - pr, (W * 9) // 10
    if auto > w90:
        return None, f"порог Codex {auto} > 90% окна {w90}: Codex взял бы {w90}, порог F не действовал бы"
    return {"W": str(W), "AUTO": str(auto), "L": str(L), "PRIROST": str(pr), "KATALOG_DOLYA": str(k), "W90": str(w90)}, None


def _f_json_yaml(value):
    """JSON list inserted into YAML: preserve astral text and escape YAML-special controls."""
    return re.sub(r"[\x7f-\x9f\u2028\u2029\ud800-\udfff\ufffe\uffff]",
                  lambda m: "\\u%04x" % ord(m.group()),
                  json.dumps(value, ensure_ascii=False))


def _f_parametry(a, ob, lichnost):
    """(семейство, параметры) либо (None, беда)."""
    n = namerenie(a)
    r = n.get("raskladka") or {}
    sem = r.get("semejstvo")
    if sem not in F_SEMEJSTVA:
        return None, f"семейство {sem!r} F не знает"
    owner = ob.get("vladelec_telegram")
    if isinstance(owner, bool) or not isinstance(owner, int) or owner <= 0:
        return None, "mashina.raskladka_obshchee.vladelec_telegram — обязательный целый ID > 0"
    goal_senders = ob.get("postanovshchiki_celey")
    if not isinstance(goal_senders, list) or not all(isinstance(x, str) and x.strip() for x in goal_senders):
        return None, "mashina.raskladka_obshchee.postanovshchiki_celey — явный список непустых имён"
    kl = r.get("klyuch") or {}
    if set(kl) not in ({"pass"}, {"fajl"}):
        return None, f"raskladka.klyuch — ровно одно из pass|fajl, а тут {sorted(kl)}"
    osn = (ob.get("osnova") or {}).get(sem)
    if not isinstance(osn, dict):
        return None, f"нет mashina.raskladka_obshchee.osnova.{sem}"
    p = {"IMYA": a["imya"], "IMYA_RU": n["imya_vidimoe"], "IMYA_RU_STROCH": n["imya_vidimoe"].lower(),
         "KOMPAKT_AGENT": n["kompakt_agent"],  # B-H-081 Ш6: C (KOMPAKT_AGENT шлюза)
         "BAZA_SESSIJ_YAVNO": True,  # B-H-081 Ш6: C — база сессий шлюза явной строкой (у Искры — умолчание модуля, отличием)
         "DOM": n["dom"], "POLZ": n["polzovatel"], "MODEL": n["model"], "PORT_SHLYUZA": str(int(r["port_shlyuza"])),
         "KLYUCH_STROKA": f"klyuchPass: {kl['pass']}" if "pass" in kl else f"klyuchFajl: {kl['fajl']}"}
    p["OSTROV_API"] = False  # B-N-1695: включение только явным отличием гостя
    p["PDF_BLANKI"] = ""  # B-N-1701 (в реестр 07.10): каталог фирменных бланков PDF канала (pdfTemplatesDir) — только отличием гостя
    chisla, beda = _f_chisla(sem, osn)
    if chisla is None:
        return None, beda
    p.update(chisla)
    # B-N-738: поколение DSH — «0.2»: каталогов DSH 0.2 не читает (dsh-agent-preset-registry: «neither scans directories nor
    # accepts preset paths»), строки B вкладываются в A строкой '@deepseek-ai/dsh-agent-preset'.
    # B-H-081 Ш4 (слово владельца 30.09 03:28 МСК: обновления dsh односторонние): «0.1» и отсутствие поля — отказ, не умолчание.
    pok = ob.get("dsh_pokolenie")
    if pok != "0.2":
        return None, f"mashina.raskladka_obshchee.dsh_pokolenie {pok!r} — раскладка 0.1 не поддерживается, нужно «0.2»"
    p["DSH02"] = True
    # Живой подъём 0.2.0-rc.2 (B-N-738, 29.09): dsh-persona требует prefix вместо text; workflow-worker-thread снят (→ workflow-ptc).
    p["DSH01"] = not p["DSH02"]
    p["PERSONA_KLYUCH"] = "prefix" if p["DSH02"] else "text"
    if sem == "sdk-claude":
        # B-N-1457: подписка Claude-агентов — ОБЩАЯ, номер ведёт только pereklyuchatel-podpiski (env шлюзов, у всех разом).
        #   Реестр номер не хранит: хранил «начальный» podpiska-N — отставал от /switch, а svyazki-podpisok по нему откатывал бы env.
        if n.get("podpiska") != PODPISKA_OBSHCHAYA and not PODPISKA_SVOYA.match(str(n.get("podpiska") or "")):
            return None, f"namerenie.podpiska {n.get('podpiska')!r} — ждали {PODPISKA_OBSHCHAYA!r} (номер ведёт pereklyuchatel-podpiski, B-N-1457)"
        p["PODPISKA"] = n["podpiska"]
        p.update(LICHNOST=lichnost, WELCOME_BUDGET="15200", KLASS_SVODKI=True, DOP_POLZOVATELI=[],
                 KATALOG_NAVYKOV="/opt/agent-skills",
                 VYDACHA_SMYSL=False,  # A-N-1158: customSkillDirs; Спартаку — свой отфильтрованный каталог
                 VYDACHA_BEZ_AVTO=False,  # A-N-1149: выдача А выключена (vydacha.avto=false), Б остаётся; смысл — только при VYDACHA_SMYSL
                 # B-N-1476: GOST — агент говорит с посторонними (отличие записи с причиной). Снимает блоки @@ESLI SVOJ@@
                 # (pwsh/jobs, подагенты codex/claude-code, workflow/ralph, plugin-manager, GATEWAY_MCP), включает @@ESLI GOST@@
                 # (флаг шлюза: без встроенных инструментов движка; привратник памяти выключен). SVOJ выводится ниже, не задаётся.
                 GOST=False,
                 # B-N-1476 r13 (Забава 13:58Z): руководитель гостя — supervisor канала 1.5.63 (инструмент письма руководителю).
                 # Только для GOST и обязателен у него; имя — существующая запись реестра, не сам гость. Своим — пусто.
                 RUKOVODITEL="",
                 # B-N-1476 r15 (Забава 14:23Z): доп. каталоги навыков платформы (customSkillDirs) — гостю без инструментов
                 # движка навыки доходят ТОЛЬКО через платформу. Список абсолютных путей существующих каталогов; умолчание пусто.
                 DOP_KATALOGI_SKILLOV=[], SOCSETI=False,
                 # B-N-1499 (слово владельца 03.10 21:10 МСК): префиксы session.id ВНЕ ПАМЯТИ — config ядра isklyuchitSessii
                 # (dsh-pamyat-core ≥ правки B-N-1499: ни подачи, ни записи). Пусто — блока в профиле нет, профиль прежний байт в байт.
                 ISKLYUCHIT_SESSII=[],
                 # B-N-1499 (слово владельца 03.10 21:10 МСК, пресет — Альфа, одобрен Забавой 18:25:57Z): чат сайта ↔ гость —
                 # config.site канала и узкий пресет <имя>-site (без памяти, bash/fs, delegation, gws, публикаций). Только при GOST.
                 SAJT_CHAT=False)
    else:
        p.update(LICHNOST=lichnost, A2A_SESSION="a2a", COMPACT_OUTCOMES=True, CO_DOM=n["dom"],
                 DOP_POLZOVATELI=[],  # B-N-1176: доп. собеседники allowedUsers (только разговор; goalUsers — владелец) — как у sdk-claude
                 TASK_CONTROL_PILOT=False, DOP_M="")  # B-N-1357 pilot default off; B-H-081 Ш5: личная вставка в M (TOML-блок) — только отличием с причиной; пусто — блока нет
    otl = r.get("otlichiya") or {}
    lishnie = sorted(set(otl) - {"prichina", "parametry"})
    if lishnie:
        return None, f"otlichiya — ключи, которых сборка не знает: {lishnie}"
    if otl and not otl.get("prichina"):
        return None, "отличия без причины"
    for k, v in (otl.get("parametry") or {}).items():
        if k not in p or k in ("IMYA", "DOM", "POLZ", "IMYA_RU", "IMYA_RU_STROCH", "DSH02", "DSH01", "PERSONA_KLYUCH", "KOMPAKT_AGENT", "PODPISKA", "SVOJ"):
            return None, f"отличие {k} — такого параметра у семейства {sem} нет"
        p[k] = v
    if sem == "sdk-claude":
        if not isinstance(p["GOST"], bool):
            return None, f"отличие GOST — true|false, а тут {p['GOST']!r}"
        p["SVOJ"] = not p["GOST"]  # B-N-1476: обратный блок — шаблон умеет только «если истинно»
        if not isinstance(p["SOCSETI"], bool) or (p["SOCSETI"] and not p["GOST"]):
            return None, "отличие SOCSETI — true|false, включение только для GOST"
        dk = p["DOP_KATALOGI_SKILLOV"]
        if not isinstance(dk, list) or not all(isinstance(x, str) and re.fullmatch(r"/[A-Za-z0-9._/-]+", x) and os.path.realpath(x) == x and os.path.isdir(x) for x in dk):
            return None, f"отличие DOP_KATALOGI_SKILLOV — список абсолютных КАНОНИЧЕСКИХ путей (realpath, без «..» и ссылок) существующих каталогов, а тут {dk!r}"  # r16: LOW Вениамина
        if not isinstance(p["SAJT_CHAT"], bool) or (p["SAJT_CHAT"] and not p["GOST"]):
            return None, "отличие SAJT_CHAT — true|false, включение только для GOST"  # B-N-1499
        ish = p["ISKLYUCHIT_SESSII"]  # B-N-1499: строка списка в шаблоне — голый скаляр YAML, поэтому знаки ограничены
        if not isinstance(ish, list) or not all(isinstance(x, str) and re.fullmatch(r"[a-z0-9][a-z0-9._-]{2,63}", x) for x in ish):
            return None, f"отличие ISKLYUCHIT_SESSII — список префиксов id сессии ([a-z0-9][a-z0-9._-]{{2,63}}), а тут {ish!r}"
        ruk = p["RUKOVODITEL"]
        if p["GOST"]:
            if not isinstance(ruk, str) or not re.fullmatch(r"[a-z][a-z0-9]{1,15}", ruk) or ruk == a.get("imya"):
                return None, f"отличие RUKOVODITEL у гостя — имя другого агента реестра, а тут {ruk!r}"
        elif ruk != "":
            return None, f"RUKOVODITEL {ruk!r} задан не гостю — только при GOST: true"
        # B-N-1476 r6 (решение Забавы 10:11Z): OMEGA у гостя есть, но ТОЛЬКО через шлюз гостей 8379 (свой ключ, корень принудительно).
        # Выводится из GOST, отличием не задаётся (его нет в p до этой строки — цикл отличий выше откажет).
        p["OMEGA_PORT"] = "8379" if p["GOST"] else "8377"
        # Аврора 10:4xZ (замер): шлюз гостей отвечает только на /mcp/ (на /mcp — 307; следует ли клиент 307 с ключом — не проверено).
        # Своим — прежний адрес байт в байт (профили 8 агентов не меняются).
        p["OMEGA_MCP_URL"] = "http://127.0.0.1:8379/mcp/" if p["GOST"] else "http://127.0.0.1:8377/mcp"
        # Решение Забавы 10:47Z: ключ гостя — OMEGA_GOST_KLYUCH (боевого OMEGA_MCP_API_KEY у гостя нет вовсе); своим прежнее имя.
        p["OMEGA_KLYUCH_IMYA"] = "OMEGA_GOST_KLYUCH" if p["GOST"] else "OMEGA_MCP_API_KEY"
    api = p["OSTROV_API"]
    if api is not False:
        if sem != "sdk-claude" or p.get("GOST") is not True:
            return None, "отличие OSTROV_API — включение только для GOST: true семейства sdk-claude"
        if not isinstance(api, dict) or not {"baseUrl", "keyFile", "botId"} <= set(api) <= {"baseUrl", "keyFile", "botId", "requestKeyDir"}:
            return None, "отличие OSTROV_API — false или объект baseUrl/keyFile/botId (+ необязательный requestKeyDir)"
        url, key, bot = api["baseUrl"], api["keyFile"], api["botId"]
        rkd = api.get("requestKeyDir", "")  # B-N-1700 (в реестр 07.10): ключи повтора вне workspace
        # Значения не печатаются: ошибочная URL может содержать userinfo/секрет.
        try:
            # A-N-1880 (F02 Гаммы): ОДНО правило с клиентом tool-bridge src/ostrov_api.py (Client.__init__): только http — клиент ходит
            #   http.client.HTTPConnection, https для него другой протокол; профиль с https собирался, а API падал при вызове.
            if not isinstance(url, str) or not re.fullmatch(r"http://[A-Za-z0-9.\[\]:-]+/?", url):
                raise ValueError
            parsed = urlsplit(url)
            if (not parsed.hostname or parsed.netloc.endswith(":") or parsed.username is not None or parsed.password is not None or
                    parsed.path not in ("", "/") or parsed.query or parsed.fragment or
                    (parsed.port is not None and not 1 <= parsed.port <= 65535)):
                raise ValueError
        except ValueError:
            return None, "отличие OSTROV_API.baseUrl — http:// URL (не https: клиент только HTTP) без userinfo, пути, query, fragment и пробелов; порт 1..65535"
        if (not isinstance(key, str) or not re.fullmatch(r"/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+", key) or
                os.path.normpath(key) != key):
            return None, "отличие OSTROV_API.keyFile — абсолютный путь файла без пробелов, ссылок на «..» и YAML-меток"
        # A-N-1880: предел 16 цифр — как у клиента (ostrov_api.py Client.__init__), иначе профиль с 17–20 цифрами падал при вызове.
        if not isinstance(bot, str) or not re.fullmatch(r"[1-9][0-9]{0,15}", bot):
            return None, "отличие OSTROV_API.botId — положительная десятичная строка (1..16 ASCII цифр)"
        # Производные метки появляются ПОСЛЕ разбора отличий: подменять их нельзя.
        if rkd != "" and (not isinstance(rkd, str) or not re.fullmatch(r"/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+", rkd) or
                          os.path.normpath(rkd) != rkd):
            return None, "отличие OSTROV_API.requestKeyDir — абсолютный путь каталога без пробелов, ссылок на «..» и YAML-меток"
        p.update(OSTROV_API_BASE_URL=url, OSTROV_API_KEY_FILE=key, OSTROV_API_BOT_ID=bot, OSTROV_API_REQUEST_KEY_DIR=rkd)
    # Метка внутреннего блока шаблона нужна ВСЕМ (движок проверяет параметр и в выключенном блоке); после цикла отличий — не подменить.
    p.setdefault("OSTROV_API_REQUEST_KEY_DIR", "")
    pdf = p["PDF_BLANKI"]
    if pdf != "":
        if sem != "sdk-claude" or p.get("GOST") is not True:
            return None, "отличие PDF_BLANKI — только для GOST: true семейства sdk-claude"
        if not isinstance(pdf, str) or not re.fullmatch(r"/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+", pdf) or os.path.normpath(pdf) != pdf:
            return None, "отличие PDF_BLANKI — абсолютный путь каталога без пробелов, ссылок на «..» и YAML-меток"
    # A-N-1707 (Искра 07.10): след подъёмов для свидетеля ядра (config sledPodyomov) — ВЫВОДИТСЯ, отличием не задаётся
    #   (его нет в p до цикла отличий — цикл выше откажет). Писатель один — podyom-uzla, строки «ДО/ПОСЛЕ | <служба>»,
    #   и пишет он только своей области: sluzhba X.service, polzovatel X, dom /opt/X (то же правило, что v_oblasti_reestra
    #   в podyom-uzla). Вне области (кодеры, учётка coders) следа нет — путь не ставится, свидетель честно скажет «не задан».
    #   Гостю (GOST) путь не ставится: файл в доме Искры, гостю его не читать (изоляция) — вышло бы «след не читается».
    #   Пусто — блока в профиле нет, профиль прежний байт в байт.
    sled = ob.get("sled_podyomov") or ""
    if sled and not (isinstance(sled, str) and re.fullmatch(r"/[A-Za-z0-9._/-]+", sled)):
        return None, f"mashina.raskladka_obshchee.sled_podyomov {sled!r} — абсолютный путь без пробелов"
    imya_ = a.get("imya")
    v_oblasti = n.get("sluzhba") == f"{imya_}.service" and n.get("polzovatel") == imya_ and n.get("dom") == f"/opt/{imya_}"
    p["SLED_PODYOMOV"] = sled if (v_oblasti and p.get("GOST") is not True) else ""
    if sem == "codex":
        p["ZHURNAL_KAT"] = "-" + (n["dom"] + "/workspace").replace("/", "-") + "--"
        # B-N-codex-modeli (слово владельца 04.10 01:45 МСК): уровень рассуждений — namerenie.reasoning → GATEWAY_EFFORT шлюза (C).
        #   null — строки нет (умолчание Codex, как до правки); иное — только из перечня шлюза, иначе ОТКАЗ, а не тихое умолчание.
        ef = n.get("reasoning")
        if ef is not None and ef not in EFFORT_CODEX:
            return None, f"namerenie.reasoning {ef!r} — null или одно из {', '.join(EFFORT_CODEX)} (перечень шлюза, ветка openai)"
        p["EFFORT"] = ef or ""
    # Common ACL fields are added after agent overrides, which cannot assign these keys.
    p["VLADELEC_TELEGRAM"] = owner
    p["GOAL_A2A_SENDERS"] = _f_json_yaml(goal_senders)
    return sem, p


def _f_otrisovat(shablon, p):
    """(текст, None) либо (None, беда)."""
    out, stek = [], []
    for stroka in shablon.split("\n"):
        s = stroka.strip()
        m = re.fullmatch(r"@@(/?)ESLI ([A-Z0-9_]+)@@", s)
        if m:
            if not m.group(1):
                if m.group(2) not in p:
                    return None, f"блок {m.group(2)}: параметра нет"
                stek.append((m.group(2), bool(p[m.group(2)])))
            elif not stek or stek[-1][0] != m.group(2):
                return None, f"блок {m.group(2)}: закрытие без открытия"
            else:
                stek.pop()
            continue
        if not all(v for _, v in stek):
            continue
        otstup = stroka[:len(stroka) - len(stroka.lstrip())]
        m = re.fullmatch(r"@@SPISOK ([A-Z0-9_]+)@@", s)
        if m:
            out += [f"{otstup}- {v}" for v in p.get(m.group(1)) or []]
            continue
        if s == "@@LICHNOST@@":
            out += [(otstup + l) if l else "" for l in p["LICHNOST"].split("\n")]
            continue
        m = re.fullmatch(r"@@VSTAVKA ([A-Z0-9_]+)@@", s)
        if m:
            if not isinstance(p.get(m.group(1)), str):
                return None, f"вставка @@VSTAVKA {m.group(1)}@@: нет текстового параметра"
            out += [(otstup + l) if l else "" for l in p[m.group(1)].split("\n")]
            continue
        net = [k for k in F_METKA.findall(stroka) if k not in p or isinstance(p[k], (bool, list))]
        if net:
            return None, f"метка @@{net[0]}@@: нет строкового параметра"
        out.append(F_METKA.sub(lambda mm: str(p[mm.group(1)]), stroka))
    if stek:
        return None, f"незакрытый блок {stek[-1][0]}"
    return "\n".join(out), None


def _proverit_doli(tekst):
    """Правило платформы validateRatioRetention ДО монтажа — на СОБРАННОМ A, который читает платформа (Заря 07.10, порча на копии:
    отличие DOLYA проверку основы в _f_chisla обходит — DOLYA 0.05 при retainRatio 0.06 собиралась кодом 0, платформа отвергла
    бы профиль при подъёме). Каждый словарь с thresholdRatio: доля — число в (0;1), retainRatio рядом — строго меньше.
    None — годно, иначе беда. Ни одного thresholdRatio — тоже беда: правило проверить нечем, молчать нельзя."""
    try:
        y = _yaml_terpimyj(tekst)  # тот же разбор, что у сверки: вложенный пресет несёт теги !!js (B-N-738 k6)
    except yaml.YAMLError as e:
        return f"профиль A не разбирается как YAML ({type(e).__name__})"
    najdeno = []

    def obhod(x):
        if isinstance(x, dict):
            if "thresholdRatio" in x:
                najdeno.append(x)
            for v in x.values():
                obhod(v)
        elif isinstance(x, list):
            for v in x:
                obhod(v)
    obhod(y)
    if not najdeno:
        return "в собранном профиле A нет thresholdRatio — правило retainRatio < thresholdRatio проверить нечем"
    for c in najdeno:
        t, r = c.get("thresholdRatio"), c.get("retainRatio")
        if isinstance(t, bool) or not isinstance(t, (int, float)) or not math.isfinite(t) or not 0 < t < 1:
            return f"thresholdRatio {t!r} — число в (0;1)"
        if r is not None and (isinstance(r, bool) or not isinstance(r, (int, float)) or not r < t):
            return f"retainRatio {r!r} не меньше thresholdRatio {t!r} (validateRatioRetention платформы)"
    return None


def sobrat_ab(d, a):
    """B-H-081 Ш5: обёртка — у агента семейства codex строка «сборка-M» есть ВСЕГДА: при ранней беде (нет раскладки, личности,
    отличие без причины…) M не выпадает из сверки молча, а получает ту же беду (СЛЕПОТА), как A/C."""
    out = _sobrat_abc(d, a)
    r = namerenie(a).get("raskladka")
    if isinstance(r, dict) and r.get("semejstvo") == "codex" and not any(x[0] == "сборка-M" for x in out):
        beda = next((x[3] for x in out if x[3]), "причина не названа")
        out.append(("сборка-M", None, None, f"M не собран: {beda}"))
    return out


def _sobrat_abc(d, a):
    """[(pole, put, tekst_ili_None, beda)]; пусто — агент F не генерируется (semejstvo ne-generiruetsya)."""
    n = namerenie(a)
    r = n.get("raskladka")
    if isinstance(r, dict) and r.get("semejstvo") == "ne-generiruetsya":
        return []
    puti = (("сборка-A", f"{n['dom']}/.dsh/profiles/web/cordis.patch.yml", "A"),
            ("сборка-B", f"{n['dom']}/.dsh/.agent-presets/{a['imya']}/agent.cordis.yml", "B"),
            # B-H-081 Ш6: C — окружение шлюза агента. Секретов значением нет (токен — путём, ключ OMEGA — ${ИМЯ}); сверка — пары
            # КЛЮЧ=значение без комментариев (_smysl), история прежних комментариев — в istoriya-raskladki.md (слово владельца (а)).
            ("сборка-C", f"/etc/claude-oauth/instance-{a['imya']}.env", "C"))
    ob = (d.get("mashina") or {}).get("raskladka_obshchee")
    if not isinstance(r, dict):
        return [(pole, put, None, "нет namerenie.raskladka") for pole, put, _ in puti]
    if not isinstance(ob, dict) or not ob.get("shablony"):
        return [(pole, put, None, "нет mashina.raskladka_obshchee.shablony") for pole, put, _ in puti]
    lichnost = None
    if r.get("semejstvo") in F_SEMEJSTVA:  # личность-кодеров: у codex тот же файл, что у sdk-claude (слово владельца 29.09 19:53, Бета)
        lichnost, beda = _prochest(f"{n['dom']}/.dsh/lichnost.md")
        if lichnost is None:
            return [(pole, put, None, f"личность {n['dom']}/.dsh/lichnost.md: {beda}") for pole, put, _ in puti]
        lichnost = lichnost.rstrip("\n")
        if not lichnost.strip():
            return [(pole, put, None, f"личность {n['dom']}/.dsh/lichnost.md пуста") for pole, put, _ in puti]
    sem, p = _f_parametry(a, ob, lichnost)
    if sem is None:
        return [(pole, put, None, p) for pole, put, _ in puti]
    # B-N-1476 (Забава 10:32:39Z): списки корней выдачи «по всем корням» (dsh-pamyat-omega ≥ a30 ходит ПО СПИСКАМ) — из реестра при
    # сборке, не литералом: системные — все не-гостевые imya + mashina.imya (общий корень машины), гостевые — записи с GOST: true.
    # Строкой JSON (пустой список — «[]», а не null). Новый агент меняет списки у ВСЕХ — это и есть «одна правда».
    def _gost(x):
        r = namerenie(x).get("raskladka") or {}
        return ((r.get("otlichiya") or {}).get("parametry") or {}).get("GOST") is True
    machine_root = (d.get("mashina") or {}).get("imya")
    if not isinstance(machine_root, str) or not machine_root.strip():
        return [(pole, put, None, "mashina.imya — явное непустое имя общего корня машины") for pole, put, _ in puti]
    p["SISTEMNYE_KORNI"] = _f_json_yaml(sorted({x["imya"] for x in d["agenty"] if not _gost(x)} | {machine_root}))
    p["GOSTEVYE_KORNI"] = json.dumps(sorted({x["imya"] for x in d["agenty"] if _gost(x)}), ensure_ascii=False)
    # B-N-1476 r13: руководитель гостя — существующий НЕ-гостевой агент реестра (иначе письмо руководителю уйдёт в никуда/гостю).
    if p.get("GOST") is True and p["RUKOVODITEL"] not in {x["imya"] for x in d["agenty"] if not _gost(x)}:
        return [(pole, put, None, f"RUKOVODITEL {p['RUKOVODITEL']!r} — не агент реестра или гость") for pole, put, _ in puti]
    out = []
    shapka = f"# {_shapka()}; история раскладки — {n['dom']}/.dsh/istoriya-raskladki.md (B-H-081 F)"
    gotovo = {}
    for pole, put, tip in reversed(puti):  # B раньше A: на DSH 0.2 строки B вкладываются в A (B-N-738)
        sh_, beda = _prochest(os.path.join(ob["shablony"], sem, f"{tip}.tmpl"))
        if sh_ is None:
            gotovo[tip] = (None, f"шаблон {sem}/{tip}.tmpl: {beda}")
        elif tip == "A" and p["DSH02"]:
            tb, beda_b = gotovo["B"]
            gotovo[tip] = (None, f"пресет B не собран: {beda_b}") if tb is None else _f_otrisovat(sh_, dict(p, PRESET_B=tb))
        elif tip == "B" and sem == "codex":  # B-N-1356: каталог навыков = <CODEX_HOME>/skills из СОБРАННОГО C (один источник, как M)
            tc, beda_c = gotovo["C"]
            m_ch = re.search(r"^CODEX_HOME=(/\S+)$", tc or "", re.M)
            gotovo[tip] = ((None, f"каталог навыков: C не собран ({beda_c})" if tc is None else "каталог навыков: в собранном C нет CODEX_HOME=")
                           if not m_ch else _f_otrisovat(sh_, dict(p, KATALOG_NAVYKOV=m_ch.group(1) + "/skills")))
        elif tip == "C" and sem == "sdk-claude":  # Ш6 (б): файл токена — живое поле из текущего env
            tf, beda_tf = _token_c(d, a["imya"])
            gotovo[tip] = (None, beda_tf) if tf is None else _f_otrisovat(sh_, dict(p, TOKEN_FILE=tf))
        else:
            gotovo[tip] = _f_otrisovat(sh_, p)
        if tip == "A" and gotovo[tip][0] is not None:  # A — то, что читает платформа (B на DSH 0.2 — вставка, не документ)
            beda_d = _proverit_doli(gotovo[tip][0])
            if beda_d:
                gotovo[tip] = (None, beda_d)
    for pole, put, tip in puti:
        if tip == "B" and p["DSH02"]:
            continue  # DSH 0.2: .agent-presets никто не читает — файл B не собирается (его строки в A), лежащий — в страховку
        t, beda2 = gotovo[tip]
        out.append((pole, put, None if t is None else shapka + "\n" + t, beda2))
    if sem == "codex":  # B-H-081 Ш5: M = <CODEX_HOME>/config.toml; путь — из СОБРАННОГО C (один источник с шаблоном C, не второе правило)
        tc, beda_c = gotovo["C"]
        m = re.search(r"^CODEX_HOME=(/\S+)$", tc or "", re.M)
        if tc is None or not m:
            out.append(("сборка-M", None, None, f"путь M: C не собран ({beda_c})" if tc is None else "путь M: в собранном C нет CODEX_HOME="))
            return out
        put_m = os.path.join(m.group(1), "config.toml")
        chisla, beda_m = _f_chisla_m(ob["osnova"]["codex"])
        sh_m, beda_sh = _prochest(os.path.join(ob["shablony"], sem, "M.tmpl"))
        if chisla is None or sh_m is None:
            out.append(("сборка-M", put_m, None, beda_m if chisla is None else f"шаблон {sem}/M.tmpl: {beda_sh}"))
            return out
        tm, beda_r = _f_otrisovat(sh_m, dict(p, CODEX_HOME=m.group(1), **chisla))
        out.append(("сборка-M", put_m, None if tm is None else shapka + "\n" + tm, beda_r))
    return out


# B-H-081 Ш6 (б), решение Забавы 30.09 19:58Z: GATEWAY_TOKEN_FILE — ЖИВОЕ поле C. Подписку держит pereklyuchatel-podpiski
# (/switch владельца, порог podpiski) правкой env; реестр (namerenie.podpiska) — только НАЧАЛЬНОЕ значение. Поэтому сборка
# берёт его из ТЕКУЩЕГО env (пересборка не откатывает подписку), а verify сверяет файл с живым процессом шлюза.
ZHIVOJ_TOKEN = re.compile(r"/etc/claude-oauth/token-podpiska-\d+\Z")


PODPISKA_OBSHCHAYA = "obshchaya-claude"   # B-N-1457: значение namerenie.podpiska у всех sdk-claude
# 07.10.2026 (слово владельца 02:19 МСК: все на 2, КРОМЕ Варвары — она на 3): СВОЯ подписка агента — «podpiska-N».
#   Общая проверка её не считает; verify «подписка-своя» ждёт env = token-podpiska-N и файл. pereklyuchatel-podpiski
#   своей подписки НЕ знает: /switch сведёт и такого агента — тогда «подписка-своя» покраснеет (это и есть сигнал).
PODPISKA_SVOYA = re.compile(r"podpiska-(\d+)\Z")


def _token_obshchij(d, krome=None):
    """(путь, None) либо (None, беда): ЖИВАЯ общая подписка — GATEWAY_TOKEN_FILE в env ВСЕХ sdk-claude (кроме krome), одно значение."""
    vidno = {}
    for a in d["agenty"]:
        if (namerenie(a).get("raskladka") or {}).get("semejstvo") != "sdk-claude" or a["imya"] == krome:
            continue
        if PODPISKA_SVOYA.match(str(namerenie(a).get("podpiska") or "")):
            continue   # своя подписка — не участник общей
        f = _klyuchi_env(f"/etc/claude-oauth/instance-{a['imya']}.env", ["GATEWAY_TOKEN_FILE"])
        if f is None or not f.get("GATEWAY_TOKEN_FILE"):
            continue
        vidno.setdefault(f["GATEWAY_TOKEN_FILE"], []).append(a["imya"])
    if len(vidno) != 1:
        return None, ("общая подписка: ни у одного Claude-шлюза env не прочитан" if not vidno else
                      "общая подписка РАЗНАЯ: " + "; ".join(f"{os.path.basename(k)} — {','.join(v)}" for k, v in sorted(vidno.items())))
    v = next(iter(vidno))
    return (v, None) if ZHIVOJ_TOKEN.match(v) else (None, "общая подписка: GATEWAY_TOKEN_FILE не /etc/claude-oauth/token-podpiska-N")


def _token_c(d, imya):
    """(путь, None) либо (None, беда): файл токена шлюза для C — из текущего env агента; env нет (новый агент) — общая живая у соседей."""
    put = f"/etc/claude-oauth/instance-{imya}.env"
    # B-N-1411: существование — тем же sudo-путём, что чтение (_klyuchi_env). os.path.lexists без sudo под iskra
    #   (/etc/claude-oauth 750 root:claudeoauth) давал False = «нет файла» ⇒ начальная podpiska вместо живой (ложное
    #   «РАСХОЖДЕНИЙ 4» после /switch). Ответ — меткой ЕСТЬ/НЕТ: код sudo -n одинаков у «нет файла» и «sudo отказал».
    kod, out = sh(f"sudo -n sh -c {shlex.quote('if [ -e \"$1\" ] || [ -L \"$1\" ]; then echo ЕСТЬ; else echo НЕТ; fi')} _ {shlex.quote(put)}", timeout=15)
    if kod != 0 or out not in ("ЕСТЬ", "НЕТ"):
        return None, f"живое поле GATEWAY_TOKEN_FILE: есть ли {put} — не проверено рукой {moya_ruka()} (sudo -n: код {kod})"
    if out == "НЕТ":
        return _token_obshchij(d, krome=imya)
    d = _klyuchi_env(put, ["GATEWAY_TOKEN_FILE"])
    if d is None:
        return None, f"живое поле GATEWAY_TOKEN_FILE: {put} не прочитан рукой {moya_ruka()}"
    v = d.get("GATEWAY_TOKEN_FILE")
    if v is None:
        return _token_obshchij(d, krome=imya)
    if not ZHIVOJ_TOKEN.match(v):
        return None, "живое поле GATEWAY_TOKEN_FILE в текущем env — не /etc/claude-oauth/token-podpiska-N"
    return v, None


def _okruzhenie_processa(pid, klyuch):
    """Значение ОДНОГО ключа из окружения живого процесса (в нём секреты — наружу только это значение). (знач|None, беда|None)."""
    try:
        p = subprocess.run(["sudo", "-n", "cat", "--", f"/proc/{int(pid)}/environ"], capture_output=True, timeout=15)
    except Exception as e:
        return None, type(e).__name__
    if p.returncode != 0:
        return None, f"окружение pid {pid} не прочитано рукой {moya_ruka()} (sudo -n: код {p.returncode})"
    for x in p.stdout.split(b"\0"):
        k, _, v = x.partition(b"=")
        if k.decode("utf-8", "replace") == klyuch:
            return v.decode("utf-8", "replace"), None
    return None, None


def sverit_privratnik_gostya(d, stroki):
    """B-N-1476 r14 (Вениамин 14:09Z, LOW): у гостя (GOST: true) привратник памяти выключен — граница эскалации песочницы
    держится на одной строке шаблона. Сверка ЖИВОГО профиля: ровно одна строка «otvechatNaSprosRazresheniya: false», ни одной
    «true». Только чтение (sudo -n). Поведение (строку ядра при подъёме) сверяет klon-agenta.sh --proverit-gost."""
    rash = slep = 0
    for a in d["agenty"]:
        n = namerenie(a); r = n.get("raskladka") or {}
        if ((r.get("otlichiya") or {}).get("parametry") or {}).get("GOST") is not True:
            continue
        imya = a["imya"]; prf = f"{n.get('dom')}/.dsh/profiles/web/cordis.patch.yml"
        def sud(verdikt, fakt):
            stroki.append(f"  {imya:<10} {'привратник':<16} {verdikt:<12} ждали=в {prf} одна строка otvechatNaSprosRazresheniya: false, true нет машина={fakt}")
        k1, o1 = sh(f"sudo -n grep -c '^[[:space:]]*otvechatNaSprosRazresheniya: false[[:space:]]*$' {shlex.quote(prf)}")
        k2, o2 = sh(f"sudo -n grep -c '^[[:space:]]*otvechatNaSprosRazresheniya: true' {shlex.quote(prf)}")
        if k1 not in (0, 1) or k2 not in (0, 1) or not o1.isdigit() or not o2.isdigit():
            sud(SLEP, f"профиль не прочитан рукой {moya_ruka()} (sudo -n: коды {k1}/{k2})"); slep += 1
        elif o1 == "1" and o2 == "0":
            sud(OK, "выключен")
        else:
            sud(RASH, f"false ×{o1}, true ×{o2} — песочница гостя без границы"); rash += 1
    return rash, slep


def sverit_zhivoe_c(d, stroki):
    """Ш6 (б): у агентов sdk-claude GATEWAY_TOKEN_FILE в env = в окружении живого шлюза. Печатает только «равно/не равно»."""
    rash = slep = 0
    # B-N-1890 (Вениамин): заданная ручка видна в выводе — забытая переменная иначе даёт ложное зелёное по подставе
    for k in ("AGENT_REGISTRY_KATALOG_C", "AGENT_REGISTRY_YUNIT_C"):
        if k in os.environ:
            stroki.append(f"  подстановка {k}={os.environ[k]}")
    for a in d["agenty"]:
        r = namerenie(a).get("raskladka") or {}
        if r.get("semejstvo") != "sdk-claude":
            continue
        imya = a["imya"]; unit = YUNIT_C.format(imya)
        def sud(verdikt, fakt):
            stroki.append(f"  {imya:<10} {'живое-C':<16} {verdikt:<12} ждали=GATEWAY_TOKEN_FILE env = процесса {unit} машина={fakt}")
        f = _klyuchi_env(f"{KATALOG_C}/instance-{imya}.env", ["GATEWAY_TOKEN_FILE"])
        pid = pokazatel(unit, "MainPID")
        if f is None or "GATEWAY_TOKEN_FILE" not in f:
            sud(SLEP, "в env ключ не прочитан"); slep += 1; continue
        if not pid.isdigit() or pid == "0":
            sud(SLEP, f"процесса нет (MainPID {pid or 'пусто'})"); slep += 1; continue
        v, beda = _okruzhenie_processa(pid, "GATEWAY_TOKEN_FILE")
        # B-N-1476 r13: у гостя (GOST: true) guest-launch.sh подменяет путь на копию systemd — номер сверяется равенством ИМЕНИ (ниже).
        gost = ((r.get("otlichiya") or {}).get("parametry") or {}).get("GOST") is True
        # B-N-1890 (Михалыч 09.10): с B-N-1621 (95-gost.conf) гость получает ОДНУ подписку копией gost-podpiska-vybor в
        # RuntimeDirectory юнита (/run/<RuntimeDirectory>/token-podpiska-N), а не через LoadCredential. Сверяем ИМЯ файла (номер
        # подписки = env) и что каталог — один из двух законных: /run/credentials/<юнит> (прежняя раскладка) или RuntimeDirectory.
        # Путь в чужом каталоге с тем же именем — расхождение, как и другой номер.
        if gost:
            rd = pokazatel(unit, "RuntimeDirectory") or ""
            katalogi = {f"/run/credentials/{unit}"} | {f"/run/{x}" for x in rd.split()}
            sovpalo = bool(v) and os.path.basename(v) == os.path.basename(f["GATEWAY_TOKEN_FILE"]) and os.path.dirname(v) in katalogi
        else:
            sovpalo = v == f["GATEWAY_TOKEN_FILE"]
        if beda:
            sud(SLEP, beda); slep += 1
        elif sovpalo:
            sud(OK, f"равно (гость: копия того же номера в {os.path.dirname(v)})" if gost else "равно")
        else:
            sud(RASH, "НЕ равно (env переключён, шлюз не поднят — или наоборот)"); rash += 1
    # B-N-1457: подписка Claude-агентов общая — env у ВСЕХ одинаков, это token-podpiska-N, файл есть; в реестре номер не хранится
    claude = [a for a in d["agenty"] if (namerenie(a).get("raskladka") or {}).get("semejstvo") == "sdk-claude"]
    if claude:
        v, beda = _token_obshchij(d)
        est = None
        if v:
            kod, out = sh(f"sudo -n sh -c {shlex.quote('if [ -f \"$1\" ]; then echo ЕСТЬ; else echo НЕТ; fi')} _ {shlex.quote(v)}", timeout=15)
            est = out if kod == 0 and out in ("ЕСТЬ", "НЕТ") else None
        obshchie = [a for a in claude if not PODPISKA_SVOYA.match(str(namerenie(a).get("podpiska") or ""))]
        for a in claude:
            imya = a["imya"]; pod = namerenie(a).get("podpiska")
            m = PODPISKA_SVOYA.match(str(pod or ""))
            if m:
                zhdem = f"/etc/claude-oauth/token-podpiska-{m.group(1)}"
                def sud3(verdikt, fakt):
                    stroki.append(f"  {imya:<10} {'подписка-своя':<16} {verdikt:<12} ждали=реестр {pod}: env = {zhdem}, файл есть машина={fakt}")
                fe = _klyuchi_env(f"/etc/claude-oauth/instance-{imya}.env", ["GATEWAY_TOKEN_FILE"])
                if fe is None or not fe.get("GATEWAY_TOKEN_FILE"):
                    sud3(SLEP, "в env ключ не прочитан"); slep += 1
                elif fe["GATEWAY_TOKEN_FILE"] != zhdem:
                    sud3(RASH, f"env {os.path.basename(fe['GATEWAY_TOKEN_FILE'])} — своя подписка сведена (/switch?) или правлена рукой"); rash += 1
                else:
                    kod3, out3 = sh(f"sudo -n sh -c {shlex.quote('if [ -f \"$1\" ]; then echo ЕСТЬ; else echo НЕТ; fi')} _ {shlex.quote(zhdem)}", timeout=15)
                    if kod3 != 0 or out3 not in ("ЕСТЬ", "НЕТ"):
                        sud3(SLEP, f"{zhdem}: наличие не проверено рукой {moya_ruka()}"); slep += 1
                    elif out3 == "НЕТ":
                        sud3(RASH, f"{zhdem}: файла НЕТ"); rash += 1
                    else:
                        sud3(OK, f"{os.path.basename(zhdem)}")
                continue
            def sud2(verdikt, fakt):
                stroki.append(f"  {imya:<10} {'подписка-общая':<16} {verdikt:<12} ждали=реестр {PODPISKA_OBSHCHAYA}, env Claude-шлюзов одинаков машина={fakt}")
            if pod != PODPISKA_OBSHCHAYA:
                sud2(RASH, f"реестр хранит {pod!r} — отстанет от pereklyuchatel-podpiski"); rash += 1
            elif beda and "РАЗНАЯ" in beda:
                sud2(RASH, beda); rash += 1
            elif beda:
                sud2(SLEP, beda); slep += 1
            elif est == "НЕТ":
                sud2(RASH, f"{v}: файла НЕТ"); rash += 1
            elif est is None:
                sud2(SLEP, f"{v}: наличие не проверено рукой {moya_ruka()}"); slep += 1
            else:
                sud2(OK, f"{os.path.basename(v)} у всех {len(obshchie)}")
    return rash, slep


# B-H-081 Ш6 (условие Вениамина а/б): C сверяется по правилам systemd EnvironmentFile; значения — СУММОЙ, наружу только имена.
_ENV_IMYA = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
def _razobrat_env(tekst):
    """Пары EnvironmentFile по правилам systemd (автомат env-file.c): комментарии # и ; с начала строки, пробелы вокруг
    ключа и «=», кавычки '…' и "…" (в двойных — \\ перед " \\ ` $, перенос строки внутри допустим), \\ вне кавычек —
    экранирование, \\ в конце строки — продолжение, хвостовые пробелы без кавычек отбрасываются, ${…} НЕ раскрывается,
    негодное имя (в т.ч. «export X») отбрасывается, повтор ключа — выигрывает последний. {ключ: значение}."""
    out = {}
    st = "PRE_KEY"; key = []; val = []; key_ws = None; val_ws = None
    def push():
        k = "".join(key[:key_ws] if key_ws is not None else key)
        v = "".join(val[:val_ws] if val_ws is not None else val)
        if _ENV_IMYA.match(k): out[k] = v
    for c in tekst + "\n":
        nl = c in "\n\r"
        if st == "PRE_KEY":
            if c in "#;": st = "COMMENT"
            elif not c.isspace(): st = "KEY"; key = [c]; key_ws = None
        elif st == "KEY":
            if nl: st = "PRE_KEY"; key = []
            elif c == "=": st = "PRE_VALUE"; val = []; val_ws = None
            else:
                if c.isspace():
                    if key_ws is None: key_ws = len(key)
                else: key_ws = None
                key.append(c)
        elif st == "PRE_VALUE":
            if nl: push(); st = "PRE_KEY"; key = []; val = []
            elif c == "'": st = "SQ"
            elif c == '"': st = "DQ"
            elif c == "\\": st = "VAL_ESC"
            elif not c.isspace(): st = "VAL"; val.append(c); val_ws = None
        elif st == "VAL":
            if nl: push(); st = "PRE_KEY"; key = []; val = []
            elif c == "\\": st = "VAL_ESC"; val_ws = None
            else:
                if c.isspace():
                    if val_ws is None: val_ws = len(val)
                else: val_ws = None
                val.append(c)
        elif st == "VAL_ESC":
            st = "VAL"
            if not nl: val.append(c); val_ws = None
        elif st == "SQ":
            if c == "'": st = "PRE_VALUE"
            else: val.append(c)
        elif st == "DQ":
            if c == '"': st = "PRE_VALUE"
            elif c == "\\": st = "DQ_ESC"
            else: val.append(c)
        elif st == "DQ_ESC":
            st = "DQ"
            if c in '"\\`$': val.append(c)
            elif not nl: val.append("\\"); val.append(c)
        elif st == "COMMENT":  # \ в конце комментария НЕ продолжает его (замер systemd на sadik 30.09, случай T24)
            if nl: st = "PRE_KEY"
    return out


def _smysl(put, tekst):
    """Смысл производного для сверки: D/J — JSON без «_*»; H — пары КЛЮЧ=значение без комментариев."""
    if tekst is None:
        return None
    if put.endswith(".json"):
        try:
            o = json.loads(tekst)
        except ValueError:
            return ("негодный JSON",)
        return {k: v for k, v in o.items() if not str(k).startswith("_")} if isinstance(o, dict) else o
    if put.endswith(".env"):  # B-H-081 Ш6: C — пары по systemd; значение — sha256 (секрет не покидает процесс, в вывод идут имена)
        return {k: hashlib.sha256(v.encode("utf-8")).hexdigest() for k, v in _razobrat_env(tekst).items()}
    if put.endswith((".yml", ".yaml")):  # B-H-081 F: A/B — YAML-дерево (комментарии вне сверки, слово (а))
        try:
            return ("yaml", json.dumps(_yaml_terpimyj(tekst), sort_keys=True, ensure_ascii=False, default=str))
        except yaml.YAMLError:
            return ("негодный YAML",)
    if put.endswith(".toml"):  # B-H-081 Ш5: M — TOML-дерево (комментарии вне сверки)
        import tomllib
        try:
            return tomllib.loads(tekst)  # словарь: при расхождении sverit_sborku назовёт поля верхнего уровня
        except tomllib.TOMLDecodeError:
            return ("негодный TOML",)
    return sorted(l.strip() for l in tekst.splitlines() if l.strip() and not l.strip().startswith("#"))


# B-N-1353 (01.10.2026, Заря; направление владельца 12:31 «в сторону разрешения»): агент вправе включать/выключать/ставить
#   плагины себе — сверка и пересборка A это ПЕРЕЖИВАЮТ. Правка агента узнаётся по ФОРМЕ записи dsh-plugin-manager
#   (writePluginEnabled, lib/index.js ~:882): (1) элемент верхнего уровня ровно {id, disabled: bool} — дописан в конец;
#   (2) ключ disabled: bool у элемента верхнего уровня с id и без insert — поставлен в наш элемент. Наш шаблон ни того,
#   ни другого не производит; если начнёт — сборка отказывает громко (иначе сверка ослепла бы к НАШЕЙ правке).
#   ⚠️ Граница: форма, не автор — такая же строка, вписанная рукой, считается местной правкой агента (она НАЗЫВАЕТСЯ, не прячется).
def _mestnoe_agenta(dannye):
    """(список без местного, [(id, disabled)] в порядке файла). Не список — как есть, []."""
    if not isinstance(dannye, list):
        return dannye, []
    chisto, mest = [], []
    for x in dannye:
        if isinstance(x, dict) and "id" in x and "insert" not in x and isinstance(x.get("disabled"), bool):
            mest.append((x["id"], x["disabled"]))
            x = {k: v for k, v in x.items() if k != "disabled"}
            if set(x) == {"id"}:
                continue
        chisto.append(x)
    return chisto, mest


def _itog_mestnogo(mest):
    """Последнее значение на id (патчи применяются по порядку — побеждает последний), порядок первого появления."""
    itog = {}
    for i, v in mest:
        itog[i] = v
    return list(itog.items())


def _slova_mestnogo(mest):
    return ", ".join(f"{'выкл' if v else 'вкл'} {i}" for i, v in _itog_mestnogo(mest))


def _smysl_a(tekst):
    """(смысл без местного, местное) для A; (('негодный YAML',), None) — не разобран."""
    try:
        chisto, mest = _mestnoe_agenta(_yaml_terpimyj(tekst))
    except yaml.YAMLError:
        return ("негодный YAML",), None
    return ("yaml", json.dumps(chisto, sort_keys=True, ensure_ascii=False, default=str)), mest


def _perenesti_mestnoe(t_novyj, t_zhivoj):
    """Пересборка A: местные правки агента из ЖИВОГО A дописываются в конец новой сборки — той же формой (1), итог на id.
    (текст, местное|None, беда). Живого нет — переносить нечего; живой негоден — НЕ переношу и говорю."""
    if t_zhivoj is None:
        return t_novyj, [], None
    _, mest_n = _smysl_a(t_novyj)
    if mest_n:
        return None, None, f"шаблон A несёт форму правки агента ({_slova_mestnogo(mest_n)}) — местное не отличить, сборка отказывает"
    _, mest = _smysl_a(t_zhivoj)
    if mest is None:
        return t_novyj, None, "живой A не разобран как YAML — местные правки агента НЕ перенесены"
    itog = _itog_mestnogo(mest)
    if not itog:
        return t_novyj, [], None
    hvost = ("\n# B-N-1353: местные правки агента (plugin_manager) — перенесены пересборкой из живого A. Их правит агент, не реестр.\n"
             + "".join(f"- id: {json.dumps(i, ensure_ascii=False)}\n  disabled: {'true' if v else 'false'}\n" for i, v in itog))
    return t_novyj.rstrip("\n") + "\n" + hvost, itog, None


# Заводские бандлы web-профиля (cordis.yml: «each bundle in package.json's dsh.profile.bundles»); прочие — поставлены агентом.
ZAVODSKIE_BUNDLY = ("@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app")


def _pakety_agenta(put_a):
    """B-N-1353: package.json профиля в реестре НЕ собирается (пересборка его не трогает) — сверка только НАЗЫВАЕТ поставленное
    агентом: бандлы сверх заводских и зависимости не «file:». (строка|None, беда)."""
    t, beda = _prochest(os.path.join(os.path.dirname(put_a), "package.json"))
    if t is None:
        return None, beda
    try:
        pj = json.loads(t)
    except ValueError:
        return None, "package.json не JSON"
    bundly = [b for b in ((pj.get("dsh") or {}).get("profile") or {}).get("bundles") or [] if b not in ZAVODSKIE_BUNDLY]
    zav = [f"{k}@{v}" for k, v in (pj.get("dependencies") or {}).items() if not str(v).startswith("file:")]
    if not bundly and not zav:
        return "", None
    return "; ".join(x for x in (f"бандлы {bundly}" if bundly else "", f"пакеты {zav}" if zav else "") if x), None


def _chto_chitaet(put):
    """B-H-081 Ш4: сверяем только объявленный путь; пакетный E не подставляется."""
    return put


def _sborki(d, for_verify=False):
    """[(pole, imya_dlya_izvestnogo, put, tekst_ili_None, beda)]."""
    out = []
    for a in d["agenty"]:
        ab = sobrat_ab(d, a)
        profiles = [x for x in ab if x[0] == "сборка-A"]
        tekst_a = beda_a = None
        if not for_verify and profiles:
            if len(profiles) != 1:
                beda_a = "сборка A неоднозначна"
            else:
                _, _, tekst_a, beda_a = profiles[0]
        # verify читает установленный A; Петрович всегда ручной. sobrat использует новый A этой сборки.
        put, t = sobrat_d(d, a, tekst_a, beda_a)
        out.append(("сборка-D", a["imya"], put, t if put else None, None if put else t))
        for pole, put_ab, t_ab, beda_ab in ab:
            out.append((pole, a["imya"], put_ab, t_ab, beda_ab))
    h = sobrat_h(d)
    if isinstance(h, str):
        out.append(("сборка-H", "*", None, None, h))
    else:
        for put, t, kto in h:
            out.append(("сборка-H", kto[0], put, t, None))
    put, t = sobrat_j(d)
    out.append(("сборка-J", "*", put, t if put else None, None if put else t))
    return out


def sverit_katalog_m(d, stroki):
    """B-H-081 Ш5: третий носитель формулы окна — каталог моделей Codex (model_catalog_json собранного M): процент выбранной
    модели агента (namerenie.model) обязан быть katalog_dolya из F, иначе W = ⌈L/доля⌉ считает не то окно. Не генерируется —
    это данные поставщика; только сверка. Нет модели в каталоге / каталог нечитаем — НЕ ПРОВЕРЕНО, не «сошлось»."""
    import tomllib
    rash = slep = 0
    k = (((d.get("mashina") or {}).get("raskladka_obshchee") or {}).get("osnova") or {}).get("codex", {}).get("katalog_dolya")
    for pole, imya, put, t, beda in _sborki(d):
        if pole != "сборка-M" or beda or t is None:
            continue
        def sud(verdikt, ozhid, fakt):
            stroki.append(f"  {imya:<10} {'M-каталог':<16} {verdikt:<12} ждали={ozhid} машина={fakt}")
        model = namerenie(next(a for a in d["agenty"] if a["imya"] == imya)).get("model")
        kat = tomllib.loads(t).get("model_catalog_json")
        tk, beda_k = _prochest(kat) if isinstance(kat, str) else (None, "в M нет model_catalog_json")
        try:
            spisok = json.loads(tk)["models"] if tk is not None else None
        except (ValueError, KeyError, TypeError):
            spisok, beda_k = None, "каталог — не JSON с models"
        zap = [x for x in (spisok or []) if isinstance(x, dict) and x.get("slug") == model]
        if spisok is None or len(zap) != 1:
            sud(SLEP, f"{model} в {kat}", beda_k or f"моделей {model} в каталоге {len(zap)}, нужна ровно одна"); slep += 1
        elif not isinstance(k, (int, float)) or zap[0].get("effective_context_window_percent") != round(k * 100):
            sud(RASH, f"процент = {k!r}×100", f"{model}: effective_context_window_percent {zap[0].get('effective_context_window_percent')!r}"); rash += 1
        else:
            sud(OK, f"процент = katalog_dolya {k}", f"{model}: {zap[0]['effective_context_window_percent']}% в {kat}")
    return rash, slep


def sverit_sborku(d, stroki):
    rash = slep = 0
    for pole, imya, put, t, beda in _sborki(d, for_verify=True):
        def sud(verdikt, ozhid, fakt):
            stroki.append(f"  {imya:<10} {pole:<16} {verdikt:<12} ждали={ozhid} машина={fakt}")
        if beda:
            sud(SLEP, "сборка", beda); slep += 1
            continue
        chit = _chto_chitaet(put)
        tb, beda_b = _prochest(chit)
        if pole == "сборка-D" and tb is not None:
            try:
                metadata = json.loads(tb)
                stroki.append(f"  {imya:<10} {'источник-D':<16} сведения     _sources={metadata.get('_sources')} _readerRevision={metadata.get('_readerRevision')} (не сравниваются)")
            except (ValueError, AttributeError):
                pass  # негодный JSON назовёт основная сверка ниже
        if pole == "сборка-A" and tb is not None:
            sa_b, mest_b = _smysl_a(t)
            sa_l, mest_l = _smysl_a(tb)
            pk, beda_pk = _pakety_agenta(put)
            if pk or beda_pk:
                stroki.append(f"  {imya:<10} {'местное-пакеты':<16} сведения     {pk or ''}{(' [' + beda_pk + ']') if beda_pk else ''} (ставит агент, пересборка не трогает)")
            if mest_b:
                sud(SLEP, f"сборка {put}", f"шаблон несёт форму правки агента ({_slova_mestnogo(mest_b)}) — местное не отличить"); slep += 1
                continue
            if mest_l is not None and sa_l == sa_b:
                sud(OK, f"сборка {put}", "по смыслу равно" + (f"; местные правки агента: {_slova_mestnogo(mest_l)}" if mest_l else ""))
                continue
        if tb is None:
            fakt = f"{chit}: {beda_b}"
        elif _smysl(chit, tb) == _smysl(put, t):
            sud(OK, f"сборка {put}", "по смыслу равно" + ("" if chit == put else f" (читается {chit})"))
            continue
        else:
            a, b = _smysl(put, t), _smysl(chit, tb)
            if isinstance(a, dict) and isinstance(b, dict):
                raz = sorted(k for k in set(a) | set(b) if a.get(k) != b.get(k))
                if pole == "сборка-D" and "porogi" in raz:
                    # B-N-1743: porogi уже сравнивается целиком; называем конкретный порог.
                    pa, pb = a.get("porogi"), b.get("porogi")
                    ra = pa.get("routes") if isinstance(pa, dict) else None
                    rb = pb.get("routes") if isinstance(pb, dict) else None
                    if isinstance(ra, list) and isinstance(rb, list):
                        for i in range(max(len(ra), len(rb))):
                            va = ra[i] if i < len(ra) and isinstance(ra[i], dict) else {}
                            vb = rb[i] if i < len(rb) and isinstance(rb[i], dict) else {}
                            for k in ("ratio", "nominalThreshold"):
                                if va.get(k) != vb.get(k):
                                    raz.append(f"porogi.routes[{i}].{k}")
                fakt = f"{chit}: поля ≠ сборке {raz}"
            else:
                fakt = f"{chit}: ≠ сборке"
        izv, beda_i = _izvestno(imya, pole)
        if izv:
            sud("известно", f"сборка {put}", f"{fakt} [{izv}]")
        else:
            sud(RASH, f"сборка {put}", fakt + (f" [{beda_i}]" if beda_i else "")); rash += 1
    return rash, slep


BOEVYE_KORNI = ("/etc", "/opt", "/usr", "/var/spool", "/var/lib")  # список Вениамина 19:29Z


def _pod_boevym(put):
    return any(put == k or put.startswith(k + os.sep) for k in BOEVYE_KORNI) or put == "/"


def cmd_sobrat(d, argv):
    """agent-registry sobrat [--kuda <каталог>] — сверка сборки с боем; с --kuda кладёт сборку кандидатом."""
    kuda = None
    if argv[:1] == ["--kuda"] and len(argv) == 2:
        kuda = argv[1]
    elif argv:
        print("использование: agent-registry sobrat [--kuda <каталог>]  (боевые пути не пишет никогда)", file=sys.stderr)
        return 3
    # B-N-1105: повтор имени D — отказ ДО любой записи (прежде: второй O_EXCL падал трассой, первые файлы уже лежали).
    povtory = _povtory_kompakt_agent(d)
    if povtory:
        for s in povtory:
            print(f"отказ: {s} — ничего не создано", file=sys.stderr)
        return 3
    # 🔴 B-H-081 Ш3-2, КРАСНОЕ Вениамина 19:29Z: прежняя проверка префикса пропускала «/», «/var/..» и каталог со ссылкой
    #   etc → /etc — запись уходила в бой (самый вероятный путь — пустая переменная: --kuda "$DIR/" = «/»). Теперь ДВА замка:
    #   (б) --kuda — только НОВЫЙ каталог: существует (в т.ч. «/») — отказ; создаём сами, 0700;
    #   (а) realpath КАЖДОЙ цели — внутри realpath(kuda) и не под боевыми корнями; файл открывается O_NOFOLLOW|O_EXCL.
    #   Цена: кандидатом кладут в /tmp или /var/tmp (под /opt — отказ), в kandidaty — копированием.
    if kuda is not None:
        if not kuda.strip() or os.path.lexists(kuda):
            print(f"отказ: --kuda {kuda!r} — каталог обязан быть НОВЫМ (существует или пуст путь); сборку кладут кандидатом в новый каталог", file=sys.stderr)
            return 3
        # low Вениамина 19:45Z: проверка ДО makedirs — realpath ближайшего СУЩЕСТВУЮЩЕГО предка + несуществующий хвост;
        #   иначе под root «--kuda /etc/nov/pod» оставил бы в бою пустой /etc/nov, хотя дальше последовал бы отказ.
        # low Вениамина 20:02Z: abspath сворачивал «..» ЛЕКСИЧЕСКИ до ссылок — «<tmp>/ssylka/../etc/nov/pod» (ssylka → /etc)
        #   проходил предпроверку и создавал /etc/nov. realpath(strict=False) идёт по компонентам, как ядро: ссылка раньше «..».
        budet = os.path.realpath(kuda)
        if _pod_boevym(budet):
            print(f"отказ: --kuda {kuda!r} → {budet} — под боевым корнем {BOEVYE_KORNI}; ничего не создано", file=sys.stderr)
            return 3
        try:
            os.makedirs(kuda, mode=0o700)
        except OSError as e:
            print(f"отказ: --kuda {kuda!r} не создан: {e.strerror}", file=sys.stderr)
            return 3
        koren = os.path.realpath(kuda)
        if _pod_boevym(koren):
            os.rmdir(kuda)
            print(f"отказ: --kuda {kuda!r} → {koren} — под боевым корнем {BOEVYE_KORNI}", file=sys.stderr)
            return 3
    beda = 0
    for pole, imya, put, t, b in _sborki(d):
        if b:
            print(f"{pole} {imya}: НЕ СОБРАНО — {b}"); beda += 1
            continue
        chit = _chto_chitaet(put)
        tb, _ = _prochest(chit)
        dop = ""
        if pole == "сборка-A":
            t, perenos, beda_p = _perenesti_mestnoe(t, tb)
            if t is None:
                print(f"{pole} {imya}: НЕ СОБРАНО — {beda_p}"); beda += 1
                continue
            dop = (f" · местные правки агента перенесены: {_slova_mestnogo(perenos)}" if perenos else "") + (f" · ⚠️ {beda_p}" if beda_p else "")
        byt = "побайтно равно" if tb == t else ("по смыслу равно" if tb is not None and _smysl(chit, tb) == _smysl(put, t) else "≠ сборке")
        if byt == "≠ сборке" and pole == "сборка-A" and tb is not None and _smysl_a(tb)[0] == _smysl_a(t)[0] \
                and _itog_mestnogo(_smysl_a(tb)[1] or []) == _itog_mestnogo(_smysl_a(t)[1] or []):
            byt = "по смыслу равно (местное агента — тот же итог)"
        print(f"{pole} {imya}: {put} · {byt}{dop}" + ("" if chit == put else f" (сейчас читается {chit})"))
        if kuda is not None:
            tsel = os.path.join(koren, put.lstrip("/"))
            rp = os.path.realpath(os.path.dirname(tsel))  # ДО makedirs: ссылки разрешаются и в несуществующем хвосте
            if not (rp == koren or rp.startswith(koren + os.sep)) or _pod_boevym(rp):
                print(f"{pole} {imya}: ОТКАЗ ЗАПИСИ — {tsel} ведёт в {rp}: вне --kuda или под боевым корнем", file=sys.stderr)
                beda += 1
                continue
            os.makedirs(os.path.dirname(tsel), mode=0o700, exist_ok=True)
            if pole == "сборка-D":
                zapisat_d_atomarno(tsel, t)
            else:
                fd = os.open(tsel, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "w", encoding="utf-8") as f:
                    f.write(t)
    return 2 if beda else 0


def cmd_verify(d):
    global IZVESTNYE
    IZVESTNYE = d.get('izvestnye_rashozhdeniya') or []  # B-H-081 Ш1: ключ верхнего уровня реестра
    global TOKENY_POLZOVATELYA
    TOKENY_POLZOVATELYA = {}
    for _a in d['agenty']:
        _n = _a.get('namerenie') or {}
        _t = (_n.get('kanal') or {}).get('token_fajl')
        if _t:
            TOKENY_POLZOVATELYA.setdefault(_n.get('polzovatel'), set()).add(_t)
    ruka = moya_ruka()
    stroki = [f"реестр: {REESTR}   рука: {ruka}", ""]
    rash = slep = 0
    for a in d["agenty"]:
        r, s = sverit(a, ruka, stroki)
        rash += r
        slep += s
    r, s = sverit_obratno(d, stroki)
    rash += r
    slep += s
    r, s = sverit_potrebitelya(d, stroki)
    rash += r
    slep += s
    r, s = sverit_krome(d, stroki)
    rash += r
    slep += s
    for s_ in _povtory_kompakt_agent(d):  # B-N-1105: повтор имени D — расхождение, а не «сборка ≠» у одного из двух
        stroki.append(f"  {'*':<10} {'kompakt_agent':<16} {RASH:<12} ждали=имя D у каждого своё машина={s_}")
        rash += 1
    r, s = sverit_sborku(d, stroki)  # B-H-081 Ш3-2: производное ≠ сборке из реестра
    rash += r
    slep += s
    r, s = sverit_zhivoe_c(d, stroki)  # B-H-081 Ш6 (б): живое поле C — файл = процесс
    rash += r
    slep += s
    r, s = sverit_privratnik_gostya(d, stroki)  # B-N-1476 r14: привратник памяти гостя выключен
    rash += r
    slep += s
    r, s = sverit_katalog_m(d, stroki)  # B-H-081 Ш5: процент каталога моделей Codex = katalog_dolya F
    rash += r
    slep += s
    print("\n".join(stroki))
    print()
    if rash:
        print(f"🔴 РАСХОЖДЕНИЙ: {rash}" + (f", НЕ ПРОВЕРЕНО: {slep}" if slep else ""))
        return 1
    if slep:
        print(f"⚠️  НЕ ПРОВЕРЕНО: {slep} — это не «сошлось»")
        return 2
    izv = sum(1 for x in stroki if "  известно  " in x)  # B-H-081 Ш1: «совпадает» не должно прятать известные
    print(f"намерение совпадает с машиной; агентов: {len(d['agenty'])}" + (f"; ИЗВЕСТНЫХ расхождений: {izv} (сроки — в строках «известно»)" if izv else ""))
    return 0


def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv else "list"
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    d = zagruzit()
    if cmd == "list":
        return cmd_list(d)
    if cmd == "sluzhby":
        return cmd_sluzhby(d)
    if cmd == "pole":
        return cmd_pole(d, argv[1:])
    if cmd == "mashina":
        return cmd_mashina(d, argv[1:])
    if cmd == "obshchee":
        return cmd_obshchee(d, argv[1:])
    if cmd == "pokrytie":
        return cmd_pokrytie(d, argv[1:])
    if cmd == "kto":
        return cmd_kto(d, argv[1:])
    if cmd == "fakt":
        return cmd_fakt(d)
    if cmd == "verify":
        return cmd_verify(d)
    if cmd == "sobrat":
        global IZVESTNYE
        IZVESTNYE = d.get('izvestnye_rashozhdeniya') or []
        return cmd_sobrat(d, argv[1:])
    print(f"agent-registry: нет такой подкоманды — {cmd!r}", file=sys.stderr)
    return 3


if __name__ == "__main__":
    sys.exit(main())
