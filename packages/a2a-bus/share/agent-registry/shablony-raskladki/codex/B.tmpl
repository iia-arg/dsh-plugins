# Пресет Агента-@@IMYA_RU@@. Заведён 15.09.2026 рукой Забавы по поручению владельца.
# ВЗЯТ ТОЛЬКО БЛОК compaction из пресета Искры (её строки 672-792).
# Копировать персону Искры значило бы дать кодеру чужой характер и чужие правила.
#
# Что этот блок делает: включает сжатие контекста нашим модулем dsh-pamyat-kompakt-dsh.
# Без пресета сжатия не было ВОВСЕ — контекст рос до предела и обрывался.

# Личность агента — файл <дом>/.dsh/lichnost.md, вставляет sobrat (как у sdk-claude). Слово владельца 29.09 19:53,
#   тексты — Бета (раздел «КТО ТЫ» вынесен из AGENTS.md). ⚠️ До правки шлюза системную секцию DSH Codex НЕ получает
#   (claude-oauth gateway.mjs :951 «body.system ветка openai НЕ читает») — строка без действия на модель до того этапа.
- id: persona
  name: '@deepseek-ai/dsh-persona'
  config:
    @@PERSONA_KLYUCH@@: |-
      @@LICHNOST@@

- id: compaction
  name: cordis:group
  group: true
  isolate:
    compaction: true
    toolResultPruner: true
  config:
    # 🔴 07.09.2026, ПО ПРЯМОМУ СЛОВУ ВЛАДЕЛЬЦА (19:26 МСК). Механизм компакции
    # ПЛАТФОРМЫ ВЫКЛЮЧЕН ЦЕЛИКОМ. Сводку и урезание теперь делает НАШ шлюз
    # (claude-oauth) через PreCompact-хук Claude Agent SDK — той же схемой, что
    # год работает на aclaude: вход в сводку ограничен, длина задана промтом,
    # модель назначаем мы.
    #
    # Почему выключено, а не настроено. Замер дня: 466 файлов сессий SDK и НОЛЬ
    # границ компакта внутри них — платформа компактила СМЕНОЙ СЕССИИ. Пока
    # суммировщик не был задан, сводку делала модель агента и всё ехало. Как
    # только 11:43 сюда вписали summarizationProvider/Model (думающий v4-flash),
    # рассуждение стало съедать потолок вывода: сводка обрывалась на полуслове,
    # урезание в ядре НЕДЕЛИМО со сводкой (:302 бросок до checkpointMessage),
    # история не резалась, и каждый ход снова упирался в порог. Первый обрыв в
    # истории — 13:15:50, до него за трое суток 22 успешные сводки подряд.
    # Поднятие потолка 8192 -> 32768 не помогло: обрыв повторился на том же
    # контексте, только через 4 минуты вместо 80 секунд.
    #
    # Прежнее содержимое блока сохранено в страховке рядом (bak-*-pre-vykl-kompakcii-dsh).
    # 🔴 07.09.2026: СНЯТ ВМЕСТЕ С ДВИЖКОМ. command-compact ЖДЁТ службу compaction
    # и без неё виснет на «waiting for compaction» — набор не собирается, агент
    # не получает писем вовсе (поймано первым же опытом: письмо осталось в ящике).
    # Класс: снял механизм — проверь его ПОТРЕБИТЕЛЕЙ. Команда /compact теперь
    # не нужна: сжатие делает наш шлюз сам, по порогу.

    # ВОЗВРАЩЕНО 09.09.2026 ПО СЛОВУ ВЛАДЕЛЬЦА, НО ДВИЖОК ТЕПЕРЬ НАШ.
    #
    # Выше описано, почему 07.09 компакцию платформы выключили целиком: сводку
    # писала платформа думающей моделью, рассуждение съедало потолок вывода,
    # сводка обрывалась, а урезание в ядре НЕДЕЛИМО со сводкой — история не
    # резалась и каждый ход снова упирался в порог.
    #
    # Что изменилось и почему это не повтор той же беды: сводку пишет НАШ модуль
    # (dsh-pamyat-kompakt) с потолком вывода 393216 — в 12 раз больше того, на
    # котором она обрывалась. Предел сводки просится СЛОВАМИ в промте, механически
    # выход не режется. При отказе нашей модели отдаём работу родной сводке, то
    # есть компакт не срывается, а кричит в журнал.
    #
    # Что остаётся РОДНЫМ и потому переживает обновление платформы: момент компакта,
    # затенение узлов, границы, запись в журнал, возврат сводки в контекст и
    # проверка того, что сводка меньше затенённого. Наш — один объявленный крючок
    # summarize, платформа сама пишет о нём: Override this sole hook.
    #
    # ГРАНИЦА, НАЗВАННАЯ ДО ПРОБЫ: у Искры модель идёт через наш шлюз, и считает ли
    # счётчик платформы её токены — НЕ ПРОВЕРЕНО. Если не считает, порог не наступит
    # и компакта не будет вовсе. Это видно по журналу и лечится возвратом на шлюзовой
    # компакт, который сейчас работает и остаётся включённым.
    - id: compaction-basic
      name: dsh-pamyat-kompakt-dsh
      config:
        # 🔴 0.4 — РАБОЧЕЕ значение, назначено по ЗАМЕРУ после подъёма 11.09 15:54
        # (исполнение поручения владельца 11.09 14:10; прежнее 0.9 было временным
        # «запасом на первый заход» и свою роль отслужило).
        #
        # ЗАМЕР, НА КОТОРОМ СТОИТ ЧИСЛО (6 обрывов, журнал iskra.service, 11.09):
        #   запрос 1019540 · беседа 505625 · 2.016x
        #   запрос 1489398 · беседа 745217 · 1.998x
        #   обвес РАСТЁТ вместе с беседой, а не стоит константой
        # => на токен беседы приходится ~2 токена запроса, значит предел 1 000 000
        #    достигается при беседе ~500 000. ЭТО И ЕСТЬ ФАКТИЧЕСКАЯ СТЕНА.
        #
        # 0.9 = 900 000 стояло ВЫШЕ стены => компакт не мог сработать НИ РАЗУ:
        # агент падал на входе раньше (12 обрывов за сутки к 11.09 18:44).
        # 0.4 = 400 000 даёт запас ~100 000 токенов до стены — сжатию нужен свой ход,
        # а после стены изнутри нельзя ничего («single-exchange cannot be compacted»).
        #
        # ГРАНИЦА: число снято на ОДНОЙ раскладке в ОДИН день. Сменится состав
        # инструментов, скиллов или обвеса — кратность 2x поедет, и порог надо
        # ПЕРЕСНЯТЬ тем же способом, а не унаследовать.
        # 🔴 ЗАПРЕТ (Забава, координатор; основание ЗАМЕНЕНО 14.09.2026 01:45 МСК):
        # порог НЕ поднимать и платформенный компакт НЕ гасить.
        # ДЕРЖИТ КОРИДОР, а не совпадение: снизу 0.17 (ниже плагин не собирает компакт
        # вовсе), сверху ~0.48 (стена беседы, см. расчёт выше). 0.4 стоит у ВЕРХНЕГО края:
        # вверх двигать некуда, вниз — без ряда по частоте сжатий это движение вслепую.
        # СНИМАЕТСЯ рядом замеров частоты сжатий, а не одиночным наблюдением.
        #
        # ⚠️ ПРЕЖНЕЕ ОСНОВАНИЕ («держит совпадение: шлюзовой компакт не погашен, модуль
        # не читает nastrojki/iskra.json») ОТОЗВАНО как ЛОЖНОЕ — замер 14.09 01:40 МСК:
        # KOMPAKT_AGENT=iskra задана у ШЛЮЗА (claude-oauth-gateway@iskra), там настройка
        # ЧИТАЕТСЯ и kompaktShlyuzovoj:false действует ⇒ шлюзовой ПОГАШЕН, решение
        # владельца 11.09 исполнено. Строка «имя агента НЕ ЗАДАНО» идёт из ДРУГОГО
        # процесса — iskra.service, где шлюзового компакта нет вовсе.
        # 📌 Класс: один модуль в ДВУХ процессах имеет РАЗНОЕ окружение; «настройка
        # читается» — утверждение про экземпляр, а не про модуль. Называть процесс.
        # 30.09.2026 20:48 МСК — слово владельца: порог платформенного сжатия Codex-агентов 0.65.
        # Число берётся из mashina.raskladka_obshchee.osnova.codex.dolya_platformy; история прежних порогов — в реестре.
        thresholdRatio: @@DOLYA@@
        # retainRatio 0.1 — решение владельца 14.09 14:18 «ставь 0,1 у обоих».
        # Было умолчание платформы 0.16 ≈ 160 000 токенов ≈ 641 644 знака вклеенной переписки
        # в контрольной точке (замер по боевому журналу 14.09). 0.1 уменьшает вклеиваемое.
        # Правило платформы validateRatioRetention (retainRatio < thresholdRatio) выполняется.
        # retainRatio 0.06 — СЛОВО ВЛАДЕЛЬЦА 25.09.2026 12:23 МСК (голосом, через Забаву): «да, согласен, ставим как предлагаешь», B-N-871.
        # шлюзовым клонам (Заря, Аврора, Спартак) — 0.02 (A-N-773). Удержание от поверхности — ловушка A-N-875 (в работе).
        retainRatio: 0.06
        # 29.09.2026 12:08 МСК — СЛОВО ВЛАДЕЛЬЦА: повторную попытку сжатия отключить в настройках (A-N-1172). Умолчание платформы 1 давало
        compactionRetries: 0

    # B-N-1813: ручной компакт через тот же scoped двигатель (слово владельца 07.10 23:44Z).
    - id: command-compact
      name: '@deepseek-ai/dsh-command-compact'

    - id: tool-result-pruner
      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
      config:
        thresholdChars: 8192
        headChars: 4096
        tailChars: 1024

# ── delegation and workflows ────────────────────────────────────────────────

# The `subagents` registry and its spawn/fork backends live in the HOST
# composition: the registry is a process singleton whose cross-session queries
# the api-proxy serves to the browser, and a provider name may only be
# registered once. This preset contributes the delegation TOOLS, which resolve
# that host registry.
#
# `workflows` is different — nothing outside an agent reads it — so every row
# that reaches it shares one entry-local realm here, and a consumer left
# outside would resolve a host registry this preset does not populate.
#
# `tool-subagent-report` is host-plane for the same reason as the registry,
# not because a preset may not want it: it registers a CONTINUABLE SETUP on
# that singleton rather than a tool this agent calls, and the setup list is
# not scope-aware — one copy per mounted preset means every child gets
# `report` registered once per live session, which throws on the second.

- id: agent-instructions
  name: '@deepseek-ai/dsh-agent-instructions'
  config:
    maxBytes: 65536
    # Только глобальный DSH_HOME/AGENTS.md; личные правила загружает Codex.
    instructionFileCandidates: []
    localInstructionFileCandidates: []

# B-H-081 Ш1 (СЛОВО ВЛАДЕЛЬЦА 01.10 09:48 МСК «3 - б всем и будущим тоже»): три заводские строки 0.2 — всем агентам,
# ВКЛЮЧАЯ Codex. Дословно из dsh-web-app presets/standard.patch.yml; tool-plugin-manager ВКЛЮЧЁН (у завода disabled: true) —
# владелец 29.09 21:24:20Z «Все нужны». Порядок — как у завода (после agent-instructions). Не убирать без слова владельца.
- id: command-goal
  name: '@deepseek-ai/dsh-command-goal'
- id: present
  name: '@deepseek-ai/dsh-tool-present'
- id: tool-plugin-manager
  name: '@deepseek-ai/dsh-plugin-manager/tools'

# ── skills ── B-N-1356 (01.10.2026, Заря; слово владельца 01.10 12:31 «все возможности всем»; пилот моста 0.3.23 на alfa 13:2x МСК —
# 16 инструментов у модели, skill нет): мост отдаёт модели Codex всё, что есть в реестре агента, — нет строки здесь, нет у модели.
# Каталог ОДИН — <CODEX_HOME>/skills (@@KATALOG_NAVYKOV@@: сборка берёт CODEX_HOME из СОБРАННОГО C, как путь M — второго правила нет).
# Почему он: это отобранный для агента набор (ссылки на /opt/agent-skills и /opt/agent-skills-local; у marc — ещё SEO), его же
# читает сам Codex ⇒ платформа и Codex видят ОДНО. /opt/agent-skills рядом НЕ добавлять — те же имена дважды; /opt/agent-skills-local
# целиком — тоже нет (update-dsh-platform и прочие — только выбранными ссылками). Ссылки skill-filesystem проходит (stat по ссылке).
# ⚠️ Цена: описания каталога — в контекст каждой сессии (alfa 25 навыков ≥6,7 тыс. зн., marc 72 ≥16,7 тыс. зн. — оценка снизу, 1-я строка).
- id: skill-filesystem
  name: '@deepseek-ai/dsh-skill-filesystem'
  config:
    customSkillDirs:
      - @@KATALOG_NAVYKOV@@

- id: tool-skill
  name: '@deepseek-ai/dsh-tool-skill'
  # B-N-1356в (01.10, решение Забавы — вариант В со стороны платформы): навыки в запросе нити дважды — свой блок Codex и этот
  # каталог (замер Авроры 10:56Z: alfa 11 362 + 8 365 зн., marc 32 083 + 22 856). Описание в каталоге — до 200 зн. (умолч. 500,
  # dsh-tool-skill index.js :40); навык не пропадает, полный текст — при вызове skill. Codex-сторону ([skills] в M) не трогать — стоп владельца 29.09.
  config:
    catalogDescriptionMaxLength: 200
