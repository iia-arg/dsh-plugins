[Unit]
Description=Почтальон шины A2A: переносит письма в собственность получателя
Documentation=https://github.com/iia-arg/dsh-plugins/tree/master/packages/a2a-bus
# 🔴 ЧЕГО ЭТА СЛУЖБА НЕ ДЕЛАЕТ: не доставляет письмо в ход агента (это модуль связи),
# не читает содержимое, не закрывает окно ДО переноса (это umask 077 у отправителя),
# не сообщает человеку. О её собственной смерти узнаёт сторож машины, куда внесён таймер.

[Service]
Type=oneshot
# root нужен ровно для одного: сменить владельца письма. Больше ни для чего.
User=root
ExecStart=/usr/local/sbin/a2a-pochtalon.py
# Код 1 = часть писем не перенесена и ОСТАВЛЕНА на месте. Это не отказ прогона:
# остальные разнесены, и вносить 1 в успешные нельзя — иначе потерянное письмо
# станет неотличимо от пустой почты.
SuccessExitStatus=1
# Единственный каталог, который службе позволено менять. Не «на всякий случай»:
# служба работает от root, и без этой границы ошибка в путях правила бы всю машину.
ReadWritePaths=/var/spool/a2a
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
