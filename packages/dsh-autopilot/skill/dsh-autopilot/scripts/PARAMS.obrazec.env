# ОБРАЗЕЦ параметров окна dsh-autopilot — значения ПЕРВОГО окна sadik 15.10 (окно 007556e4, закрыто 07:06Z).
# Не запускать как есть: строка AP_OBRAZEC ниже заставляет загрузчик отказать. Скопируй файл, впиши значения
# своего окна, строку AP_OBRAZEC удали. Формат: ИМЯ=значение, значение БУКВАЛЬНО — без кавычек.
# Пометки: [окно] — меняется каждое окно; [машина] — свойство машины приложения; [пакет] — свойство выпуска.
# Не задаются здесь (вычисляют скрипты): AP_SAVE, AP_DOCUMENT_START, AP_PACKAGE_DIR, AP_RELEASE, AP_KEY_FILE,
# AP_PUBLIC_ROOT, AP_UNIT, AP_KEY_TIMER_LINK, AP_WINDOW_ID, AP_CHILD_IDS, AP_D_STAGE, AP_CHECKS_STAGE,
# AP_COUNTER_SOURCE, AP_COUNTER_README_SOURCE.
AP_OBRAZEC=1

# [окно] пункт окна; рука окна; автор учёта smontirovat-fajly — форма «Имя <имя@машина>» (поправка 1 r6:
# голое «Zabava» из PARAMS v6 отвергнуто на первом файле блока 4; в окне Забава поправила рукой).
AP_TASK=dsh-autopilot-okno
AP_ACTOR=Zabava
AP_RUKA=Zabava <zabava@aclaude>

# [пакет] принятый upstream PIN (main на github проверяется в 01), коммит полки, архив и его полная сумма.
AP_PIN=46060c3efc19a3e5cb740415cdfb601d126c29fd
AP_PACKAGE_HEAD=8dede2c2219e63a4652f4d3bdce7a044a37e2013
AP_TGZ=/var/tmp/dsh-autopilot/FINAL-15a72cad/DSH-AUTOPILOT-FINAL.tar.gz
AP_TGZ_SHA=2af4f8f5bb19dbfcc9b3ca3f6a5c375f5c86fefb4d622e3cdce73cdaf4cfc69a
AP_ARCHIVE_STRIP=0
# [пакет] полная сумма манифеста раскладки из записи реестра (в v6 была ЗАШИТА в фазу B и в блок 23).
AP_LAYOUT_MANIFEST_SHA=87f1b65f73eb7c4fb143882ce19b9244bc51fd30e785f3382da196f9671e6937
# [пакет] сумма адаптера счётчика модели.
AP_COUNTER_SHA=5ee037f3a256bd6edda98226accf7c2c63fe3268082e7b008b0066f916ede404

# [окно] принятые данные окна: план окна, план отката, П7 (по пути в строке), снимок окружения сторожа выпуска,
# перечни git-учёта (NUL). Все — root-owned, приняты воротами до окна.
AP_BACKUP_ROOT=/var/backups/montazh
AP_WINDOW_PLAN=/var/tmp/dsh-autopilot/OKNO-KIT/WINDOW-PLAN.json
AP_ROLLBACK_PLAN=/var/tmp/dsh-autopilot/OKNO-KIT/ROLLBACK-PLAN.json
AP_P7_PATHS=/var/tmp/dsh-autopilot/OKNO-KIT/P7-ALL.paths
AP_VOW_ENV_JSON=/var/tmp/dsh-autopilot/OKNO-KIT/VOW-ENV.capture.json
AP_USR_LOCAL_FILES=/var/tmp/dsh-autopilot/OKNO-KIT/USR-LOCAL.files0
AP_SYSTEMD_FILES=/var/tmp/dsh-autopilot/OKNO-KIT/SYSTEMD.files0

# [окно] реестр: живой файл, принятый кандидат и ПОЛНАЯ sha256 основы кандидата. В v6 основа была ЗАШИТА в загрузчик.
# Основа сдвигается с каждой записью реестра — снимать sha256sum живого plugins.yaml перед самым окном.
AP_PLUGINS_REGISTRY=/etc/agent-registry/plugins.yaml
AP_PLUGINS_CANDIDATE=/var/tmp/dsh-autopilot/OKNO-KIT/coordinator/plugins.yaml
AP_PLUGINS_BASE_SHA=a2ad66b7960b3b8e9e52deaf90649e5d536c0b9b17fd6535d2b104b1f3d869ed
AP_AGENTS_VERIFY=/usr/local/bin/agent-registry
AP_DORABOTKI=/opt/iskra/workspace/dorabotki/nashi-dorabotki.sh

# [окно] метка пакета — 06 не пишет реестр, пока её нет (поправка 5). 15.10: метка 07:03:19Z на b15af9f1.
AP_TREE_REPO=/opt/iskra/workspace/dsh-plugins
AP_TAG=dsh-autopilot-v0.1.0

# [машина] оператор и его юниты, каталог скиллов движка.
AP_OPERATOR=master
AP_ENGINE_SKILLS=/var/lib/coder-gateway-master/codex-home/skills
AP_AGENT_SERVICE=master.service
AP_GATEWAY_SERVICE=coder-gateway-master.service

# [машина] сеть раздачи и вход. Юнит раздачи несёт адреса сам — здесь ожидаемые значения, не настройка.
AP_MESH_IP=192.168.99.6
AP_PORT=8787
AP_REMOTE_IP=192.168.99.3
AP_DOMAIN=ap1.insmat.ru

# [машина] счётчик модели — боевые адреса.
AP_COUNTER_TARGET=/usr/local/libexec/dsh-autopilot/measure-run-codex.py
AP_COUNTER_README_TARGET=/usr/local/share/doc/dsh-autopilot/README-measure-run-codex.md

# [пакет] контрольный файл оператора (03) — тело постоянно, поэтому и сумма постоянна.
AP_PUBLIC_PATH=master/okno-probe/run-probe/state.js
AP_CONTROL_SHA=223f01c6fbb13eca6b5f572a4a18114769c7442a3e228e7a09fef3b2447367ff

# Ниже — для шагов РУКОЙ (скриптами не делаются, см. SKILL.md «Скрипты окна»): include ключа на машине входа
# (блок 9, vps-ru) и пилот оператора (§8: блоки 15–18). Пилотные AP_OPERATOR_PID, AP_THREAD, AP_TEST_START,
# AP_TEST_END, AP_USAGE_MOUNT_TIME снимаются в самом пилоте.
AP_HEADER_CONFIG=/etc/nginx/ap1.insmat.ru.klyuch.conf
AP_CODEX_HOME=/var/lib/coder-gateway-master/codex-home
AP_TEST_PROJECT=/var/tmp/dsh-autopilot/pilot-project
AP_TEST_SLUG=okno-pilot
