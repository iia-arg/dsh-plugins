[Unit]
Description=Сторож покрытия копии: есть ли данные, которых копия не берёт и никто не объявил ненужными
Documentation=file:///usr/local/sbin/backup-coverage-watch
After=multi-user.target

[Service]
Type=oneshot
# Рукой АГЕНТА, как и сторож реестров. Обход домов идёт через `sudo -n find`
# (дом соседа из-под iskra не читается), а полное беспарольное право у этого
# пользователя есть — записано в реестре вмешательств отдельной строкой,
# и там же сказано, что все наши пределы поведенческие, а не силовые.
User=iskra
Group=iskra
# 20.09.2026: каталог состояния глушения. Создавал systemd, а не рука —
# ручной каталог исчезает при чистке /var/lib, и глушение отвалится МОЛЧА.
# Поймано живым признаком 06:35:00Z: Permission denied ⇒ 24 тревоги в сутки.
StateDirectory=backup-coverage-watch
# agent-button нужна отправщику тревог (/etc/agent-alert/token, 640 root:agent-button).
# Берётся из /etc/group по имени пользователя, membership там есть.
ExecStart=/usr/local/sbin/backup-coverage-watch
# 🔴 Код 1 = «нашёл непокрытое». Это штатный результат наблюдения, а не сбой:
# без этой строки systemd красит сторожа в failed при каждой находке, и тогда
# настоящие отказы (3 реестр не читается, 4 обход не удался, 5 пустой обход)
# становятся неотличимы от обычной работы. Требование автора, и оно верное.
# 🔴 ГРАНИЦА: сюда НЕЛЬЗЯ дописывать 3/4/5. Они означают «проверка не
# состоялась», и failed по ним — единственное, чем это отличается от молчания
# исправного сторожа.
SuccessExitStatus=1
StandardOutput=journal
StandardError=journal
