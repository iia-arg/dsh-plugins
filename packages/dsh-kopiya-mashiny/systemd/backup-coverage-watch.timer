[Unit]
Description=Ежечасный прогон сторожа покрытия копии (такт поднят с суточного 20.09.2026)

[Timer]
# 07:35 UTC — через пять минут после сторожа реестров (07:30). Обе тревоги
# приходят вместе, а не двумя порциями в разное время суток. Пояс машины
# Etc/UTC; суффикс написан явно, чтобы перевод пояса не сдвинул прогон молча.
# 🔴 ТАКТ ПОДНЯТ С СУТОК ДО ЧАСА (20.09.2026). Прежняя точка 07:35 сохранена — она
# одна из двадцати четырёх, стыковка со сторожем реестров не потеряна.
# ОБОСНОВАНИЕ ЧИСЛОМ, а не ощущением: прогон замерен трижды — 1312 / 1135 / 1152 мс,
# CPU 1,2 с ⇒ 24 прогона стоят ~29 с CPU в сутки.
# ⚠️ УЧАЩЕНИЕ ЗАКОННО ТОЛЬКО ВМЕСТЕ С ГЛУШЕНИЕМ ПОВТОРОВ, заведённым в самом стороже
# (отпечаток состава находок, срок 24 ч). Без него вышло бы 24 одинаковых тревоги в
# сутки — выгорание, которое мы уже видели на стороже копии.
# И намерение автора («стоящее расхождение обязано повторяться каждый день») СОХРАНЕНО
# в точности: на неизменный состав приходит по-прежнему ОДИН крик в сутки. Меняется
# другое — НОВАЯ находка становится видна в течение часа, а не суток.
# Замер, ради которого это и делается: 19–20.09 три непокрытых каталога нашлись СЛУЧАЙНО,
# по другим поводам, потому что между прогонами сторож молчит.
OnCalendar=*-*-* *:35:00 UTC
# 🔴 ЕЖЕДНЕВНО, а не еженедельно (у автора было воскресенье). Довод тот же,
# которым он снял порог по времени с домов: о новом доме надо знать сразу.
# И второй, наш: окна тишины нет намеренно — стоящее расхождение обязано
# повторяться каждый день, иначе долг становится невидимым, а он и есть то,
# ради чего сторож заведён. Цена названа прямо: пока разметка соседа не
# дописана, тревога будет приходить ежедневно. Это долг, а не шум.
Persistent=true
AccuracySec=1min
Unit=backup-coverage-watch.service

[Install]
WantedBy=timers.target
