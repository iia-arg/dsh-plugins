[Unit]
Description=Ежедневная приёмка копии sadik
# 🔴 ЧЕГО ЭТОТ ТАЙМЕР НЕ ДЕЛАЕТ: не проверяет старые копии на диске — только
# последнюю по отметке; не судит о чужой цепи в общей папке; не ловит собственную
# смерть. Последнее закрыто снаружи: этот таймер внесён в SERVICES сторожа машины.

[Timer]
# 🔴 B-N-741 (24.09): 06:15 UTC = старт сборки 03:00 + разброс 5 мин + её предел TimeoutStartSec 3 ч + 10 мин.
# К этому часу сборка ночи ЛИБО кончилась, ЛИБО убита — приёмка не застаёт её на ходу. Меняется предел
# или час сборки — пересчитать по этой формуле. Прежние 04:00 («час после сборки 32 МБ») 24.09 застали
# перезапуск копии на ходу (03:59–04:53) и дали ЗЕЛЕНО по вчерашней.
OnCalendar=*-*-* 06:15:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=backup-verify.service

[Install]
WantedBy=timers.target
