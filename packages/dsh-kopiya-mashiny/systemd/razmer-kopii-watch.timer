[Unit]
Description=Ежесуточный прогон сторожа размера копии sadik

[Timer]
# 06:45 UTC — после сборки (03:00 UTC, до 3 ч) и после приёмки (переносится на 06:15, B-N-741):
# сторож видит отметку ЭТОЙ ночи. Сборка дольше 3 ч 45 мин — сторож сравнит вчерашнюю пару, это видно по имени в строке.
# Раз в сутки: ступенька меряется раз за ночь; нехватка места повторяется ежедневно, пока не решена — это долг, не шум.
OnCalendar=*-*-* 06:45:00 UTC
Persistent=true
AccuracySec=1min
Unit=razmer-kopii-watch.service

[Install]
WantedBy=timers.target
