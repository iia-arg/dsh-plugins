[Unit]
# Копия машины собирается САМОЙ машиной и уезжает на Drive.
# Скрипт: /usr/local/sbin/sadik-backup.py (написал Михалыч, правила и ставит Искра).
# Состав копии — из /etc/agent-registry/agents.yaml, своего списка у скрипта нет.
Description=Копия sadik на Google Drive
Documentation=file:///opt/iskra/workspace/procedury/DOLGI.md
After=network-online.target
Wants=network-online.target
# 🔴 B-N-741 (24.09): убийство по TimeoutStartSec, OOM по MemoryMax и SIGKILL минуют fail() скрипта — 24.09 03:20Z
# 'oom-kill' не сказал никто. Смерть видит только systemd: он и зовёт тревогу. Пропуск запуска это НЕ ловит — см. приёмку.
OnFailure=sadik-backup-failed.service

[Service]
Type=oneshot
# 🔴 ОТ ROOT, И ЭТО ЗАМЕР, А НЕ ПРЕДПОЧТЕНИЕ (25.08):
#   от iskra Path.exists() на /opt/dsh БРОСАЕТ PermissionError — копия собралась бы
#   без дома соседа либо отказом;
#   от root запись хранилища не читается — поэтому за секретом скрипт ходит
#   к владельцу ключа через sudo -n -u iskra, и группу agent-secrets новый процесс
#   получает из /etc/group. Проверено боевым прогоном 10:49 и 10:53 UTC.
# SupplementaryGroups здесь НЕ нужен: живому процессу root группа не требуется,
# требуется она порождённому процессу iskra, и он берёт её сам.
User=root
ExecStart=/usr/local/sbin/sadik-backup.py
# Предел: боевой прогон 30,6 МБ занял 8 с. 30 минут — запас кратный, а не процентный,
# и он же граница: зависшая отправка не должна висеть до следующих суток.
# 🔴 B-N-739 (24.09): 30 минут перестало хватать. 23.09 архив 8,9 ГБ — готово за 26 мин (впритык); 24.09 одна сборка 23 ГБ
# заняла 15 мин, выгрузка не влезла бы. 3 часа — запас кратный на рост и медленную сеть, и всё ещё граница до следующих суток.
TimeoutStartSec=10800
# 🔴 B-N-739: ПРЕДЕЛ ПАМЯТИ. 24.09 03:20Z копия (выгрузка multipart в памяти) дала 24,8 ГиБ и уронила ГЛОБАЛЬНЫЙ OOM —
# ядро выбирало жертву на всей машине. С пределом cgroup OOM ограничен копией: соседи не страдают, копия падает с тревогой.
# Потоковая выгрузка (кусок 64 МиБ) держит ~220 МиБ на проверке 1 ГиБ. 4G — граница, а не ожидание; MemoryHigh — торможение раньше убийства.
# ⚠️ Пик СБОРКИ архива отдельно не замерен (прежний пик 9,8G — с выгрузкой). Первый прогон покажет «memory peak» в журнале.
MemoryHigh=2G
MemoryMax=4G
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
