[Unit]
Description=Ежедневная копия sadik на Google Drive
# Условие остановки названо в самом юните: механизм без границы производит тот вред,
# от которого бережёт. Здесь границы две — предел времени в .service и то, что
# ротация трогает ТОЛЬКО свой контейнер на Drive (подпапка own-chain).
# 🔴 ЧЕГО ЭТОТ ТАЙМЕР НЕ ДЕЛАЕТ: не проверяет, что уехавшее ОТКРЫВАЕТСЯ. Это делает приёмка
# по своему расписанию: backup-verify.timer → /usr/local/sbin/proverka-svezhesti-kopii.sh
# (B-N-756, 24.09.2026: прежняя строка «приёмка прогоняется рукой» устарела).

[Timer]
# 03:00 UTC — до утренних сторожей (07:30/07:35), чтобы они видели свежую копию.
OnCalendar=*-*-* 03:00:00 UTC
# Пропущенный из-за выключенной машины прогон делается при следующем подъёме.
Persistent=true
RandomizedDelaySec=300
Unit=sadik-backup.service

[Install]
WantedBy=timers.target
