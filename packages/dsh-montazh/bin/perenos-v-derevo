#!/usr/bin/env bash
# perenos-v-derevo — перенести пакет с БОЕВОГО ДИСКА в дерево репозитория так, чтобы
# удаление никогда не прошло молча.
#
# ЗАЧЕМ. Перенос делался рукой (cp/rsync по случаю). 05.09.2026 он СТЁР раздел описания,
# живший только в дереве: инструмент отработал с кодом 0 и не сказал ни слова о том, что
# удалил. Класс: ПЕРЕНОС, УДАЛИВШИЙ СТРОКИ, ОБЯЗАН ОТКАЗАТЬ ЛИБО НАЗВАТЬ УДАЛЁННОЕ.
# Способ подсказан Михалычем 06.09 и проверен на НАШЕЙ паре, а не на его стенде:
# `rsync -ai --delete --dry-run` печатает `*deleting <файл>` ДО того, как удалит.
#
# 🔴 СВЕРКА ПО СОДЕРЖИМОМУ (-c), А НЕ ПО ВРЕМЕНИ. Без -c rsync считает разошедшимся всякий
# файл с другим mtime: замер 07.09 дал «разошлось 55 файлов» при том, что по содержимому
# не разошёлся НИ ОДИН. Перенос по времени гнал бы в дерево пустые правки, а коммит
# утверждал бы изменение, которого нет.
#
# ЧТО ЭТОТ ИНСТРУМЕНТ НЕ ДЕЛАЕТ И ГДЕ НЕ ПРИМЕНЯЕТСЯ:
#   — не коммитит и не ставит тегов: решение о выпуске принимается отдельно и другой рукой;
#   — не переносит из дерева на диск (обратное направление — другой предмет, другие риски);
#   — не знает, ЗАКОННО ли удаление: он умеет только не дать сделать его молча;
#   — node_modules и .git не трогает вовсе.
#
# КОДЫ: 0 перенесено (или переносить нечего) · 1 ОТКАЗ: перенос удалил бы файлы · 2 слепота
set -uo pipefail

DISK_KOREN=${DISK_KOREN:-/opt/iskra/plugins}
DEREVO_KOREN=${DEREVO_KOREN:-/opt/iskra/workspace/dsh-plugins/packages}

PAKET=""; SOGLASNA=""
for a in "$@"; do
  case "$a" in
    # 🔴 ОБХОД ТРЕБУЕТ НАЗВАННОЙ ПРИЧИНЫ (07.09.2026, наблюдение Забавы; тот же день, что
    # завёлся ключ). Удаление необратимо, а голый флаг оставляет след «удалено» без «зачем».
    # Образец рядом работает: PODNYAT_NESMOTRYA=«почему сейчас» у ворот подъёма — и однажды
    # эта причина сама доехала до чужого журнала и объяснила чужому агенту, что произошло.
    # Механизм, вынуждающий НАЗВАТЬ, оставляет след даже когда его об этом не просили.
    --soglasna-udalit=*) SOGLASNA="${a#--soglasna-udalit=}"
        [ -n "$SOGLASNA" ] || { echo "🔴 --soglasna-udalit= с ПУСТОЙ причиной: назовите её словами" >&2; exit 2; };;
    --soglasna-udalit) echo "🔴 --soglasna-udalit ТРЕБУЕТ ПРИЧИНЫ: --soglasna-udalit='почему это можно стереть'" >&2
        echo "   Удаление необратимо; через неделю «зачем» не восстановит никто." >&2
        exit 2 ;;
    --pomosh|-h) sed -n '2,20p' "$0"; exit 0 ;;
    -*) echo "🔴 неизвестный ключ: $a (есть --soglasna-udalit=<причина>, --pomosh)" >&2; exit 2 ;;
    *) [ -n "$PAKET" ] && { echo "🔴 пакет назван дважды: «$PAKET» и «$a»" >&2; exit 2; }; PAKET="$a" ;;
  esac
done
[ -n "$PAKET" ] || { echo "perenos-v-derevo <имя-пакета> [--soglasna-udalit=<причина>]" >&2; exit 2; }

command -v rsync >/dev/null || { echo "🔴 СЛЕПОТА: rsync не найден — сверить и перенести нечем" >&2; exit 2; }
IST="$DISK_KOREN/$PAKET"; CEL="$DEREVO_KOREN/$PAKET"
[ -d "$IST" ] || { echo "🔴 СЛЕПОТА: на диске нет каталога $IST" >&2; exit 2; }
[ -d "$CEL" ] || { echo "🔴 СЛЕПОТА: в дереве нет каталога $CEL — новый пакет заводится рукой, не этим инструментом" >&2; exit 2; }

KLYUCHI=(-aic --delete --exclude node_modules --exclude .git)

# 🔴 СУХОЙ ПРОГОН ПЕРВЫМ И ВСЕГДА. Он и есть ворота: вопрос «что я сейчас потеряю»
# задаётся ДО потери, а не после. Вывод берём целиком: обрезка здесь съела бы именно
# строки *deleting, ради которых всё и заведено.
SUHOJ=$(rsync "${KLYUCHI[@]}" --dry-run "$IST/" "$CEL/" 2>&1); KOD=$?
[ "$KOD" -eq 0 ] || { echo "🔴 СЛЕПОТА: сухой прогон rsync вернул код $KOD"; printf '%s\n' "$SUHOJ"; exit 2; }

UDALYAET=$(printf '%s\n' "$SUHOJ" | grep '^\*deleting' || true)
MENYAET=$(printf '%s\n' "$SUHOJ" | grep -E '^[<>ch]' || true)
N_UD=$(printf '%s' "$UDALYAET" | grep -c . || true)
N_IZ=$(printf '%s' "$MENYAET" | grep -c . || true)
VSEGO=$(find "$IST" -type f -not -path '*/node_modules/*' -not -path '*/.git/*' | wc -l)

echo "── перенос $PAKET: $IST -> $CEL"
echo "   файлов на диске $VSEGO · переносится по СОДЕРЖИМОМУ $N_IZ · УДАЛИЛОСЬ БЫ $N_UD"

if [ "$N_UD" -gt 0 ]; then
  echo "🔴 В ДЕРЕВЕ ЕСТЬ ФАЙЛЫ, КОТОРЫХ НЕТ НА ДИСКЕ. Перенос их СТЁР бы:"
  printf '%s\n' "$UDALYAET" | sed 's/^/     /'
  if [ -z "$SOGLASNA" ]; then
    echo "   ОТКАЗ: ничего не тронуто. Это может быть текст, живущий только в дереве —"
    echo "   сперва перенесите его на диск, иначе он исчезнет без следа."
    echo "   Осознанный обход есть и он требует ПРИЧИНЫ: --soglasna-udalit='почему это можно стереть'."
    exit 1
  fi
  echo "   ⚠️ ОБХОД ПРИМЕНЁН, ПРИЧИНА: $SOGLASNA — перечисленное выше будет удалено."
fi

if [ "$N_IZ" -eq 0 ] && [ "$N_UD" -eq 0 ]; then
  echo "✅ переносить нечего: дерево равно диску по содержимому (не по времени правки)"
  exit 0
fi

BOEVOJ=$(rsync "${KLYUCHI[@]}" "$IST/" "$CEL/" 2>&1); KOD=$?
[ "$KOD" -eq 0 ] || { echo "🔴 СЛЕПОТА: перенос вернул код $KOD"; printf '%s\n' "$BOEVOJ"; exit 2; }

# 🔴 ПРОВЕРКА ФАКТА, А НЕ НАМЕРЕНИЯ: спрашиваем тем же сухим прогоном ПОСЛЕ переноса.
# «rsync вернул 0» — утверждение инструмента о себе; пустой сухой прогон — след на той стороне.
# ⚠️ ПРОИСХОЖДЕНИЕ ЭТОЙ ВЕТКИ — ПРЕДУСМОТРИТЕЛЬНОСТЬ, А НЕ ЖИВОЙ СЛУЧАЙ (правило координатора
# 06.09: у пробы помечать, снята ли форма с действительности). Воспроизвести «rsync сказал 0,
# а расхождение осталось» 07.09 не удалось: попытка сделать цель недоступной на запись беду НЕ
# создала — правка существующего файла не требует записи в каталог, то есть порча не пересекла
# границу, которую проверяет признак. Остальные ветки сняты с живого: отказ по *deleting и
# слепота по коду 23 (нечитаемый файл в источнике) проверены порчей.
POSLE=$(rsync "${KLYUCHI[@]}" --dry-run "$IST/" "$CEL/" 2>&1); KOD=$?
if [ "$KOD" -ne 0 ]; then
  echo "🔴 СЛЕПОТА: сверка ПОСЛЕ не добыта (rsync код $KOD): $IST -> $CEL" >&2
  printf '%s\n' "$POSLE" >&2
  exit 2
fi
OSTATOK=$(printf '%s\n' "$POSLE" | grep -E '^[<>ch*]'); KOD=$?
[ "$KOD" -le 1 ] || { echo "🔴 СЛЕПОТА: не разобран результат сверки ПОСЛЕ (grep код $KOD)" >&2; exit 2; }
if [ -n "$OSTATOK" ]; then
  echo "🔴 ПОСЛЕ ПЕРЕНОСА РАСХОЖДЕНИЕ ОСТАЛОСЬ — перенос не сделал того, что обещал:"
  printf '%s\n' "$OSTATOK" | sed 's/^/     /'
  exit 1
fi
echo "✅ перенесено и сверено ПОСЛЕ: сухой прогон пуст, дерево равно диску по содержимому"
