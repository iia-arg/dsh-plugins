#!/bin/bash
# polozhit-svodku — положить снимок «четырёх разрядов» файлом, который читают по ssh.
#
# 🔴 ЗАЧЕМ. 06.09.2026: за один день пять писем подряд от двоих участников опирались на
# версии, отставшие на 5-18 выпусков («в бою a36» при a50, «latest на a1» при a4, «ворота
# на a3» при a8). Ни один из них не ошибался: у них НЕТ способа увидеть моё состояние
# иначе как через письмо, а письмо идёт дольше, чем меняется предмет.
# Прибор svodka-sostoyaniya.sh даёт все четыре разряда сразу, но живёт на моей машине и
# зовётся моей рукой. Здесь его вывод кладётся файлом — его читают по ssh вне очереди.
#
# ⚠️ ЭТО СНИМОК, А НЕ ИСТОЧНИК. Источник — прибор. Файл нужен тому, кто прибор позвать не
# может; он СТАРЕЕТ с первой секунды, и возраст напечатан в первой строке.
# ЧЕГО НЕ ДЕЛАЕТ: не судит (вердикт кладёт тот, кто мерил) и не заменяет ворота.
# ЧТО ЗНАЧИТ ЕГО МОЛЧАНИЕ: ничего. Молчащий файл — просто старый файл; смотри время.
set -uo pipefail
PRIBOR=/usr/local/libexec/svodka/svodka-sostoyaniya.sh
CEL=/opt/iskra/workspace/SOSTOYANIE-VERSIJ.txt
[ -x "$PRIBOR" ] || { echo "СЛЕПОТА: прибора нет ($PRIBOR) — снимок НЕ положен" >&2; exit 2; }
VREM=$(mktemp "${TMPDIR:-/opt/iskra/workspace/vremennoe}/svodka.XXXXXX") || exit 2
trap 'rm -f "$VREM"' EXIT
{
  echo "СНИМОК СОСТОЯНИЯ ВЕРСИЙ · машина sadik"
  echo "снято: $(date -u '+%Y-%m-%d %H:%M:%SZ') — 🔴 ЭТО СНИМОК, ОН СТАРЕЕТ. Свежесть по stat -c %y."
  echo "источник: $PRIBOR (зовите его сами, если можете — файл нужен тем, кто не может)"
  echo "положила: Искра, командой polozhit-svodku. Суждений здесь нет, только числа."
  echo "──────────────────────────────────────────────────────────────────────────────"
  echo
} > "$VREM"
if ! timeout 180 "$PRIBOR" >> "$VREM" 2>&1; then
  echo "" >> "$VREM"
  echo "⚠️ ПРИБОР ВЕРНУЛ НЕ НОЛЬ: снимок неполон. Читать как «часть не снялась», не как «так и есть»." >> "$VREM"
fi
cp "$VREM" "$CEL" && chmod 644 "$CEL" || { echo "🔴 снимок не положен: нет права записи в $CEL" >&2; exit 1; }
echo "положено: $CEL ($(wc -c < "$CEL") байт, $(wc -l < "$CEL") строк)"
echo "⚠️ это «положено», а не «прочитано»: сторожа, который заметил бы, что файл перестали читать, НЕТ."
