#!/usr/bin/env bash
# proba-chastnyh-imen — искать наши частные имена в каталоге ПЕРЕД публикацией.
#
# ЗАЧЕМ. 02.09.2026 в реестр уехали два пакета с именами живых агентов:
# tool-bridge 0.2.0 («у Искры две…») и telegram-multiagent 1.4.1 («ответ Забаве
# записан» — в ЛОГ-строке, видной постороннему). Обе проверки — и исполнителя,
# и аудитора — дали ноль. Слепота была не в алфавите и не в регистре, а в ФОРМЕ
# СЛОВА: списки держали точные имена, а в тексте стояли склонения.
# Поэтому здесь ищутся ОСНОВЫ, и -i обязателен.
#
#   proba-chastnyh-imen <каталог>   проверить
#   proba-chastnyh-imen --kontrol   проверить САМУ ПРОБУ на подставном
#
# Контроль гоняется ТОЙ ЖЕ функцией с ТЕМИ ЖЕ флагами — иначе контролируешь не то,
# чем меряешь (поймано аудитором на себе в ту же ночь).
set -uo pipefail

# 🔴 ЛОКАЛЬ — UTF-8 ИЛИ ОТКАЗ (B-N-1954, 09.10.2026, нашла Заря). Без UTF-8 локали
# (env -i, ручной зов без LANG) `grep -i` не сводит регистр кириллицы: «Искры» не
# совпадает с основой «искр». Контроль давал код 2, а обычный режим — «чисто» с кодом 0
# на файле с именами: тихое ложное зелёное. Под systemd LANG приходит из
# /etc/default/locale, при ручном зове — нет. Отказ один не лечит: vypusk-tegom зовёт
# --kontrol с выводом в /dev/null, причина не дошла бы. Поэтому ставим C.UTF-8 сами
# и печатаем это; не встала (локали нет на машине) — отказ с причиной.
if [ "$(locale charmap 2>/dev/null)" != "UTF-8" ]; then
  export LC_ALL=C.UTF-8
  if [ "$(locale charmap 2>/dev/null)" != "UTF-8" ]; then
    echo "🔴 ОТКАЗ: нет UTF-8 локали (LANG/LC_ALL пусты или не UTF-8), и C.UTF-8 на машине нет." >&2
    echo "   Без неё -i не сводит регистр кириллицы — проба слепа. Это НЕ «чисто»." >&2
    exit 2
  fi
  echo "локаль: не UTF-8 (LANG/LC_ALL пусты или не UTF-8) — выставлена LC_ALL=C.UTF-8" >&2
fi

proverit() {
  grep -rilE "$OSNOVY" "$1" 2>/dev/null | grep -v '/node_modules/' | grep -v '/\.git/'
}

# 🔴 ЛИШНИЙ ДОВОД — ОТКАЗ, А НЕ ТИХОЕ УМОЛЧАНИЕ (02.09.2026, поймала Искра на sadik).
# Она позвала `proba-chastnyh-imen . --kontrol`, ключ ВТОРЫМ доводом. Инструмент брал `.`
# как каталог и второй довод молча выбрасывал: вывод был обычный, и она решила, что
# контроль пройден. Проверка, которую считают пройденной и которая не запускалась, хуже
# отсутствующей. Тот же дефект чинили в тот день у a2a-send: порядок доводов молча съедался.
if [ "$#" -gt 1 ]; then
  echo "🔴 ОТКАЗ: лишние доводы: $*" >&2
  echo "   Принимается РОВНО ОДИН: <каталог> ЛИБО --kontrol." >&2
  echo "   Ключ вторым доводом раньше терялся молча — теперь это отказ." >&2
  exit 2
fi
case "${1:-}" in
  --kontrol|-*) : ;;
esac
# №5 аудита A-N-1948 (10.10.2026, Заря): контроль — на ВСТРОЕННОМ подставном списке, не на списке машины. Прежде он требовал,
# чтобы в списке машины стояли основы «Искр/Забав/Петрович», и на любом другом списке давал «ПРОВАЛЕН». Мерит он механику —
# основа + склонение + верхний регистр + локаль — той же функцией proverit с теми же флагами; список машины проверяется ниже
# отдельно (нет / пуст — отказ). Основа нарочно выдуманная: в настоящий список она не попадёт.
if [ "${1:-}" = "--kontrol" ]; then
  T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
  OSNOVY='ромашк|васильк'
  printf 'у РОМАШКИ две сессии\nответ Васильку записан\n' > "$T/podstavnoy.txt"
  printf 'обычный текст без основ\n' > "$T/chistyj.txt"
  N=$(proverit "$T" | grep -c . || true)
  if [ "$N" -eq 1 ]; then echo "контроль зрячести: ПРОЙДЕН (встроенный подставной список: склонения и верхний регистр найдены, чистый файл не задет)"; exit 0
  else echo "🔴 контроль ПРОВАЛЕН: найдено файлов $N из 1 — склонения или регистр не ловятся, проба слепа"; exit 2; fi
fi

# 🔴 СПИСОК ОСНОВ — В ОБЩЕМ ФАЙЛЕ, не здесь. Причина: 02.09.2026 у Забавы и
# Вениамина списки разошлись (у него не было «aclaude»), и его прогон промолчал
# на утечке, которую нашла она. Два прибора с разными списками хуже одного.
# Пропажа или пустота файла — ОТКАЗ (код 2), а НЕ «чисто»: пустой список
# совпадает ни с чем и красит зелёным что угодно.
# Список ищется по порядку: переменная -> общее место (читаемо ЛЮБЫМ пользователем,
# в т.ч. служебными на других машинах) -> домашнее. Причина второго пути: 02.09.2026
# на sadik каталог /home/claude имеет права 750, и служебный пользователь dsh не мог
# войти в него — файл был читаемый, а каталог выше закрыт. Инструмент молча отказывал.
SPISOK="${PROBA_SPISOK:-}"
if [ -z "$SPISOK" ]; then
  for _p in /usr/local/share/chastnye-osnovy.txt \
            /home/claude/my-assistant/shared/chastnye-osnovy.txt; do
    [ -r "$_p" ] && { SPISOK="$_p"; break; }
  done
  [ -z "$SPISOK" ] && SPISOK=/usr/local/share/chastnye-osnovy.txt
fi
if [ ! -r "$SPISOK" ]; then
  echo "🔴 ОТКАЗ: список основ не читается: $SPISOK"
  echo "   Проверять нечем. Это НЕ «чисто»."
  exit 2
fi
OSNOVY=$(grep -vE '^\s*(#|$)' "$SPISOK" | paste -sd'|' -)
if [ -z "$OSNOVY" ]; then
  echo "🔴 ОТКАЗ: в списке $SPISOK нет ни одной основы. Это НЕ «чисто»."
  exit 2
fi

D="${1:-}"
[ -d "$D" ] || { echo "использование: proba-chastnyh-imen <каталог> | --kontrol" >&2; exit 2; }
# 🔴 Пустой каталог давал «чисто» — ложно-зелёное, неотличимое от проверенного.
# Поймано 02.09.2026 на себе: проба сказала «чисто» на каталоге, куда ничего не
# распаковалось. Инструмент против слепоты был слеп ровно так же.
FAJLOV=$(find "$D" -type f -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | grep -c . || true)
if [ "$FAJLOV" -eq 0 ]; then
  echo "🔴 СЛЕПОТА: в каталоге $D нет файлов — проверять нечего. Это НЕ «чисто»."
  exit 2
fi
echo "файлов в обходе: $FAJLOV"
# Сумма списка печатается ВСЕГДА, в том числе на зелёном: расхождение списков у
# разных агентов становится видно там, где встречаются ОТЧЁТЫ. Печать только при
# расхождении вернула бы «пустота неотличима от исправности» (02.09.2026, замысел
# Искры, эталон намеренно НЕ заводим — он был бы третьей копией для присмотра за двумя).
# 🔴 Сумма считается по ОТСОРТИРОВАННОМУ списку: она обязана быть тождеством
# СОДЕРЖАНИЯ, а не файла. 02.09.2026 Искра перебрала 69 расстановок, чтобы сойтись
# со мной при одинаковом наборе основ — порядок входил в сумму, и одинаковые списки
# давали разные суммы. Сортировка в LC_ALL=C — иначе порядок зависит от локали
# машины, и мы вернёмся к тому же расхождению через другую дверь.
SUMMA=$(grep -vE '^\s*(#|$)' "$SPISOK" | LC_ALL=C sort -u | sha256sum | cut -c1-16)
echo "основ в списке: $(echo "$OSNOVY" | tr '|' '\n' | grep -c .) из $SPISOK, сумма $SUMMA, регистр не учитывается"
NAYDENO=$(proverit "$D")
CHISLO=$(printf '%s' "$NAYDENO" | grep -c . || true)
echo "найдено файлов: $CHISLO"
if [ "$CHISLO" -gt 0 ]; then
  # 🔴 ОБРЕЗКА ОБЪЯВЛЯЕТСЯ. 02.09.2026 я прочла показанные три строки как ПОЛНОЕ
  # число вхождений и назвала исполнителю объём работы втрое меньше настоящего
  # (12 вхождений вместо 3). Обрезка вывода — это фильтр; молчащий фильтр
  # превращает окно в утверждение о множестве.
  echo "$NAYDENO" | while read -r f; do
    VSEGO=$(grep -icE "$OSNOVY" "$f")
    echo "--- $f  (вхождений: $VSEGO)"
    grep -inE "$OSNOVY" "$f" | head -3
    [ "$VSEGO" -gt 3 ] && echo "    … показаны первые 3 из $VSEGO"
  done
  echo "🔴 ПУБЛИКОВАТЬ НЕЛЬЗЯ"; exit 1
fi
echo "чисто"
