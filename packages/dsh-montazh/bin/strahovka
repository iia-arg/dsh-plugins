#!/usr/bin/env bash
# strahovka — снять страховочную копию так, чтобы её ВОЗРАСТ и ВЛАДЕЛЕЦ не врали.
#
# 🔴 ЗАЧЕМ. Страховку я называю основанием отката в каждом письме, а проверить её
# возраст было нечем: `cp -p` СОХРАНЯЕТ mtime ОРИГИНАЛА, поэтому у копии он
# говорит о предмете, а не об операции. Замер 05.09.2026 по машине: страховок
# 1020, у 837 mtime расходится с настоящим временем создания больше минуты,
# наибольший разрыв 356 часов. Свою сегодняшнюю поймал Михалыч: mtime отстал на
# 14 часов, и откат выглядел бы возвратом к состоянию полусуточной давности.
# Цена ошибки двусторонняя: годную страховку забракуют как старую, чужую примут
# за свежую.
#
# ЧЕМ ЛЕЧИТСЯ: не памяткой, а опцией. `--preserve=mode,ownership` сохраняет
# владельца и права (они нужны: копия от чужого имени при откате СМЕНИТ хозяина
# файла — своя ошибка 05.09) и НЕ сохраняет время (оно и врало). Проверено
# парой: владелец root:root и права 640 сохранены, mtime = момент копирования
# секунда в секунду.
#
# ЧЕГО НЕ ДЕЛАЕТ:
#   не откатывает и не проверяет, что откат ВОЗМОЖЕН — только снимает копию;
#   не работает с каталогами (страховка каталога — другой предмет и другая цена);
#   не затирает существующую страховку того же имени — отказ, а не тихая замена:
#     затёртая страховка неотличима от снятой заново, а это разные состояния;
#   не решает за вас про sudo: файл чужой и прав нет — ОТКАЗ с подсказкой,
#     а не копия от своего имени.
#
# 🔴 B-N-892 (25.09.2026, Михалыч; решение главной по B-H-407): КОПИЯ БОЛЬШЕ НЕ КЛАДЁТСЯ РЯДОМ.
# Было: <файл>.bak-pre-<повод>-<UTC>-XXXXXX рядом с оригиналом — противоречит решению
# «новое .bak рядом с боевыми не заводить». Стало: единое место (оно в копии, объявлено в реестре):
#   /var/backups/montazh/<пункт>/<настоящий путь без ведущего /, / → %>.<ГГГГММДДTЧЧММSSZ>.<sha256[:16] основы>
# Вызов: strahovka --punkt <пункт> <файл>. Пункт — латиница, цифры, дефис. Без пункта или в прежней
# форме «<файл> <повод>» — ОТКАЗ с причиной, а не тихий откат к «рядом».
# Права и владелец — КАК У ОРИГИНАЛА (--preserve=mode,ownership): откат cp'ом вернёт их верно, а
# закрытый оригинал (640 root:agent-secrets) даёт такую же закрытую копию.
# 🔴 ЗАКРЫТЫЙ ОРИГИНАЛ — ВНЕ КОПИИ (условие Вениамина 25.09 к B-N-892). /var/backups/montazh уезжает
#   в копию на Drive; утром 25.09 так уехали 18 страховок instance-*.env с ключом (A-N-776, B-N-840).
#   Поэтому: у оригинала НЕТ права чтения для прочих (o+r: 600/640/660…, у .env и секретов так всегда)
#   → копия в /var/backups/montazh-s-klyuchom/<пункт>/ (root 700, вне копии), и вывод это называет.
#   Открытый оригинал → /var/backups/montazh/<пункт>/. Ложное срабатывание дёшево (закрытый не-секрет
#   просто не уедет наружу), пропуск — ключ в облаке.
# ⚠️ ЧЕГО НЕ ЛОВИТ: ОТКРЫТЫЙ файл с секретом (644 с токеном внутри) — по правам не отличить, уедет
#   в копию. Это остаётся руке и поиску по ЗНАЧЕНИЮ в ночной копии.
# Отказ «внутри пакета» (05.09) снят: копия больше не ложится в дерево пакета, повода нет.
#
# 🔴 ГРАНИЦА САМОЙ ОПЦИИ --preserve=mode,ownership (05.09.2026, своя ошибка в тот же день).
# Она годится для СОЗДАНИЯ копии, как здесь, и ВРЕДНА при ЗАМЕНЕ существующего файла:
# режим переносится от ИСТОЧНИКА, а не сохраняется у назначения. Я заменила ею манифест
# общего каталога, копируя из временного файла (600), — права уехали с 644 на 600, и
# сосед на минуту потерял чтение. Поймала проверкой ЕГО глазами, не своими: своё чтение
# из-под sudo не показало бы ничего.
# ПРИ ЗАМЕНЕ: снять режим и владельца НАЗНАЧЕНИЯ до правки и вернуть их после,
# либо править файл на месте. Опция тут не помощник.
# ЧТО ЗНАЧИТ ЕГО МОЛЧАНИЕ: ничего. Он не сторож, он делает одно действие.
set -uo pipefail
MONTAZH=/var/backups/montazh
MONTAZH_KLYUCH=/var/backups/montazh-s-klyuchom
ISPOLZ="strahovka --punkt <пункт> <файл>   → $MONTAZH/<пункт>/<путь через %>.<UTC>.<sha256[:16]>"

PUNKT=""
if [ "${1:-}" = --punkt ] && [ $# -eq 3 ]; then PUNKT=$2; FAJL=$3
else
  echo "🔴 ОТКАЗ: вызов «$*» не распознан. $ISPOLZ" >&2
  echo "   С B-N-892 (25.09.2026) копия кладётся в единое место, РЯДОМ с оригиналом — больше нет." >&2
  exit 2
fi
[[ "$PUNKT" =~ ^[A-Za-z0-9-]+$ ]] || { echo "🔴 ОТКАЗ: пункт «$PUNKT» — только латиница, цифры, дефис" >&2; exit 2; }
[ -f "$FAJL" ] || { echo "🔴 не файл или не существует: $FAJL" >&2; exit 2; }
PUT=$(realpath -e -- "$FAJL") || { echo "🔴 не добыт настоящий путь: $FAJL" >&2; exit 2; }
PRAVA=$(stat -c %a -- "$PUT" 2>/dev/null || sudo -n stat -c %a -- "$PUT" 2>/dev/null)
[[ "$PRAVA" =~ ^[0-7]{3,4}$ ]] || { echo "🔴 не добыты права оригинала $PUT — не решу, наружу копия или нет" >&2; exit 2; }
if (( ${PRAVA: -1} & 4 )); then KOREN=$MONTAZH; ZAKRYT=""
else KOREN=$MONTAZH_KLYUCH; ZAKRYT="оригинал закрыт ($PRAVA, нет o+r) — копия ВНЕ копии: montazh-s-klyuchom"; fi
KAT="$KOREN/$PUNKT"

SUDO=""
[ -r "$PUT" ] || SUDO="sudo"
{ [ -d "$KAT" ] && [ -w "$KAT" ]; } || { [ ! -d "$KAT" ] && [ -w "$KOREN" ]; } || SUDO="sudo"
if [ -n "$SUDO" ] && ! sudo -n true 2>/dev/null; then
  echo "🔴 файл не читается или $KAT не мой, а sudo без пароля недоступен — не делаю" >&2; exit 2
fi
$SUDO mkdir -p -- "$KAT" || { echo "🔴 нет каталога страховок $KAT" >&2; exit 2; }

# Сумма ОСНОВЫ — до копии: она входит в имя и сверяется с копией.
R1=$($SUDO sha256sum -- "$PUT"); K1=$?; S1=${R1%% *}
{ [ "$K1" -eq 0 ] && [[ "$S1" =~ ^[[:xdigit:]]{64}$ ]]; } || { echo "🔴 не добыта сумма основы $PUT (код $K1)" >&2; exit 2; }
STAMP=$(date -u +%Y%m%dT%H%M%SZ); KOD=$?
[ "$KOD" -eq 0 ] && [ -n "$STAMP" ] || { echo "🔴 не добыта дата страховки" >&2; exit 2; }
KOPIYA="$KAT/$(printf '%s' "$PUT" | sed 's|^/||; s|/|%|g').$STAMP.${S1:0:16}"

# Копия — в частичный файл того же каталога, затем ln в итоговое имя: резерв атомарный,
# имя уже есть — ОТКАЗ, чужая точка возврата не затирается. Частичный удаляется в любой ветке.
CHAST=$($SUDO mktemp -- "$KAT/.chast-XXXXXX") || { echo "🔴 не создан частичный файл в $KAT" >&2; exit 2; }
ubrat() { $SUDO rm -f -- "$CHAST"; }
$SUDO cp --preserve=mode,ownership -- "$PUT" "$CHAST" || { ubrat; echo "🔴 копия не создана" >&2; exit 1; }
R2=$($SUDO sha256sum -- "$CHAST"); K2=$?; S2=${R2%% *}
{ [ "$K2" -eq 0 ] && [[ "$S2" =~ ^[[:xdigit:]]{64}$ ]]; } || { ubrat; echo "🔴 не добыта сумма копии (код $K2)" >&2; exit 2; }
[ "$S1" = "$S2" ] || { ubrat; echo "🔴 СУММЫ РАЗОШЛИСЬ — страховка негодна: $S1 против $S2" >&2; exit 1; }
$SUDO ln -- "$CHAST" "$KOPIYA" 2>/dev/null || { ubrat; echo "🔴 ОТКАЗ: $KOPIYA уже есть — не затираю" >&2; exit 1; }
ubrat

echo "страховка: $KOPIYA"
[ -n "$ZAKRYT" ] && echo "  🔒 $ZAKRYT"
echo "  сумма   : ${S1:0:16} (sha256[:16], совпала с оригиналом)"
echo "  владелец: $($SUDO stat -c '%U:%G %a' "$KOPIYA") — как у оригинала"
echo "  СОЗДАНА : $($SUDO stat -c '%w' "$KOPIYA" | cut -c1-19) UTC"
echo "  🔴 возраст брать ОТСЮДА либо по 'stat -c %w', НЕ по mtime и НЕ по ctime:"
echo "     mtime у копии от cp -p наследуется от оригинала (врёт назад),"
echo "     ctime сдвигается вперёд при любом chmod/chown/переносе."
