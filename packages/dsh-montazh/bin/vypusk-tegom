  echo "  исправных пакетов краснеют; метку не подтверждаю. Объявленный обход: STENDY_INACHE=\"довод\"" >&2
  exit 2
else
  # Печать окружения берётся из ТОГО ЖЕ массива, что уходит в вызов: печать отдельной строкой лгала бы, если
  # подстановку уберут (так и вышло на порче 24.09 — отказ пришёл, а строка всё ещё называла DSH_TEST_APP).
  # B-N-1914 (наряд Забавы 06:28Z): ОБЛАСТЬ СТЕНДОВ ВЫПУСКА. По плану сверки копий (тот же выбор, что у сверки ниже):
  #  · VYPUSK_KOPII задан — стенды ТОЛЬКО из выбранных копий (B-N-1905), а не из боевой области обходчика;
  #  · копий-каталогов нет, есть запись derevo (пакет по местам) — стенды ИЗ ДЕРЕВА ВЫПУСКА, гоняются против мест боя;
  #  · иначе (или план слеп) — прежняя область и перечень обходчика.
  # Перечень (знаменатель) в обоих новых случаях — стенды ДЕРЕВА ВЫПУСКА (у копии — приложенные к её каталогу):
  # копия без стенда дерева даст «в перечне есть, на диске нет», лишний стенд копии — «на диске есть, в перечне нет».
  # B-N-2019: копия — под User зарегистрированного агента, корень — его dom/app; owner кода не используется.
  # НЕ ЛОВИТ: копии вне зарегистрированных домов; строки перечня ночного обхода (другой прибор).
  OBH_ENV=("${OBH_SREDA[@]}" PAKET_IMYA="$IMYA_P")
  stendy_dereva() { local d="$1" s; for s in "$d"/test/stend-*.mjs "$d"/test/stend-*.sh "$d"/test/stend-*.py "$d"/stend-*.mjs "$d"/stend-*.sh "$d"/stend-*.py; do
      [ -f "$s" ] || continue; case "$s" in *.py) [ -f "${s%.py}.sh" ] && continue ;; esac; printf '%s\n' "${s#"$d"/}"; done; }
  # Учётка стенда: строка-файл «путь @учётка корень» из ОБЛАСТИ САМОГО ОБХОДЧИКА (второго списка не заводим) — у копии по точному
  # пути, у дерева выпуска по хвосту «/<каталог пакета>/<стенд>» (строки обходчика пишут путь дерева Искры). Нет строки — своя учётка.
  pometka() { local put="$1" hvost="$2" st p; while IFS= read -r st; do p="${st%% @*}"
      if [ "$p" = "$put" ] || { [ -n "$hvost" ] && [[ "$p" == *"$hvost" ]]; }; then printf '%s\n' "${st#"$p" }"; return 0; fi
    done < <(grep -E '^/[^ ]+/stend-[^ /]+ @[^ ]+ /[^ ]+$' "$OBHODCHIK"); return 0; }
  PLAN_VYVOD=$(kopii_vypuska plan 2>&1); PLAN_KOD=$?; PLAN=$(printf '%s\n' "$PLAN_VYVOD" | grep '^ПЛАН: ') || PLAN=""
  if [ "$PLAN_KOD" -eq 2 ] && { [[ "$PLAN_VYVOD" == *"СЛЕПОТА: копии выпуска: область не задана:"* ]] || [[ "$PLAN_VYVOD" == *"СЛЕПОТА: копии выпуска: неверный derevo.subdir"* ]]; }; then
    printf '%s\n' "$PLAN_VYVOD" >&2; exit 2
  fi
  # LOW Вениамина 07:2xZ (B-N-1914): VYPUSK_KOPII задан, а план не KOPIYA — сразу СЛЕПОТА, без отката к прежней области: иначе отчёт
  # успел бы показать зелёные стенды чужих копий (повод B-N-1905), а отказ держался бы только на втором вызове сверки ниже.
  # B-N-2033: VYPUSK_KOPII может выбирать и записи derevo (ID мест) — тогда план DEREVO по этим ID.
  if [ -n "${VYPUSK_KOPII+x}" ] && { [ "$PLAN_KOD" -ne 0 ] || { [[ "$PLAN" != "ПЛАН: KOPIYA"* ]] && [[ "$PLAN" != "ПЛАН: DEREVO"* ]]; }; }; then
    echo "СЛЕПОТА: VYPUSK_KOPII задан, а область стендов по нему не построена — стенды не гоняю (иначе прошли бы стенды чужих копий):" >&2
    printf '%s\n' "$PLAN_VYVOD" | grep -E 'СЛЕПОТА|ПЛАН' | head -5 | sed 's/^/   /' >&2; exit 2
  fi
  # B-N-2121: строка плана общей копии (учётка стендов и поимённые пользователи кода) — в отчёт; без неё принимающий не видит, кого судили.
  printf '%s\n' "$PLAN_VYVOD" | grep '^ОБЩАЯ КОПИЯ ' | sed 's/^/   /'
  KAT_ABS=$(realpath "$KATALOG"); STENDY_D=$(stendy_dereva "$KAT_ABS"); N_D=$(printf '%s' "$STENDY_D" | grep -c . || true)
  OBL_V=""; OBSH_KORNI=""; : > "$VREM/perechen-vypuska"
  case "$PLAN" in
    "ПЛАН: DEREVO"*)
      IFS=$'\t' read -r _ DER_IDS DER_REG <<< "$PLAN"
      if [ "$N_D" -eq 0 ]; then
        echo "СЛЕПОТА: пакет $IMYA_P разложен по местам ($DER_IDS), а в дереве выпуска стендов нет — судить нечего." >&2
        echo "  Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2; exit 2
      fi
      OBL_V="$KAT_ABS/"$'\n'; printf '%s\n' "$STENDY_D" | sed "s#^#$KAT_ABS/#" > "$VREM/perechen-vypuska"
      while IFS= read -r rel; do pm=$(pometka "" "/$(basename "$KAT_ABS")/$rel")
        [ -n "$pm" ] && OBL_V="$OBL_V$KAT_ABS/$rel $pm"$'\n' && echo "   стенд $rel — по строке обходчика: $pm"; done <<< "$STENDY_D"
      echo "ОБЛАСТЬ СТЕНДОВ ВЫПУСКА: пакет по местам (derevo $DER_IDS) — стенды дерева выпуска $KAT_ABS: $N_D (общие для всех ID, гоняются один раз)" ;;
    "ПЛАН: SOURCE_ONLY"*)
      # B-N-2030: копий в бою нет, источник — сам каталог выпуска: стенды ДЕРЕВА ВЫПУСКА (как у DEREVO), учётка — по строке обходчика.
      IFS=$'\t' read -r _ SO_ID SO_REG <<< "$PLAN"
      if [ "$N_D" -eq 0 ]; then
        echo "СЛЕПОТА: SOURCE_ONLY $IMYA_P (источник $SO_ID): в дереве выпуска стендов нет — судить нечего." >&2
        echo "  Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2; exit 2
      fi
      OBL_V="$KAT_ABS/"$'\n'; printf '%s\n' "$STENDY_D" | sed "s#^#$KAT_ABS/#" > "$VREM/perechen-vypuska"
      while IFS= read -r rel; do pm=$(pometka "" "/$(basename "$KAT_ABS")/$rel")
        [ -n "$pm" ] && OBL_V="$OBL_V$KAT_ABS/$rel $pm"$'\n' && echo "   стенд $rel — по строке обходчика: $pm"; done <<< "$STENDY_D"
      echo "ОБЛАСТЬ СТЕНДОВ ВЫПУСКА: SOURCE_ONLY (источник $SO_ID, копий нет) — стенды дерева выпуска $KAT_ABS: $N_D" ;;
    "ПЛАН: KOPIYA"*)
      while IFS=$'\t' read -r _ pid proot pkto papp pvid; do
        pabs=$(sudo -n realpath "$proot")
        [ "$pvid" = obshchaya ] && OBSH_KORNI="$OBSH_KORNI$pid"$'\t'"$pabs"$'\n' && echo "   копия $pid — ОБЩАЯ: стенды под владельцем живой копии $pkto; слепок корня ДО и ПОСЛЕ стендов"
        [ -n "$pkto" ] && [ -n "$papp" ] && sudo -n -u "$pkto" test -d "$papp" || { echo "СЛЕПОТА: копия $pid ($pabs) — учётка/платформа агента не читается: $pkto $papp." >&2; exit 2; }
        OBL_V="$OBL_V$pabs/ @$pkto $papp"$'\n'
        printf '%s\n' "$STENDY_D" | grep . | sed "s#^#$pabs/#" >> "$VREM/perechen-vypuska"
        while IFS= read -r rel; do [ -n "$rel" ] || continue; pm=$(pometka "$pabs/$rel" "")
          [ -n "$pm" ] && OBL_V="$OBL_V$pabs/$rel $pm"$'\n' && echo "   стенд $rel копии $pid — по строке обходчика: $pm"; done <<< "$STENDY_D"
        echo "ОБЛАСТЬ СТЕНДОВ ВЫПУСКА: копия $pid → $pabs${pkto:+ (учётка $pkto)}; стендов дерева выпуска на неё: $N_D"
      done <<< "$PLAN" ;;
  esac
  [ -n "$OBL_V" ] && OBH_ENV+=(OBLAST_STENDOV="${OBL_V%$'\n'}" PERECHEN_STENDOV="$VREM/perechen-vypuska")
  # B-N-1909 (находка Искры 05:24Z): обходчик — НЕ в процессе зовущего. Оболочка агента под шлюзом несёт группу шлюза
  # 986 (claudeoauth) сверх групп учётки, и стенды видели то, чего не видит ночная служба (User=iskra без 986). Поэтому — как
  # служба: systemd-run User=<учётка зовущего>, группы — свежие по учётке (initgroups systemd), окружение — systemd + среда юнита
  # (OBH_ENV) + подмены обходчика, ЗАДАННЫЕ зовущим (их имена — из файла самого обходчика: ${ИМЯ-…}/${ИМЯ:-…}); umask 0022;
  # остановка — RuntimeMaxSec=3000 (как 50 мин юнита). Нет sudo/systemd-run — СЛЕПОТА, без отката в процесс зовущего.
  # НЕ ПОВТОРЯЕТ PrivateTmp юнита: входы ворот (перечень $VREM, дерево выпуска, подставы стендов) лежат в /tmp и /var/tmp, и
  # частный /tmp сделал бы их невидимыми. Стенд, чей исход зависит только от частного /tmp, этим не ловится.
  OBH_RUKA=$(id -un)
  OBH_PREDEL=3000
  if [ -n "${VYPUSK_OBH_PREDEL_SEK:-}" ]; then   # подмена — ТОЛЬКО стенду ворот (проба «обходчик оборван»), печатается
    [[ "$VYPUSK_OBH_PREDEL_SEK" =~ ^[1-9][0-9]{0,4}$ ]] || { echo "СЛЕПОТА: VYPUSK_OBH_PREDEL_SEK не целое 1..99999 с" >&2; exit 2; }
    OBH_PREDEL=$VYPUSK_OBH_PREDEL_SEK; echo "⚠️ ПОДМЕНА предела обходчика: ${OBH_PREDEL} с (VYPUSK_OBH_PREDEL_SEK)" >&2
  fi
  OBH_RUN=(sudo -n systemd-run -q --wait --pipe --collect -p User="$OBH_RUKA" -p UMask=0022 -p RuntimeMaxSec="$OBH_PREDEL")
  for e in "${OBH_ENV[@]}"; do OBH_RUN+=(-E "$e"); done
  # Среда юнита главнее зовущего (как прежний env "${OBH_ENV[@]}"): имя, уже заданное в OBH_ENV, от зовущего не берётся.
  while IFS= read -r pv; do printf '%s\n' "${OBH_ENV[@]}" | grep -q "^$pv=" && continue; [ -n "${!pv+x}" ] && OBH_RUN+=(-E "$pv=${!pv}"); done < <(grep -oE '\$\{[A-Z_][A-Z0-9_]*(:-|-)' "$OBHODCHIK" | sed -E 's/^\$\{//; s/(:-|-)$//' | sort -u | grep -vxE 'PAKET_IMYA')
  OBH_LISHNIE=$(comm -23 <(id -Gn | tr ' ' '\n' | sort -u) <(id -Gn "$OBH_RUKA" | tr ' ' '\n' | sort -u) | tr '\n' ' ')
  echo "   среда стендов: systemd-run User=$OBH_RUKA, группы учётки (initgroups): $(id -Gn "$OBH_RUKA")${OBH_LISHNIE:+ · у зовущего сверх них: $OBH_LISHNIE— в стенды НЕ передаются}"
  if ! sudo -n systemd-run --version >/dev/null 2>&1; then
    echo "СЛЕПОТА: нет sudo -n systemd-run — стенды в среде ночной службы не прогнать, в процессе зовущего не гоняю (B-N-1909)." >&2; exit 2
  fi
  # B-N-1926 (Аврора; Вениамин; замечания Зари 11:13Z): обходчик идёт отдельной службой systemd-run — её /tmp и /var/tmp ОБЩИЕ (пространство
  #   PID 1); прочие sudo ворот (помощник журнала, сверка копий) идут в пространстве зовущего и его /tmp видят. Зовущий под PrivateTmp
  #   (стенд из ночного обхода) кладёт $VREM и, бывает, дерево выпуска в СВОЙ частный /tmp — обходчик их не видит и слепнет без причины.
  #   Путь виден службе, если устройство:inode у зовущего = у /proc/1/root<путь>. Три исхода, три строки: нет права проверить
  #   (/proc/1/root через sudo) · вход не читается у самого зовущего · «/tmp зовущего ≠ /tmp службы»; все — код 2, стенды не гоняются.
  #   НЕ ЛОВИТ: пути, которые стенды пакета берут сами (их подставы вне области), — это дело стенда (TMPDIR).
  if [ -n "$OBL_V" ]; then
    sudo -n stat -c %d:%i /proc/1/root/ >/dev/null 2>&1 \
      || { echo "СЛЕПОТА: видимость входов ворот службе обходчика не проверить — нет права читать /proc/1/root (sudo -n stat); стенды не гоняю." >&2; exit 2; }
    while IFS= read -r st; do [ -n "$st" ] || continue; p="${st%% *}"; p="${p%/}"
      vuser="$OBH_RUKA"; case "$st" in *' @'*) vuser="${st#* @}"; vuser="${vuser%% *}" ;; esac
      u=$(sudo -n -u "$vuser" stat -c %d:%i "$p" 2>/dev/null) || { echo "СЛЕПОТА: вход ворот $p не читается учёткой копии $vuser — сверять видимость нечего; стенды не гоняю." >&2; exit 2; }
      s=$(sudo -n stat -c %d:%i "/proc/1/root$p" 2>/dev/null)
      [ "$u" = "$s" ] || { echo "СЛЕПОТА: /tmp зовущего ≠ /tmp службы — $p обходчику (systemd-run, /tmp PID 1) не виден (у зовущего $u, у службы ${s:-нет}): PrivateTmp зовущего? Задайте TMPDIR на общий путь (вне /tmp и /var/tmp); стенды не гоняю." >&2; exit 2; }
    done < <(printf '%s\n' "$VREM" "$OBL_V")
  fi
  # B-N-2121 (условие Вениамина 1): стенды общей копии идут под ВЛАДЕЛЬЦЕМ живой копии — слепок всего корня (путь, вид, sha256
  #   содержимого/цель ссылки, режим, владелец) ДО и ПОСЛЕ обходчика; разошёлся — ОТКАЗ «стенд изменил живую копию», раньше разбора
  #   исхода стендов. Не снят — СЛЕПОТА. НЕ ЛОВИТ: запись вне корня (дома других учёток, /etc, /tmp) и изменение, вернувшее байты,
  #   режим и владельца в прежнее (mtime/ctime не сравниваются — живая копия их не хранит как содержание).
  slepok() { sudo -n python3 -I - "$1" "$2" <<'PYSLEPOK'
import hashlib,os,stat,sys
root,out=sys.argv[1:3];rows=[];n=0
for d,dirs,files in os.walk(root,followlinks=False,onerror=lambda e:sys.exit("не читается: "+str(e))):
    dirs.sort()
    for name in sorted(dirs+files):
        p=os.path.join(d,name);s=os.lstat(p);n+=1
        if n>500000:sys.exit("больше 500000 путей")
        if stat.S_ISREG(s.st_mode):
            h=hashlib.sha256()
            with open(p,"rb") as f:
                for b in iter(lambda:f.read(1<<20),b""):h.update(b)
            v="f\t"+h.hexdigest()
        elif stat.S_ISLNK(s.st_mode):v="l\t"+os.readlink(p)
        else:v=("d" if stat.S_ISDIR(s.st_mode) else "o")+"\t-"
        rows.append(os.path.relpath(p,root)+"\t"+v+"\t"+oct(stat.S_IMODE(s.st_mode))+"\t"+str(s.st_uid)+":"+str(s.st_gid))
open(out,"w").write("\n".join(rows)+"\n");print(len(rows))
PYSLEPOK
  }
  N_OBSH=0
  while IFS=$'\t' read -r oid okor; do [ -n "$oid" ] || continue; N_OBSH=$((N_OBSH+1))
    k=$(slepok "$okor" "$VREM/slepok-do-$N_OBSH" 2>&1) || { echo "СЛЕПОТА: слепок общей копии $oid ($okor) ДО стендов не снят: $k — стенды не гоняю." >&2; exit 2; }
    echo "   слепок общей копии $oid ДО стендов: путей $k"
  done <<< "$OBSH_KORNI"
  OBH=$("${OBH_RUN[@]}" "$OBHODCHIK" 2>&1); OBH_KOD=$?
  N_OBSH=0
  while IFS=$'\t' read -r oid okor; do [ -n "$oid" ] || continue; N_OBSH=$((N_OBSH+1))
    k=$(slepok "$okor" "$VREM/slepok-posle-$N_OBSH" 2>&1) || { echo "СЛЕПОТА: слепок общей копии $oid ($okor) ПОСЛЕ стендов не снят: $k — изменила ли её проба, неизвестно." >&2; exit 2; }
    izm=$(sudo -n diff "$VREM/slepok-do-$N_OBSH" "$VREM/slepok-posle-$N_OBSH" | sed -n 's/^[<>] //p' | cut -f1 | LC_ALL=C sort -u)
    if [ -n "$izm" ]; then
      echo "🔴 ОТКАЗ: стенд изменил живую копию $oid → $okor: путей $(printf '%s\n' "$izm" | grep -c .) — $(printf '%s\n' "$izm" | head -20 | paste -sd, - | sed 's/,/, /g')" >&2
      exit 1
    fi
    echo "   слепок общей копии $oid ПОСЛЕ стендов: путей $k — совпал с ДО"
  done <<< "$OBSH_KORNI"
  echo "   окружение обходчика: ${OBH_ENV[*]} (вся среда юнита $OBH_SLUZHBA, не окружение зовущего) · uid=$(id -u) ($(id -un)); перечень и область — умолчания обходчика"
  echo "стенды пакета $IMYA_P в боевой раскладке ($OBHODCHIK, код $OBH_KOD):"
  echo "$OBH" | sed -e '/^STEND-PROGNAN: /d' -e 's/^/   /'   # B-N-2062: факт прогона — данные суда меток, не отчёт
  # LOW Вениамина 08:0xZ (1.0.15): systemd-run отдаёт 1 и при гибели обходчика (RuntimeMaxSec, сигнал, OOM). Обходчик, вынесший
  # суждение, всегда печатает итог «ПОКРЫТИЕ:» (или «СЛЕПОТА ОХВАТА») — без него код 1 не «не зелёный», а «суждения не было».
  if [ "$OBH_KOD" -eq 1 ] && ! printf '%s\n' "$OBH" | grep -qE 'ПОКРЫТИЕ:|СЛЕПОТА ОХВАТА'; then
    echo "СЛЕПОТА: обходчик по пакету $IMYA_P оборван (код $OBH_KOD, итоговой строки «ПОКРЫТИЕ:» нет; предел ${OBH_PREDEL} с) — суждения не было, метку не подтверждаю." >&2
    printf '%s\n' "$OBH" | tail -3 | sed 's/^/   /' >&2; exit 2
  fi
  if [ "$OBH_KOD" -eq 1 ]; then
    echo "🔴 ОТКАЗ: обходчик по пакету $IMYA_P не зелёный — метку не ставим." >&2
    echo "$OBH" | grep -E 'РАСХОЖДЕНИЕ:|🔴' | sed 's/^ */   /' >&2
    exit 1
  elif [ "$OBH_KOD" -ne 0 ] && [ "$OBH_KOD" -ne 3 ]; then
    echo "СЛЕПОТА: обходчик по пакету $IMYA_P не вынес суждения (код $OBH_KOD) — метку не подтверждаю." >&2
    echo "  Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2
    exit 2
  fi
  # B-H-203: код 3 — только ожидаемое. Без единой строки «ОЖИДАЕМО:» код 3 не подтверждён выводом — СЛЕПОТА.
  OZHIDAEMOE=""
  if [ "$OBH_KOD" -eq 3 ]; then
    OZHIDAEMOE=$(echo "$OBH" | grep -F 'ОЖИДАЕМО: ' | sed 's/^ *ОЖИДАЕМО: //')
    if [ -z "$OZHIDAEMOE" ]; then
      echo "СЛЕПОТА: обходчик дал код 3 (только ожидаемое), но строк «ОЖИДАЕМО:» нет — перечень ожидаемого не установлен; метку не подтверждаю." >&2
      exit 2
    fi
    echo "⚠️ ОЖИДАЕМОЕ по исключениям (метка ставится, перечень — в сообщение тега):"
    printf '%s\n' "$OZHIDAEMOE" | sed 's/^/   · /'
  fi
  # Слепота обходчика и при коде 0 (условие Искры 3): все стенды пакета слепы — «зелёных 0» — суждения нет.
  ZELENYH=$(echo "$OBH" | sed -n 's/.* зелёных \([0-9][0-9]*\) .*/\1/p' | awk '{s+=$1} END{print s+0}')
  if [ "$ZELENYH" -eq 0 ]; then
    echo "СЛЕПОТА: у пакета $IMYA_P ни один стенд не вынес суждения (зелёных 0) — метку не подтверждаю." >&2
    echo "  Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2
    exit 2
  fi
  # B-N-1823: каталоги обходчика доказывают, что он получил предмет.
  # Равенство выпуска судит единая сверка всех выбранных копий ниже;
  # старую копию вне явного выпуска нельзя сравнивать с новым тарболом.
  # B-H-060 (MED Вениамина 15:44): цикл ниже при НУЛЕ строк «КАТАЛОГ ПАКЕТА:» не выполняется ни разу, и ворота
  # говорили «можно», не сверив дерево с боем (обходчик без PAKET_IMYA: 155 стендов, строк 0). Ноль — СЛЕПОТА.
  KATALOGI=$(echo "$OBH" | sed -n 's/^КАТАЛОГ ПАКЕТА: //p')
  if [ -z "$KATALOGI" ]; then
    echo "СЛЕПОТА: обходчик не назвал каталог пакета — сверка дерева с боем НЕ выполнена; метку не подтверждаю." >&2
    echo "  Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2
    exit 2
  fi
  # B-N-2062 (Заря; решение Забавы 03:16Z, вариант А; LOW Вениамина к мосту 3.1.5): стенд, которому мерить нечего, говорит
  #   «STEND-NEPRIMENIMO: <проба>: <причина>» и выходит кодом 0 — обходчик пропускает метку наружу с путём и учёткой. Проба,
  #   «не применимая» на КАЖДОЙ копии пакета, где лежит этот стенд, не измерена нигде — СЛЕПОТА 2 с перечнем копий и причин.
  #   Хоть одна копия без метки — проба измерена, суждения нет. Меток нет — ветка молчит (прежнее поведение).
  #   Знаменатель — копии, где стенд ПРОГНАН: строки обходчика «STEND-PROGNAN: <путь>\t<учётка>\t<код>» (dsh-obhod-stendov 3.1.67,
  #   LOW Вениамина 03:29Z). Строк нет (обходчик старше) — прежнее: каталоги «КАТАЛОГ ПАКЕТА:», где файл стенда есть (test -f).
  #   НЕ ЛОВИТ: стенд, не печатающий метку (судится кодом, как прежде); со старым обходчиком — копию, где стенд лежит, но не прогнан.
  # 18.10.2026 (замысел Вениамина 09:14 МСК, наряд Забавы 06:14Z, AP 0.1.10): УЗКИЙ ОБЪЯВЛЕННЫЙ ПРОПУСК одной пробы вместо общего
  #   STENDY_INACHE. NEP_PRINYATO — строки «<стенд>:<проба>=<довод>»; <стенд> — путь от каталога пакета (test/stend-x.sh) или имя
  #   файла. Пара совпала с НЕИЗМЕРЕННОЙ пробой — «не применимо по объявлению: …» в выводе и в тексте метки; прочие стенды пакета
  #   гоняются и судятся как обычно. Любая другая неизмеренная проба — СЛЕПОТА 2, как прежде. Пара, не совпавшая ни с одной
  #   неизмеренной пробой (опечатка, проба измерена, стенд меток не печатал, стенды не прогнаны), и строка не той формы — СЛЕПОТА 2
  #   «объявление не применено»: опечатка не становится молчаливым пропуском.
  #   НЕ ЛОВИТ: верность довода (печатается как дан); пробу, которая перестала быть «не применимой» по существу, но метку печатает.
  NEP=$(printf '%s\n' "$OBH" | sed -n 's/^ *STEND-NEPRIMENIMO: //p')
  if [ -n "$NEP" ]; then
    PROGNAN=$(printf '%s\n' "$OBH" | sed -n 's/^ *STEND-PROGNAN: //p')
    if ! NEP_SUD=$(KATALOGI="$KATALOGI" NEP="$NEP" PROGNAN="$PROGNAN" NEP_PRINYATO="${NEP_PRINYATO:-}" python3 - <<'PYNEP'
import os, subprocess
prinyato = {}
for l in os.environ['NEP_PRINYATO'].splitlines():
    if not l.strip(): continue
    st, _, ost = l.partition(':'); proba, _, dovod = ost.partition('=')
    if not (st.strip() and proba.strip() and dovod.strip()): print('СЛЕПОТА\tобъявление NEP_PRINYATO не той формы «<стенд>:<проба>=<довод>»: ' + l[:160]); continue
    prinyato[(st.strip(), proba.strip())] = dovod.strip()
primeneno = set()
kats = [(l.split('\t') + [''])[:2] for l in os.environ['KATALOGI'].splitlines() if l.strip()]
marks = {}
for l in os.environ['NEP'].splitlines():
    if not l.strip(): continue
    chasti = l.split('\t', 2)
    if len(chasti) != 3: print('СЛЕПОТА\tметка обходчика не разобрана: ' + l[:160]); continue
    put, kto, ost = chasti
    d = max((k for k, _ in kats if put.startswith(k)), key=len, default=None)
    if d is None: print('СЛЕПОТА\tметка стенда вне каталогов пакета: ' + put); continue
    proba, _, prichina = ost.partition(': ')
    marks.setdefault((put[len(d):], proba), {})[d] = prichina
prognany = set(l.split('\t', 1)[0] for l in os.environ.get('PROGNAN', '').splitlines() if l.strip())
for (rel, proba), po in sorted(marks.items()):
    est = []
    for d, kto in kats:
        if prognany:
            if d + rel in prognany: est.append(d)
            continue
        cmd = ['test', '-f', d + rel]
        if kto and kto != '-': cmd = ['sudo', '-n', '-u', kto] + cmd
        if subprocess.run(cmd).returncode == 0: est.append(d)
    # 3.1.30 (info Вениамина 04:10Z): копий, где стенд прогнан, 0 — не «измерено на остальных», а знаменатель не установлен.
    #   С STEND-PROGNAN сейчас недостижимо (метка и факт прогона печатаются подряд с одним путём); достижимо со старым обходчиком
    #   (test -f под учёткой каталога отказал на всех копиях: sudo -n не пускает, нет права чтения) или при будущем разводе двух строк.
    if not est:
        print('СЛЕПОТА\tметка «%s» стенда %s есть (копий с меткой %d), а копий, где он прогнан, 0 — %s; знаменатель не установлен'
              % (proba, rel, len(po), 'строк STEND-PROGNAN для него нет' if prognany else 'файл стенда не найден ни в одном каталоге пакета (test -f)'))
    elif all(d in po for d in est):
        klyuch = next((k for k in ((rel, proba), (os.path.basename(rel), proba)) if k in prinyato), None)
        if klyuch: primeneno.add(klyuch); print('PRINYATO\t%s\t%s\t%s' % (rel, proba, prinyato[klyuch]))
        else: print('NEIZMERENO\t%s\t%s\t%d\t%s' % (rel, proba, len(est), ' · '.join(d + ': ' + po[d] for d in est)))
    else:
        print('IZMERENO\t%s\t%s\t%d\t%d' % (rel, proba, len(po), len(est)))
for st, proba in sorted(set(prinyato) - primeneno):
    print('NEPRIMENENO\t%s:%s' % (st, proba))
PYNEP
    ); then
      echo "СЛЕПОТА: метки «не применимо» стендов пакета $IMYA_P не разобраны (разбор упал) — метку не подтверждаю." >&2; exit 2
    fi
    if printf '%s\n' "$NEP_SUD" | grep -q '^СЛЕПОТА'; then
      echo "СЛЕПОТА: метки «не применимо» стендов пакета $IMYA_P (или объявление NEP_PRINYATO) не сводятся к каталогам и прогонам пакета — метку не подтверждаю:" >&2
      printf '%s\n' "$NEP_SUD" | sed -n 's/^СЛЕПОТА\t/   /p' >&2; exit 2
    fi
    printf '%s\n' "$NEP_SUD" | awk -F'\t' '$1=="IZMERENO"{print "   не применимо на " $4 " из " $5 " копий: " $2 " · «" $3 "» — на остальных измерено"}'
    if printf '%s\n' "$NEP_SUD" | grep -q '^NEPRIMENENO'; then
      printf '%s\n' "$NEP_SUD" | awk -F'\t' '$1=="NEPRIMENENO"{print "СЛЕПОТА: объявление не применено: NEP_PRINYATO «" $2 "» не совпало ни с одной неизмеренной пробой пакета (опечатка, проба измерена или её нет)"}' >&2
      echo "  метку не подтверждаю: объявление без предмета не становится пропуском." >&2
      exit 2
    fi
    NEP_OB=$(printf '%s\n' "$NEP_SUD" | awk -F'\t' '$1=="PRINYATO"{printf "%s%s · «%s» — %s", (n++?"; ":""), $2, $3, $4}')
    [ -z "$NEP_OB" ] || { NEP_OB="не применимо по объявлению: $NEP_OB"; echo "   $NEP_OB"; }
    if printf '%s\n' "$NEP_SUD" | grep -q '^NEIZMERENO'; then
      printf '%s\n' "$NEP_SUD" | awk -F'\t' '$1=="NEIZMERENO"{print "СЛЕПОТА: проба «" $3 "» стенда " $2 " НЕ ИЗМЕРЕНА ни на одной копии пакета (не применимо на всех " $4 "): " $5}' >&2
      echo "  метку не подтверждаю: зелёный код стенда здесь не суждение. Объявленный обход: STENDY_INACHE=\"довод\" vypusk-tegom <каталог>" >&2
      exit 2
    fi
  fi

fi
# NEP_PRINYATO задано, а применить не к чему: стенды не прогнаны (STENDY_INACHE) или ни один не напечатал «не применимо».
NEP_P="${NEP_PRINYATO:-}"
if [ -n "${NEP_P//[[:space:]]/}" ] && [ -z "$NEP_OB" ]; then
  echo "СЛЕПОТА: объявление не применено: NEP_PRINYATO задано, а неизмеренных проб пакета $IMYA_P нет (стенды не прогнаны или меток «не применимо» не печатали) — метку не подтверждаю." >&2
  exit 2
fi

# B-N-1823: the release scope is registry IDs, never "copies whose version already matches".
# Run even under STENDY_INACHE: skipping behavior tests does not waive byte equality.
kopii_vypuska sverka > "$VREM/kopii-vypuska" 2>&1
KOPII_KOD=$?
cat "$VREM/kopii-vypuska"
case "$KOPII_KOD" in 0) ;; 1|2) exit "$KOPII_KOD";; *) echo "СЛЕПОТА: сверка копий не исполнилась (код $KOPII_KOD)." >&2; exit 2;; esac
# B-N-2030: план и сверка SOURCE_ONLY обязаны назвать один источник при одном реестре. Сменился выбор или реестр между ними — СЛЕПОТА,
#   без повтора (стенды гнались под планом, а сверка судила иное). План не строился (STENDY_INACHE) — сравнивать не с чем, суждение сверки.
# B-N-2033: то же для мест — набор ID плана (по нему гнались стенды) = набору сверки, реестр тот же.
DER_SVERKA=$(sed -n 's/^АННОТАЦИЯ ОБЛАСТИ: derevo=\([^;]*\);.*registry_sha256=\([0-9a-f]*\).*/\1\t\2/p' "$VREM/kopii-vypuska")
if [ -n "${PLAN+x}" ] && { [[ "${PLAN:-}" == "ПЛАН: DEREVO"* ]] || [ -n "$DER_SVERKA" ]; } && [ "${DER_IDS:-}"$'\t'"${DER_REG:-}" != "$DER_SVERKA" ]; then
  echo "СЛЕПОТА: план стендов и сверка разошлись в записях derevo (план: ${PLAN:-нет} · сверка: ${DER_SVERKA:-не по местам}) — выбор или реестр сменились за прогон; метку не подтверждаю." >&2; exit 2
fi
SO_SVERKA=$(sed -n 's/^АННОТАЦИЯ ОБЛАСТИ: source_only=\([^;]*\);.*registry_sha256=\([0-9a-f]*\).*/\1\t\2/p' "$VREM/kopii-vypuska")
if [ -n "${PLAN+x}" ] && { [[ "${PLAN:-}" == "ПЛАН: SOURCE_ONLY"* ]] || [ -n "$SO_SVERKA" ]; } && [ "${SO_ID:-}"$'\t'"${SO_REG:-}" != "$SO_SVERKA" ]; then
  echo "СЛЕПОТА: план стендов и сверка разошлись в SOURCE_ONLY (план: ${PLAN:-нет} · сверка: ${SO_SVERKA:-не SOURCE_ONLY}) — выбор или реестр сменились за прогон; метку не подтверждаю." >&2; exit 2
fi


# 🔴 ИТОГ ПО ИМЕНАМ — НЕ «ЧИСТ», А «НЕ ПРОВЕРЯЛОСЬ». Прежде здесь печаталось
# «частные имена: тарбол чист» и три строки из imena.txt. После выключения разряда (14.09)
# файла imena.txt нет вовсе, sed давал ошибку, а строка про «чист» утверждала РЕЗУЛЬТАТ
# проверки, которой не было. Отсутствие проверки, выданное за результат, хуже отказа:
# читающий уносит «чисто» как замер.
echo "частные имена: НЕ ПРОВЕРЯЛИСЬ — разряд выключен распоряжением владельца 06.09 (см. выше)"
# 🔴 СОВЕТ ПРАВЛЕН 07.09.2026. Прежняя строка звала `git push origin <тег>` — то есть
# вела прямо в действие, ЗАПРЕЩЁННОЕ владельцем 06.09 13:50 (ни GitHub, ни npm до беты).
# Ворота отказывали на частных именах и тут же учили нарушению; hook в клоне остановил бы,
# но ложная подсказка В МЕХАНИЗМЕ опаснее ложной в письме — письмо перечитывают, механизм нет.
# Здесь тег ЛОКАЛЬНЫЙ, и это не временная оговорка, а действующее правило.
# B-N-1923: метка — по имени КАТАЛОГА (у 6 пакетов имя ≠ каталогу, B-N-1824); сторож примет и метку по имени пакета.
sled_vorot "$(basename "$KATALOG")-v${VERSIYA}" "${IMYA_P:-$(basename "$KATALOG")}" npm
echo "$GALKA можно ставить ЛОКАЛЬНЫЙ тег (аннотированный; область — в сообщении):"
SCOPE_MSG=$(sed -n 's/^АННОТАЦИЯ ОБЛАСТИ: //p' "$VREM/kopii-vypuska")
# NEP_PRINYATO: довод узкого пропуска входит в КАЖДУЮ подсказку метки — какую ни возьми, он в тексте метки.
SCOPE_MSG="${NEP_OB:+$NEP_OB; }$SCOPE_MSG"
printf '   git tag -a <пакет>-v<версия> -m %q\n' "$SCOPE_MSG"

# B-H-060 (low Вениамина 15:01): объявленный обход должен иметь ЧИТАТЕЛЯ после ворот — довод уходит в
# сообщение АННОТИРОВАННОГО тега, где его видит `git show <тег>`; печать в терминал читателем не является.
if [ -n "${STENDY_INACHE:-}" ]; then
  echo "   ⚠️ стенды НЕ прогнаны — тег ставить АННОТИРОВАННЫЙ, довод в сообщение:"
  printf '   git tag -a <пакет>-v<версия> -m %q\n' "стенды не прогнаны: $STENDY_INACHE; $SCOPE_MSG"
fi
if [ -n "${OZHIDAEMOE:-}" ]; then
  echo "   ⚠️ есть ОЖИДАЕМОЕ (исключения) — тег ставить АННОТИРОВАННЫЙ, перечень в сообщение:"
  # Одинарные кавычки, а не %q: %q экранирует каждый пробел, и перечень в совете нечитаем человеком.
  printf "   git tag -a <пакет>-v<версия> -m '%s'\n" "$(printf '%s' "ожидаемое по исключениям: $(printf '%s' "$OZHIDAEMOE" | tr '\n' ';'); $SCOPE_MSG" | sed "s/'/'\\\\''/g")"
fi
echo "   push НЕ делать: запрет владельца 06.09.2026 13:50, до выхода из альфы в бету."
echo "   Признак выпуска — локальный тег + равенство дерева тега боевому диску."
exit 0
