kopii_vypuska() {  # $1 — режим: sverka | plan
sudo -n python3 - "$KATALOG" "$VREM/raspak/package" "$REESTR_KOPII" "${VYPUSK_KOPII-}" "${VYPUSK_KOPII+x}" "$VERSIYA" "$1" "${VYPUSK_POLKA_DIR-}" "${VYPUSK_POLKA_DIR+x}" "${VYPUSK_AGENTY-/etc/agent-registry/agents.yaml}" <<'PYKOPII'
import sys,json,yaml,hashlib,re,os,io,stat,tarfile,subprocess,pwd
from pathlib import Path
def blind(reason):
    print("СЛЕПОТА: копии выпуска: "+reason);sys.exit(2)
def load(path):
    try:return json.loads(Path(path).read_text())
    except (OSError,ValueError,UnicodeError):blind("не прочитан JSON "+str(path))
tree,packed,registry,scope,scope_set,version,rezhim,polka_dir,polka_set,agents_registry=sys.argv[1:]
tree,packed=Path(tree),Path(packed)
meta=load(packed/"package.json")
if not isinstance(meta,dict):blind("package.json тарбола не объект")
name=meta.get("name")
if not isinstance(name,str) or not name or meta.get("version")!=version:
    blind("идентичность тарбола не совпадает с выпуском")
try:doc=yaml.safe_load(Path(registry).read_text())
except (OSError,ValueError,yaml.YAMLError):blind("не прочитан реестр "+registry)
if not isinstance(doc,dict) or not isinstance(doc.get("plugins"),list):blind("нет списка plugins в "+registry)
# B-N-1893: копии пакета бывают и в services (шлюз подписки: claude-oauth-gateway, claude-oauth-gateway-guest).
# Копия — path, если это абсолютный каталог с package.json (dsh-schedule-guard: path = копия у Петровича, source.address = ИСТОЧНИК,
# дерево Искры). Иначе (шлюзы: path — свободный текст) — source.address при source.type=local-dir (адрес-файл → его каталог).
# Запись services без local-dir или без package.json в каталоге — не копия пакета: в отдельную строку, не в НЕ СУДИМЫ.
svc=doc.get("services",[])
if not isinstance(svc,list):blind("services не список в "+registry)
rows=[("plugins",r) for r in doc["plugins"]]+[("services",r) for r in svc]
if len(rows)>4096:blind("реестр превышает 4096 записей plugins+services")
all_ids={}; where={}; sect_of={}
known=[]; unjudged=[]; foreign=[]; svc_net=[]
for sect,row in rows:
    if not isinstance(row,dict):blind("не объект в "+sect)
    ident=row.get("id")
    if not isinstance(ident,str) or not re.fullmatch(r"[A-Za-z0-9_.-]+",ident) or ident in all_ids:blind("пустой или повторный id в реестре")
    all_ids[ident]=row; sect_of[ident]=sect
    pth=row.get("path")
    if sect=="plugins":location=pth
    elif isinstance(pth,str) and Path(pth).is_absolute() and not any(c in pth for c in "\0\t\n") and (Path(pth)/"package.json").is_file():
        location=pth
    else:
        src=row.get("source")
        if not isinstance(src,dict) or src.get("type")!="local-dir" or not isinstance(src.get("address"),str) or not Path(src["address"]).is_absolute():
            svc_net.append(ident);continue
        if any(c in src["address"] for c in "\0\t\n"):blind("небезопасный source.address у "+ident)
        try:location=str(Path(src["address"]) if Path(src["address"]).is_dir() else Path(src["address"]).parent)
        except OSError:blind("путь не читается "+ident+" → "+src["address"])
    where[ident]=location
    if not isinstance(location,str) or not Path(location).is_absolute():
        unjudged.append(ident+" → "+str(location)+" (не абсолютный path)");continue
    if any(c in location for c in "\0\t\n"):blind("небезопасный path у "+ident)
    root=Path(location)
    try:
        (root/"package.json").stat()
    except (FileNotFoundError,NotADirectoryError):
        if sect=="services":svc_net.append(ident);continue
        unjudged.append(ident+" → "+location+" (нет package.json)");continue
    except OSError:blind("путь не читается "+ident+" → "+location)
    copy=load(root/"package.json")
    if not isinstance(copy,dict) or not isinstance(copy.get("name"),str) or not copy["name"]:
        blind("package.json без имени объекта "+ident+" → "+location)
    if copy["name"]==name:known.append(ident)
    else:foreign.append(ident+" ("+copy["name"]+")")
print("НЕ СУДИМЫ: "+str(len(unjudged))+"; "+("; ".join(unjudged) if unjudged else "нет"))
print("ВНЕ СЕМЬИ "+name+": "+(", ".join(foreign) if foreign else "нет"))
print("SERVICES НЕ КОПИИ ПАКЕТА (не local-dir или без package.json): "+str(len(svc_net)))
if scope_set:
    if not scope:blind("VYPUSK_KOPII задан пустым")
    declared=load(scope)
    if not isinstance(declared,dict) or set(declared)!={"package","version","copies"}:
        blind("scope должен содержать только package/version/copies")
    if declared["package"]!=name or declared["version"]!=version:blind("scope относится к другому пакету/номеру")
    selected=declared["copies"]
    if not isinstance(selected,list) or not selected or any(not isinstance(i,str) or not i for i in selected) or len(set(selected))!=len(selected):
        blind("пустой, повторный или неверный список copies")
    print("ПЕРЕЧЕНЬ КОПИЙ ВЫПУСКА: "+scope+" SHA256="+hashlib.sha256(Path(scope).read_bytes()).hexdigest())
else:selected=known
# B-N-2030 (14.10.2026, Аврора; замысел Гаммы 51aa233e, MED Вениамина 00:4xZ): SOURCE_ONLY — пакет, чья ЕДИНСТВЕННАЯ запись указывает на
# сам каталог выпуска (dsh-pamyat-vyvoz: зовут рукой, в бою не живёт). Сверка с собой по-прежнему ничего не доказывает (B-N-1893, отказ
# ниже не снят); вместо неё — заранее уложенный архив полки, чья сумма ЗАКРЕПЛЕНА в записи реестра принимавшим (поле polka:
# {version, sha256}) ДО ворот. Роль — только точная: имя в ЗАКРЫТОМ перечне (пополнение — правкой ворот через П7), VYPUSK_KOPII не задан,
# запись plugins с id = имени пакета, path и source.address (local-dir) — сам каталог выпуска. Иначе — прежняя СЛЕПОТА «сам каталог».
# Источник копией не считается: настоящие копии семьи сверяются обычным ходом, источник называется отдельно.
SOURCE_ONLY={"dsh-pamyat-vyvoz"}
istochnik=None
if not scope_set and name in SOURCE_ONLY:
    sam=[i for i in selected if Path(where[i]).resolve()==tree.resolve()]
    if len(sam)==1:
        i=sam[0];row=all_ids[i];src=row.get("source")
        if (i==name and sect_of[i]=="plugins" and isinstance(row.get("path"),str) and Path(row["path"]).resolve()==tree.resolve()
                and isinstance(src,dict) and src.get("type")=="local-dir" and isinstance(src.get("address"),str)
                and Path(src["address"]).resolve()==tree.resolve()):
            istochnik=i;selected=[x for x in selected if x!=i]
            print("ИСТОЧНИК (не копия): "+i+" → "+str(tree)+" — сверка с собой не делается")
def arhiv_polki(vid,zakreplena=None):
    # A-N-1975 (метапакет) и B-N-2030 (SOURCE_ONLY): архив полки — один дескриптор, члены в памяти, сверка с тарболом ворот в обе стороны.
    # zakreplena — сумма, закреплённая принимавшим до ворот: ≠ — ОТКАЗ (архив не тот, что принят, даже при равном составе).
    # Возврат None — ОТКАЗ уже напечатан (код 1 у зовущего); иначе (архив, sha256, члены, тарбол).
    if polka_set and not polka_dir:blind("VYPUSK_POLKA_DIR задан пустым")
    polka=polka_dir if polka_set else "/opt/agent-plugins-tarbally"
    arh=os.path.join(polka,name+"-"+version+".tgz")
    try:fd=os.open(arh,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    except FileNotFoundError:blind(vid+" "+name+": архива полки нет: "+arh)
    except OSError as e:blind(vid+" "+name+": архив полки не открыт без перехода по ссылке ("+(e.strerror or str(e))+"): "+arh)
    with os.fdopen(fd,"rb") as f:
        st=os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):blind(vid+" "+name+": архив полки не обычный файл: "+arh)
        if st.st_uid!=0:blind(vid+" "+name+": хозяин архива полки не root (uid "+str(st.st_uid)+"): "+arh)
        if st.st_mode&(stat.S_IWGRP|stat.S_IWOTH):blind(vid+" "+name+": архив полки пишется группой или прочими ("+oct(stat.S_IMODE(st.st_mode))+"): "+arh)
        if st.st_size>256*1024*1024:blind(vid+" "+name+": архив полки больше 256 МБ: "+arh)
        data=f.read()
    sha=hashlib.sha256(data).hexdigest()
    if zakreplena is not None and sha!=zakreplena:
        print("ОТКАЗ: "+vid+" "+name+": архив полки "+arh+" SHA256="+sha+" ≠ закреплённой в реестре "+zakreplena+" — это не принятый архив (переупакован или подменён)");return None
    chleny={};opasnye=[]
    try:
        with tarfile.open(fileobj=io.BytesIO(data),mode="r:gz") as t:
            for m in t:
                n=m.name;c=n.split("/")
                if n.startswith("/"):opasnye.append(n+" — абсолютный путь");continue
                if ".." in c:opasnye.append(n+" — «..» в пути");continue
                if m.issym():opasnye.append(n+" — символьная ссылка → "+m.linkname);continue
                if m.islnk():opasnye.append(n+" — жёсткая ссылка → "+m.linkname);continue
                if m.isdir():continue
                if not m.isfile():opasnye.append(n+" — не обычный файл (тип "+repr(m.type)+")");continue
                c=[x for x in c if x not in ("",".")]
                if len(c)<2 or c[0]!="package":opasnye.append(n+" — вне каталога package/");continue
                rel="/".join(c[1:])
                if rel in chleny:opasnye.append(n+" — повтор члена");continue
                if len(chleny)>=16384:blind(vid+" "+name+": в архиве полки больше 16384 файлов")
                chleny[rel]=t.extractfile(m).read()
    except (tarfile.TarError,EOFError,OSError) as e:blind(vid+" "+name+": архив полки не читается ("+str(e)[:120]+"): "+arh)
    if opasnye:
        print("ОТКАЗ: "+vid+" "+name+": в архиве полки "+arh+" члены не «обычный файл/каталог»: "+"; ".join(opasnye[:20])+(" …ещё "+str(len(opasnye)-20) if len(opasnye)>20 else ""));return None
    tar_rel={str(p.relative_to(packed)):p for p in packed.rglob("*") if p.is_file()}
    if not tar_rel:blind("пустой состав тарбола ворот")
    lishnie=sorted(set(chleny)-set(tar_rel));net=sorted(set(tar_rel)-set(chleny))
    raz=sorted(r for r in set(chleny)&set(tar_rel) if chleny[r]!=tar_rel[r].read_bytes())
    if lishnie or net or raz:
        print("ОТКАЗ: "+vid+" "+name+": архив полки "+arh+" ≠ тарболу ворот: "+"; ".join(x for x in (
            ("различаются: "+", ".join(raz[:20])) if raz else "",("лишние в архиве: "+", ".join(lishnie[:20])) if lishnie else "",
            ("нет в архиве: "+", ".join(net[:20])) if net else "") if x));return None
    return arh,sha,chleny,tar_rel
