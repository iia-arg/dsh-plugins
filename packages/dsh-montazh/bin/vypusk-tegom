if [ "$KOD" -ne 0 ]; then
  echo "🔴 ОТКАЗ: в ТАРБОЛЕ найдены частные имена — тег не ставим." >&2
  sed -n '/^---/,$p' "$VREM/imena.txt" >&2
  exit 1
