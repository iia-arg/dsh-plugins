# B-N-2121 (dsh-montazh 3.1.43, Заря; замысел ГОДЕН Вениамина 15:45 МСК 18.10): ОБЩАЯ копия — код одной копии исполняют службы
#   многих учёток (/opt/claude-oauth: 16 служб, 14 учёток), «ровно одна привязка к дому агента» невыполнима по устройству. Признак —
#   ЯВНОЕ поле записи реестра копии  obshchaya: {uchetka: <владелец корня, не root>, yunity: [образцы имён служб], ne_ispolnyayut: [точные имена]}  (как polka у
#   SOURCE_ONLY: кладёт принимавший, правка реестра — через pravka). Проверки живьём, каждая — именованная СЛЕПОТА:
#   · uchetka существует, ≠ root, ВЛАДЕЕТ корнем копии, у корня нет доступа прочим;
#   · «пользователи кода» корня ищутся двумя способами разной природы: (1) все Exec* КАЖДОЙ загруженной службы (systemctl show — уже
#     с drop-in: claude-oauth-gateway@varvara, 95-gost.conf, по шаблону — /opt/claude-oauth, на деле — гостевая копия) — довод-путь в корне («node <корень>/…», «/usr/bin/env node <корень>/…»), либо файл-обёртка ВНЕ корня (довод или path,
#     обычный текстовый файл до 1 МиБ без NUL), чей текст называет корень; (2) живые процессы /proc: довод cmdline или exe в корне
#     (относительный довод — от cwd процесса, только если файл есть) → служба по cgroup; процесс вне службы — СЛЕПОТА;
#   · каждый пользователь обязан попасть под образец yunity, каждый образец — под ≥1 пользователя; пользователей 0 — СЛЕПОТА, не «0»;
#   · поле obshchaya вместе с привязкой к дому агента — СЛЕПОТА «двойная привязка».
#   НЕ ЛОВИТ: обёртку-бинарник или обёртку, вычисляющую путь (не называющую корень текстом), если её служба сейчас не запущена
#   (живой процесс способ (2) находит); пользователя кода вне systemd без живого процесса; поведение каждого экземпляра в его среде.
EXEC=("ExecCondition","ExecStartPre","ExecStart","ExecStartPost","ExecReload","ExecStop","ExecStopPost")   # все команды службы, уже с drop-in
def polzovateli_koda(root):
    """→ ({служба: [способы]}, {служба: User}, [процессы вне служб])."""
    rr=root.resolve();naideno={};kto={};vne=[]
    def v_korne(t,cwd=None):   # довод процесса бывает любым текстом (python3 -c '<код>'): ENAMETOOLONG и пр. — «не путь корня», не падение
        if not t:return False
        try:
            if not t.startswith("/"):
                if not cwd:return False
                q=Path(cwd)/t
                if not q.is_file():return False
                t=str(q)
            return Path(t).resolve().is_relative_to(rr)
        except (OSError,RuntimeError,ValueError):return False
    def obertka(t):
        if not t.startswith("/") or v_korne(t):return False
        try:
            q=Path(t)
            if not q.is_file() or q.stat().st_size>1048576:return False
            b=q.read_bytes()
        except OSError:return False
        if b"\0" in b[:4096]:return False
        return str(rr).encode() in b or str(root).encode() in b
    def dobav(u,how):naideno.setdefault(u,[]);naideno[u].count(how) or naideno[u].append(how)
    try:lu=subprocess.run(["systemctl","list-units","--type=service","--all","--plain","--no-legend","--no-pager"],capture_output=True,text=True,timeout=15,check=True).stdout
    except (OSError,subprocess.SubprocessError):blind("общая копия: перечень служб не прочитан (systemctl list-units)")
    units=sorted({l.split()[0] for l in lu.splitlines() if l.split() and l.split()[0].endswith(".service")})
    if not units or len(units)>4096:blind("общая копия: служб "+str(len(units))+" — перечень пуст или больше 4096")
    for i in range(0,len(units),200):
        try:out=subprocess.run(["systemctl","show","-p","Id","-p","User",*[x for e in EXEC for x in ("-p",e)],"--no-pager","--",*units[i:i+200]],capture_output=True,text=True,timeout=60,check=True).stdout
        except (OSError,subprocess.SubprocessError):blind("общая копия: ExecStart служб не прочитан (systemctl show)")
        for blok in out.split("\n\n"):
            pole={};ex=[]
            for l in blok.splitlines():
                k,_,v=l.partition("=")
                if k in EXEC:ex.append((k,v))
                else:pole[k]=v
            u=pole.get("Id","")
            if not u:continue
            kto[u]=pole.get("User") or "root"
            for k,v in ex:
                for prog,argv in re.findall(r"path=(\S+) ; argv\[\]=(.*?) ; ignore_errors=",v):
                    toks=[prog]+argv.split(" ")
                    for t in toks:
                        if v_korne(t):dobav(u,k+": "+t)
                        elif obertka(t):dobav(u,k+": обёртка "+t)
    for d in Path("/proc").iterdir():
        if not d.name.isdigit():continue
        try:
            args=[x.decode("utf-8","replace") for x in (d/"cmdline").read_bytes().split(b"\0") if x]
            cwd=os.readlink(d/"cwd")
            try:exe=os.readlink(d/"exe")
            except OSError:exe=""
            cg=(d/"cgroup").read_text()
        except (OSError,ValueError):continue
        if not (any(v_korne(t,cwd) for t in args) or v_korne(exe.removesuffix(" (deleted)"))):continue
        if str(os.getpid())==d.name:continue
        sl=[c for c in cg.strip().split("/") if c.endswith(".service")]
        if sl:dobav(sl[-1],"процесс "+d.name)
        else:vne.append(d.name+" ("+cg.strip().split("::")[-1][:80]+")")
    return naideno,kto,vne
def obshchaya_plan(ident,root,row):
    ob=row.get("obshchaya")
    if not isinstance(ob,dict) or not {"uchetka","yunity"}<=set(ob)<={"uchetka","yunity","ne_ispolnyayut"}:
        blind("копия "+ident+": поле obshchaya кривое — нужны uchetka и yunity, необязательно ne_ispolnyayut, других ключей нет")
    akt,obr,neisp=ob["uchetka"],ob["yunity"],ob.get("ne_ispolnyayut",[])
    if not isinstance(neisp,list) or len(neisp)>32 or any(not isinstance(x,str) or not re.fullmatch(r"[A-Za-z0-9_@.:-]+\.service",x) for x in neisp) or len(set(neisp))!=len(neisp):
        blind("копия "+ident+": obshchaya.ne_ispolnyayut — список ТОЧНЫХ имён служб (без образцов), без повторов, до 32")
    if not isinstance(akt,str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*",akt):blind("копия "+ident+": obshchaya.uchetka негодна")
    if not isinstance(obr,list) or not obr or len(obr)>32 or any(not isinstance(x,str) or not re.fullmatch(r"[A-Za-z0-9_@.*:-]+\.service",x) for x in obr) or len(set(obr))!=len(obr):
        blind("копия "+ident+": obshchaya.yunity — непустой список образцов «*.service» без пробелов и повторов, до 32")
    if re.search(r"\s",str(root)):blind("копия "+ident+": пробел в корне общей копии")
    try:pw=pwd.getpwnam(akt);st=root.stat()
    except (KeyError,OSError):blind("копия "+ident+": учётка "+akt+" или корень "+str(root)+" не читается")
    if pw.pw_uid==0 or akt=="root":blind("копия "+ident+": obshchaya.uchetka = root — стенды общей копии под root не гоняются (только строкой обходчика @root)")
    if st.st_uid!=pw.pw_uid:blind("копия "+ident+": корень "+str(root)+" принадлежит uid "+str(st.st_uid)+", а не "+akt+" ("+str(pw.pw_uid)+")")
    if st.st_mode&0o007:blind("копия "+ident+": у корня "+str(root)+" есть доступ прочим ("+oct(st.st_mode&0o777)+")")
    import fnmatch
    try:naideno,kto,vne=polzovateli_koda(root)
    except Exception as e:blind("копия "+ident+": живой поиск пользователей кода упал — "+type(e).__name__+": "+str(e)[:200])
    if vne:blind("копия "+ident+": код корня исполняет процесс вне службы — "+", ".join(vne[:5]))
    if not naideno:blind("копия "+ident+": ни одна служба не исполняет код корня "+str(root)+" (ни ExecStart, ни обёртка, ни живой процесс) — общая копия без пользователей")
    # Текстовый признак обёртки («файл называет корень») шире исполнения: сторож, читающий каталог, или комментарий тоже называют корень
    #   (замер 18.10: 7 таких служб у /opt/claude-oauth). Их принимающий называет поимённо в ne_ispolnyayut; служба, найденная СТРОГИМ
    #   способом (путь в Exec* или живой процесс), объявлением «не исполняет» не перекрывается.
    strogo=lambda u:any(": обёртка " not in m for m in naideno[u])
    neisp_strogie=sorted(u for u in naideno if u in neisp and strogo(u))
    if neisp_strogie:blind("копия "+ident+": объявлена неисполняющей, а исполняет код корня: "+"; ".join(u+" ["+", ".join(naideno[u][:2])+"]" for u in neisp_strogie))
    vne_obr=sorted(u for u in naideno if u not in neisp and not any(fnmatch.fnmatchcase(u,x) for x in obr))
    if vne_obr:blind("копия "+ident+": неучтённый пользователь кода (вне yunity и ne_ispolnyayut): "+"; ".join(u+" ["+", ".join(naideno[u][:2])+"]" for u in vne_obr[:10]))
    pustye=[x for x in obr if not any(fnmatch.fnmatchcase(u,x) for u in naideno if u not in neisp)]+[x for x in neisp if x not in naideno]
    if pustye:blind("копия "+ident+": объявление отстало — не найден ни один пользователь по: "+", ".join(pustye))
    isp=sorted(u for u in naideno if u not in neisp);uch=sorted({kto.get(u,"?") for u in isp})
    print("ОБЩАЯ КОПИЯ "+ident+" → "+str(root)+": учётка стендов "+akt+"; исполняют код "+str(len(isp))+" служб от "+str(len(uch))+" учёток: "
          +"; ".join(u+"("+kto.get(u,"?")+") ["+", ".join(naideno[u][:2])+"]" for u in isp)
          +(" · называют корень, не исполняют (объявлено): "+", ".join(sorted(u for u in naideno if u in neisp)) if neisp else ""))
    return akt
if rezhim=="plan":
    if scope_set:
        # B-N-2019: владелец кода не User агента. Связь — зарегистрированный дом и загруженный юнит.
        try:agents=yaml.safe_load(Path(agents_registry).read_text())
        except (OSError,ValueError,yaml.YAMLError):blind("не прочитан реестр агентов "+agents_registry)
        if not isinstance(agents,dict) or not isinstance(agents.get("agenty"),list):blind("нет списка agenty в "+agents_registry)
        if len(agents["agenty"])>256:blind("реестр агентов превышает 256 записей")
        for ident,root in targets:
            matches=[]
            for agent in agents["agenty"]:
                intent=agent.get("namerenie") if isinstance(agent,dict) else None
                home=intent.get("dom") if isinstance(intent,dict) else None
                if not isinstance(home,str) or not home.startswith("/") or home=="/" or re.search(r"\s|\x00",home):blind("небезопасный dom в реестре агентов")
                if root.resolve().is_relative_to(Path(home).resolve()):matches.append(intent)
            row=all_ids[ident]
            if "obshchaya" in row:
                if matches:blind("копия "+ident+" → "+str(root)+": двойная привязка — поле obshchaya и дом агента ("+str(len(matches))+")")
                akt=obshchaya_plan(ident,root,row)
                print("ПЛАН: KOPIYA\t"+ident+"\t"+str(root)+"\t"+akt+"\t"+str(root)+"\tobshchaya");continue
            if len(matches)!=1:blind("копия "+ident+" → "+str(root)+": привязок к дому агента "+str(len(matches))+", нужна одна")
            intent=matches[0];actor=intent.get("polzovatel");unit=intent.get("sluzhba")
            if not isinstance(actor,str) or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*",actor):blind("копия "+ident+": не задан polzovatel")
            if not isinstance(unit,str) or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.@-]*\.service",unit):blind("копия "+ident+": не задан sluzhba")
            try:
                pwd.getpwnam(actor)
                reply=subprocess.run(["systemctl","show",unit,"-p","LoadState","-p","User","--no-pager"],capture_output=True,text=True,timeout=5,check=True)
            except (KeyError,OSError,subprocess.SubprocessError):blind("копия "+ident+": учётка/юнит не читается "+actor+" "+unit)
            properties=dict(line.split("=",1) for line in reply.stdout.splitlines() if "=" in line)
            if properties.get("LoadState")!="loaded" or properties.get("User")!=actor:blind("копия "+ident+": User юнита "+unit+" не совпал с polzovatel "+actor)
            app=str(Path(intent["dom"])/"app")
            print("ПЛАН: KOPIYA\t"+ident+"\t"+str(root)+"\t"+actor+"\t"+app)
    else:print("ПЛАН: OBYCHNO")
    sys.exit(0)
print("ОБЛАСТЬ ВЫПУСКА: "+name+" "+version+"; выбранные id: "+", ".join(selected))
excluded=[i for i in known if i not in selected and i!=istochnik]   # B-N-2030: источник — не копия, назван строкой «ИСТОЧНИК»
print("ВНЕ ЭТОГО ВЫПУСКА (явный subset): "+(", ".join(excluded) if excluded else "нет"))
for ident,root in targets:
    differences=[]
    try:
        for source in tar_files:
            rel=source.relative_to(packed)
            target=root/rel
            if not target.is_file() or source.read_bytes()!=target.read_bytes():differences.append(str(rel))
        deployed_stands=stands(root)
        for rel in tree_stands:
            target=root/rel
            if not target.is_file() or (tree/rel).read_bytes()!=target.read_bytes():differences.append(rel)
        differences.extend(sorted(deployed_stands-tree_stands))
    except OSError:blind("копия не читается "+ident+" → "+str(root))
    if differences:
        print("ОТКАЗ: выпуск ≠ копия "+ident+" → "+str(root)+": "+", ".join(sorted(set(differences))))
        sys.exit(1)
    print("КОПИЯ ВЫПУСКА СВЕРЕНА: "+ident+" → "+str(root))
print("СВЕРКА КОПИЙ: "+str(len(targets))+" из "+str(len(selected))+"; это байты, не поведение всех сред")
print("АННОТАЦИЯ ОБЛАСТИ: copies="+",".join(selected)+"; registry_sha256="+hashlib.sha256(Path(registry).read_bytes()).hexdigest()+("; scope_sha256="+hashlib.sha256(Path(scope).read_bytes()).hexdigest() if scope_set else ""))
PYKOPII
}

