#!/bin/bash
# ВЫПУСК ТЕГОМ. Искра, 06.09.2026.
#
# ⚠️ ШАПКА ПРИВЕДЕНА К КОДУ 14.09.2026. Разряд частных имён ВЫКЛЮЧЕН (отменён
# распоряжением владельца 06.09 17:55). Прибор частные имена НЕ ПРОВЕРЯЕТ.
# Прежняя первая строка обещала «с воротами на частные имена» — читающий шапку и
# читающий код получали ПРОТИВОПОЛОЖНЫЙ ответ на вопрос «проверяет ли». История
# разряда ниже сохранена намеренно: она объясняет тело под `if false`.
#
# 🔴 ЗАЧЕМ. По решению владельца 05.09.2026 12:10Z выпуск = коммит + тег на origin;
# в npm — только по вехам. Проба частных имён при этом стояла ТОЛЬКО внутри обёртки
# публикации, то есть на пути, по которому больше не ходят. Замер 06.09 09:0xZ: на
# ПУБЛИЧНОМ master 7 пакетов, 32 вхождения. Путь тегом не был закрыт никогда, а стал
# единственным. Здесь он закрывается отказом с кодом, а не памяткой.
#
# ЧТО ДЕЛАЕТ: гонит пробу частных имён по ТОМУ, ЧТО ПОЕДЕТ (тарбол npm pack, а не
# каталог: каталог содержит node_modules и мусор, тарбол — состав), и при находке
# отказывает ДО коммита. Ни git add, ни tag, ни push не выполняются.
#
# ЧЕГО НЕ ЛОВИТ — назвать обязан, иначе молчание прочтут как «чисто»:
#   · частное имя, которого нет в списке основ (/usr/local/share/chastnye-osnovy.txt);
#   · частные имена, УЖЕ лежащие в истории репозитория — смотрит только предмет сейчас;
#   · равенство дерева тега предмету — это признак выпуска, его снимает приёмка;
#   · принятость. Здесь её нет вовсе.
# ЧТО ЗНАЧИТ ЕГО МОЛЧАНИЕ: «в тарболе не нашлось основ ИЗ СПИСКА», не «чисто вообще».
# РЕЖИМ ДЕРЕВА (B-N-1774): каталог без package.json, но с CHANGELOG.md — служебный пакет дерева; см. ветку ниже.
set -u
KATALOG="${1:-}"
[ "$#" -eq 1 ] || { echo "ОТКАЗ: нужен ровно один каталог; неизвестные параметры не допускаются." >&2; exit 2; }
# A-N-1975 (условие Вениамина 3): подмена полки метапакета (VYPUSK_POLKA_DIR) — только стенду и только с подставным журналом
# (VYPUSK_ZHURNAL_DIR). При боевом журнале по подменённой полке лёг бы боевой след, и сторож меток принял бы метку.
if [ -n "${VYPUSK_POLKA_DIR+x}" ] && [ -z "${VYPUSK_ZHURNAL_DIR:-}" ]; then
  echo "ОТКАЗ: VYPUSK_POLKA_DIR задан без VYPUSK_ZHURNAL_DIR — подмена полки при боевом журнале не допускается; ничего не сверено, следа нет." >&2; exit 2
fi
# Условие Вениамина к A-N-1975 (11:2xZ): явный VYPUSK_ZHURNAL_DIR, ведущий в боевой журнал (= ZHURNAL_DIR помощника zhurnal-zapis), — тот же отказ.
BOEVOJ_ZHURNAL_DIR=/var/lib/vypusk-tegom
if [ -n "${VYPUSK_AGENTY+x}" ]; then
  if [ -z "$VYPUSK_AGENTY" ] || [ -z "${VYPUSK_ZHURNAL_DIR:-}" ] || [ "$(realpath -m -- "$VYPUSK_ZHURNAL_DIR")" = "$BOEVOJ_ZHURNAL_DIR" ]; then
    echo "ОТКАЗ: VYPUSK_AGENTY — подмена реестра агентов только с отдельным VYPUSK_ZHURNAL_DIR; следа нет." >&2; exit 2
  fi
  echo "⚠️ ПОДМЕНА реестра агентов: $VYPUSK_AGENTY (подставной журнал)"
fi
if [ -n "${VYPUSK_POLKA_DIR+x}" ] && [ -n "${VYPUSK_ZHURNAL_DIR:-}" ] && [ "$(realpath -m -- "$VYPUSK_ZHURNAL_DIR")" = "$(realpath -m -- "$BOEVOJ_ZHURNAL_DIR")" ]; then
  echo "ОТКАЗ: VYPUSK_ZHURNAL_DIR=$VYPUSK_ZHURNAL_DIR — боевой журнал $BOEVOJ_ZHURNAL_DIR; подмена полки при боевом журнале не допускается; ничего не сверено, следа нет." >&2; exit 2
fi
# B-N-1774 (2): служебные пакеты дерева (dsh-limity, dsh-obhod-stendov… — 13 шт.) без package.json — РЕЖИМ ДЕРЕВА:
# имя = имя каталога, версия = верхний заголовок CHANGELOG, состав и бой — запись реестра с derevo.subdir этого каталога
# (VYPUSK_REESTR — реестр-кандидат; по умолчанию боевой). npm pack и обходчик по имени из package.json здесь неприменимы.
# B-N-2030/2033: план стендов и его поля — только свои, из окружения зовущего не наследуются (сверка плана со сверкой ниже).
unset PLAN SO_ID SO_REG DER_IDS DER_REG
REZHIM=npm
[ -n "$KATALOG" ] && [ -d "$KATALOG" ] && [ ! -f "$KATALOG/package.json" ] && [ -f "$KATALOG/CHANGELOG.md" ] && REZHIM=derevo
if [ -z "$KATALOG" ] || { [ "$REZHIM" = npm ] && [ ! -f "$KATALOG/package.json" ]; }; then
  echo "использование: vypusk-tegom <каталог пакета>  (пакет npm — с package.json; пакет дерева — без него, с CHANGELOG.md)" >&2
  echo "  ставит ЛОКАЛЬНЫЙ тег на выпуск. Разряд частных имён ВЫКЛЮЧЕН" >&2
  echo "  (отменён распоряжением владельца 06.09) — имена НЕ проверяются." >&2
  exit 2
fi
# B-N-779: путь — в АБСОЛЮТНЫЙ до первого require. Относительный без «./» (vypusk-tegom pkg) require
# читает как ИМЯ модуля и ищет в node_modules: имя пакета не прочитано → СЛЕПОТА на исправном пакете.
# B-N-784 (low Вениамина): CDPATH= — иначе «cd p» уходит в одноимённый каталог из CDPATH и печатает путь в stdout
# (KATALOG стал бы двумя строками); «--» — иначе каталог с именем на «-» читается как ключ cd.
KATALOG=$(CDPATH= cd -- "$KATALOG" && pwd -P) || { echo "СЛЕПОТА: каталог пакета не открылся: ${1}" >&2; exit 2; }
# A-N-1948 шаг 0 (решение Забавы Р2, 09.10): прежние имена пакета — поле package.json "dsh":{"prezhnie_imena":[…]}.
# Читатель — рубеж прежней метки ниже: после переименования каталога/имени свежие метки лежат под прежним префиксом.
# Поле необязательно; кривое (не список, не строки, имя не [A-Za-z0-9._-], больше 16) — СЛЕПОТА, а не молчаливое «прежних нет».
# Ключ dsh принадлежит и платформе (dsh.bundle, dsh.profile) — читаем только prezhnie_imena, прочее не судим.
PREZHNIE=""
if [ "$REZHIM" = npm ]; then
  PREZHNIE=$(node -e 'const m=require(require("path").resolve(process.argv[1]));
if(m.dsh===undefined||(m.dsh&&typeof m.dsh==="object"&&!Array.isArray(m.dsh)&&m.dsh.prezhnie_imena===undefined))process.exit(0);
const p=m.dsh&&typeof m.dsh==="object"&&!Array.isArray(m.dsh)?m.dsh.prezhnie_imena:null;
if(!Array.isArray(p)||p.length>16||p.some(x=>typeof x!=="string"||!/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(x)))process.exit(3);
console.log(p.join("\n"));' "$KATALOG/package.json" 2>/dev/null) \
  || { echo "СЛЕПОТА: поле dsh.prezhnie_imena в $KATALOG/package.json не прочитано или кривое (нужен список имён [A-Za-z0-9._-], не больше 16)." >&2; exit 2; }
fi
PROBA=/usr/local/bin/proba-chastnyh-imen
# №5 аудита A-N-1948 (10.10.2026, Заря; слово владельца 09.10 18:33 «имена — не находка, только секреты»): ОБЯЗАТЕЛЬНОСТЬ
# пробы частных имён в воротах СНЯТА. Сам разряд выключен ещё 06.09 (тело ниже под `if false`), а живыми оставались наличие
# прибора и его --kontrol — контроль зрячести выключенной проверки: он ничего не мерил, но слепил ворота на любой машине без
# /usr/local/share/chastnye-osnovy.txt с основами sadik. Прибор остаётся в пакете РУЧНЫМ. Вернут разряд — вернуть и эти две
# проверки (контроль ДО предмета: проба, молчащая по поломке, неотличима от молчащей по чистоте — порядок куплен 06.09).
# ═══ ОСТАТКИ ПРИБОРОВ В КАТАЛОГЕ ПАКЕТА (правка 06.09.2026, куплена делом) ═══════════
# 🔴 Прибор обёрток кладёт свои копии рядом со стендом и убирает их на выходе и на
# обрыве — но не переживает SIGKILL, и это у него честно названо. Названной границы
# мало: остаток `.obyortka-porcha-<pid>.mjs` пережил убитый по таймауту прогон и
# попал в `git add`, то есть уехал бы в ТЕГ. Тарбол его не берёт (точечные файлы), а
# дерево берёт — значит проверка тарбола этот путь не закрывает по построению.
# Здесь отказ, а не уборка: снести чужой файл молча значило бы стереть след того,
# что прибор оборвали, — и в следующий раз никто бы об этом не узнал.
OSTATKI=$(find "$KATALOG" -name '.obyortka-*' -not -path '*/node_modules/*' 2>/dev/null)
if [ -n "$OSTATKI" ]; then
  echo "🔴 ОТКАЗ: в каталоге пакета лежат остатки приборов — тег не ставим." >&2
  echo "$OSTATKI" | sed 's/^/   /' >&2
  echo "   Тарбол их не берёт, а дерево берёт: уехали бы в тег и в историю." >&2
  echo "   Уберите руками и повторите — уборка здесь НЕ делается намеренно, чтобы" >&2
  echo "   след оборванного прогона не пропал." >&2
  exit 1
fi
# ═══ ЗАГОЛОВОК ВЫПУСКА В CHANGELOG (B-N-1038, 26.09.2026, Искра) ═══════════════════════
# 🔴 Метка ставится на ВЫПУЩЕННОЕ: верхний заголовок CHANGELOG обязан нести версию из
# package.json и не нести «не выпущено». Пометку снимает рука отдельным коммитом
# («релизный заголовок») ПЕРЕД меткой — и 26.09 в 04:38Z рука промахнулась: метка
# subscription-gateway-v0.4.10 встала на коммит с «(не выпущено …)», ворота молчали.
# B-N-1204 (30.09.2026, Аврора): и пометку «номер — при монтаже» / «кандидат к …» — заголовок кандидата, номер которому
# дадут при монтаже (0.4.14 шлюза ушёл в метку с «кандидат к обновлению DSH, номер — при монтаже»). Образец проверен
# и под LC_ALL=C, и под C.UTF-8 (B-N-1204 proba-lokal.out).
# ЧЕГО НЕ ЛОВИТ: неверную дату и содержание записи; пометку, написанную иначе, чем
# «не выпущен…», «номер — при монтаже», «кандидат к »; слово «кандидат» само по себе (законно в выпущенных: «кандидат Авроры»); старые метки — они история, эти ворота смотрят только предмет сейчас.
# Версия — через python3, не node: node уже читает имя пакета ниже, и его отказ обязан дойти до своей
# слепоты «имя пакета не прочитано» (П19 стенда ворот), а не до этой (откат 12:10Z, B-N-1038).
# B-N-2029 (14.10.2026, Аврора; замысел Гаммы 51aa233e): номер — ОДИН образец на оба места (дерево и верх CHANGELOG). Дефис ASCII
# допустим внутри идентификатора pre-release и в его конце (SemVer 2.0.0 п.9: «1.3.0-b2027-notices2», «1.3.0-x-y-z.--»); прежний
# образец обрывался на втором дефисе, и законный номер получал отказ хвоста. Кириллица в номер не входит (LC_ALL=C — набор байтов, не
# локали): «1.0.9-кандидат» по-прежнему даёт номер 1.0.9 и хвост «-кандидат» → отказ B-N-1774. «+build» не поддержан (как и прежде).
OBRAZEC_VERSII='[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]*[0-9A-Za-z-])?'
if [ "$REZHIM" = derevo ]; then
  # Версии вне CHANGELOG у пакета дерева нет: её и берём, заголовок ниже проверяется на «не выпущено» тем же правилом.
  VERSIYA=$(grep -m1 -E '^## ' "$KATALOG/CHANGELOG.md" | LC_ALL=C grep -oE "$OBRAZEC_VERSII" | head -1)
else
VERSIYA=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$KATALOG/package.json" 2>/dev/null) || VERSIYA=
fi
if [ -z "$VERSIYA" ]; then
  echo "СЛЕПОТА: версия не прочитана (${REZHIM}: $([ "$REZHIM" = derevo ] && echo 'верхний заголовок CHANGELOG' || echo package.json)) — заголовок выпуска сверить не с чем." >&2
  exit 2
fi
if [ ! -f "$KATALOG/CHANGELOG.md" ]; then
  echo "🔴 ОТКАЗ: в пакете нет CHANGELOG.md — выпуск $VERSIYA нигде не записан." >&2
  exit 1
fi
VERH=$(grep -m1 -E '^## ' "$KATALOG/CHANGELOG.md")
VERH_VERSIYA=$(printf '%s' "$VERH" | LC_ALL=C grep -oE "$OBRAZEC_VERSII" | head -1)
# B-N-1774, условие Вениамина 01:10Z (med): образец версии обрывается на первом не-латинском знаке, и «## 1.0.9-кандидат r20»
# (заголовок dsh-limity этой ночи) давал версию «1.0.9» — отсев «не выпущено»/«кандидат к » его не ловит. Поэтому после номера
# в заголовке допустимы ТОЛЬКО пробел, «—», «(» или конец строки; иначе отказ. Сравнение побайтное (case), от локали не зависит.
VERH_OST=${VERH#*"$VERH_VERSIYA"}
case "$VERH_OST" in ''|' '*|'('*|'—'*) VERH_HVOST=ok ;; *) VERH_HVOST= ;; esac
if [ "$VERH_VERSIYA" != "$VERSIYA" ] || [ -z "$VERH_HVOST" ] || printf '%s' "$VERH" | grep -qE 'не выпущен|Не выпущен|НЕ ВЫПУЩЕН' \
   || printf '%s' "$VERH" | grep -qE '(Н|н)омер[[:space:]]*(—|–|-)?[[:space:]]*при[[:space:]]+монтаж|(К|к)андидат к '; then
  echo "🔴 ОТКАЗ: верхний заголовок CHANGELOG не годится для метки $VERSIYA:" >&2
  echo "   $VERH" >&2
  [ -z "$VERH_HVOST" ] && echo "   после номера $VERH_VERSIYA идёт «$(printf '%s' "$VERH_OST" | cut -c1-20)» — допустимы только пробел, «—», «(» или конец строки." >&2
  echo "   Нужен «## $VERSIYA …» без «не выпущено» и без «номер — при монтаже» / «кандидат к …». Сними пометку отдельным коммитом" >&2
  echo "   («релизный заголовок») и повтори — метку на невыпущенное не ставим." >&2
  exit 1
fi

VREM=$(mktemp -d "${TMPDIR:-/tmp}/vypusk-tegom.XXXXXX") || exit 2
trap 'rm -rf "$VREM"' EXIT
# ═══ СЛЕД ВОРОТ (B-N-1923, Заря; замысел ГОДЕН Вениамина 09:04Z, наряд Забавы 09:28Z) ══════════════════════════════════
# 🔴 ЗАЧЕМ. Ворота метку НЕ ставят — её ставит рука по «✅». До B-N-1923 о прогоне ворот не оставалось следа нигде вне $VREM,
#   и метка «через ворота» от метки «мимо» не отличалась ничем. Теперь перед «✅» помощник root (libexec/vypusk-tegom/zhurnal-zapis, через sudo -n)
#   пишет строку в журнал root:root вне дерева; сторож metki-mimo-vorot-watch сверяет с ним КАЖДУЮ метку.
#   Коммит, tree каталога и «чисто» помощник вычисляет САМ — отсюда только метка, пакет, режим, каталог и файл вывода.
#   Грязный каталог (≠ HEAD) — ОТКАЗ код 2 «закоммить и повтори» (развилка (б), Забава 09:28Z): судили рабочие файлы,
#   а метка ляжет на коммит. След не записан — «✅» нет, код 2. Каталог вне git (прогон на копии) — «✅» с пометкой БЕЗ СЛЕДА:
#   метку ставить не во что, а поставленную по такому прогону сторож назовёт «мимо ворот».
# ГРАНИЦА: у 8 учёток NOPASSWD ALL (sudoers.d, замер 09.10) — подделка следа рукой возможна; цель — «мимо ворот ВИДНО».
# Полный вывод прогона (stdout и stderr, потоки раздельны) — в $VREM/vyvod: его сумма и копия уходят в след.
# №17 аудита A-N-1948 (10.10.2026, Заря): tee — фоновые процессы; sled_vorot берёт сумму файла, пока хвост мог быть ещё в пути.
# Поэтому прежние потоки сохраняем (3, 4), pid обоих tee запоминаем, и sled_vorot перед помощником возвращает потоки и ЖДЁТ tee.
exec 3>&1 4>&2
exec > >(tee -a "$VREM/vyvod" >&3); TEE_OUT=$!
exec 2> >(tee -a "$VREM/vyvod" >&4); TEE_ERR=$!
dopisat_vyvod() {   # закрыть трубы tee и дождаться, пока они допишут; предел 10 с — иначе слепота, а не неполный след
  local i
  exec >&3 2>&4
  for i in $(seq 50); do kill -0 "$TEE_OUT" 2>/dev/null || kill -0 "$TEE_ERR" 2>/dev/null || break; sleep 0.2; done
  if kill -0 "$TEE_OUT" 2>/dev/null || kill -0 "$TEE_ERR" 2>/dev/null; then
    echo "СЛЕПОТА: вывод ворот не дописан за 10 с (tee живы: $TEE_OUT $TEE_ERR) — след с неполным выводом не пишу." >&2; exit 2
  fi
  wait "$TEE_OUT" "$TEE_ERR" 2>/dev/null
}
ZHURNAL_ZAPIS="${VYPUSK_ZHURNAL_ZAPIS:-/usr/local/libexec/vypusk-tegom/zhurnal-zapis}"   # подмена и VYPUSK_ZHURNAL_DIR — только стенду
GALKA="✅"   # sled_vorot меняет её на «пробный прогон», если каталог вне git (следа нет)
# B-N-2115(б) (18.10.2026, Заря): «метка уже есть» — ДО записи следа, в ОБОИХ режимах. Прежде в режиме npm проверки не было вовсе
#   (режим дерева проверяет раньше, :194): повторный прогон по dsh-autopilot-v0.1.9 записал вторую строку следа (вывод ec308f8d),
#   а метку рука поставить не смогла. Строка следа на уже стоящую метку — заранее выданный допуск: сторож принимает метку, если
#   ХОТЬ ОДНА строка следа совпала по tree (metki-mimo-vorot-watch :151–160). Проверка здесь, а не в начале, — ловит и метку,
#   поставленную ВО ВРЕМЯ прогона. Имена — как у сторожа: по каталогу и по имени пакета (без @scope/).
#   НЕ ЛОВИТ: каталог вне git (пробный прогон — следа и так нет) и репозиторий, который git этой учётке не открывает
#   (чужой владелец без safe.directory) — там проверка молчит, как прежде.
metka_uzhe_est() {   # $1 метка по каталогу · $2 пакет → печатает имя найденной метки, код 0; нет — код 1
  local m
  git -C "$KATALOG" rev-parse --git-dir >/dev/null 2>&1 || return 1
  for m in "$1" "${2##*/}-v${VERSIYA}"; do
    git -C "$KATALOG" rev-parse -q --verify "refs/tags/$m" >/dev/null 2>&1 && { printf '%s' "$m"; return 0; }
  done
  return 1
}
sled_vorot() {   # $1 метка · $2 пакет · $3 режим — звать прямо перед «✅»
  local otv kod est
  dopisat_vyvod
  if est=$(metka_uzhe_est "$1" "$2"); then
    echo "🔴 ОТКАЗ: метка $est уже есть (→ $(git -C "$KATALOG" rev-parse --short=12 "$est^{commit}" 2>/dev/null)) — след ворот не пишу: метки не переносятся, нужен новый номер." >&2
    exit 1
  fi
  # «--ключ=значение»: каталог/метка на «-» (П21 стенда ворот) иначе читались бы помощником как ключ.
  otv=$(sudo -n "$ZHURNAL_ZAPIS" --metka="$1" --paket="$2" --rezhim="$3" --katalog="$KATALOG" --vyvod="$VREM/vyvod" \
        ${VYPUSK_ZHURNAL_DIR:+--zhurnal-dir="$VYPUSK_ZHURNAL_DIR"} 2>&1); kod=$?
  case "$kod" in
    0) echo "   $otv" ;;
    4) echo "⚠️ $otv"; GALKA="✅ ПРОБНЫЙ ПРОГОН, метку по нему сторож не примет —" ;;   # Вениамин 09:46Z п.4: галку читают первой
    3) echo "🔴 ОТКАЗ: $otv — ворота судили рабочие файлы, а метка ляжет на коммит. Закоммить и повтори." >&2; exit 2 ;;
    *) echo "СЛЕПОТА: след ворот не записан (код $kod) — «✅» не даю: метку по этому прогону сторож назовёт «мимо ворот»." >&2
       printf '%s\n' "$otv" | sed 's/^/   /' >&2; exit 2 ;;
  esac
}
if [ "$REZHIM" = derevo ]; then
  IMYA_D=$(basename "$KATALOG"); REPO_D="${VYPUSK_REPO:-/opt/iskra/workspace/dsh-plugins}"
  REESTR_D="${VYPUSK_REESTR:-/etc/agent-registry/plugins.yaml}"
  echo "РЕЖИМ ДЕРЕВА (без package.json): пакет $IMYA_D, версия $VERSIYA (заголовок CHANGELOG), реестр $REESTR_D"
  if git -C "$REPO_D" rev-parse -q --verify "refs/tags/${IMYA_D}-v${VERSIYA}" >/dev/null 2>&1; then
    echo "🔴 ОТКАЗ: метка ${IMYA_D}-v${VERSIYA} уже есть — метки не переносятся, нужен новый номер." >&2; exit 1
  fi
  SUBDIR=$(realpath -m --relative-to="$(realpath -m "$REPO_D")" "$KATALOG")
  case "$SUBDIR" in ..*|/*) echo "СЛЕПОТА: каталог $KATALOG вне репозитория $REPO_D — состав из дерева не взять." >&2; exit 2;; esac
  # Состав — git ls-files каталога (то, что ляжет в метку), а не find: записки и остатки вне git в метку не едут.
  ( cd "$REPO_D" && git ls-files -- "$SUBDIR" ) | sed "s#^$SUBDIR/##" > "$VREM/sostav" || true
  [ -s "$VREM/sostav" ] || { echo "СЛЕПОТА: в git нет ни одного файла $SUBDIR — метка ляжет пустой." >&2; exit 2; }
  # 3.1.31 (Заря; «да» Забавы 05:30:55Z — латентный остаток B-N-2033 в режиме дерева): записей derevo одного subdir может быть
  #   НЕСКОЛЬКО (один пакет на двух местах). Единица сверки — ID записи, как в сверке копий (B-N-2033, :602): судятся ВСЕ записи
  #   subdir; у каждой — двусторонний состав и побайтное «выпуск = бой»; расхождения называются с ID, все сразу. Записей 0 — СЛЕПОТА.
  #   НЕ ЛОВИТ: VYPUSK_KOPII в режиме дерева не читается (сужать нечем — имени из package.json нет), судятся все записи subdir.
  if ! python3 - "$REESTR_D" "$SUBDIR" "$VREM" > "$VREM/zapisi" 2> "$VREM/zapis.err" <<'PYD'
import sys, yaml
reestr, subdir, vrem = sys.argv[1:4]
d = yaml.safe_load(open(reestr))
z = [s for s in d.get('services', []) if isinstance(s, dict) and (s.get('derevo') or {}).get('subdir') == subdir]
if not z: sys.exit('записей с derevo.subdir=%s: 0 (нужна хотя бы одна)' % subdir)
ids = [str(s.get('id')) for s in z]
if len(set(ids)) != len(ids): sys.exit('id записей derevo.subdir=%s повторяются: %s' % (subdir, ', '.join(ids)))
for n, s in enumerate(z):
    dv = s['derevo']
    with open('%s/zapis.%d' % (vrem, n), 'w', encoding='utf-8') as f:
        for x in dv.get('files') or []: f.write('F\t%s\t%s\n' % (x['remote'], x['local']))
        for x in dv.get('not_installed') or []: f.write('N\t%s\t\n' % x)
        for x in dv.get('expected_diff_files') or []: f.write('E\t%s\t\n' % x)
    print('%d\t%s' % (n, ids[n]))
PYD
  then echo "СЛЕПОТА: запись реестра не прочитана ($REESTR_D): $(tail -1 "$VREM/zapis.err")" >&2; exit 2; fi
  N_ZAP=$(grep -c . "$VREM/zapisi")
  [ "$N_ZAP" -gt 1 ] && echo "   записей derevo для $SUBDIR: $N_ZAP ($(cut -f2 "$VREM/zapisi" | paste -sd, - | sed 's/,/, /g')) — судятся все, единица — ID"
  SLEP_D=""; RAZN_D=""; NF=0
  while IFS=$'\t' read -r nz idz; do
    Z="$VREM/zapis.$nz"
    # Двусторонняя сверка: файл метки без строки в записи — запись отстала; строка files без файла в метке — тоже.
    OTSTALO=$(awk -F'\t' '$1=="F"||$1=="N"{print $2}' "$Z" | LC_ALL=C sort -u | LC_ALL=C comm -23 <(LC_ALL=C sort -u "$VREM/sostav") -)
    LISHNEE=$(awk -F'\t' '$1=="F"{print $2}' "$Z" | LC_ALL=C sort -u | LC_ALL=C comm -13 <(LC_ALL=C sort -u "$VREM/sostav") -)
    [ -n "$OTSTALO" ] && SLEP_D="$SLEP_D$(echo "$OTSTALO" | sed "s/^/   [$idz] в метке, нет в записи: /")"$'\n'
    [ -n "$LISHNEE" ] && SLEP_D="$SLEP_D$(echo "$LISHNEE" | sed "s/^/   [$idz] в files записи, нет в метке: /")"$'\n'
    while IFS=$'\t' read -r vid rem loc; do
      [ "$vid" = F ] || continue; NF=$((NF+1))
      grep -qxF "$rem" <(awk -F'\t' '$1=="E"{print $2}' "$Z") && continue
      sudo -n cat -- "$loc" 2>/dev/null | cmp -s - "$KATALOG/$rem" || RAZN_D="$RAZN_D[$idz] $rem → $loc"$'\n'
    done < "$Z"
  done < "$VREM/zapisi"
  if [ -n "$SLEP_D" ]; then
    echo "СЛЕПОТА: запись реестра ≠ составу метки (VYPUSK_REESTR — реестр-кандидат этого выпуска):" >&2
    printf '%s' "$SLEP_D" >&2
    exit 2
  fi
  if [ -n "$RAZN_D" ]; then
    echo "🔴 ОТКАЗ: выпуск ≠ бою по записи реестра — метку ставят после монтажа (дерево метки = бой):" >&2
    printf '%s' "$RAZN_D" | head -10 | sed 's/^/   /' >&2; exit 1
  fi
  echo "   выпуск = бой по записи реестра: записей $N_ZAP ($(cut -f2 "$VREM/zapisi" | paste -sd, - | sed 's/,/, /g')), файлов $NF, состав метки $(grep -c . "$VREM/sostav") (files + not_installed, сверено в обе стороны)"
  if [ -n "${STENDY_INACHE:-}" ]; then
    echo "⚠️ стенды пакета НЕ ПРОГНАНЫ: обход объявлен — «$STENDY_INACHE». Это не «стенды зелёные»."
  else
    echo "СЛЕПОТА: стенды пакета дерева ворота не гоняют — обходчик выбирает пакет по name из package.json, которого нет." >&2
    echo "  Объявленный обход: STENDY_INACHE=\"довод (чем и когда стенды прогнаны)\" vypusk-tegom <каталог>" >&2
    exit 2
  fi
  echo "частные имена: НЕ ПРОВЕРЯЛИСЬ — разряд выключен распоряжением владельца 06.09"
  sled_vorot "${IMYA_D}-v${VERSIYA}" "$IMYA_D" derevo
  echo "$GALKA можно ставить ЛОКАЛЬНЫЙ тег: git tag -a ${IMYA_D}-v${VERSIYA} -m $(printf '%q' "стенды не прогнаны: $STENDY_INACHE")"
  echo "   push НЕ делать: запрет владельца 06.09.2026 13:50. Признак выпуска — локальный тег + равенство дерева тега боевому диску."
  exit 0
fi
# №10 дополнение (Вениамин 01:4xZ, Забава 01:37Z): --ignore-scripts — сценарии prepack/prepare/postpack пакета не исполняются
#   (тот же класс, что в приборах сумм: находка Авроры 01:30Z). Состав тарбола — без чужих сценариев.
if ! ( cd "$KATALOG" && npm pack --ignore-scripts --pack-destination "$VREM" ) >"$VREM/pack.log" 2>&1; then
  echo "СЛЕПОТА: npm pack не собрал тарбол — проверять нечего." >&2
  tail -3 "$VREM/pack.log" >&2
  exit 2
fi
TGZ=$(ls "$VREM"/*.tgz 2>/dev/null | head -1)
[ -z "$TGZ" ] && { echo "СЛЕПОТА: тарбол не найден после npm pack." >&2; exit 2; }
mkdir -p "$VREM/raspak" && tar xzf "$TGZ" -C "$VREM/raspak" || { echo "СЛЕПОТА: тарбол не распаковался." >&2; exit 2; }
# ═══ РАЗРЯД «ЧАСТНЫЕ ИМЕНА» — ВЫКЛЮЧЕН, НЕ УДАЛЁН (14.09.2026) ═══════════════════
