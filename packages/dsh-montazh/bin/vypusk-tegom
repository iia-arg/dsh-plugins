fi
# ═══ ОБЁРТКИ СТЕНДОВ КРАСНЕЮТ ОТ ВОЗВРАТА ТЕЛА (решение координатора 06.09.2026) ═══════
# 🔴 ЗАЧЕМ В ВОРОТА ВЫПУСКА. Обёртка, глухая к возврату тела, делает ВСЕ свои пробы
# украшением, и снаружи это неотличимо от исправного стенда: зелёный итог, растущее число
# проб, ноль расхождений. Замер 06.09: из 56 стендов флота глухих 19. Вред сегодня нулевой
# (тел с возвратом нет ни одного) — то есть класс СПЯЩИЙ, и правится он «при касании».
#
# 🔴 ПОЭТОМУ ОТКАЗ ТОЛЬКО НА ТРОНУТОМ. Отказывать за всякую глухую обёртку значило бы сделать
# ворота непроходимыми для шести пакетов сразу — а ворота, непроходимые никогда, обходят не
# глядя. Здесь: наследие называется числом и именами, а ОТКАЗ даётся, если глухой стенд
# ИЗМЕНЁН ПОСЛЕ последнего тега пакета, то есть его в этом выпуске трогали и к форме не привели.
# ГРАНИЦА ПРИЗНАКА «ТРОНУТ» (B-N-1774, 08.10.2026): по СОДЕРЖИМОМУ против последней метки пакета (git show <метка>:<путь>).
# Прежде — по времени файла: копия/checkout давали ложный отказ, правка с touch -d проходила. ⚠️ Не ловит: стенд,
# переименованный между метками (новое имя — «тронут», это и верно), каталог пакета вне VYPUSK_REPO (считается тронутым).
# ⚠️ И ЧЕГО РАЗРЯД НЕ ДЕЛАЕТ: не судит сами пробы. Он про обёртку, а не про то, верны ли
# проверки внутри. Молчание значит «обёртки краснеют», а НЕ «стенды полны».
# 🔴 A-N-980 (26.09.2026): среда юнита обходчика разбирается ЗДЕСЬ, выше прибора обёрток, — прибор гоняет стенды в ТОЙ ЖЕ среде,
# что обходчик ниже, а не в оболочке зовущего. Иначе исход плавал по руке: без DSH_TEST_APP у зовущего стенд, честно слепой без
# платформы, давал «не на чем мерить», с ней — «краснеет» (stend-komandy-svodki a84: ворота Искры — код 2, дерево — 0, Вениамин — СЛЕПОТА).
OBH_SLUZHBA="${OBHODCHIK_SLUZHBA:-vse-stendy-boevye.service}"
OBH_SREDA_STROKA=$(systemctl show "$OBH_SLUZHBA" -p Environment --value 2>/dev/null)
OBH_SREDA=(); OBH_SREDA_BEDA=""
# read -ra, а не for по строке без кавычек (INFO Вениамина): «*» и «?» в значении раскрылись бы по файлам каталога пакета.
read -ra OBH_SREDA_EL <<< "$OBH_SREDA_STROKA"
for el in "${OBH_SREDA_EL[@]}"; do
  if [[ "$el" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then OBH_SREDA+=("$el"); else OBH_SREDA_BEDA="$OBH_SREDA_BEDA «$el»"; fi
done
KRASNEET="${OBYORTKA_KRASNEET:-/usr/local/bin/obyortka-krasneet}"   # подмена — только стенду ворот (A-N-956)
if [ -n "${STENDY_INACHE:-}" ]; then
  echo "⚠️ обёртки стендов НЕ ПРОГНАНЫ: предварительный прогон объявлен — «$STENDY_INACHE». Это не новый зелёный замер."
elif [ ! -x "$KRASNEET" ]; then
  echo "⚠️ обёртки стендов НЕ проверены: прибора $KRASNEET нет (это «не смотрели», не «чисто»)."
else
  OB_VYVOD=$(env "${OBH_SREDA[@]}" "$KRASNEET" "$KATALOG" 2>&1); OB_KOD=$?   # A-N-980: в среде юнита (только ИМЯ=значение)
  # 🔴 A-N-1888 (Михалыч 09.10.2026): СВОДКА — ПО СТРОКЕ «ОБЁРТКИ СТЕНДОВ:», А НЕ ПЕРВОЙ СТРОКОЙ ВЫВОДА. Прежде печаталась
  # `echo "$OB_VYVOD" | head -1`, а stderr прибора слит в вывод (2>&1): под systemd SIGPIPE игнорируется (IgnoreSIGPIPE=yes),
  # конвейер прибора `grep … | head -1` пишет «grep: write error: Broken pipe» — эта строка гонкой встаёт ПЕРВОЙ (замер 1 из 3,
  # nudzh/storozha 08.10 23:54Z), и сводку вытесняла. Вердикт при этом считался (маркеры ГЛУХОЙ/ЛОВУШКА — по всему выводу), но
  # «сводки нет» читалось как молчание разряда. Над выводом — here-string, без писателя в рвущийся конвейер.
  SVODKA=$(grep -m1 '^ОБЁРТКИ СТЕНДОВ:' <<< "$OB_VYVOD")
  SLEPOTA_PRIBORA=""; [ "$OB_KOD" -eq 2 ] && SLEPOTA_PRIBORA=$(grep -m1 '^СЛЕПОТА' <<< "$OB_VYVOD")
  case "$SVODKA" in 'ОБЁРТКИ СТЕНДОВ:'*) echo "$SVODKA" ;; *) [ -n "$SLEPOTA_PRIBORA" ] && echo "$SLEPOTA_PRIBORA" ;; esac
  # 🔴 A-N-955 (25.09.2026): прибор сорвал прогон стенда своим сторожем группы процессов (стенд рекурсивен
  # или завис: ≥40 процессов или ≥120 с) — ОТКАЗ. До сторожа такой стенд давал не отказ, а ~1000 процессов
  # и прибор, который не кончается (restore a35, 17:44Z). Стенд обязан кончаться; метку на такой не ставим.
  if grep -q '^🔴 СТОРОЖ ПРИБОРА' <<< "$OB_VYVOD"; then
    awk '/^🔴 СТОРОЖ ПРИБОРА/{p=1; print; next} p && /^ /{print; next} {p=0}' <<< "$OB_VYVOD" >&2
    echo "🔴 ОТКАЗ: прогон стенда сорван сторожем прибора (рекурсия или зависание) — тег не ставим." >&2
    exit 1
  fi
  # 🔴 КОД 2 ПРИБОРА — «НЕ ИЗМЕРЕНО», А НЕ «ЗЕЛЕНО» (A-N-956, находка Авроры A-N-955; вариант Вениамина 18:40Z).
  # Прежде код 2 (в области нет стендов, стенд красный до порчи, порча не внеслась, test/ закрыт на запись)
  # проходил МОЛЧА: печаталась первая строка прибора, где «ГЛУХИХ НЕ ИЗМЕРЕНО» легко прочесть как ноль.
  # Теперь — отдельная строка ворот с причиной. НЕ отказ: у dsh-pamyat-kompakt и kompakt-dsh стенды лежат
  # в корне пакета, вне области прибора, и код 2 у них всегда — отказ сделал бы ворота непроходимыми.
  # ⚠️ НЕ ЛОВИТ: «ГЛУХИХ НЕ ИЗМЕРЕНО» при коде 0 (все стенды — обёртки-условия) и код 1 прибора, при котором
  # часть стендов тоже не измерена (код 1 главнее кода 2).
  # A-N-1888: нет ни сводки, ни слепоты прибора (код 2 с «СЛЕПОТА…», напр. «.mjs-стендов нет») — разряд обёрток НЕ УСТАНОВЛЕН:
  # прибор упал, оборван или вывел иное. Это СЛЕПОТА ворот, код 2, а не молчаливый проход.
  # ГДЕ НЕ ДЕЙСТВУЕТ: прибора нет (ветка выше — «не проверены», как прежде). НЕ ЛОВИТ: сводку с неверными числами.
  case "$SVODKA" in 'ОБЁРТКИ СТЕНДОВ:'*) ;; *) if [ -z "$SLEPOTA_PRIBORA" ]; then
    echo "СЛЕПОТА: прибор обёрток $KRASNEET не дал сводки «ОБЁРТКИ СТЕНДОВ:» (код $OB_KOD) — вердикт по обёрткам не установлен, метку не ставим."
    sed -n '1,5s/^/   прибор: /p' <<< "$OB_VYVOD"
    exit 2
  fi ;; esac
  if [ "$OB_KOD" -eq 2 ]; then
    PRICHINA=$(awk '/^(СЛЕПОТА|НЕ НА ЧЕМ МЕРИТЬ|НЕТ ПРАВ)/{p=1} p && NF {print; if (++n == 3) exit}' <<< "$OB_VYVOD" | tr '\n' ' ' | sed 's/  */ /g')
    echo "⚠️ глухота не измерена: ${PRICHINA:-прибор вернул код 2 без причины} — это НЕ «глухих 0»."
  fi
  # 🔴 ИМЕНА БЕРЁМ ИЗ СТРОК С МАРКЕРОМ, А НЕ ПО МАСКЕ ПУТИ. Первая редакция выцепляла всё
  # похожее на путь стенда — и поймала строку ОБЛАСТИ прибора («…/*/test/stend-*.mjs»),
  # то есть объявила глухим сам шаблон. Признак по форме строки отвечает про форму.
  # 🔴 МАРКЕР — ДОГОВОРНАЯ СТРОКА ПРИБОРА «ГЛУХОЙ: <путь>» (A-N-956, 25.09.2026). До того здесь
  # искалась фраза «вписана заведомо падающая проба», которой прибор не печатал ни в одной
  # редакции с 20.09: отбор был пуст всегда, отказ не наступал никогда. Разрыв ловит П27 стенда ворот.
  # A-N-958: и «ЛОВУШКА: <путь>» — условие-функция истинна всегда, проба зелена при любых данных: та же глухота зеркально,
  # судится тем же правилом «тронут — отказ, не тронут — наследие».
  GLUHIE_FAJLY=$(sed -n 's/^ГЛУХОЙ: //p; s/^ЛОВУШКА: //p' <<< "$OB_VYVOD" | sort -u)
  if [ -n "$GLUHIE_FAJLY" ]; then
    # A-N-960: путь — ДОВОДОМ (process.argv), не текстом JS: апостроф в пути ломал строковый литерал → «имя не прочитано».
    IMYA_PAKETA=$(node -p 'require(require("path").resolve(process.argv[1])).name' "$KATALOG/package.json" 2>/dev/null)
    REPO="${VYPUSK_REPO:-/opt/iskra/workspace/dsh-plugins}"   # подмена — только стенду ворот (A-N-956, проба «наследие»)
    RUBEZH=""
    if [ -d "$REPO/.git" ] && [ -n "$IMYA_PAKETA" ]; then
      # A-N-1562: после «-v» — цифра. Маска «<имя>-v*» ловила и соседа, чьё имя продолжает это: у dsh-pamyat
      # рубежом выходила метка dsh-pamyat-vyvoz-v… (замер 04.10: …-vyvoz-v0.1.0-alpha.19 вместо dsh-pamyat-v0.1.0-alpha.102).
      # sort -V упорядочивает обе формы номера верно: 0.1.0-alpha.N < 1.1.N (перенумерация продолжает N).
      # B-N-1824 (08.10.2026): метки пакета ставятся то по имени из package.json, то по КАТАЛОГУ дерева (у 6 пакетов имя ≠
      # каталогу: telegram-multiagent = dsh-telegram-multiagent, у него 12 меток по имени и 95 по каталогу). По одному имени
      # рубежом выходила метка 27.09 — всё изменённое с тех пор «тронуто», ложный отказ на 2.5.113. Рубеж — самая СВЕЖАЯ ПО
      # ДАТЕ КОММИТА из меток обоих префиксов (номера разных префиксов sort -V не сравнить).
      # ЧЕГО НЕ ЛОВИТ: метку под третьим именем; метку, поставленную на коммит старше прежней (дата коммита, не метки).
      # A-N-1948: и метки под прежними именами (dsh.prezhnie_imena) — третий префикс, которого B-N-1824 не ловил.
      KAT_IMYA=$(basename "$(realpath -m "$KATALOG")")
      POSL_TEG=$( printf '%s\n' "$IMYA_PAKETA" "$KAT_IMYA" $PREZHNIE | sort -u | while IFS= read -r pr; do
                    [ -n "$pr" ] && git -C "$REPO" tag --list "${pr}-v[0-9]*"; done \
                  | while IFS= read -r t; do [ -n "$t" ] && printf '%s %s\n' "$(git -C "$REPO" log -1 --format=%ct "$t" 2>/dev/null)" "$t"; done \
                  | sort -n -k1,1 | tail -1 | cut -d' ' -f2-)
      [ -n "$POSL_TEG" ] && RUBEZH=$(git -C "$REPO" log -1 --format=%ct "$POSL_TEG" 2>/dev/null)
    fi
    # A-N-1948: каталог пакета в метке-рубеже может называться прежним именем (git mv) — тогда путь файла в метке иной.
    # Ищем каталог: нынешний, затем имя пакета, затем прежние имена; первый, что есть в метке. Нет ни одного — путь прежний.
    KAT_REL=$(realpath -m --relative-to="$(realpath -m "$REPO")" "$KATALOG"); KAT_V_METKE="$KAT_REL"
    if [ -n "$RUBEZH" ]; then
      KAT_RODIT=$(dirname "$KAT_REL"); [ "$KAT_RODIT" = . ] && KAT_RODIT="" || KAT_RODIT="$KAT_RODIT/"
      while IFS= read -r pr; do
        [ -n "$pr" ] || continue
        if git -C "$REPO" cat-file -e "$POSL_TEG:$KAT_RODIT$pr" 2>/dev/null; then KAT_V_METKE="$KAT_RODIT$pr"; break; fi
      done < <(printf '%s\n' "$KAT_IMYA" "$IMYA_PAKETA" $PREZHNIE)
      [ "$KAT_V_METKE" != "$KAT_REL" ] && echo "рубеж по прежнему имени: метка $POSL_TEG, каталог в ней $KAT_V_METKE (ныне $KAT_REL)"
    fi
    TRONUTYE=""
    # 🔴 A-N-959 (25.09.2026, находка Вениамина): обход ПОСТРОЧНО, не «for g in $СПИСОК». Без кавычек путь с пробелом
    # резался на куски, [ -f ] не находил ни одного — отказ молча превращался в «наследие» с обломками имён.
    # Список — одна строка на путь (так его печатает прибор); TRONUTYE — тоже построчно.
    while IFS= read -r g; do
      [ -n "$g" ] || continue
      [ -f "$g" ] || continue
      # B-N-1774 (1): «тронут» — по СОДЕРЖИМОМУ против прежней метки, а не по mtime: checkout/копия меняли время без правки
      # (ложный отказ), touch -d прятал правку (пропуск). Файл ≠ его байтам в метке (или его в метке нет) — тронут.
      # Рубежа нет (первый выпуск имени либо репозиторий недоступен) или файл вне репозитория — считаем тронутым:
      # новый пакет обязан рождаться с исправной обёрткой, а слепота не повод пропустить.
      REL=$(realpath -m --relative-to="$(realpath -m "$REPO")" "$g")
      case "$REL" in ..*|/*) REL="";; esac
      case "$REL" in "$KAT_REL"/*) REL="$KAT_V_METKE/${REL#"$KAT_REL"/}";; esac
      if [ -z "$RUBEZH" ] || [ -z "$REL" ] || ! git -C "$REPO" show "$POSL_TEG:$REL" 2>/dev/null | cmp -s - "$g"; then
        TRONUTYE="$TRONUTYE$g"$'\n'; fi
    done <<< "$GLUHIE_FAJLY"
    if [ -n "$TRONUTYE" ]; then
      echo "🔴 ОТКАЗ: глухая обёртка в стенде, ТРОНУТОМ в этом выпуске — тег не ставим." >&2
      printf '%s' "$TRONUTYE" | while IFS= read -r t; do [ -n "$t" ] && echo "   $t" >&2; done
      echo "   Обёртка обязана краснеть на возврате тела: строка = причина, false = отказ." >&2
      echo "   Рубеж: ${POSL_TEG:-тегов пакета нет}. Признак — содержимое файла против метки-рубежа (B-N-1774)." >&2
      exit 1
    fi
    echo "⚠️ глухие обёртки есть, но в этом выпуске их не трогали — наследие, правится при касании:"
    printf '%s\n' "$GLUHIE_FAJLY" | while IFS= read -r g; do [ -n "$g" ] && echo "   $g"; done
  fi
fi

# ═══ СТЕНДЫ ПАКЕТА В БОЕВОЙ РАСКЛАДКЕ (B-H-060, Аврора, 24.09.2026) ═══════════════════════
# 🔴 ЗАЧЕМ. До 24.09 ворота стендов не звали вовсе (0 вхождений обходчика, замер Искры 10:07Z): метку
# можно было поставить на дерево с КРАСНЫМ стендом, а обходчик гнали руками после монтажа и таймером
