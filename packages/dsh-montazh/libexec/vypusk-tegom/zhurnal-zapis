#!/usr/bin/env python3
# RU: zhurnal-zapis (vypusk-tegom) — СЛЕД ВОРОТ ВЫПУСКА (B-N-1923). Зовёт vypusk-tegom через `sudo -n` прямо перед «✅»; пишет строку в журнал
# RU: root:root вне дерева, куда автор метки сам не пишет (без sudo). Сторож metki-mimo-vorot-watch сверяет с журналом КАЖДУЮ метку.
# RU: От зовущего — только метка, пакет, режим, каталог выпуска (где судили) и файл вывода ворот. Коммит, tree каталога и «чисто»
# RU: помощник ВЫЧИСЛЯЕТ САМ (root) из каталога: зовущий их не подставит.
# RU: Чтение чужого дерева — БЕЗ записи индекса: `git --no-optional-locks status` (иначе git под root обновил бы .git/index
# RU: дерева iskra и сделал бы его владельцем root).
# RU: 🔴 git — от ВЛАДЕЛЬЦА .git (setpriv), без safe.directory (условие Вениамина 09:46Z, MED): status исполняет core.fsmonitor и
# RU: фильтры clean из .git/config; под root с safe.directory=* это было исполнение чужого конфига от root (замер 09.10 10:1xZ:
# RU: хук fsmonitor подставного репозитория отработал от root). Теперь конфиг исполняется с правами того, кто его написал.
# RU: Репозиторий ищется подъёмом по каталогам до .git — сам root git в чужом дереве не зовёт.
# RU: Коды: 0 — след записан · 3 — каталог грязный (≠ HEAD): метку ставить не на что · 4 — каталог вне git: следа нет ·
# RU: 2 — слепота (журнал не годен, git не ответил, доводы не той формы).
# RU: ГРАНИЦА: у 8 учёток NOPASSWD ALL (sudoers.d, замер 09.10) — любая из них может позвать помощника с выдуманными меткой/пакетом
# RU: на настоящем чистом каталоге. Цель — «метка мимо ворот ВИДНА», а не «невозможна».
# EN: zhurnal-zapis (vypusk-tegom) — release-gate trace (B-N-1923). Called by vypusk-tegom via `sudo -n` right before «✅»; appends a line to a
# EN: root-owned journal outside the tree. Commit, directory tree and cleanliness are computed here as root, not passed in.
# EN: Exit: 0 written · 3 dirty · 4 outside git · 2 blind. Boundary: 8 NOPASSWD ALL accounts can forge a call — bypass is VISIBLE, not impossible.
import argparse, datetime, fcntl, hashlib, os, re, shutil, stat, subprocess, sys

ZHURNAL_DIR = '/var/lib/vypusk-tegom'

def slepo(why):
    print(f'СЛЕПОТА: след ворот не записан: {why}', file=sys.stderr); sys.exit(2)

VLADELEC = None   # (uid, gid, дом) владельца .git — задаётся до первого вызова git
def git(repo, *a):
    # От владельца .git (setpriv, без PAM), окружение — с нуля: ни safe.directory, ни конфиг root. Не пишет: --no-optional-locks.
    uid, gid, dom = VLADELEC
    env = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': dom, 'LANG': 'C.UTF-8', 'GIT_OPTIONAL_LOCKS': '0'}
    r = subprocess.run(['setpriv', f'--reuid={uid}', f'--regid={gid}', '--clear-groups', '--',
                        'git', '--no-optional-locks', '-C', repo, *a], capture_output=True, text=True, env=env)
    return r.returncode, r.stdout.strip(), r.stderr.strip()

def najti_git(put):   # подъём до каталога с .git (каталог или файл worktree), без git
    while True:
        if os.path.lexists(os.path.join(put, '.git')): return put
        verh = os.path.dirname(put)
        if verh == put: return None
        put = verh

def chistoe(v):
    if not v or any(c in v for c in '\t\n\r'): slepo(f'довод пуст или с TAB/переводом строки: {v!r}')
    return v

p = argparse.ArgumentParser(add_help=False)
for k in ('--metka', '--paket', '--rezhim', '--katalog', '--vyvod'): p.add_argument(k, required=True)
p.add_argument('--zhurnal-dir', default=ZHURNAL_DIR)
try: a = p.parse_args()
except SystemExit: slepo('нужны --metka --paket --rezhim --katalog --vyvod [--zhurnal-dir]')
metka, paket, rezhim = chistoe(a.metka), chistoe(a.paket), chistoe(a.rezhim)
# B-N-2029: форма номера = OBRAZEC_VERSII ворот (дефис внутри pre-release); иначе законный «…-v1.3.0-b2027-notices2» — слепота следа.
if not re.fullmatch(r'[A-Za-z0-9._@/-]+-v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]*[0-9A-Za-z-])?', metka): slepo(f'метка не той формы: {metka}')
if rezhim not in ('npm', 'derevo'): slepo(f'режим не npm/derevo: {rezhim}')

# 1. Где судили. Вне git — следа нет (код 4): метку на такой прогон ставить не во что, сторож назовёт её «мимо ворот».
katalog = os.path.realpath(chistoe(a.katalog))
koren = najti_git(katalog)
if koren:
    import pwd
    st = os.lstat(os.path.join(koren, '.git'))
    try: dom = pwd.getpwuid(st.st_uid).pw_dir
    except KeyError: slepo(f'владелец .git {koren} (uid {st.st_uid}) не найден в passwd')
    if st.st_uid == 0: slepo(f'.git {koren} принадлежит root — git от root по чужому конфигу не зову')
    VLADELEC = (st.st_uid, st.st_gid, dom)
    kod, repo, err = git(katalog, 'rev-parse', '--show-toplevel')
else: kod, repo = 1, ''
if kod != 0 or not repo:
    print(f'БЕЗ СЛЕДА: каталог {katalog} вне git — метку по этому прогону сторож не примет'); sys.exit(4)
subdir = os.path.relpath(katalog, repo)
if subdir.startswith('..'): slepo(f'каталог {katalog} вне дерева {repo}')

# 2. Чисто ли: судили рабочие файлы; метка ляжет на коммит — они обязаны совпасть (решение (б): грязно — отказ ворот).
kod, porcelain, err = git(repo, 'status', '--porcelain', '--untracked-files=all', '--', subdir)
if kod != 0: slepo(f'git status не ответил ({repo}): {err[:160]}')
if porcelain:
    print(f'ГРЯЗНО: каталог {subdir} в {repo} ≠ HEAD ({len(porcelain.splitlines())} путей, первый: {porcelain.splitlines()[0][:120]})'); sys.exit(3)
kod, kommit, err = git(repo, 'rev-parse', 'HEAD')
if kod != 0 or not re.fullmatch(r'[0-9a-f]{40}', kommit): slepo(f'HEAD не прочитан: {err[:160]}')
kod, tree, err = git(repo, 'rev-parse', 'HEAD^{tree}' if subdir == '.' else f'HEAD:{subdir}')
if kod != 0 or not re.fullmatch(r'[0-9a-f]{40}', tree): slepo(f'tree {subdir} не прочитан: {err[:160]}')

# 3. Журнал: каталог root, без записи для группы/всех — иначе след подделывается без sudo.
zd = a.zhurnal_dir
try: st = os.stat(zd)
except OSError as e: slepo(f'каталога журнала нет: {zd} ({e.strerror})')
if st.st_uid != 0 or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH): slepo(f'каталог журнала {zd} не root или пишется группой/всеми')
# №10 аудита A-N-1948 (10.10.2026, Заря): помощник идёт под root, а файл вывода называет зовущий — прежде читался ЛЮБОЙ путь
# и копия ложилась в vyvod/*.txt с 0644 (чтение любого файла root). Теперь — только ОБЫЧНЫЙ файл, ХОЗЯИН которого — сам
# зовущий (SUDO_UID; без sudo — тот, кто запустил): своё он прочёл бы и так. Открытие без перехода по ссылке, проверка — по
# УЖЕ ОТКРЫТОМУ (fstat), так подмена пути между проверкой и чтением не проходит; жёсткая ссылка на чужой файл несёт чужого хозяина.
# ЧЕГО НЕ ЛОВИТ: учётку с NOPASSWD ALL — ей помощник не нужен (граница выше).
zov = int(os.environ['SUDO_UID']) if os.environ.get('SUDO_UID', '').isdigit() else os.getuid()
try: fd = os.open(chistoe(a.vyvod), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError as e: slepo(f'файл вывода ворот не открыт: {a.vyvod} ({e.strerror})')
st_v = os.fstat(fd)
if not stat.S_ISREG(st_v.st_mode): os.close(fd); slepo(f'файл вывода ворот не обычный файл: {a.vyvod}')
if st_v.st_uid != zov: os.close(fd); slepo(f'хозяин файла вывода {a.vyvod} — uid {st_v.st_uid}, а зовущий — uid {zov}: чужой файл помощник root не читает')
with os.fdopen(fd, 'rb') as f: vyvod = f.read()
vyvod_sha = hashlib.sha256(vyvod).hexdigest()
vremya = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
vd = os.path.join(zd, 'vyvod'); os.makedirs(vd, mode=0o755, exist_ok=True)
vf = os.path.join(vd, f'{vremya.replace("-", "").replace(":", "")}-{metka.replace("/", "_")}.txt')
with open(vf, 'wb') as f: f.write(vyvod)
os.chmod(vf, 0o644)

# 4. Кто и какими воротами: родитель sudo — процесс ворот; сумма их файла (подменённые ворота видны). Не найден — «-».
vorota = '-'
try:
    pp = int(open(f'/proc/{os.getppid()}/stat').read().rsplit(')', 1)[1].split()[1])
    argv = open(f'/proc/{pp}/cmdline', 'rb').read().split(b'\0')
    skript = next((x.decode() for x in argv[1:3] if x and os.path.isfile(x.decode())), None)
    if skript: vorota = f'{os.path.realpath(skript)}:{hashlib.sha256(open(skript, "rb").read()).hexdigest()[:16]}'
except Exception: pass
kto = os.environ.get('SUDO_USER') or '-'

stroka = '\t'.join([vremya, metka, paket, rezhim, repo, subdir, kommit, tree, '1', vyvod_sha, vorota, kto]) + '\n'
zf = os.path.join(zd, 'zhurnal.tsv')
fd = os.open(zf, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
try:
    fcntl.flock(fd, fcntl.LOCK_EX); os.write(fd, stroka.encode())
finally: os.close(fd)
os.chmod(zf, 0o644)
print(f'СЛЕД ЗАПИСАН: {metka} · {subdir} · коммит {kommit[:12]} · tree {tree[:12]} · вывод {vyvod_sha[:16]} · {zf}')
