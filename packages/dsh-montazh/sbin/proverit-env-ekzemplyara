#!/bin/bash
# Забава, 14.09.2026. Проверка env экземпляра шлюза ПЕРЕД подъёмом.
# ЗАЧЕМ (Вениамин + Искра, 14.09 22:04-22:07): кодеров будут заводить копированием
#   единственного образца instance-iskra.env. При этом ЧУЖИМИ окажутся 5 значений,
#   и ГРОМКАЯ среди них только одна (порт — иначе не поднимется, поправят первым делом).
#   Остальные ТИХИЕ: поставщик · рабочий каталог · агент компакта · файл токена.
# 🔴 КЛАСС: ЗАЩИТА ОТ ОТСУТСТВИЯ НЕ ЕСТЬ ЗАЩИТА ОТ ПОДМЕНЫ. Снятие умолчания закрыло
#   пустоту, но чужое ВЕРНОЕ значение проходит молча: строка есть, значение известное.
# 🔴 ОХВАТ, И ОН ПЕЧАТАЕТСЯ ЧИСЛОМ (замечание Вениамина 14.09 22:11): в образце ВОСЕМЬ
#   переменных, признак «чужое имя агента» ловит ДВЕ. Без напечатанного знаменателя прибор
#   прочтётся как «env проверен», а проверена будет четверть. Наш класс «ноль без знаменателя».
#   ловит:    GATEWAY_WORK_DIR · KOMPAKT_AGENT (имя агента в значении) + поставщик против ожидаемого
#   НЕ ловит: GATEWAY_TOKEN_FILE (чужой токен РАБОТАЕТ) · DEEPSEEK_API_KEY (общий на 4 файла ⇒
#             расход кодеров ляжет на один счёт, разделить нельзя) · GATEWAY_MCP · GATEWAY_PORT
#             (он громкий сам) · GATEWAY_MAX_TURNS (безвреден)
set -u
IMYA=${1:?имя агента (alfa|beta|gamma|iskra|...)}
F=${2:-/etc/claude-oauth/instance-$IMYA.env}
OZHID=${3:-}                      # ожидаемый поставщик; не задан — только проверка имён

[ -f "$F" ] || { echo "🔴 СЛЕПОТА: нет файла $F — проверять нечего, это НЕ чисто"; exit 2; }
# 🔴 -f НЕ ЗНАЧИТ «читается»: файл может существовать, а права не дать его открыть.
# Замер 22.09: права 000 ⇒ grep говорит «Permission denied», STROK выходит ПУСТОЙ,
# страж ниже ломается о пустую переменную («integer expression expected») и пускает
# дальше, все признаки дают 0, прибор печатает «✅ чужих имён нет» и ВЫХОДИТ С НУЛЁМ.
# Пустое не равно пустому: здесь пустое означало отказ добычи, а не отсутствие беды.
[ -r "$F" ] || { echo "🔴 СЛЕПОТА: $F есть, но НЕ ЧИТАЕТСЯ (права $(stat -c %A "$F" 2>/dev/null)) — это НЕ чисто"; exit 2; }
STROK=$(grep -cvE '^\s*(#|$)' "$F"); KOD=$?
# ⚠️ ГРАНИЦА ПРАВИЛА ДЛЯ grep (замер 22.09): код 1 у grep — это ЗАКОННОЕ «совпадений
# нет», а не отказ. Отказ начинается с 2 (нет файла, нет прав). Правило «добыто
# только при коде 0» к grep напрямую не применимо — различитель здесь «код ≥ 2».
[ "$KOD" -le 1 ] || { echo "🔴 СЛЕПОТА: счёт значащих строк НЕ ДОБЫТ (код grep $KOD) — это НЕ чисто"; exit 2; }
[ -n "$STROK" ] || { echo "🔴 СЛЕПОТА: счёт значащих строк пуст при коде $KOD — источник не ответил"; exit 2; }
[ "$STROK" -eq 0 ] && { echo "🔴 СЛЕПОТА: в $F нет ни одной значащей строки"; exit 2; }
echo "предмет: $F · значащих строк: $STROK · агент: $IMYA"

BEDA=0
# 1. ЧУЖОЕ ИМЯ АГЕНТА (признак Искры: ловит КЛАСС копирования, а не поле)
CHUZHIE=""
for A in iskra dsh petrovich alfa beta gamma; do
  [ "$A" = "$IMYA" ] && continue
  # 🔴 ТОЛЬКО В ЗНАЧЕНИЯХ, НЕ В КОММЕНТАРИЯХ (14.09, первое боевое применение поймало
  #    меня же: в комментарии стояло «не копировать для beta/gamma» — прибор покраснел
  #    на РЕЧИ О ПРЕДМЕТЕ. Класс Искры: прибор, читающий файл со своим описанием, обязан
  #    различать предмет и речь о нём. Различитель — ПОЗИЦИЯ: значение после «=».)
  N=$(grep -E '^[[:space:]]*[A-Z_]+=' "$F" | cut -d= -f2- | grep -cE "(^|[^a-z])$A([^a-z]|$)" || true)
  [ "$N" -gt 0 ] && CHUZHIE="$CHUZHIE $A($N)"
done
if [ -n "$CHUZHIE" ]; then
  echo "🔴 ЧУЖОЕ ИМЯ АГЕНТА В ЕГО env:$CHUZHIE"
  grep -nE "(^|[^a-z])($(echo $CHUZHIE | sed 's/([0-9]*)//g;s/ /|/g;s/^|//'))([^a-z]|$)" "$F" | grep -vE '^\s*[0-9]+:\s*#' | sed 's/=.*/=<значение скрыто>/;s/^/     /'
  echo "     ⇒ похоже на копирование чужого образца. Тихие беды: рабочий каталог, агент компакта"
  BEDA=1
else
  echo "✅ чужих имён агентов нет"
fi
# контроль зрячести признака: СВОЁ имя обязано находиться
SVOE=$(grep -E '^[[:space:]]*[A-Z_]+=' "$F" | cut -d= -f2- | grep -cE "(^|[^a-z])$IMYA([^a-z]|$)" || true)
echo "   контроль зрячести: своё имя «$IMYA» — $SVOE вхождений (0 = признак слеп, смотреть глазами)"

# 2. ПОСТАВЩИК ПРОТИВ ОЖИДАЕМОГО (закрывает то, что имя агента не ловит)
# 🔴 код берётся у ДОБЫВАЮЩЕЙ команды (grep), а не у конвейера: tail/cut/tr вернут 0
# даже когда grep не смог открыть файл. Отдельным прогоном, потому что у конвейера
# код последней команды, а нам нужен код первой.
grep -E '^\s*GATEWAY_POSTAVSHIK=' "$F" >/dev/null 2>&1; KOD=$?
[ "$KOD" -le 1 ] || { echo "🔴 СЛЕПОТА: поставщик НЕ ДОБЫТ (код grep $KOD) — это НЕ «не задан»"; exit 2; }
P=$(grep -E '^\s*GATEWAY_POSTAVSHIK=' "$F" | tail -1 | cut -d= -f2- | tr -d '"'"'"' ' || true)
if [ -z "$P" ]; then
  echo "⚠️ GATEWAY_POSTAVSHIK не задан — шлюз ОТКАЖЕТ при старте (громко, это не тихая беда)"
elif [ -n "$OZHID" ]; then
  if [ "$P" = "$OZHID" ]; then echo "✅ поставщик «$P» совпал с ожидаемым"
  else echo "🔴 ПОСТАВЩИК «$P», А ОЖИДАЛСЯ «$OZHID» — это ПЯТАЯ беда: значение верное, но ЧУЖОЕ"; BEDA=1; fi
else
  echo "⚠️ поставщик «$P» — ОЖИДАЕМЫЙ НЕ НАЗВАН, сверить не с чем (дай третьим доводом)"
fi
# 3. ОХВАТ ЧИСЛОМ — обязателен, иначе прибор читается шире, чем он есть
VSEGO_PEREM=$(grep -cE '^\s*[A-Z_]+=' "$F")
echo "📊 ОХВАТ: проверено 3 признака из $VSEGO_PEREM переменных (имя агента в 2 + поставщик в 1)"
echo "   НЕ проверены: токен · ключ DeepSeek · MCP · порт · предел ходов — им нужен список ожидаемого"
exit $BEDA
