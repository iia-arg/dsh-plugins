  echo "🔴 ОТКАЗ: бой изменён после предполётной сверки — ${#RO[@]} из $N; не заменён ни один файл вызова, временные убраны (B-N-1848)" >&2
  zhurnal "otkaz-osnova-pod-zamkom punkt=$PUNKT boj=$BOJ rashozhdenij=${#RO[@]} iz=$N strahovka=${STR:-net}"; exit 2
fi

# B-N-2025: до первой замены, под монтажным замком. Успех не закрывает окно.
OKNO_ROWS=$(mktemp) || { ubrat_vrem; exit 2; }
for ((i = 0; i < N; i++)); do
  printf '%s\t%s\t%s\t%s\t%s\n' "${CEL[$i]}" "$(sha "${VREM[$i]}")" "${VLAD[$i]%:*}" "${VLAD[$i]#*:}" "${REZH[$i]}" >> "$OKNO_ROWS"
done
OKNO_CMD=("${MONTAZH_OKNO_BIN:-/usr/local/sbin/montazh-okno}" podgotovit --task "$PUNKT" --actor "$RUKA" --rows "$OKNO_ROWS" --registry "$REESTR_PL")
[ -z "$OKNO_ID" ] || OKNO_CMD+=(--id "$OKNO_ID")
[ -z "$OKNO_PLAN" ] || OKNO_CMD+=(--plan "$OKNO_PLAN")
if ! OKNO_ID=$("${OKNO_CMD[@]}"); then rm -f "$OKNO_ROWS"; ubrat_vrem; echo 'ОТКАЗ: окно не опубликовано, файлы не заменены' >&2; exit 2; fi
rm -f "$OKNO_ROWS"
# B-N-2039: подсказку --okno-id — только если в окне есть entry: (запись derevo в живом реестре); иначе (новый пакет,
# файлы вне derevo) join невозможен по устройству — каждый каталог своим окном. Запись окна — тот же каталог, что у montazh-okno.
OKNO_ZAP="${MO_STATE_DIR:-/var/lib/montazh-okna}/$OKNO_ID.json"
if [ -r "$OKNO_ZAP" ] && grep -qF '"entry:' -- "$OKNO_ZAP"; then
  # B-N-2042 (У2 ворот): entry: закрывается только после pravka реестра; срок окна 1800 с, просрочка — тревога владельцу.
  echo "ОКНО МОНТАЖА: $OKNO_ID; другие каталоги той же записи derevo — с --okno-id $OKNO_ID; pravka реестра тем же тактом, до 1800 с (иначе просрочка — тревога); закрыть после последнего каталога и pravka: montazh-okno zakryt $OKNO_ID"
elif [ -r "$OKNO_ZAP" ]; then
  echo "ОКНО МОНТАЖА: $OKNO_ID; записи derevo в окне нет (новый пакет или файлы вне derevo) — каждый каталог своим окном, без --okno-id; закрыть сразу: montazh-okno zakryt $OKNO_ID"
else
  echo "ОКНО МОНТАЖА: $OKNO_ID; запись окна не прочитана — есть entry: в окне ⇒ другие каталоги с --okno-id, нет ⇒ каждый своим окном; закрыть: montazh-okno zakryt $OKNO_ID"
fi
okno_ishod() {
  local code=$?
  if [ "$code" -ne 0 ]; then
    "${MONTAZH_OKNO_BIN:-/usr/local/sbin/montazh-okno}" otkaz "$OKNO_ID" || echo "СЛЕПОТА: окно $OKNO_ID не переведено в failed" >&2
  fi
  return "$code"
}
trap 'okno_ishod; strahovka_ishod' EXIT

# ── 3. mv; сбой → откат переложенных ───────────────────────────────────────────────────────────
for ((i = 0; i < N; i++)); do
  if ! mv -f -- "${VREM[$i]}" "${CEL[$i]}"; then
    echo "🔴 mv в ${CEL[$i]} отказал — откатываю переложенные ($i)"
    for ((j = 0; j < i; j++)); do
      if [ "${SUSH[$j]}" = 1 ]; then tar -xpf "$STR" -C / -- "${CEL[$j]#/}" && echo "   возвращён из страховки: ${CEL[$j]}"
      else rm -f -- "${CEL[$j]}" && echo "   удалён новый: ${CEL[$j]}"; fi
    done
    for ((j = i; j < N; j++)); do rm -f -- "${VREM[$j]}"; done
    for ((j = ${#SOZD[@]} - 1; j >= 0; j--)); do rmdir -- "${SOZD[$j]}" 2>/dev/null; done
    zhurnal "otkat punkt=$PUNKT boj=$BOJ na=$i iz=$N strahovka=${STR:-net}"
    exit 1
  fi
done

# ── 4. сверка ─────────────────────────────────────────────────────────────────────────────────
RZ=0
for ((i = 0; i < N; i++)); do
  [ "$(sha "${CEL[$i]}")" = "$(sha "${SRC[$i]}")" ] || { echo "   🔴 ${CEL[$i]} ≠ кандидату"; RZ=$((RZ + 1)); }
  fv=$(stat -c '%u:%g' -- "${CEL[$i]}" 2>/dev/null); fr=$(stat -c '%a' -- "${CEL[$i]}" 2>/dev/null)   # B-N-1817: права — тоже предмет сверки
  [ "$fv" = "${VLAD[$i]}" ] || { echo "   🔴 ${CEL[$i]}: владелец $fv ≠ плану ${VLAD[$i]}"; RZ=$((RZ + 1)); }
  [ -n "$fr" ] && [ $(( 8#$fr )) = $(( 8#${REZH[$i]} )) ] || { echo "   🔴 ${CEL[$i]}: режим ${fr:-?} ≠ плану ${REZH[$i]}"; RZ=$((RZ + 1)); }
done
if [ "$RZ" -gt 0 ]; then
  echo "🔴 СВЕРКА НЕ СОШЛАСЬ: $RZ из $N. Откат: ${STR:+tar -xpf $STR -C / ; }новые удалить: $(for ((i = 0; i < N; i++)); do [ "${SUSH[$i]}" = 0 ] && printf '%s ' "${CEL[$i]}"; done)"
  zhurnal "sverka-ne-soshlas punkt=$PUNKT boj=$BOJ rashozhdenij=$RZ iz=$N strahovka=${STR:-net}"
  exit 1
fi
echo "✅ ПОЛОЖЕНО И СВЕРЕНО (сумма, режим, владелец): $N из $N · страховка ${STR:-нет (все новые)}"
[ -n "$RAVNY_STR" ] && echo "$RAVNY_STR"
zhurnal "smontirovano punkt=$PUNKT boj=$BOJ fajlov=$N novyh=$((N - SUSHCH)) bez_izmenenij=${#RAVNY[@]} strahovka=${STR:-net}"

# ── 4б. B-N-923: коммит учёта git — ровно смонтированные пути, по корню ─────────────────────────
git_kommit монтаж ""

# ── 5. B-N-922: монтаж в dorabotki → письмо хозяйке ───────────────────────────────────────────
V_DORAB=(); for ((i = 0; i < N; i++)); do [[ "${CEL[$i]}" == "$DORAB"/* ]] && V_DORAB+=("$i"); done
[ ${#V_DORAB[@]} -gt 0 ] || exit "$KOD_GIT"
TELO=$(
  echo "smontirovat-fajly → Искре: смонтировано в твои dorabotki (пункт $PUNKT, рука ${SUDO_USER:-$(id -un)})"
  echo
  for i in "${V_DORAB[@]}"; do echo "  ${CEL[$i]} · было ${DO[$i]} → стало $(sha "${CEL[$i]}" | cut -c1-16)"; done
  echo "страховка: ${STR:-нет (все новые; откат = удалить новые)}"
  [ -n "$RAVNY_STR" ] && echo "$RAVNY_STR"
  for c in "${BEZ_UCH[@]}"; do echo "⚠️ новый файл БЕЗ строки учёта: $c — впиши строку в список nashi-dorabotki.sh, иначе ночной --check даст 1 (B-N-1028)"; done
  echo "за тобой: nashi-dorabotki.sh --save (учёт сумм), затем --check"
  echo "(письмо положил сам инструмент после сверки, B-N-922)"
)
pismo_iskre "$TELO" монтаж
