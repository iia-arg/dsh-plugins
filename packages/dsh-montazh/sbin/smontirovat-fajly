  [ "$(realpath -m -- "$BOJ/$rel")" = "$(realpath -m -- "$NASHI")" ] && { NASHI_EFF="$KAND/$rel"; echo "список учёта nashi — из кандидата этого вызова ($rel едет тем же окном)"; }
done
OSNI=(); BEZ_UCH=(); SRC=(); CEL=(); SUSH=(); VLAD=(); REZH=(); ZAKR=(); PRIM=(); DO=(); RAVNY=(); declare -A VIDEL
for rel in "${FAJLY[@]}"; do
  [[ "$rel" == /* || "/$rel/" == */../* || -z "$rel" ]] && otkaz "путь «$rel» — абсолютный или с «..»"
  s="$KAND/$rel"
  { [ -f "$s" ] && [ ! -L "$s" ] && [ -r "$s" ]; } || otkaz "файл кандидата не обычный или не читается: $rel"
  c0="$BOJ/$rel"; prim=""
  if [ ! -e "$c0" ] && [ ! -L "$c0" ] && [ "$NOVYJ" = 0 ]; then
    otkaz "в бою нет имени $c0 (путь кандидата: $rel): проверьте имя; новый файл разрешается только явным --novyj (B-N-1693)"
  fi
  if [ -L "$c0" ]; then
    c=$(realpath -e -- "$c0" 2>/dev/null) || otkaz "битая ссылка в бою: $c0"
    [ -f "$c" ] || otkaz "ссылка в бою не на обычный файл: $c0 → $c"
    prim="ссылка → монтирую в цель $c (A-H-179)"
  elif [ -e "$c0" ] && [ ! -f "$c0" ]; then
    otkaz "боевое имя не файл: $c0"
  else
    c=$(realpath -m -- "$c0")
  fi
  [ -n "${VIDEL[$c]:-}" ] && otkaz "две записи в одну цель: $c"
  VIDEL[$c]=1
  if [[ "$c" =~ ^(.*/\.dsh)/(profiles/[^/]+/)?cordis\.patch\.yml$ ]]; then
    zs=$(profil_zanyat "${BASH_REMATCH[1]}"); zk=$?
    if [ "$zk" = 0 ]; then prim="${prim:+$prim; }профиль агента: $zs"
    elif [ "$NA_HODU_ZADAN" = 1 ]; then
      prim="${prim:+$prim; }⚠️ ПРОФИЛЬ НА ХОДУ по ключу: $zs"
      echo "⚠️ ПРОФИЛЬ НА ХОДУ по ключу (B-N-1014): $c — $zs · причина «$NA_HODU»"
      zhurnal "profil-na-hodu punkt=$PUNKT cel=$c sostoyanie=$zs prichina=$NA_HODU"
    elif [ "$zk" = 1 ]; then
      otkaz "профиль ЗАНЯТОГО агента: $c — $zs. Правка профиля применяется СРАЗУ и снимает волокно изменённой записи (у telegram-multiagent — с ходом и очередью писем): дождитесь пустого хода или --profil-na-hodu='почему' (B-N-1014)"
    else
      otkaz "занятость агента для $c не установить: $zs — не знаю ≠ можно; --profil-na-hodu='почему' (B-N-1014)"
    fi
  fi
  if [ -n "${PARA[$c]:-}" ]; then
    ish=${PARA[$c]}
    [ -f "$ish" ] && [ -r "$ish" ] || otkaz "$c стоит боем в паре, а исходника $ish нет/не читается — сначала выпуск/правка исходника $ish (B-N-971)"
    [ "$(sha "$ish")" = "$(sha "$s")" ] || otkaz "кандидат $rel ≠ исходнику пары $ish (кандидат $(sha "$s" | cut -c1-16), исходник $(sha "$ish" | cut -c1-16)) — сначала выпуск/правка исходника $ish (B-N-971)"
    prim="${prim:+$prim; }= исходнику пары $ish"
  fi
  if [ -f "$c" ] && [ "$(sha "$c")" = "$(sha "$s")" ]; then RAVNY+=("$rel"); continue; fi   # B-N-1576: равный бою не монтируется
  if [ ${#OSN[@]} -gt 0 ]; then   # B-N-1848: бой обязан равняться основе, от которой собран кандидат
    [ -n "${OSN[$rel]+x}" ] || otkaz "--osnova задана не всем монтируемым файлам: нет для «$rel» (B-N-1848)"
    ob=${OSN[$rel]}
    if [ "$ob" = net ]; then
      { [ -e "$c" ] || [ -L "$c" ]; } && otkaz "основа $rel — «файла нет», а в бою он есть: $c (сумма $(sha "$c" | cut -c1-16)) — чужой новый не затираю (B-N-1848)"
    else
      [ -f "$c" ] || otkaz "основа $rel задана ($ob), а в бою файла $c нет (B-N-1848)"
      bs=$(sha "$c")
      [ "${bs:0:${#ob}}" = "$ob" ] || otkaz "бой ≠ основе: $c — основа $ob, бой ${bs:0:${#ob}} — бой изменён после снятия кандидата; пересобери кандидат от текущего боя (B-N-1848)"
    fi
    prim="${prim:+$prim; }основа сверена ${ob:0:16}"
  fi
  OSNI+=("${OSN[$rel]:-}")   # B-N-1848: основа по индексу цели — для сверки под замком (2б)
  if [ -f "$c" ]; then
    su=1; vl=$(stat -c '%u:%g' -- "$c"); rz=$(stat -c '%a' -- "$c"); DO+=("$(sha "$c" | cut -c1-16)")
  else
    su=0; DO+=("новый"); p=$(dirname -- "$c"); while [ ! -d "$p" ]; do p=$(dirname -- "$p"); done
    sosedi "$c" "$s"   # B-N-1817: было «режим кандидата & 0755, владелец ближайшего каталога» — 600 кандидата уезжало в бой 600
    if [ -n "$MODE_KL" ]; then rz=$MODE_KL; osr="ключ --mode"; elif [ -n "$S_REZH" ]; then rz=$S_REZH; osr=$S_OSN_R
    else otkaz "режим нового $c не установить: $S_OSN_R — задайте --mode=NNN (B-N-1817)"; fi
    # Вениамин 03:07Z: одно правило на обе ветки — прежняя маска & 0755 срезала g+w/o+w/suid/sgid всегда; от соседей режим не маскируется, поэтому отказ
    (( 8#$rz & 8#6022 )) && otkaz "режим нового $c = $rz ($osr) даёт запись группе/прочим или suid/sgid — не ставлю; задайте --mode=NNN без них (B-N-1817)"
    if [ -n "$OWNER_KL" ]; then vl=$OWNER_KL; osv="ключ --owner"; elif [ -n "$S_VLAD" ]; then vl=$S_VLAD; osv=$S_OSN_V
    else otkaz "владельца нового $c не установить: $S_OSN_V — задайте --owner=uid:gid (B-N-1817)"; fi
    prim="${prim:+$prim; }новый · режим $rz — $osr · владелец $vl — $osv"
    if [[ "$c" == "$DORAB"/* ]]; then
      v_spiske_nashi "$c"; vk=$?
      # 🔴 B-N-1098 (26.09.2026, Михалыч; наряд Забавы): было ПРЕДУПРЕЖДЕНИЕ (B-N-1028), стало ОТКАЗ до записи.
      # За 26.09 четыре раза новый файл в dorabotki ставили без строки учёта, и ночной --check Искры краснел;
      # предупреждение читала память монтирующей — это не защита. Строка может ехать ЭТИМ ЖЕ вызовом (NASHI_EFF, B-N-1028б).
      [ "$vk" = 1 ] && otkaz "сначала строка учёта: $c — впиши «|$c|» в список $NASHI (или привези кандидат nashi-dorabotki.sh этим же вызовом) (B-N-1098)"
      [ "$vk" = 2 ] && otkaz "список учёта $NASHI_EFF не прочитан — строку учёта для нового $c не проверить (B-N-1098)"
    fi
  fi
  (( ${rz: -1} & 4 )) && zk=0 || zk=1
  SRC+=("$s"); CEL+=("$c"); SUSH+=("$su"); VLAD+=("$vl"); REZH+=("$rz"); ZAKR+=("$zk"); PRIM+=("$prim")
done
N=${#CEL[@]}; SUSHCH=0; KLYUCH=0; M=$((N + ${#RAVNY[@]}))
