# ── 2. временные имена рядом с целями ──────────────────────────────────────────────────────────
VREM=(); SOZD=()
ubrat_vrem() { for t in "${VREM[@]}"; do [ -n "$t" ] && rm -f -- "$t"; done
               # B-N-2036: зовётся только до первой замены — своя страховка не нужна; иначе повтор в ту же секунду: «страховка уже есть»
               if [ "${STR_MOYA:-0}" = 1 ] && rm -f -- "$STR"; then STR_MOYA=0; echo "страховка снята (в бою ничего не заменено): $STR"; fi
               for ((j = ${#SOZD[@]} - 1; j >= 0; j--)); do rmdir -- "${SOZD[$j]}" 2>/dev/null; done; }
for ((i = 0; i < N; i++)); do
  c=${CEL[$i]}; d=$(dirname -- "$c")
  if [ ! -d "$d" ]; then
    p=$d; nov=(); while [ ! -d "$p" ]; do nov=("$p" "${nov[@]}"); p=$(dirname -- "$p"); done
    for k in "${nov[@]}"; do
      install -d -o "${VLAD[$i]%:*}" -g "${VLAD[$i]#*:}" -m 755 -- "$k" || { ubrat_vrem; echo "🔴 не создан каталог $k — в бою ничего не заменено"; exit 1; }
      SOZD+=("$k")
    done
  fi
  t=$(mktemp -- "$d/.$(basename -- "$c").smf-XXXXXX") || { ubrat_vrem; echo "🔴 не создано временное имя в $d — в бою ничего не заменено"; exit 1; }
  VREM+=("$t")
  install -o "${VLAD[$i]%:*}" -g "${VLAD[$i]#*:}" -m "${REZH[$i]}" -- "${SRC[$i]}" "$t" \
    || { ubrat_vrem; echo "🔴 install ${SRC[$i]#$KAND/} отказал — в бою ничего не заменено"; exit 1; }
