    || { ubrat_vrem; echo "🔴 временная копия ${SRC[$i]#$KAND/} ≠ кандидату — в бою ничего не заменено"; exit 1; }
done

# ── 2б. B-N-1848: замок монтажа и сверка основы ПОД НИМ — по ВСЕМ файлам, затем mv всех ───────────
