if ! flock -w 300 8; then ubrat_vrem; echo "🔴 ОТКАЗ: замок $ZAMOK занят дольше 300 с (другой монтаж) — в бою ничего не заменено (B-N-1848)" >&2; zhurnal "otkaz-zamok-zanyat punkt=$PUNKT"; exit 2; fi
RO=()
for ((i = 0; i < N; i++)); do
