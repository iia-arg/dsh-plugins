if [ "$N" = 0 ]; then   # B-N-1576
  echo "$RAVNY_STR"
  echo "🔴 ОТКАЗ: монтировать нечего — кандидат $KAND равен бою $BOJ во всех $M файлах; страховки, записи, коммита и письма нет (код 3)" >&2
  zhurnal "montirovat-nechego punkt=$PUNKT boj=$BOJ fajlov=$M"
  exit 3
fi
for ((i = 0; i < N; i++)); do
  [ "${SUSH[$i]}" = 1 ] && { SUSHCH=$((SUSHCH + 1)); [ "${ZAKR[$i]}" = 1 ] && KLYUCH=1; }
