[Unit]
Description=Недельный прогон долгих стендов (B-N-1074): среда 16:00 UTC — час наименьшего числа монтажей (01–15.10: 23 против 35–77; в 01:30 машина бывала красной от окон и stend-storozha-reestrov слеп), до apt-daily 18:00 и копии OMEGA 18:20, вне ночного обхода 03:40, не в воскресенье (mdcheck/e2scrub)

[Timer]
OnCalendar=Wed *-*-* 16:00:00 UTC
Persistent=true
AccuracySec=1min
Unit=vse-stendy-nedelnye.service

[Install]
WantedBy=timers.target
