STRAHOVKA_UMOLCH = '/var/backups/montazh/B-N-738-zhurnaly'
REESTR = '/etc/agent-registry/agents.yaml'
ISTORIYA = {'kind': 'agent-message', 'form': 'relay', 'senderSessionId': 'a2a:istoriya'}
# Неоткрываемые в 0.2 (прогон мелких сессий 29.09 ~18:0xZ; признаки сняты сканом 52 журналов 29.09 19:1xZ): агент, путь КАТАЛОГА сессии
# относительно <DSH_HOME>/sessions, sha256 журнала. Сумма не сошлась — файл НЕ переносится (могли тронуть, это уже не тот предмет).
NEOTKRYVAEMYE = [
