[Unit]
Description=Scheduled memory maintenance: proposals only
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=omega
Group=omega
ExecStartPre=+/usr/bin/python3 -I -S -B /usr/local/lib/dsh-pamyat-obsluzhivanie/prepare_key.py prepare
ExecStopPost=+/usr/bin/python3 -I -S -B /usr/local/lib/dsh-pamyat-obsluzhivanie/prepare_key.py remove
# RU: Реестр агентов, источник ключа, место установки runner.py и доступ к спулу тревог — данные конкретной машины:
#     их задаёт вставка машины (Environment=AGENTS_REGISTRY, OBSL_KLYUCH_HOME, OBSL_KLYUCH_HRANILISHCHE, OBSL_RUNNER;
#     группа спула agent-alert), а не этот файл. Токен бота тревог службе не выдаётся (3.1.5, B-N-2055): agent-alert
#     от omega его не читает и сдаёт тревогу в спул root-отправителя.
# EN: The agent registry, the key source, the runner.py install location and access to the alert spool are machine
#     data: a machine drop-in sets them (Environment=AGENTS_REGISTRY, OBSL_KLYUCH_HOME, OBSL_KLYUCH_HRANILISHCHE,
#     OBSL_RUNNER; the agent-alert spool group), not this file. The alert bot token is not given to the service
#     (3.1.5, B-N-2055): agent-alert running as omega cannot read it and drops the alert into the root sender's spool.
Environment=DEEPSEEK_CREDENTIAL_FILE=/run/dsh-pamyat-obsluzhivanie-key/deepseek
ExecStart=/opt/omega/venv/bin/python3 -B ${OBSL_RUNNER} --run
StateDirectory=dsh-pamyat-obsluzhivanie
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
TimeoutStartSec=60min
TimeoutStopSec=90s
KillMode=control-group
Restart=no
Nice=10
MemoryMax=4G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# RU: писателю уроков (учётка omega) нужна запись в OMEGA; судья открывает источник только на чтение (mode=ro).
# EN: the omega lesson writer needs write access; the judge opens the source read-only (mode=ro).
# RU: root-помощники — только стандартная библиотека, установлены вне каталогов пакета, доступных на запись.
# EN: root helpers are stdlib-only, installed outside writable package trees.
Environment=HOME=/var/lib/omega
Environment=OMEGA_HOME=/var/lib/omega/.omega
Environment=OMEGA_EMBEDDING_MODEL=bge-m3
Environment=OMEGA_EMBEDDING_MODEL_DIR=/var/lib/omega/.cache/omega/models/bge-m3-onnx
Environment=OMEGA_EMBEDDING_DIM=1024
Environment=OMEGA_EMBEDDING_POOLING=cls
Environment=OMEGA_EMBEDDING_PAD_TOKEN=<pad>
Environment=OMEGA_EMBEDDING_PAD_ID=1
Environment=HF_HUB_OFFLINE=1
Environment=OMEGA_RERANKER_AUTODOWNLOAD=0
