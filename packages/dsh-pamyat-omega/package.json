{
  "name": "dsh-pamyat-omega",
  "version": "3.1.4",
  "description": "Долговременная память, подтверждение доставки и поиск по MCP · Long-term memory, delivery confirmation and retrieval over MCP",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "test",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "test": "r=0; for f in test/stend-*.mjs; do node \"$f\"; c=$?; if [ $c -eq 1 ]; then r=1; elif [ $c -eq 2 ] && [ $r -ne 1 ]; then r=2; elif [ $c -ne 0 ] && [ $c -ne 2 ] && [ $r -ne 1 ]; then r=$c; fi; done; exit $r"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-pribory": "^3.1.2"
  },
  "peerDependenciesMeta": {
    "dsh-pribory": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Aleksandr Argelander",
  "keywords": [
    "память-агента · agent-memory",
    "долговременная-память · long-term-memory",
    "подтверждение-доставки · delivery-confirmation",
    "MCP · mcp"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iia-arg/dsh-plugins.git",
    "directory": "packages/dsh-pamyat-omega"
  }
}
