#!/usr/bin/python3
"""0 clear; 1 overdue; 2 incomplete/error. One alert per AGENT per 6 h (count + oldest letter); each letter alerted at most once.
Readonly channel DBs; own durable state. N=300s; timer=60s. No message bodies.
Env (tests/operators): A2A_COPY_NOW_MS, A2A_COPY_REGISTRY, A2A_COPY_STATE, A2A_COPY_ALERT; A2A_COPY_POCHTALON_LOG — ONLY for harnesses:
a file read instead of the postman journal (no cursor, no cache). Never set it on the live unit: it replaces the proof of display.
"""
import argparse,fcntl,hashlib,json,os,re,sqlite3,stat,subprocess,sys,time
from pathlib import Path
import yaml
N_MS=300000
MARK=re.compile(r'^\d{8}T\d{6}Z-[A-Za-z0-9_.-]+-ownerall-[a-zA-Z0-9]+\.txt$')
# B-N-1649: since telegram 2.5.87 the plugin does not copy a spool letter the postman already showed; the postman's own journal line
# for that exact <mailbox>/<file> is the proof of display. Its failure line ('копия владельцу НЕ ушла') is not proof: DELAY stays.
POKAZANO=re.compile(r'^\[почтальон\] ([^/\s]+/[^/\s]+): владельцу показано \(чат [a-z_][a-z0-9_-]*\)$')
OKNO_POCHTALONA_MS=48*3600*1000
OSTYVANIE_MS=6*3600*1000

def pokazano_pochtalonom(db,since_ms,now,write):
    """Keys '<mailbox>/<file>' the postman showed. Kept in own state; each run reads the journal only after the saved cursor
    (first run, or a lost cursor: at most the last 48 h). --inspect reads the same but saves nothing."""
    fixture=os.environ.get('A2A_COPY_POCHTALON_LOG')
    if fixture:return {m.group(1) for m in map(POKAZANO.match,Path(fixture).read_text().splitlines()) if m}
    est=db is not None and db.execute("SELECT 1 FROM sqlite_master WHERE name='pokazano'").fetchone()
    cursor=(db.execute("SELECT value FROM control WHERE key='pochtalon_cursor'").fetchone() or [None])[0] if est else None
    base=['journalctl','-u','a2a-pochtalon.service','-o','cat','--no-pager','-q','--show-cursor']
    okno=['--since','@'+str(max(since_ms,now-OKNO_POCHTALONA_MS)//1000)]
    z=subprocess.run(base+(['--after-cursor',cursor] if cursor else okno),capture_output=True,text=True,timeout=40)
    if z.returncode!=0 and cursor:z=subprocess.run(base+okno,capture_output=True,text=True,timeout=40)
    if z.returncode!=0:raise ValueError('postman journal unreadable: rc='+str(z.returncode))
    lines=z.stdout.splitlines();novyj=None
    if lines and lines[-1].startswith('-- cursor: '):novyj=lines.pop()[len('-- cursor: '):]
    new={m.group(1) for m in map(POKAZANO.match,lines) if m}
    old={x[0] for x in db.execute('SELECT key FROM pokazano')} if est else set()
    if write and est:
        for key in new:db.execute('INSERT OR IGNORE INTO pokazano VALUES(?,?)',(key,now))
        # The per-receipt verdict lives in notices ('pokazano'), so the journal cache can be pruned.
        db.execute('DELETE FROM pokazano WHERE at<?',(now-OKNO_POCHTALONA_MS,))
        if novyj:db.execute("INSERT OR REPLACE INTO control VALUES('pochtalon_cursor',?)",(novyj,))
        db.commit()
    return old|new

def connect_ro(path):
    if not path.is_file():raise ValueError('ledger missing: '+str(path))
    c=sqlite3.connect(path.as_uri()+'?mode=ro',uri=True,timeout=1)
    c.execute('PRAGMA query_only=ON');deadline=time.monotonic()+2
    c.set_progress_handler(lambda:int(time.monotonic()>deadline),1000)
    c.row_factory=sqlite3.Row;c.execute('BEGIN')
    return c

def inspect(registry,now,since):
    data=yaml.safe_load(registry.read_text());agents=data.get('agenty')
    if not isinstance(agents,list)or not agents:raise ValueError('empty registry')
    pending=[];errors=[];seen=[]
    for a in agents:
        name=a['imya'];n=a['namerenie'];k=n.get('kanal',{})
        if k.get('tip')!='telegram':continue
        if not re.fullmatch('[a-z][a-z0-9_-]{0,63}',name):raise ValueError('invalid agent name')
        seen.append(name);owner_all=False
        mode=k.get('rezhim_dostavki')
        owner_all=mode=='owner-all'
        if mode not in ('owner-all','personal','broadcast'):errors.append(name+': registry mode missing/invalid')
        c=None
        try:
            db=Path(n['dom'])/'workspace/.message-receipts/receipts.sqlite';c=connect_ro(db)
            if c.execute('PRAGMA user_version').fetchone()[0]!=2:raise ValueError('unsupported ledger version')
            known={Path(x[0]).name for x in c.execute('SELECT path FROM sources WHERE path IS NOT NULL')}
            # B-N-1595: receipts of the signed stop path never get a question copy (no question exists): control, refusal,
            # conflict, replacement; in-flight controls are recognised by mail_stop_controls (absent before telegram 2.5.72).
            # B-N-1599: pollReceiptDirectory finishes these branches locally before copyAsk (signature refusal, empty letter, signed /goal,
            # capability probe, signed task-control); each outcome is written by that branch only. Holds (blocked, unfinished) stay reported.
            stops=c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='mail_stop_controls'").fetchone()
            q="""SELECT id,received_at FROM receipts r WHERE route='a2a' AND received_at>=? AND received_at<=?
              AND duplicate_of IS NULL AND COALESCE(outcome,'')!='operator_discarded'
              AND substr(COALESCE(outcome,''),1,10)!='mail_stop_' AND COALESCE(blocked,'')!='mail_stop_intake'
              AND substr(COALESCE(logical_key,''),1,5)!='stop-'
              AND NOT(r.finished_at IS NOT NULL AND COALESCE(outcome,'') IN ('signature_rejected','empty','channel_completed','capability_response','task_control_recorded'))"""+("""
              AND NOT EXISTS(SELECT 1 FROM mail_stop_controls m WHERE m.receipt_id=r.id OR m.replacement_receipt=r.id)""" if stops else '')+"""
              AND NOT EXISTS(SELECT 1 FROM outbox o WHERE o.id=r.id||':copy:question' AND o.sent_at IS NOT NULL)
              ORDER BY received_at"""
            for row in c.execute(q,(since,now-N_MS)):
                paths=[x[0]for x in c.execute('SELECT path FROM sources WHERE receipt_id=? AND path IS NOT NULL',(row['id'],))]
                if not owner_all and not any(MARK.fullmatch(Path(p).name)for p in paths):continue
                keys=['receipt:'+name+':'+row['id']]+['source:'+name+':'+Path(p).name for p in paths]
                pending.append({'keys':keys,'text':name+': нет подтверждения question; receipt='+row['id'],'age_s':(now-row['received_at'])//1000,
                    'pisma':[Path(p).parent.name+'/'+Path(p).name for p in paths],'received_at':row['received_at']})
            spool=Path(k['yashchik'])
            if not spool.is_dir():raise ValueError('spool missing')
            for f in spool.iterdir():
                if not MARK.fullmatch(f.name)or f.is_symlink()or not f.is_file()or f.name in known:continue
                age=now-int(f.stat().st_mtime*1000)
                if age>=N_MS:
                    pending.append({'keys':['source:'+name+':'+f.name],'text':name+': письмо ещё не принято; файл='+f.name,'age_s':age//1000})
        except Exception as e:errors.append(name+': '+type(e).__name__+' '+str(e)[:160])
        finally:
            if c:c.close()
    if not seen:raise ValueError('no Telegram agents')
    return pending,errors,seen

def apply_baseline(db, registry, manifest, now):
    if db.execute("SELECT 1 FROM control WHERE key='baseline'").fetchone():
        raise ValueError('baseline already recorded; repeated --baseline refused')
    if db.execute('SELECT 1 FROM notices LIMIT 1').fetchone():
        raise ValueError('notices is not empty; baseline must precede alerts, nothing changed')
    fd=os.open(manifest,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,'rb') as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):raise ValueError('baseline manifest must be a regular file')
        raw=stream.read(1048577)
    if len(raw)>1048576:raise ValueError('baseline manifest exceeds 1 MiB')
    plan=json.loads(raw)
    if not isinstance(plan,dict) or set(plan)!={'version','expected_count','records'} or type(plan['version']) is not int or plan['version']!=1:
        raise ValueError('invalid baseline manifest schema')
    records=plan['records']
    if not isinstance(records,list) or type(plan['expected_count']) is not int or len(records)!=plan['expected_count']:
        raise ValueError('baseline record count mismatch')
    config=yaml.safe_load(registry.read_text());agents={x['imya']:x['namerenie'] for x in config['agenty']}
    grouped={};keys=set()
    for row in records:
        if not isinstance(row,dict) or set(row)!={'agent','receipt_id','received_at'}:raise ValueError('invalid baseline record')
        name=row['agent'];rid=row['receipt_id'];received=row['received_at']
        if not isinstance(name,str) or not re.fullmatch('[a-z][a-z0-9_-]{0,63}',name) or name not in agents or agents[name].get('kanal',{}).get('tip')!='telegram':raise ValueError('unknown baseline agent')
        if not isinstance(rid,str) or not re.fullmatch('[A-Za-z0-9:_-]{1,128}',rid):raise ValueError('invalid receipt identity')
        if type(received) is not int or received<0 or received>now-N_MS:raise ValueError('baseline record is not old enough')
        key='receipt:'+name+':'+rid
        if key in keys:raise ValueError('duplicate baseline identity')
        keys.add(key);grouped.setdefault(name,[]).append(row)
    # Read only each exact approved identity; newly overdue rows are never added to the plan.
    for name,items in grouped.items():
        c=connect_ro(Path(agents[name]['dom'])/'workspace/.message-receipts/receipts.sqlite')
        try:
            if c.execute('PRAGMA user_version').fetchone()[0]!=2:raise ValueError('unsupported baseline ledger version')
            for row in items:
                actual=c.execute('SELECT received_at,route FROM receipts WHERE id=?',(row['receipt_id'],)).fetchall()
                if len(actual)!=1 or actual[0]['received_at']!=row['received_at'] or actual[0]['route']!='a2a':
                    raise ValueError('baseline identity/time differs: '+name+'/'+row['receipt_id'])
        finally:c.close()
    # Only receipt keys, never source aliases: an old basename must not hide a new receipt.
    with db:
        for key in sorted(keys):db.execute('INSERT INTO notices VALUES(?,?,?)',(key,'baseline',now))
        db.execute("INSERT INTO control VALUES('baseline',?)",(json.dumps({'at':now,'count':len(records),'manifest_sha256':hashlib.sha256(raw).hexdigest()}),))
    print('BASELINE receipts='+str(len(records))+' alerts=0 manifest_sha256='+hashlib.sha256(raw).hexdigest())
    for name,items in sorted(grouped.items()):
        print('BASELINE agent='+name+' count='+str(len(items)))
        for row in items:print('  receipt='+row['receipt_id']+' received_at='+str(row['received_at']))
    return 0

def main():
    parser=argparse.ArgumentParser(description=__doc__);group=parser.add_mutually_exclusive_group();group.add_argument('--inspect',action='store_true');group.add_argument('--baseline',metavar='APPROVED_JSON');args=parser.parse_args()
    now=int(os.environ.get('A2A_COPY_NOW_MS',str(time.time_ns()//1000000)))
    registry=Path(os.environ.get('A2A_COPY_REGISTRY','/etc/agent-registry/agents.yaml')).resolve()
    state=Path(os.environ.get('A2A_COPY_STATE','/var/lib/a2a-owner-copy-watch/state.sqlite')).resolve()
    since=0;lock=None;db=None
    try:
        if not args.inspect:
            state.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
            lock=open(state.parent/'lock','a');fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
            db=sqlite3.connect(state,timeout=1);os.chmod(state,0o600)
            db.executescript('CREATE TABLE IF NOT EXISTS notices(key TEXT PRIMARY KEY,status TEXT,at INTEGER);CREATE TABLE IF NOT EXISTS control(key TEXT PRIMARY KEY,value TEXT);CREATE TABLE IF NOT EXISTS pokazano(key TEXT PRIMARY KEY,at INTEGER);CREATE TABLE IF NOT EXISTS agent_alerts(agent TEXT PRIMARY KEY,at INTEGER);')
        elif state.exists():
            # Own state: readonly, but no 2 s deadline (that guards channel DBs); the postman journal read may take ~13 s first.
            db=connect_ro(state);db.set_progress_handler(None,0)
        if args.baseline:return apply_baseline(db,registry,args.baseline,now)
        pending,errors,seen=inspect(registry,now,since)
        shown_count=0;voprosy=[row for row in pending if 'pisma' in row]
        if voprosy:
            try:
                shown=pokazano_pochtalonom(db,min(r['received_at'] for r in voprosy)-600000,now,not args.inspect)
                # any file of the receipt: a second file joins a receipt only with identical bytes (message-receipts receive).
                vidny={r['keys'][0] for r in voprosy if any(n in shown for n in r['pisma'])}
                if not args.inspect and vidny:
                    for key in vidny:db.execute('INSERT OR IGNORE INTO notices VALUES(?,?,?)',(key,'pokazano',now))
                    db.commit()
                pending=[r for r in pending if r['keys'][0] not in vidny];shown_count=len(vidny)
            except Exception as e:errors.append('postman: '+type(e).__name__+' '+str(e)[:160])
        tikho={x[0]:x[1] for x in db.execute("SELECT key,status FROM notices WHERE status IN ('baseline','pokazano')")} if db else {}
        baseline_count=sum(tikho.get(row['keys'][0])=='baseline' for row in pending)
        shown_count+=sum(tikho.get(row['keys'][0])=='pokazano' for row in pending)
        pending=[row for row in pending if row['keys'][0] not in tikho]
        print('agents='+','.join(seen)+' overdue='+str(len(pending))+' baseline='+str(baseline_count)+' threshold_s=300 shown_by_postman='+str(shown_count))
        for row in pending:print('DELAY '+row['text']+' age_s='+str(row['age_s']))
        for error in errors:print('UNVERIFIED '+error,file=sys.stderr)
        if args.inspect:return 2 if errors else (1 if pending else 0)
        batch=[]
        for row in pending:
            found=[db.execute('SELECT status FROM notices WHERE key=?',(key,)).fetchone() for key in row['keys']]
            previous=next((x[0]for x in found if x),None)
            if previous:
                for key in row['keys']:db.execute('INSERT OR IGNORE INTO notices VALUES(?,?,?)',(key,previous,now))
                if previous!='sent':errors.append(row['text']+': alert outcome '+previous+'; manual verification required')
            else:batch.append(row)
        db.commit()
        gruppy={}
        for row in batch:gruppy.setdefault(row['keys'][0].split(':')[1],[]).append(row)
        for agent,rows in sorted(gruppy.items()):
            # B-N-1649 У1(б): at most one alert per agent per 6 h. Letters overdue inside the window stay un-notified and are counted
            # in the next alert after it; they keep printing DELAY in the journal meanwhile.
            last=db.execute('SELECT at FROM agent_alerts WHERE agent=?',(agent,)).fetchone()
            if last and now-last[0]<OSTYVANIE_MS:
                print('COOLDOWN agent='+agent+' letters='+str(len(rows))+' next_after_s='+str((last[0]+OSTYVANIE_MS-now)//1000));continue
            # Persist intent BEFORE I/O: unknown/failed alert is not automatically repeated.
            for row in rows:
                for key in row['keys']:db.execute('INSERT OR IGNORE INTO notices VALUES(?,?,?)',(key,'attempted',now))
            db.execute('INSERT OR REPLACE INTO agent_alerts VALUES(?,?)',(agent,now));db.commit()
            oldest=max(rows,key=lambda x:x['age_s'])
            body=('A2A: задержка копии владельцу более 5 минут\n'+agent+': писем без подтверждения '+str(len(rows))+'; самое старое — '
                +oldest['text']+'; возраст '+str(oldest['age_s'])+'с\nследующая тревога по '+agent+' не раньше чем через 6 ч; перечень — journalctl -u a2a-owner-copy-watch')
            alert=os.environ.get('A2A_COPY_ALERT','/usr/local/bin/agent-alert')
            try:
                z=subprocess.run([alert,'--plain'],input=body,text=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=25,env={'PATH':'/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin','AGENT_ALERT_POPYTOK':'1','AGENT_ALERT_TAJMAUT':'20'})
                status='sent'if z.returncode==0 else 'failed'
            except (OSError,subprocess.TimeoutExpired):status='unknown'
            for row in rows:
                for key in row['keys']:db.execute('UPDATE notices SET status=? WHERE key=?',(status,key))
            db.commit();print('alert='+status+' agent='+agent+' identities='+str(len(rows)))
            if status!='sent':errors.append('agent-alert '+status+'; no automatic resend; inspect state and journal')
        for error in errors:print('ERROR '+error,file=sys.stderr)
        return 2 if errors else (1 if pending else 0)
    finally:
        if db:db.close()
        if lock:lock.close()

if __name__=='__main__':
    try:sys.exit(main())
    except Exception as e:print('a2a-owner-copy-watch: '+type(e).__name__+': '+str(e),file=sys.stderr);sys.exit(2)
