#!/usr/bin/env bash
# srochnoe-novye — сколько писем в срочном канале НЕ ПРОЧИТАНО.
#
# 🔴 ЗАЧЕМ. 06.09.2026 Забава завела срочный канал и в первом же письме назвала его
# границу: «СРОЧНОЕ НЕ ЗОВЁТ — вы узнаете о файле, только если пойдёте смотреть».
# Я не ходила. За сутки там легло 41 письмо, среди них «вы уже подняты», «стоп
# публикации» и два прямых вопроса. Ни одно не прочитано вовремя.
# Граница была НАЗВАНА и всё равно сработала: названная граница не защищает, если
# у читающего нет повода посмотреть. Этот прибор и есть повод.
#
# ЧТО ДЕЛАЕТ: считает файлы новее отметки .prochitano-do и печатает их заголовки.
# ЧЕГО НЕ ДЕЛАЕТ: НЕ ЗОВЁТ САМ — той же болезнью болеет, что и канал. Его надо
# позвать. Лечение полное — дублирование строки-зова в обычный ящик на стороне
# отправителя; здесь только видимость, а не тревога.
set -uo pipefail
KAT="${SROCHNOE:-/opt/iskra/workspace/srochnoe}"
OTM="$KAT/.prochitano-do"
[ -d "$KAT" ] || { echo "срочного каталога нет: $KAT"; exit 2; }
if [ "${1:-}" = "--otmetit" ]; then
  touch "$OTM"; echo "отметка прочтения обновлена: $(date -u '+%F %T UTC')"; exit 0
fi
FIND_ARGS=("$KAT" -maxdepth 1 -type f -name '*.txt')
if [ -f "$OTM" ]; then
  FIND_ARGS+=(-newer "$OTM")
else
  echo "⚠️ отметки прочтения НЕТ — считаю новыми ВСЕ. Это не «их столько пришло»."
fi
novye=$(find "${FIND_ARGS[@]}" 2>&1)
KOD=$?
if [ "$KOD" -ne 0 ]; then
  echo "СЛЕПОТА: не добыт список писем в $KAT: find код $KOD; $novye" >&2
  exit 2
fi
novye=$(printf '%s\n' "$novye" | sort 2>&1)
KOD=$?
if [ "$KOD" -ne 0 ]; then
  echo "СЛЕПОТА: не отсортирован список писем в $KAT: sort код $KOD; $novye" >&2
  exit 2
fi

n=$(printf '%s' "$novye" | grep -c . || true)
if [ "$n" = 0 ]; then echo "срочный канал: новых нет"; exit 0; fi
echo "🔴 срочный канал: НЕ ПРОЧИТАНО $n"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  vremya=$(stat -c %y "$f" 2>&1)
  KOD=$?
  [ "$KOD" -eq 0 ] || { echo "СЛЕПОТА: не добыто время $f: stat код $KOD; $vremya" >&2; exit 2; }
  zagolovok=$(head -1 "$f" 2>&1)
  KOD=$?
  [ "$KOD" -eq 0 ] || { echo "СЛЕПОТА: не добыт заголовок $f: head код $KOD; $zagolovok" >&2; exit 2; }
  printf '   %s  %s\n' "$(printf '%s' "$vremya" | cut -c6-16)" "$(printf '%s' "$zagolovok" | cut -c1-88)"
done <<< "$novye"
exit 1
