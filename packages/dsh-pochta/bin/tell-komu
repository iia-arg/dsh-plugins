#!/usr/bin/env bash
# tell-komu — положить ФАЙЛ в исходящую щель к агентам aclaude, назвав адресата ИМЕНЕМ.
#
# ЗАЧЕМ. Адресация писем наружу делается именем файла (dlya-<кому>-…). Пока файл клали
# в щель руками (cp), проверки имени не было вовсе: файл с ЛЮБЫМ именем уезжал, и при
# неузнанном имени сборщик координатора отдавал письмо ЕЙ. 04.09.2026 так и вышло — моё
# письмо ушло не тому, отправитель был уверен, получатель не знал, что письмо было.
#
# 🔴 УМОЛЧАНИЕ ЗДЕСЬ — ОТКАЗ, А НЕ ДОСТАВКА КОМУ-НИБУДЬ.
# Формулировка Забавы, 04.09: «у канала с разбором адресов умолчание есть всегда, и оно
# молчит». Доставка координатору по умолчанию ХУЖЕ пустоты: письмо ушло, все уверены,
# и никто не узнает. Отказ с ненулевым кодом не пропустит никто.
#
# ГДЕ НЕ ПРИМЕНЯЕТСЯ И КОГДА МЕШАЕТ:
#   — не проверяет, ЧТО написано, только КОМУ; содержимое не читает;
#   — не знает разбора на стороне координатора: сверяет с перечнем, о котором мы
#     договорились в переписке, а не с её кодом. Появится новый адресат — перечень править
#     здесь руками, иначе инструмент откажет законному письму;
#   — осознанный обход есть: A2A_SKIP_ADRESAT=1 (тогда имя не проверяется вовсе);
#   — писать агенту ЭТОЙ машины (Петрович) надо не им, а a2a-send.
#
# ИМЯ ФАЙЛА: dlya-<кому>-<что угодно>. <кому> — РОДИТЕЛЬНЫЙ падеж из $ADRESATY: veniamina, zabavy,
#   mihalycha, vseh («dlya-veniamin-…», «dlya-zabava-…» → отказ, код 3; 28.09 Искра наступила дважды).
#   Дата в имени НЕ обязательна: время и pid инструмент добавит сам. Справка: tell-komu --help (код 3).
#
# КОДЫ: 0 положено и зеркало сохранено | 3 отказ (адресат/файл/права) | 4 положено, зеркала нет

set -uo pipefail
# ClaudeClaw не разбирает v2: этот маршрут не допускает управляющий конверт.
if [ "${1:-}" = "--v2" ]; then
  echo 'ОТКАЗ: tell-komu ведёт на aclaude; v2 разрешён только sadik→sadik' >&2
  exit 3
fi

# #286: ровно одна итоговая запись за процесс, не за каждую промежуточную печать.
# «Передано» означает локальную укладку, НЕ начало хода и НЕ доставку на другой хост.
# Не пишем тело/ответ tell-owner: в них может быть переписка. Поля экранированы %q.
SLED_TRANSFER=ne_podtverzhdena
SLED_REASON=nepredvidennoe_zavershenie
sled_itog() {
  local code="$1" row dest source target reason outcome
  [ "$BASH_SUBSHELL" -eq 0 ] || return 0
  outcome=otkaz
  [ "$SLED_TRANSFER" = ne_podtverzhdena ] || outcome=peredano
  [ "$code" -ne 0 ] || [ "$SLED_TRANSFER" != ne_podtverzhdena ] || outcome=ishod_ne_ustanovlen
  printf -v dest '%q' "${KOMU:-ne_raspoznan}"
  printf -v source '%q' "${F:-ne_zadan}"
  printf -v target '%q' "${TELL_DIR:-ne_vybran}/${IMYA_V_SHCHELI:-ne_sozdano}"
  printf -v reason '%q' "$SLED_REASON"
  row="ishod=$outcome kod=$code peredacha=$SLED_TRANSFER komu=$dest istochnik=$source fajl=$target prichina=$reason pid=$$ uid=$EUID"
  # Одна попытка, 3 с ожидания + 1 с до SIGKILL; отказ журнала не меняет исход отправки.
  if ! timeout -k 1s 3s logger -t tell-komu -- "$row"; then
    printf '%s\n' "tell-komu: журнал НЕ подтвердил запись исхода (ожидание 3+1 с); $row" >&2
  fi
  return 0
}
trap 'sled_itog "$?"' EXIT
# B-N-613 (25.09.2026): сигнал — свой код и своя причина. Без этого EXIT брал "$?" ПРЕЖНЕЙ
# команды: процесс кончался 143, а в журнале стояло «kod=0 ishod_ne_ustanovlen». exit N здесь
# запускает тот же EXIT уже с N. Bash выполняет ловушку после завершения текущей дочерней команды.
trap 'SLED_REASON=signal_TERM; exit 143' TERM
trap 'SLED_REASON=signal_INT; exit 130' INT
trap 'SLED_REASON=signal_HUP; exit 129' HUP


ADRESATY="veniamina mihalycha zabavy vseh"
# №14 A-N-1948 (10.10): справка и пустой вызов — ДО щели и перечня: без годного /etc/a2a/tell-shcheli.list
# справка, обещанная в шапке, иначе недостижима (код 3 «перечень не прочитан»).
F="${1:-}"
if [ -z "$F" ] || [ "$F" = "--help" ] || [ "$F" = "-h" ]; then
  echo "tell-komu <файл>   — имя файла обязано начинаться с dlya-<кому>-" >&2
  echo "  кому: $ADRESATY — родительный падеж (dlya-veniamina-…, не dlya-veniamin-…)" >&2
  echo "  агенту этой машины (petrovich) — не этим инструментом, а a2a-send" >&2
  # справка — тоже код 3 (причина spravka): код 0 без передачи журнал пишет как ishod_ne_ustanovlen (#286)
  if [ -n "$F" ]; then SLED_REASON='spravka'; else SLED_REASON='ne_zadan_fajl'; fi
  exit 3
fi
# 🔴 A-N-664 (23.09.2026, Михалыч): щель — по УЧЁТКЕ АГЕНТА, а не по $HOME. 23.09 11:21Z и 11:32Z
# у Беты среда вызова пришла с HOME=/home/coders (домашний учётки coders по passwd), а юнит задаёт
# /opt/coders/beta: 4 письма легли в /home/coders/a2a/tell, которую не обходит никто, и курьер
# ответил «передано». Корень агента DSH надёжнее — DSH_HOME=/opt/coders/<агент>/.dsh; нет его — $HOME.
_KOREN="${HOME}"
[ -n "${DSH_HOME:-}" ] && _KOREN="${DSH_HOME%/.dsh}"
TELL_DIR="${ZABAVA_TELL_DIR:-$_KOREN/a2a/tell}"
ZERKALO="${A2A_ZERKALO:-$_KOREN/a2a/polnye}"
# A-N-668: единый перечень на sadik. Нет годного перечня — нет разрешённой щели.
TELL_LIST="/etc/a2a/tell-shcheli.list"
# Подмена допустима только как явно объявленная проба; журнал — обязательный след.
if [ "${A2A_TELL_LIST+x}" = x ]; then
  if [ "${A2A_TELL_PROBA:-0}" != 1 ] || [ -z "$A2A_TELL_LIST" ]; then
    echo 'ОТКАЗ tell-komu: подмена перечня требует A2A_TELL_PROBA=1 и непустого A2A_TELL_LIST' >&2
    SLED_REASON='neobyavlennaya_podmena_perechnya'
    exit 3
  fi
  TELL_LIST="$A2A_TELL_LIST"
  printf -v _tell_list_path '%q' "$TELL_LIST"
  _tell_list_notice="перечень подменён: $_tell_list_path (A2A_TELL_PROBA=1)"
  if ! timeout -k 1s 3s logger -t tell-komu -- "$_tell_list_notice"; then
    echo 'ОТКАЗ tell-komu: журнал не подтвердил подмену перечня; письмо НЕ положено' >&2
    SLED_REASON='podmena_perechnya_ne_zapisana'
    exit 3
  fi
  printf 'ПРОБА tell-komu: %s\n' "$_tell_list_notice" >&2
fi
if ! OBHODIMYE_SHCHELI="$(python3 - "$TELL_LIST" <<'PY_TELL_LIST'
import pathlib, sys
try:
    paths = []
    for number, line in enumerate(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"): continue
        parts = line.split()
        # C-N-1670 (06.10, Михалыч): необязательный третий столбец — класс щели; известен только «gost» (его читает
        # sadik-tell-poll на aclaude: пометка У1 и предел У2). Здесь класс не используется — только допускается.
        if len(parts) not in (2, 3) or (len(parts) == 3 and parts[2] != "gost"): raise ValueError(f"строка {number}: нужны щель, имя и необязательный класс gost")
        location, name = parts[0], parts[1]
        path = pathlib.PurePosixPath(location)
        if not path.is_absolute() or path.name != "tell" or str(path) != location or ".." in path.parts or ":" in location or ":" in name:
            raise ValueError(f"строка {number}: негодный путь tell или имя")
        if location in paths: raise ValueError(f"строка {number}: повтор щели")
        paths.append(location)
    if not paths: raise ValueError("перечень пуст")
    print(" ".join(paths))
except (OSError, UnicodeError, ValueError) as e:
    print(f"ОТКАЗ tell-komu: перечень {sys.argv[1]} не прочитан: {e}", file=sys.stderr)
    sys.exit(3)
PY_TELL_LIST
)"; then
  SLED_REASON='perechen_shchelej_ne_prochitan'
  exit 3
fi

[ -f "$F" ] || { echo "🔴 tell-komu: файла нет: $F" >&2; { SLED_REASON='fajl_otsutstvuet'; exit 3; }; }
[ -s "$F" ] || { echo "🔴 tell-komu: файл пуст: $F — письмо НЕ положено" >&2; { SLED_REASON='fajl_pust'; exit 3; }; }

IMYA="$(basename "$F")"
# 🔴 УНИКАЛЬНОЕ ИМЯ ВЫЧИСЛЯЕТСЯ ЗДЕСЬ, до зеркала: зеркало и щель обязаны носить ОДНО имя,
# иначе копия перестанет совпадать с уехавшим — а она для того и заведена.
OSNOVA="${IMYA%.*}"; RASSHIRENIE="${IMYA##*.}"
[ "$OSNOVA" = "$IMYA" ] && { OSNOVA="$IMYA"; RASSHIRENIE="txt"; }
IMYA_V_SHCHELI="$OSNOVA-$(date -u '+%Y%m%dT%H%M%SZ')-$$.$RASSHIRENIE"
KOMU=""
for a in $ADRESATY; do
  case "$IMYA" in "dlya-$a-"*) KOMU="$a"; break ;; esac
done

if [ -z "$KOMU" ]; then
  if [ "${A2A_SKIP_ADRESAT:-0}" = 1 ]; then
    echo "⚠️ tell-komu: адресат в имени не узнан, но задан осознанный обход A2A_SKIP_ADRESAT=1." >&2
    KOMU="(обход)"
  else
    echo "🔴 ОТКАЗ: в имени «$IMYA» не распознан адресат." >&2
    echo "   Жду имя вида dlya-<кому>-<тема>.<расширение>, где кому — одно из (родительный падеж):" >&2
    echo "   $ADRESATY" >&2
    echo "   Переименуй файл либо задай A2A_SKIP_ADRESAT=1 осознанно." >&2
    echo "   Письмо НЕ положено: при неузнанном имени сборщик отдаёт его координатору," >&2
    echo "   и получатель не узнает, что письмо было." >&2
    { SLED_REASON='adresat_ne_raspoznan'; exit 3; }
  fi
fi

# ДЛИНА В ЗНАКАХ, ДО ОТПРАВКИ. Наблюдённый предел канала координатора — 3500 знаков;
# что сверх, обрезается МОЛЧА, и отправитель узнаёт об этом только по недоумению адресата.
# 🔴 Мерить надо ЗНАКИ, а не байты: кириллица весит два байта, и «5409 байт» ничего не
# говорит о том, влезло письмо или нет (05.09.2026 так и вышло — часть замера обрезало).
# 🔴 РЕЖЕТСЯ СЕРЕДИНА, А НЕ ХВОСТ — поправлено 14.09.2026 по факту, до того здесь стояло
# «хвост обрежется», и я строила защиту на этой неверной модели: делила письмо надвое,
# полагая, что спасаю концовку. Курьер на приёме печатает своё поведение сам: «вырезана
# СЕРЕДИНА: 148 знаков из 3508, начало и КОНЕЦ сохранены» (наблюдение Вениамина 14.09,
# его сторона; в нашем коде этого не прочитать — предел и способ живут у получателя).
# ⇒ Деление надвое НЕ СПАСАЕТ: концовка дошла бы и так, а срезается СОДЕРЖАНИЕ из середины,
# и срез виден получателю, но не отправителю. Верный ход — слать коротко, а длинное класть
# файлом и давать путь (зеркало в ~/a2a/polnye кладётся этим же инструментом).
# ГДЕ НЕ ПРИМЕНЯЕТСЯ: это ПРЕДУПРЕЖДЕНИЕ, а не отказ. Предел живёт на ЧУЖОЙ стороне,
# величина 3500 снята наблюдением, а не прочитана в её коде: сделай я отказ — законное
# письмо однажды не уйдёт из-за числа, которое мы сами придумали. Молчание этой строки
# значит «письмо короче предела, КАК Я ЕГО ЗНАЮ», а не «дойдёт целиком».
# 🔴 ТЕКСТУ ДОСТАЁТСЯ 3361 ЗНАК — ЭТО ОСТАТОК, А НЕ ПРЕДЕЛ (уточнено 14.09.2026 замером).
# Курьер печатает длину письма и сколько вырезал. Две точки:
#   длина 3509 − вырезано 148 = осталось 3361
#   длина 3938 − вырезано 577 = осталось 3361
# Он же печатает «предел 3500», и 3361 + 139 = 3500 сходится ровно.
# ⇒ ПОРОГ 3500 ВЕРЕН, но считается ВКЛЮЧАЯ служебный резерв под пометку о вырезе. Тексту
# достаётся остаток. Прежняя ошибка была не в пороге, а в том, что мы считали его весь
# доступным тексту — и письма с «превышением на 9 знаков» теряли полторы сотни.
# 🔴 ПОЧЕМУ ЗАПИСАНО ФОРМУЛОЙ, А НЕ ЧИСЛОМ 3361 (поправка Вениамина, принята):
# это величина ПРОИЗВОДНАЯ. Удлинят пометку — резерв вырастет, остаток упадёт, и голая
# константа начнёт врать МОЛЧА: предупреждения не будет, письма снова начнут резаться
# «без причины». Формула показывает, что именно чинить.
# ⇒ КЛАСС: ПРОИЗВОДНАЯ ВЕЛИЧИНА, ЗАПИСАННАЯ КАК ПЕРВИЧНАЯ, ТЕРЯЕТ СВЯЗЬ С ТЕМ, ОТ ЧЕГО
# ЗАВИСИТ. Родня правилу «в справке о числе — способ, а не число».
# ⚠️ ЗНАМЕНАТЕЛЬ: ДВЕ точки. Что резерв ровно 139 — подтверждено дважды; третья точка
# либо укрепит, либо вскроет. Пути в пометках были 33 и 41 знак (разной длины), остаток
# в обеих 3361 ⇒ резерв ФИКСИРОВАННЫЙ и от длины пути не зависит.
# ⚠️ И порог живёт на ЧУЖОЙ стороне: это замер ЕГО курьера, не наш.
# 🔴 20.09.2026: РЕЗ ДОСТАВКИ СНЯТ У ПОЛУЧАТЕЛЯ (#193, слово владельца 18.09) и это
# ПРОВЕРЕНО пробой #269: письмо 5326 знаков дошло ЦЕЛИКОМ, 9 маркеров из 9, смещение
# у всех РОВНО 138 (шапка сборщика) — вырежи механизм хоть знак в середине, смещение
# у последующих маркеров разошлось бы. Не разошлось ни разу.
# ⚠️ ПОЧЕМУ ТЕПЕРЬ СПРАВКА, А НЕ УГРОЗА. Прежняя строка говорила «вырежутся» — будущее
# время о ЧУЖОЙ стороне. Я пересказала её как «вырезано» (прошедшее) и доложила чужую
# догадку как свой замер; сокращала письма, теряя подробности, которых получатель так
# и не увидел. Прибор не врал — он сказал «предел, КАК Я ЕГО ЗНАЮ». Соврал ПЕРЕСКАЗ.
# ⇒ КЛАСС: ПРЕДУПРЕЖДЕНИЕ О ВОЗМОЖНОМ ВРЕДЕ, ПЕРЕСКАЗАННОЕ В ПРОШЕДШЕМ ВРЕМЕНИ,
#   СТАНОВИТСЯ ЛОЖНЫМ ИЗВЕСТИЕМ О СЛУЧИВШЕМСЯ.
# ⇒ ЛЕЧЕНИЕ В ФОРМУЛИРОВКЕ: строка написана так, что её НЕЛЬЗЯ пересказать прошедшим
#   временем. «Проверено до N на дату» вредом не станет ни в чьём пересказе.
# ⚠️ ГРАНИЦА: 5560 — не предел, а ПРОВЕРЕННАЯ ГЛУБИНА. Выше неизвестно, а не «режется».
#   Узнаешь исход на большей длине — впиши сюда новое число И ДАТУ, иначе справка
#   состарится молча, как состарился прежний порог 3500 (жил с 14.09 по 20.09).
# 🔴 УСЛОВИЕ, ПРИ КОТОРОМ ЭТА СПРАВКА ВЕРНА (замечание Вениамина, #269): она держится
# не на дате, а на том, что у ПОЛУЧАТЕЛЯ снят рез (#193, 18.09.2026, слово владельца).
# Вернут рез — 5560 станет ложью, а дата останется прежней и будет выглядеть свежей.
# ЦЕНА МОЛЧАНИЯ, если не проверить условие: курьер молчит до 5560, письма 3400–5500
# уедут обрезанными БЕЗ предупреждения, и узнаем мы об этом от получателя.
# ⇒ Расходится с наблюдением — проверять СНАЧАЛА условие (жив ли рез), потом число.
PROVERENO_DO="${A2A_PROVERENO_DO:-5560}"   # знаков; проба #269 20.09.2026, 9 из 9
ZNAKOV="$(wc -m < "$F" | tr -d ' ')"
if [ "${ZNAKOV:-0}" -gt "$PROVERENO_DO" ]; then
  echo "ℹ️ ДЛИНА $ZNAKOV знаков — ВЫШЕ ПРОВЕРЕННОЙ ГЛУБИНЫ $PROVERENO_DO (проба #269, 20.09.2026)." >&2
  echo "   Это НЕ «письмо режется»: на такой длине доставку никто не мерил. Неизвестно, а не плохо." >&2
  echo "   Верно, ПОКА у получателя снят рез (#193, 18.09.2026). Вернут — число устареет молча." >&2
  echo "   Хочешь знать — положи пробу с маркерами, несущими СВОЮ позицию, и сверь смещение." >&2
  echo "   Кладу как есть: зеркало с полным текстом всё равно остаётся в ~/a2a/polnye." >&2
fi

# ═══ СОКРАЩЁННОЕ ИМЯ ПАКЕТА — ПРЕДУПРЕЖДЕНИЕ (06.09.2026) ══════════════════════════
# 🔴 ЗАЧЕМ. Я написала в отчёте «telegram-multiagent 1.5.5», опустив приставку «для
# читаемости». Михалыч запросил это имя, получил 404 и чуть не объявил мою приёмку девяти
# пакетов недействительной: «пакета в реестре нет вовсе, значит ставилось не из npmjs».
# Тяжёлая и полностью ложная тревога, отменявшая работу целиком. Спасло его правило
# «неправдоподобный результат — сначала усомнись в пробнике», а не моя точность.
# Замер по зеркалам моих писем: 21 сокращение в 15 письмах из 339 — класс, не оплошность.
#
# ИМЯ ПАКЕТА В ПИСЬМЕ — ЭТО АДРЕС, А НЕ НАЗВАНИЕ (формулировка Михалыча). Сокращённый
# адрес ведёт в 404, а 404 читается как «предмета не существует».
#
# ⚠️ ЭТО ПРЕДУПРЕЖДЕНИЕ, А НЕ ОТКАЗ, и по той же причине, что у длины: письмо может
# законно упоминать каталог или ветку с похожим именем. Запрет однажды не выпустил бы
# верное письмо.
# ⚠️ ОБЛАСТЬ: имена берутся ИЗ КОНФИГА ПРОФИЛЯ, а не из списка в этом файле — список,
# записанный рукой, отвечает про себя. Нет конфига — строка молчит, и это сказано.
KONFIG_IMEN="${A2A_KONFIG_IMEN:-/opt/iskra/.dsh/profiles/web/cordis.patch.yml}"
if [ -r "$KONFIG_IMEN" ]; then
  KOROTKIE=""
  for polnoe in $(grep -oE '(^|[^a-zA-Z0-9-])dsh-[a-z0-9-]+' "$KONFIG_IMEN" | grep -oE 'dsh-[a-z0-9-]+' | sort -u); do
    hvost="${polnoe#dsh-}"
    # ищем хвост БЕЗ приставки: (?<!dsh-) в grep нет, потому отсеиваем строкой ниже
    if grep -oE "(^|[^a-zA-Z0-9-])$hvost([^a-zA-Z0-9-]|$)" "$F" >/dev/null 2>&1; then
      KOROTKIE="$KOROTKIE $hvost→$polnoe"
    fi
  done
  if [ -n "$KOROTKIE" ]; then
    echo "⚠️ СОКРАЩЁННОЕ ИМЯ ПАКЕТА:$KOROTKIE" >&2
    echo "   Имя пакета в письме — это АДРЕС: по нему пойдут запросом, и сокращённое даст 404," >&2
    echo "   а 404 читается как «предмета не существует». Кладу как есть — это может быть" >&2
    echo "   каталог или ветка с тем же хвостом, запрещать не берусь." >&2
  fi
else
  echo "⚠️ имена пакетов не проверены: конфиг $KONFIG_IMEN не читается (это «не смотрела», не «чисто»)." >&2
fi

# ═══ «СДЕЛАНО» БЕЗ ВЕРСИИ И СУММЫ ══════════════════════════════════════════════════════
# 🔴 ЗАЧЕМ. 06.09.2026 координатор четырежды присылала разрешение на одну и ту же правку.
# Разбор показал общий корень с двух концов: я писала «правка сделана» — слово одно, предмет
# в 02:05 и в 02:58 разный, и отличить их было НЕЧЕМ. Её повторы объясняются до конца этим:
# она не могла увидеть, что «сделана» уже про другое.
# ⚠️ Договорённость с этого дня: я называю ВЕРСИЮ И СУММУ, она помечает цитату цитатой.
# Здесь моя половина переведена из обещания в проверку.
#
# ⚠️ ПРЕДУПРЕЖДЕНИЕ, А НЕ ОТКАЗ — по той же причине, что у длины и у имён: письмо может
# законно говорить «сделано» про то, у чего версии нет вовсе (правка настройки, перенос
# файла, ответ на вопрос). Запрет однажды не выпустил бы верное письмо.
# ЧЕГО НЕ ЛОВИТ: отчёт, где версия названа СЛОВАМИ («поднял номер»), и отчёт о чужой работе.
# ЧТО ЗНАЧИТ МОЛЧАНИЕ: «слов о завершении не нашлось ЛИБО рядом есть номер», не «отчёт полон».
if grep -qiE '(сделан|готов|выпущен|закрыт|исправлен|починен)[аоые]?\b' "$F" 2>/dev/null; then
  if ! grep -qE '(alpha|beta|rc)\.[0-9]+|[0-9]+\.[0-9]+\.[0-9]+|[0-9a-f]{16}' "$F" 2>/dev/null; then
    echo "⚠️ «СДЕЛАНО» БЕЗ ВЕРСИИ И СУММЫ: в письме есть слово о завершении, а номера версии" >&2
    echo "   или суммы предмета рядом нет. Слово покрывает разное содержимое в разные часы —" >&2
    echo "   читающий не отличит сегодняшнее «сделано» от вчерашнего и повторит распоряжение." >&2
    echo "   Кладу как есть: бывает завершение без версии (настройка, перенос, ответ)." >&2
  fi
fi

# ═══ ШАПКА ОБЕЩАЕТ КОПИИ, КОТОРЫХ КУРЬЕР НЕ ШЛЁТ ═══════════════════════════════════════
# 🔴 ЗАМЕР 06.09.2026: из 174 моих писем ОДНОМУ адресату 126 несли в шапке «(копии X, Y)».
# Копий не было ни одной: сборщик маршрутизирует ПО ИМЕНИ ФАЙЛА, один файл — один адресат.
# Три четверти писем утверждали доставку, которой не происходило, и утверждали её в том
# месте, где читающий проверять не станет: в шапке, моей же рукой.
# Это класс «ложная подпись хуже пустой», и здесь он вредит НЕ получателю письма, а тем,
# кто в нём назван: они считаются извещёнными и потому не спрашивают.
#
# ⚠️ ПРЕДУПРЕЖДЕНИЕ, А НЕ ОТКАЗ — по той же причине, что у длины, имён пакетов и «сделано»:
# письмо может законно называть человека, не обещая ему копии («Михалыч установил, что…»),
# и автор может сознательно послать копию отдельным файлом.
# ЧЕГО НЕ ЛОВИТ: обещание копии НИЖЕ третьей строки; имя вне списка курьера; и не различает
# обещание от упоминания — судит человек.
# ЧТО ЗНАЧИТ МОЛЧАНИЕ: «в шапке не названо ЧУЖИХ известных имён», а не «письмо дойдёт всем».
# ⚠️ ОБЛАСТЬ: коды адресатов берутся из $ADRESATY (одно место), русские КОРНИ ведутся здесь
# рукой — падежи покрыты усечением, но четвёртое имя придётся вписать, и молчание про него
# будет означать «не знаю такого», а не «его в шапке нет».
if [ "$KOMU" != "vseh" ] && [ "$KOMU" != "(обход)" ]; then
  GOLOVA="$(head -3 "$F" 2>/dev/null)"
  NAZVANY=""
  for a in $ADRESATY; do
    [ "$a" = "$KOMU" ] && continue
    case "$a" in
      veniamina) koren="Вениамин" ;;
      mihalycha) koren="Михалыч"  ;;
      zabavy)    koren="Забав"    ;;
      *)         continue         ;;
    esac
    printf '%s' "$GOLOVA" | grep -qi -- "$koren" && NAZVANY="$NAZVANY $koren"
  done
  if [ -n "$NAZVANY" ]; then
    echo "⚠️ ШАПКА НАЗЫВАЕТ ТЕХ, КОМУ ПИСЬМО НЕ УЙДЁТ:$NAZVANY" >&2
    echo "   Адресат ровно один и берётся из имени файла: «$KOMU». Копий курьер не рассылает." >&2
    echo "   Названные в шапке будут считаться извещёнными и потому не спросят." >&2
    echo "   Нужна копия — положите ОТДЕЛЬНЫЙ файл dlya-<кому>-… либо пишите dlya-vseh-…" >&2
    echo "   Кладу как есть: имя в шапке может быть упоминанием, а не обещанием." >&2
  fi
fi

case " $OBHODIMYE_SHCHELI " in
  *" ${TELL_DIR%/} "*) ;;
  *) echo "🔴 tell-komu: щель $TELL_DIR не включена в единый перечень $TELL_LIST — передача не разрешена. НЕ кладу." >&2
     echo "   Разрешённые перечнем: $OBHODIMYE_SHCHELI" >&2
     echo "   Причина обычно в среде вызова: HOME=$HOME, DSH_HOME=${DSH_HOME:-не задан}." >&2
     { SLED_REASON='shchel_ne_obhoditsya_sborshchikom'; exit 3; } ;;
esac
mkdir -p "$TELL_DIR" 2>/dev/null
[ -w "$TELL_DIR" ] || { echo "🔴 tell-komu: нет права записи в $TELL_DIR" >&2; { SLED_REASON='net_prava_zapisi_v_shchel'; exit 3; }; }

# Зеркало ДО отправки: щель опустошается за минуту, и текст исчезает вместе с ней.
mkdir -p "$ZERKALO" 2>/dev/null
zerkalo_ok=да
if [ "$(readlink -f "$F")" != "$(readlink -f "$ZERKALO/$IMYA_V_SHCHELI")" ]; then
  cp -n "$F" "$ZERKALO/$IMYA_V_SHCHELI" 2>/dev/null || zerkalo_ok=нет
  # 🔴 ПРАВА ЗЕРКАЛА ЗАДАЮТСЯ ЯВНО, А НЕ НАСЛЕДУЮТСЯ ОТ ЧЕРНОВИКА (14.09.2026).
  # `cp` переносит права исходника. С 18:19 я стала готовить письма через `mktemp`, а он
  # создаёт файлы с 600 — и девять зеркал подряд перестали читаться получателем. Заметил
  # это не я: Вениамин пошёл читать полные тексты у источника и упёрся в отказ доступа.
  # ⇒ Класс: СМЕНА СПОСОБА ОТМЕНЯЕТ ТО, ЧТО КОРМИЛОСЬ ОТ ПРЕЖНЕГО, и следа об отмене нет.
  # Правка mktemp была верной (защита от чужого файла в общем /tmp), побочное следствие —
  # зеркало, которое существует и недоступно тому, ради кого заведено.
  # ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: зеркало — переписка, а не секрет. Пойдёт письмо с секретом —
  # его нельзя класть сюда вовсе, а не прикрывать правами.
  chmod 644 "$ZERKALO/$IMYA_V_SHCHELI" 2>/dev/null || true
fi

# 🔴 ШТАМП ВРЕМЕНИ СТАВИТ ТОТ, КТО КЛАДЁТ, И В МОМЕНТ УКЛАДКИ (правка 05.09.2026).
# ЗАЧЕМ. Мы трое всю ночь строили хронологию по штампам, написанным В ТЕЛЕ письма
# рукой автора. Замер получателя показал: мой штамп «23:47 UTC» стоял в письме,
# положенном в 23:15:15 — на 32 минуты ПОЗЖЕ укладки, то есть был не измерен, а
# вспомнен. У координатора то же самое, дважды. Штамп из головы в разборе
# неотличим от замера и весит столько же.
# ЧТО ЭТО НЕ ЛЕЧИТ: авторские штампы в теле остаются и по-прежнему могут врать.
# Эта строка не спорит с ними — она даёт получателю НЕЗАВИСИМОЕ число, снятое
# машиной в момент действия. Расходятся — верить этой.
# 🔴 ПИСЬМО СОБИРАЕТСЯ ЦЕЛИКОМ И ТОЛЬКО ПОТОМ ВСТАЁТ НА МЕСТО (05.09.2026, класс координатора).
# Раньше было: cp в щель → дописать штамп. Между двумя действиями письмо УЖЕ ЛЕЖИТ в щели и
# ещё НЕ ГОТОВО — сборщик мог забрать его без штампа укладки. Окно короткое, но оно есть по
# построению, а не по скорости: тот же класс, на котором сегодня упал сборщик координатора
# (правка по месту) и сторож флота у Михалыча.
# Готовим рядом, в том же каталоге (перенос атомарен только в пределах одной файловой
# системы — проверено: щель, зеркало и /tmp на одном разделе), под именем, которое сборщик
# НЕ берёт: он читает *.txt и *.md, а временный носит суффикс .sobiraetsya.
SHTAMP="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
# 🔴 ИМЯ В ЩЕЛИ УНИКАЛЬНО (20.09.2026, находка Вениамина, подтверждена пробой).
# Прежде письмо ложилось под именем файла. Вторая укладка того же имени ПЕРЕЗАПИСЫВАЛА
# первое письмо МОЛЧА: ни отказа, ни следа, отправитель видит успешную укладку.
# Проба на копии: две укладки подряд → в щели ОДИН файл, сумма второго, первое исчезло.
# Сегодня спасла случайность — сборщик успел забрать первое за 48 секунд до второй укладки.
# «Пришло дважды» и «не пришло вовсе» здесь разделяла одна минута.
# ⚠️ Расширение СОХРАНЯЕТСЯ: приёмник берёт только .txt и .md, иначе письмо не возьмут.
# ⚠️ Префикс dlya-<кому>- сохраняется: по нему распознаётся адресат.
# Зеркало кладётся ПОД ТЕМ ЖЕ уникальным именем — иначе копия перестанет совпадать
# с уехавшим, а она для того и заведена.
VREM_PISMO="$TELL_DIR/.$IMYA_V_SHCHELI.sobiraetsya.$$"
cp "$F" "$VREM_PISMO" || { echo "🔴 tell-komu: не собрать письмо рядом со щелью. Письмо НЕ положено." >&2; { SLED_REASON='otkaz_kopirovaniya_pisma'; exit 3; }; }
printf '\n--\nположено в щель: %s (снято командой в момент укладки, не рукой автора)\n' \
  "$SHTAMP" >> "$VREM_PISMO" \
  || { rm -f "$VREM_PISMO"; echo "🔴 tell-komu: штамп не дописан — письмо НЕ положено (в щель кладём только готовое)." >&2; { SLED_REASON='otkaz_dobavleniya_shtampa'; exit 3; }; }
mv "$VREM_PISMO" "$TELL_DIR/$IMYA_V_SHCHELI" || { rm -f "$VREM_PISMO"; echo "🔴 tell-komu: перенос в щель не удался. Письмо НЕ положено." >&2; { SLED_REASON='otkaz_perenosa_v_shchel'; exit 3; }; }
# 🔴 ТОТ ЖЕ ШТАМП — В ЗЕРКАЛО. Зеркало заводилось как копия ОТПРАВЛЕННОГО; допиши мы
# строку только в щель, копия перестала бы совпадать с уехавшим, и через сутки сверять
# было бы не с чем. Зеркало кладётся ДО отправки (страховка на случай сбоя), штамп
# дописывается ПОСЛЕ успешной укладки — иначе в копии стояло бы время отправки,
# которой не было.
if [ "$zerkalo_ok" != "нет" ] && [ -f "$ZERKALO/$IMYA_V_SHCHELI" ]; then
  printf '\n--\nположено в щель: %s (снято командой в момент укладки, не рукой автора)\n' \
    "$SHTAMP" >> "$ZERKALO/$IMYA_V_SHCHELI" \
    || echo "⚠️ tell-komu: штамп в зеркало не дописан — копия отличается от отправленного" >&2
fi
[ -s "$TELL_DIR/$IMYA_V_SHCHELI" ] || { echo "🔴 tell-komu: файл в щели пуст или пропал. Письмо НЕ положено." >&2; { SLED_REASON='fajl_v_shcheli_pust_ili_propal'; exit 3; }; }

SLED_TRANSFER=polozheno_v_shchel
echo "положено: $TELL_DIR/$IMYA_V_SHCHELI ($(stat -c %s "$TELL_DIR/$IMYA_V_SHCHELI") байт), адресат: $KOMU"
if [ "$zerkalo_ok" = да ]; then
  echo "зеркало:  $ZERKALO/$IMYA_V_SHCHELI"
else
  echo "⚠️ зеркало НЕ сохранено — восстановить текст после неверной доставки будет нечем" >&2
  { SLED_REASON='zerkalo_ne_sohraneno'; exit 4; }
fi
echo "🔴 ГРАНИЦА: это «положено», а не «доставлено». Забирает сборщик координатора."
echo "   Застревание стережёт zastryalo-v-shcheli.timer (предел 5 мин): письмо, взятое из щели"
echo "   дольше предела, он назовёт ПО ИМЕНИ. Живость: systemctl is-active zastryalo-v-shcheli.timer"
echo "   ⚠️ чего он НЕ ловит: «мы сами перестали класть» — пустая щель законна и тревоги не даёт."

SLED_REASON=pismo_i_zerkalo_sohraneny
