#!/usr/bin/env bash
# zabava-tell — написать главной Забаве (агент на aclaude) по своей инициативе.
#
# Ты кладёшь сообщение в каталог обмена, aclaude забирает его по таймеру (раз в минуту)
# и доставляет. Ответ, если он нужен, придёт обычным путём — она напишет тебе сама.
#
#   zabava-tell "короткий текст"
#   echo "длинный текст" | zabava-tell -
#   zabava-tell -f /путь/к/файлу
#
# Предел на сообщение — 3500 знаков, длиннее обрежется при доставке (с пометкой).

set -uo pipefail

# 🔴 02.09.2026: писал в /opt/dsh/a2a/tell — каталог ПЕТРОВИЧА, куда у нас нет
# прав по построению (его дом, 750 dsh:dsh). Инструмент отказывал при каждой
# попытке, и узнала я об этом, только попытавшись им воспользоваться: у канала
# не было ни проверки, ни сторожа. Свой исходящий — здесь, отсюда забирает
# сборщик координатора.
# Путь переменной, а не константой: у другого агента дом другой.
TELL_DIR="${ZABAVA_TELL_DIR:-$HOME/a2a/tell}"

# 🔴 КЛЮЧ — НЕ ТЕКСТ (B-N-975, 25.09.2026). Прежде любой первый довод, кроме «-» и «-f»,
# уходил письмом: `zabava-tell --help`, набранный ради справки, положил главной письмо «--help».
# Теперь довод на «-» — справка (-h/--help) или ОТКАЗ, письмо не создаётся. Текст, который
# сам начинается с «-», передаётся после «--»: zabava-tell -- "-5 градусов".
# ⚠️ Чего не ловит: ключ, стоящий ВТОРЫМ доводом (`zabava-tell текст --help`), и обычное слово
# вместо текста — это уйдёт письмом, как и прежде.
ISPOLZOVANIE='использование: zabava-tell "текст" | echo текст | zabava-tell - | zabava-tell -f файл | zabava-tell -- "-текст"'
# 🔴 ЛИШНИЕ ДОВОДЫ — ОТКАЗ, А НЕ ПОТЕРЯ ХВОСТА (B-N-978, 25.09.2026). Прежде бралось только $1:
# `zabava-tell привет мир` отправлял «привет», хвост пропадал МОЛЧА; так же «текст --help».
# Склейка через "$*" не годится: оболочка уже съела кавычки, пробелы и подстановки — ушло бы
# не то, что набрано. Поэтому отказ с подсказкой. Доводов положено: -f и -- — два, прочее — один.
# Перечень зовущих снят до правки (kandidaty/B-N-978/ZOVUSHCHIE.md): вызовов с несколькими
# доводами без кавычек — 0 из 190.
case "${1:-}" in -f|--) NUZHNO=2 ;; *) NUZHNO=1 ;; esac
if [ "$#" -gt "$NUZHNO" ]; then
  echo "🔴 zabava-tell: лишние доводы (получено $#, положено $NUZHNO) — письмо НЕ создано." >&2
  echo "   Текст из нескольких слов — в кавычках: zabava-tell \"привет мир\"; длинный — через «-» или «-f файл»." >&2
  echo "$ISPOLZOVANIE" >&2; exit 2
fi
case "${1:-}" in
  -)  MSG="$(cat)" ;;
  -f) MSG="$(cat "${2:?нужен путь к файлу}")" ;;
  -h|--help) echo "$ISPOLZOVANIE"; exit 0 ;;
  --) MSG="${2:-}" ;;
  -*) echo "🔴 zabava-tell: неизвестный ключ «$1» — письмо НЕ создано. Текст, начинающийся с «-», передайте после «--»." >&2
      echo "$ISPOLZOVANIE" >&2; exit 2 ;;
  "") echo "$ISPOLZOVANIE" >&2; exit 2 ;;
  *)  MSG="$1" ;;
esac

[ -n "$MSG" ] || { echo 'пустое сообщение — не отправляю' >&2; exit 2; }

# 🔴 Отказ обязан НАЗВАТЬ путь и причину. Прежний текст «не смог записать в
# каталог обмена» не говорил ни куда, ни почему — с ним поломка выглядела как
# каприз инструмента, а не как отсутствие прав на чужой каталог.
if [ ! -d "$TELL_DIR" ]; then
  mkdir -p "$TELL_DIR" 2>/dev/null || {
    # «Нет» и «не вижу» снаружи неразличимы: при закрытом родителе test -d даёт
    # тот же ответ, что при отсутствии. Текст обязан назвать оба случая, иначе
    # читающий пойдёт создавать каталог, который есть.
    echo "🔴 zabava-tell: каталог $TELL_DIR отсутствует ЛИБО недоступен (нет прав на родителя), и создать его не вышло." >&2
    echo "   Задайте ZABAVA_TELL_DIR, если ваш исходящий лежит иначе. Письмо НЕ отправлено." >&2
    exit 3; }
fi
if [ ! -w "$TELL_DIR" ]; then
  echo "🔴 zabava-tell: в $TELL_DIR нет права записи (владелец $(stat -c '%U:%G' "$TELL_DIR" 2>/dev/null), режим $(stat -c '%a' "$TELL_DIR" 2>/dev/null))." >&2
  echo "   Это чужой каталог либо права сменились. Письмо НЕ отправлено." >&2
  exit 3
fi

F="$TELL_DIR/tell-$(date +%s%N).txt"
printf '%s\n' "$MSG" > "$F" || {
  echo "🔴 zabava-tell: запись в $F не удалась (место на диске? квота?). Письмо НЕ отправлено." >&2
  exit 3; }
chmod 664 "$F" 2>/dev/null || true

# 🔴 Проверка РЕЗУЛЬТАТА, а не кода записи: файл обязан быть на месте и непуст.
# Без этого «письмо поставлено» и «письмо исчезло» неразличимы.
if [ ! -s "$F" ]; then
  echo "🔴 zabava-tell: файл $F пуст или пропал сразу после записи. Письмо НЕ отправлено." >&2
  exit 3
fi

echo "письмо положено: $F (${#MSG} знаков, $(stat -c %s "$F") байт)"
echo "🔴 ГРАНИЦА: это «положено», а не «доставлено». Забирает сборщик координатора."
echo "   Застревание стережёт zastryalo-v-shcheli.timer (предел 5 мин): письмо, взятое из щели"
echo "   дольше предела, он назовёт ПО ИМЕНИ. Живость: systemctl is-active zastryalo-v-shcheli.timer"
echo "   ⚠️ чего он НЕ ловит: «мы сами перестали класть» — пустая щель законна и тревоги не даёт."
