#!/bin/bash
# СТОРОЖ ЗАСТРЯВШЕГО ПИСЬМА: письмо положено в щель и НЕ ЗАБРАНО дольше предела.
# Коды: 0 чисто · 1 застряло (расхождение) · 2 слепота (проверить нечем).
#
# 🔴 ЗАЧЕМ. Курьер печатает «положено», а не «доставлено» — забирает сборщик на той стороне,
# и у канала НЕТ сторожа, который заметил бы, что забирать перестали. Отправитель в этом
# случае видит успех, получатель не видит ничего, и спросить не о чем: пустая щель и щель,
# из которой не забирают, снаружи различаются только ВРЕМЕНЕМ ЛЕЖАНИЯ.
#
# ПРЕДЕЛ — ИЗ ЗАМЕРА, НЕ «ИЗРЕДКА». Сборщик опрашивает раз в ~25-30 с; наблюдённые времена
# от укладки до забора: 10, 21, 25, 25 с. Предел 5 минут — запас на порядок от наблюдённого
# максимума. Число здесь, а не в голове: изменится такт сборщика — правится одна строка.
# 🔴 #286 (21.09.2026): ПОРОГ ИЗМЕРЕН, А НЕ НАЗНАЧЕН. Прежде 5 минут стояли без
# основания — я их выбрала, не померив. Замер на живом письме 23:48:02Z → 23:48:19Z:
# забрано быстрее 10 с (это шаг моей проверки, точнее не мерила). Порог 5 мин —
# это ×30 от наблюдаемого, и такой запас здесь верен: сторож ловит «забирать
# ПЕРЕСТАЛИ», а не задержку в секунды. ⚠️ Замер ОДИН, и это оценка по одному случаю.
PREDEL_MIN="${ZASTRYALO_PREDEL_MIN:-5}"
SHCHEL="${ZASTRYALO_SHCHEL:-/opt/iskra/a2a/tell}"
# B-N-1872б: ALERT задаётся ДО первой слепоты. Прежде он стоял ниже всех её вызовов, и тревога
# слепоты не уходила никогда: у юнитов нет OnFailure, код 2 никто не слышал.
ALERT="${ZASTRYALO_ALERT:-/usr/local/bin/agent-alert}"
slepota() {
  echo "$1"
  if [ -x "$ALERT" ]; then
    "$ALERT" "застряло-в-щели ($SHCHEL), $1" >/dev/null 2>&1 || echo "    ⚠️ тревога слепоты НЕ ушла: $ALERT вернул отказ"
  else
    echo "    ⚠️ тревога слепоты НЕ отправлена: $ALERT не найден или не исполняем"
  fi
  exit 2
}
#
# ⚠️ ГРАНИЦА ОБЛАСТИ, НАЗВАННАЯ ВСЛУХ (условие координатора 06.09): считаем ТОЛЬКО .txt и .md.
# Канал наружу берёт лишь их; файл с чужим расширением лежит в щели ВЕЧНО, и это НОРМА, а не
# беда. Считай мы его — сторож стал бы фоном с первого дня, а фоновый сторож есть выключенный.
# Но и молчать о нём нельзя: чужие расширения считаются ОТДЕЛЬНО и называются числом, иначе
# «чисто» прочтётся как «в щели пусто».
#
# ЧЕГО ЭТОТ СТОРОЖ НЕ ЛОВИТ:
#   · доставку. «Забрано из щели» не значит «прочитано адресатом» — следа у получателя не видно;
#   · письма, которые сборщик забрал и потерял ПОСЛЕ забора;
#   · чужие щели: смотрит ровно один каталог, названный выше.
# ЧТО ЗНАЧИТ ЕГО МОЛЧАНИЕ: «в НАЗВАННОМ каталоге нет взятых расширений старше предела»,
# а не «канал работает».
set -uo pipefail   # 🔴 БЕЗ pipefail код $(find|wc) — это код wc, а он ВСЕГДА 0 (замер 22.09)

if [ ! -d "$SHCHEL" ]; then
  slepota "СЛЕПОТА: каталога щели нет: $SHCHEL — проверять нечего, и это НЕ «чисто»."
fi
if [ ! -r "$SHCHEL" ]; then
  slepota "СЛЕПОТА: каталог щели не читается: $SHCHEL (права $(stat -c %A "$SHCHEL" 2>/dev/null))."
fi

# 🔴 ЗНАЧЕНИЕ, ДОБЫТОЕ КОМАНДОЙ, СЧИТАЕТСЯ ДОБЫТЫМ ТОЛЬКО ПРИ КОДЕ 0 ЭТОЙ КОМАНДЫ.
# Пустое НЕ равно пустому: «файлов 0» значит И «их нет», И «find отказал».
# Замер 22.09 на живом предмете: зеркало СУЩЕСТВУЕТ, но не читается ⇒ «положено 0 ·
# забрано 0 · чисто», код 0. Отказ добычи был выдан за законную пустоту.
# Код проверяется ОТДЕЛЬНОЙ строкой после захвата: exit внутри $( ) убивает
# подоболочку, а не скрипт — скрипт пошёл бы дальше с пустой переменной.
ne_dobyto() {
  slepota "⚠️ СЛЕПОТА: НЕ ДОБЫТО — $1 (код команды $2). Это НЕ «чисто»: источник не ответил."
}

# find по -mmin: возраст ФАЙЛА, а не имени. Имя несёт метку укладки, но метка ставится
# отправителем, а лежание — свойство файла; берём то, что меряет система.
mapfile -t ZASTRYALI < <(find "$SHCHEL" -maxdepth 1 -type f \( -name '*.txt' -o -name '*.md' \) -mmin "+$PREDEL_MIN" -printf '%f\t%TY-%Tm-%Td %TH:%TM\n' 2>/dev/null | sort)
# 🔴 у подстановки процесса < <( ) кода НЕТ — mapfile вернёт 0, даже если find отказал.
# Поэтому источник спрашивается ОТДЕЛЬНО и код берётся у него.
find "$SHCHEL" -maxdepth 1 -type f >/dev/null 2>&1; KOD=$?
[ "$KOD" -eq 0 ] || ne_dobyto "перечень писем в щели" "$KOD"
CHUZHIH=$(find "$SHCHEL" -maxdepth 1 -type f ! -name '*.txt' ! -name '*.md' 2>/dev/null | wc -l); KOD=$?
[ "$KOD" -eq 0 ] || ne_dobyto "счёт чужих расширений в щели" "$KOD"
VSEGO=$(find "$SHCHEL" -maxdepth 1 -type f 2>/dev/null | wc -l); KOD=$?
[ "$KOD" -eq 0 ] || ne_dobyto "счёт файлов в щели" "$KOD"

echo "щель: $SHCHEL · предел ${PREDEL_MIN} мин · файлов всего $VSEGO · чужих расширений $CHUZHIH (лежат вечно — это НОРМА, не беда)"

# 🔴 #286: СЧЁТ В ЗЕЛЁНОМ ВЫВОДЕ (решение координатора 21.09, вместо тревоги).
# Пустая щель значит И «не клали», И «забрали» — молчание между ними не выбирает.
# Если сломается НАША сторона и письма перестанут попадать в щель вовсе, щель будет
# пуста, сторож промолчит, всё зелёное. Поэтому ноль ВИДЕН, но не кричит: у нуля
# появляется знаменатель прямо здесь, а не в голове читателя.
# ⚠️ ПОРОГА НА ЭТО НЕТ НАМЕРЕННО — «мы перестали класть» законно (ночь, нечего слать).
# Решает человек, глядя на ряд.
ZERKALO="${A2A_ZERKALO:-$HOME/a2a/polnye}"
# B-N-1872б: счёт — только если зеркало есть. Прежде find по несуществующему зеркалу при pipefail
# давал код 1, ne_dobyto выходил кодом 2 — ветка «зеркала нет» была недостижима, и пропажа зеркала
# глушила главную проверку щели. Считаются .md И .txt: tell-komu кладёт в зеркало расширение исходного
# файла, без расширения — .txt; прежде .txt в «положено» не попадали.
if [ -d "$ZERKALO" ]; then
  POLOZHENO_SUTKI=$(find "$ZERKALO" -maxdepth 1 -type f \( -name '*.md' -o -name '*.txt' \) -mtime -1 2>/dev/null | wc -l); KOD=$?
  [ "$KOD" -eq 0 ] || ne_dobyto "счёт положенного по зеркалу за сутки" "$KOD"
  # №15 A-N-1948 (10.10): разности «забрано = положено − всего» нет — щель кладут и мимо зеркала (zabava-tell: tell-*.txt),
  # а VSEGO считает и чужие расширения; разность выходила отрицательной. Печатаются оба числа, вывод — за человеком.
  echo "за сутки: положено через tell-komu $POLOZHENO_SUTKI · в щели сейчас $VSEGO (все файлы; разность не считается — в щель кладут и мимо зеркала)"
else
  echo "за сутки: ПРОВЕРИТЬ НЕЧЕМ — зеркала нет ($ZERKALO), счёт положенного недоступен"
fi

if [ "${#ZASTRYALI[@]}" -eq 0 ]; then
  echo "чисто: взятых расширений старше предела нет. Это НЕ «канал работает» — это «в этом каталоге не залежалось»."
  exit 0
fi

echo "🔴 ЗАСТРЯЛО: ${#ZASTRYALI[@]} писем лежат дольше ${PREDEL_MIN} мин — сборщик их не забрал."
for z in "${ZASTRYALI[@]}"; do echo "    $z"; done
echo "    Что это значит: отправитель видел «положено», получатель не получил ничего."
echo "    Куда смотреть: сборщик на стороне координатора (его такт ~25-30 с) и права каталога."
# 🔴 #286 С5: ТРЕВОГА ИДЁТ ТУДА, ГДЕ ЕСТЬ ЧИТАТЕЛЬ. Прежде сторож печатал в stdout
# и всё: при вызове по таймеру это значило «никто не узнает». Спрашивать надо
# не «подан ли сигнал», а «кто его принял».
# ⚠️ СМЫСЛ ТРЕВОГИ РАЗВЕДЁН ЯВНО (граница названа координатором): сторож следит
# за ЧУЖИМ забирающим, на который мы не влияем. «Письма лежат» — это ЗАБИРАТЬ
# ПЕРЕСТАЛИ, чужая сторона. Обратный случай («мы сами перестали класть») здесь
# НЕ ловится и тревогой не объявляется: пустая щель — законное состояние.
if [ -x "$ALERT" ]; then
  SOOB="🔴 ЗАСТРЯЛО В ЩЕЛИ: ${#ZASTRYALI[@]} писем лежат дольше ${PREDEL_MIN} мин.
ЧТО ЭТО ЗНАЧИТ: ЗАБИРАТЬ ПЕРЕСТАЛИ — сбор на СТОРОНЕ ПОЛУЧАТЕЛЯ, не у нас.
Обратное («мы сами перестали класть») этот сторож НЕ ловит.
ИМЕНА: $(printf '%s\n' "${ZASTRYALI[@]}" | sed 's|.*/||' | head -5 | tr '\n' ' ')"
  "$ALERT" "$SOOB" >/dev/null 2>&1 || echo "    ⚠️ тревога НЕ ушла: $ALERT вернул отказ"
else
  echo "    ⚠️ тревога НЕ отправлена: $ALERT не найден или не исполняем — сигнал остался в stdout"
fi
exit 1
