[Unit]
Description=Сторож застрявшего письма — каждые 5 минут

[Timer]
# 🔴 #286: такт РАВЕН порогу застревания (5 мин). Обоснование замером 21.09:
# письмо живёт в щели ≤10,9 с (верхняя граница по двум наблюдениям — мой замер
# исчезновения и замер координатора «дошло до меня»). Порог 5 мин — ×28 от факта;
# такт 5 мин значит, что застрявшее письмо заметится через 5–10 мин.
# ⚠️ Занижать порог по двум наблюдениям не стану: это было бы тем же назначением,
# от которого мы уходим. Набрать 5–10 случаев, взять худший, утроить ЕГО.
OnCalendar=*:0/5
Persistent=true
Unit=zastryalo-v-shcheli.service

[Install]
WantedBy=timers.target
