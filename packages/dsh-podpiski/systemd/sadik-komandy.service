[Unit]
Description=Приёмник команд владельца для sadik (/switch подписки), long-poll @arg_dsh_switch_bot (B-N-1151, Искра; свой бот с B-N-2055 №1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-switch
ExecStart=/usr/local/sbin/sadik-komandy-priyomnik
Restart=always
RestartSec=5
RestartPreventExitStatus=2
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/var/lib/sadik-komandy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
