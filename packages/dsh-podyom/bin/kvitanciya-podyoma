#!/bin/bash
# Выставить квитанцию разбора подъёма — НЕ РУКОЙ, А ПО ИСХОДУ ПРИБОРА.
#
# 🔴 ЗАЧЕМ. Строка PODYOM_PODTVERZHDEN/PODTVERDILA в файле состояния сообщает ровно одно:
# «подъём РАЗОБРАН Искрой». Пока её ставила рука, она дважды за сутки становилась ложной:
# 05.09 её подделала чужая рука (порча и возврат через sudo), а потом я потеряла её при
# пересборке файла — и никто не заметил 19 часов, потому что ОТСУТСТВИЕ строки законно
# («ещё не смотрела»), а значит признак не может сообщить о своей пропаже.
# Класс Михалыча: механизм завели, предмет пересоздали — механизм замолчал.
#
# ЧТО ЭТА КОМАНДА ДЕЛАЕТ: зовёт прибор перед подъёмом в режиме «после» и пишет квитанцию
# ТОЛЬКО при исходе 0. Тогда строка означает не «я помню, что смотрела», а «прибор разобрал
# и сошлось» — и это воспроизводимо кем угодно тем же вызовом.
#
# ⚠️ ГРАНИЦЫ, названные здесь, а не в переписке:
#   · квитанция НЕ значит «подъём был законным» (слово координатора) и НЕ значит «состав
#     верный» (вердикт приёмки). Только «разобран».
#   · подделать её может любой, у кого есть sudo на этой машине: файл iskra:iskra 644, чужая
#     рука пишет только через sudo — и оставляет след. Неподделываемого признака у нас НЕТ,
#     и выдумывать его хуже, чем назвать этот предел вслух.
#   · КВИТАНЦИЮ НЕЛЬЗЯ ВЫСТАВИТЬ ЗАДНИМ ЧИСЛОМ. Прибор сравнивает бой с ДИСКОМ, а диск
#     двигается моими же выпусками: выпустила новую версию — исход стал 1, и это ЗАКОННО.
#     Значит звать надо сразу после разбора подъёма, а не когда вспомнилось.
#   · команда правит ТОЛЬКО две строки; остальной файл не трогает.
set -u
# 🔴 B-N-902 (25.09.2026, Михалыч): КВИТАНЦИЯ ЕСТЬ ТОЛЬКО У ИСКРЫ. Файл состояния с PODYOM_PODTVERZHDEN
# есть только у неё (SOSTOYANIE-ISKRY.txt); у Петровича (dsh.service) и клонов его НЕТ — и выдумывать
# его нельзя. Было: аргумент молча игнорировался, и даже «--help» выставлял квитанцию Искре.
# Стало: без аргумента, «iskra» или «iskra.service» — как прежде; ЛЮБОЙ другой аргумент — ОТКАЗ кодом 2
# ДО всякого действия. Для dsh и клонов правило «после podyom-uzla — квитанция» НЕ применяется.
# Подмены для стендов (KVITANCIYA_FAJL/SLUZHBA/PRIBOR) — как были.
case "${1:-}" in
  ''|iskra|iskra.service)
    [ $# -le 1 ] || { echo "🔴 ОТКАЗ: лишние аргументы «$*» — квитанция НЕ выставлена" >&2; exit 2; } ;;
  *) echo "🔴 ОТКАЗ: «${1:0:40}» — квитанция подъёма есть ТОЛЬКО у Искры (iskra.service). У dsh и клонов" >&2
     echo "   файла состояния нет; правило «после podyom-uzla — квитанция» к ним не применяется. Квитанция НЕ выставлена." >&2
     exit 2 ;;
esac
SOST="${KVITANCIYA_FAJL:-/opt/iskra/workspace/SOSTOYANIE-ISKRY.txt}"
SLUZHBA="${KVITANCIYA_SLUZHBA:-iskra.service}"
# Боевое публичное имя, а не рабочая копия (A-N-676, шаг 2) — см. podyom-uzla.
PRIBOR="${KVITANCIYA_PRIBOR:-/usr/local/bin/pered-podyomom.mjs}"

[ -f "$SOST" ] || { echo "🔴 ОТКАЗ: файла состояния нет: $SOST" >&2; exit 2; }
[ -w "$SOST" ] || { echo "🔴 ОТКАЗ: файл состояния не пишется этой рукой: $SOST" >&2; exit 2; }
[ -f "$PRIBOR" ] || { echo "🔴 СЛЕПОТА: прибора нет: $PRIBOR — это «проверить нечем», не «сошлось»" >&2; exit 2; }

START_RAW=$(systemctl show "$SLUZHBA" -p ActiveEnterTimestamp --value 2>/dev/null)
[ -n "$START_RAW" ] || { echo "🔴 СЛЕПОТА: старт службы $SLUZHBA не читается" >&2; exit 2; }
START=$(date -u -d "$START_RAW" +%Y-%m-%dT%H:%M:%SZ) || { echo "🔴 СЛЕПОТА: старт не разбирается: $START_RAW" >&2; exit 2; }

echo "прибор: $PRIBOR --posle --cel-s-diska --sluzhba $SLUZHBA"
VYVOD=$(node "$PRIBOR" --posle --cel-s-diska --sluzhba "$SLUZHBA" 2>&1)
ISHOD=$?
echo "$VYVOD" | grep -E '^исход:|🔴' | head -6

if [ "$ISHOD" != 0 ]; then
  echo "🔴 КВИТАНЦИЯ НЕ ВЫСТАВЛЕНА: исход прибора $ISHOD (0 нужен)." >&2
  echo "   Это НЕ поломка команды: 1 значит «бой разошёлся с диском», 2 — «проверить нечем»." >&2
  echo "   Частый законный случай: после подъёма вы выпустили новую версию, и диск ушёл вперёд." >&2
  echo "   Тогда квитанция про ЭТОТ подъём уже не выставляется — её надо было ставить сразу." >&2
  exit "$ISHOD"
fi

SEJCHAS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
TMP=$(mktemp "$(dirname "$SOST")/.kvitanciya-XXXXXX") || exit 2
if grep -q '^PODYOM_PODTVERZHDEN=' "$SOST"; then
  sed -e "s|^PODYOM_PODTVERZHDEN=.*|PODYOM_PODTVERZHDEN=$START|" \
      -e "s|^PODTVERDILA=.*|PODTVERDILA=iskra|" "$SOST" > "$TMP"
else
  # строки нет — вставляем ПЕРВЫМИ, чтобы пересборка файла их не унесла в хвост
  { printf 'PODYOM_PODTVERZHDEN=%s\nPODTVERDILA=iskra\n\n' "$START"; cat "$SOST"; } > "$TMP"
fi
# B-N-926: хозяин — тоже с прежнего файла. mktemp создаёт файл рукой ЗАПУСТИВШЕГО; под root без chown квитанция оставляла
# SOSTOYANIE-ISKRY.txt root:root 644, и следующая квитанция под iskra отказывала «не пишется этой рукой» (25.09 16:03Z).
chmod --reference="$SOST" "$TMP" && chown --reference="$SOST" "$TMP" && mv -f "$TMP" "$SOST" || { rm -f "$TMP"; echo "🔴 ОТКАЗ: подмена не состоялась" >&2; exit 2; }

echo "✅ КВИТАНЦИЯ ВЫСТАВЛЕНА: PODYOM_PODTVERZHDEN=$START · PODTVERDILA=iskra"
echo "   значит: прибор разобрал подъём и сошлось ($SEJCHAS). НЕ значит «законно» и не значит «состав верный»."
