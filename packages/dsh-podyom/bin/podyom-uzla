#!/bin/bash
# Подъём службы агента с проверкой, что НЕ ИДЁТ компакт.
#
# 🔴 ЗАЧЕМ. 04.09.2026 10:03:04Z я перезапустила службу соседа, когда у него шёл ПЕРВЫЙ
# в его жизни компакт (начался 10:02:49Z). Команда `/compact` вернула error, компакт
# оборвался; повтор состоялся сам через семь секунд и дошёл до конца — то есть обошлось,
# но обошлось СЛУЧАЙНО, а не по устройству.
# Правило «поднимать, когда ход не идёт» у нас записано с утра. Правило, которое надо
# вспомнить в момент подъёма, не держит: в этот момент думаешь о версии и сумме предмета.
#
# ГДЕ НЕ ПРИМЕНЯЕТСЯ:
#   — видит компакт по журналу службы, а не по состоянию платформы: если событие
#     compaction/start не печатается, проверка СЛЕПА и говорит об этом;
#   — не видит обычный ход агента (шаг без компакта). Это осознанное сужение: шаг
#     переживает перезапуск (движок висит на шлюзе), а компакт — нет;
#   — окно поиска ограничено, идущий дольше окна компакт не будет виден.
set -u
PODYOM_ORIGINAL_ARGS=("$@")
OKNO=${OKNO:-15min}
# 🔴 ОБЛАСТЬ — ДВЕ СЛУЖБЫ ПОИМЁННО, НЕ МАСКА (ворота В7 приёмки, 05.09.2026).
# ЗАЧЕМ. Скрипт делает `systemctl restart` с чужим именем из аргумента: опечатка или
# чужое имя роняли бы ЛЮБУЮ службу машины, и отказа бы не было — только успех не про то.
# Маска здесь не годится по нашему же классу: перечень по образцу имени отвечает про
# образец, а не про предмет. Имена названы, и это сознательное сужение.
# ГДЕ НЕ ПРИМЕНЯЕТСЯ: появится третья наша служба — имя дописывается сюда рукой, и до
# тех пор скрипт про неё честно говорит «не моя область», а не поднимает.
# B-N-749 (24.09): клоны Искры zarya и avrora — та же платформа, тот же компакт и своя pamyat.db.
# B-N-815 (24.09, Аврора): marc и spartak — тот же устрой: DSH_HOME=/opt/<имя>/.dsh, база /opt/<имя>/pamyat/pamyat.db,
# свои плагины /opt/<имя>/plugins, секретарь в процессе, события type=turn/* в журнале. Применимы ВСЕ проверки
# (замер 24.09 20:3xZ); прибор состава у marc отвечает «нельзя», пока две его копии плагинов без записей реестра.
# Кодеры alfa/beta/gamma НЕ здесь: общая учётка coders с домом /home/coders, а DSH у каждого в /opt/coders/<имя> —
# прибор состава выводит профиль из дома учётки и слепнет; нужен --profil из DSH_HOME, это отдельная правка.
# B-N-1476 хвост (03.10.2026, Михалыч; поручение Забавы): ОБЛАСТЬ БЕРЁТСЯ ИЗ РЕЕСТРА, а не из списка в коде.
# ЗАЧЕМ. Список дописывался рукой и отставал: 03.10 varvara.service (заведена в реестр клоном) получила «вне области»,
# и её подняли голым restart — без снимка базы и сверки состава. Клонера-скрипта на машине нет, список жил только здесь.
# ПРАВИЛО (поимённо, не маска): служба X.service в области, если в реестре у агента X ровно
#   sluzhba = X.service, polzovatel = X, dom = /opt/X.
# Это тот самый устрой, на котором проверки скрипта верны (свой дом, своя учётка, база /opt/X/pamyat/pamyat.db).
# Кодеры alfa/beta/gamma выпадают САМИ (polzovatel = coders, dom = /opt/coders/<имя>) — по той же причине, что выше.
# Кандидаты — службы из `agent-registry sluzhby`; имя проверяется образцом [a-z][a-z0-9-]* до обращения к реестру.
# 🔴 Реестр не ответил ⇒ ОБЛАСТЬ ПУСТА ⇒ отказ любой службе (код 2, слепота), а не прежний список: тихий откат на
# константу вернул бы ровно ту беду, ради которой правка.
# ЧЕГО НЕ ЛОВИТ: агент с другим устроем, ошибочно записанный в реестр с dom=/opt/X и polzovatel=X, будет поднят
# с проверками для этого устроя — правило верит реестру; запись реестра — ответственность заводящего.
v_oblasti_reestra() {  # v_oblasti_reestra <служба>  → код 0, если в области
  local s="$1" a v
  a="${s%.service}"
  [ "$s" = "$a.service" ] || return 1
  [[ "$a" =~ ^[a-z][a-z0-9-]*$ ]] || return 1
  v=$(agent-registry pole "$a" sluzhba --json 2>/dev/null | jq -r . 2>/dev/null) && [ "$v" = "$a.service" ] || return 1
  v=$(agent-registry pole "$a" polzovatel --json 2>/dev/null | jq -r . 2>/dev/null) && [ "$v" = "$a" ] || return 1
  v=$(agent-registry pole "$a" dom --json 2>/dev/null | jq -r . 2>/dev/null) && [ "$v" = "/opt/$a" ] || return 1
}
OBLAST=""
reestr_sluzhby=$(agent-registry sluzhby 2>/dev/null) || reestr_sluzhby=""
for s_ in $reestr_sluzhby; do
  v_oblasti_reestra "$s_" && OBLAST="${OBLAST:+$OBLAST }$s_"
done
[ -n "$OBLAST" ] || echo "🔴 СЛЕПОТА: область из реестра ПУСТА (agent-registry sluzhby не ответил или нет ни одной подходящей записи)" >&2
suhoj=""; prervat_hod=""; prervat_distill=""
dovody=()
for d in "$@"; do
  case "$d" in
    --suhoj)       suhoj=да;;
    # 🔴 ОБРЫВ ХОДА ТРЕБУЕТ НАЗВАННОЙ ПРИЧИНЫ (07.09.2026, наблюдение Забавы).
    # Ключ был голым флагом. Замер по журналу: за трое суток он применён 6 раз, все шесть —
    # моей рукой, и НИ ОДНА причина никуда не попала: в отчёте я её называла, в следе машины
    # её не было вовсе. Разбирающий через неделю видел бы «ход оборван» без «зачем».
    # ПОЧЕМУ ИМЕННО ТАК, а не «предупредить и продолжить»: рядом уже стоит образец, который
    # работает — PODNYAT_NESMOTRYA=«почему сейчас» требует ЗНАЧЕНИЯ, и однажды эта причина
    # сама доехала до чужого журнала и объяснила чужому агенту, что произошло. Механизм,
    # вынуждающий НАЗВАТЬ, оставляет след даже когда его об этом не просили; предупреждение
    # не вынуждает ничего.
    # ЦЕНА И ГРАНИЦА: голая форма теперь ОТКАЗЫВАЕТ. Ломать чужие вызовы это не может —
    # замер выше показал, что голой формой не пользовался никто, кроме меня, и я пишу
    # команду заново каждый раз. Причина уходит в COMMAND= журнала sudo сама, отдельной
    # дисциплины не требует.
    --prervat-hod=*) prervat_hod="${d#--prervat-hod=}"
                     [ -n "$prervat_hod" ] || { echo "🔴 --prervat-hod= с ПУСТОЙ причиной: назовите её словами" >&2; exit 2; };;
    --prervat-hod) echo "🔴 --prervat-hod ТРЕБУЕТ ПРИЧИНЫ: --prervat-hod='почему обрываем именно сейчас'" >&2
                   echo "   Обрыв теряет работу хода целиком, и через неделю «зачем» не восстановит никто." >&2
                   exit 2;;
    # A-N-804 (24.09): обрыв идущей дистилляции — тем же порядком, что обрыв хода: только с причиной.
    --prervat-distillyaciyu=*) prervat_distill="${d#--prervat-distillyaciyu=}"
                     [ -n "$prervat_distill" ] || { echo "🔴 --prervat-distillyaciyu= с ПУСТОЙ причиной: назовите её словами" >&2; exit 2; };;
    --prervat-distillyaciyu) echo "🔴 --prervat-distillyaciyu ТРЕБУЕТ ПРИЧИНЫ: --prervat-distillyaciyu='почему обрываем именно сейчас'" >&2
                   exit 2;;
    # B-N-1494 (03.10.2026, Михалыч): --oblast — ОДИН источник области для потребителей (сторож подъёма мимо ворот).
    # Печатает область (stdout, через пробел) и выходит: код 0 — непуста, 2 — пуста (реестр не ответил либо нет
    # подходящих записей). Правило членства не копируется потребителю — он зовёт этот ключ.
    --oblast) [ -n "$OBLAST" ] && { echo "$OBLAST"; exit 0; }; exit 2;;
    --*) echo "🔴 неизвестный ключ: $d (есть --suhoj, --prervat-hod=<причина>, --prervat-distillyaciyu=<причина>, --oblast)" >&2; exit 2;;
    *) dovody+=("$d");;
  esac
done
sluzhba=${dovody[0]:-}
OZHIDAEMYJ_PID=${dovody[1]:-}
[ -n "$sluzhba" ] || {
  echo "podyom-uzla <служба> [ожидаемый MainPID] [--suhoj] [--prervat-hod=<причина>] [--prervat-distillyaciyu=<причина>]" >&2
  echo "  область: $OBLAST" >&2
  exit 2; }
# 🔴 НЕИЗВЕСТНАЯ СЛУЖБА — КОД 2 (СЛЕПОТА), А НЕ 1. Это «не моя область», то есть про
# инструмент, а не про предмет: отказ 1 читался бы как «поднимать нельзя».
case " $OBLAST " in
  *" $sluzhba "*) ;;
  *) echo "🔴 СЛЕПОТА: «$sluzhba» вне области этого скрипта." >&2
     echo "   Он поднимает только: $OBLAST" >&2
     echo "   Другую службу поднимайте рукой — и знайте, что снимка базы и сверки состава при этом не будет." >&2
     exit 2;;
esac
# B-N-749 (24.09): дом клона — для базы, плагинов и профиля. У iskra и dsh прежние пути не тронуты.
# B-N-1872б: petrovich.service — общей веткой (/opt/petrovich, реестр: dom=/opt/petrovich). Прежде он стоял рядом с iskra,
# и канон момента (:673) и снимок канонов (:818) снимались с дома Искры: плагины /opt/iskra/plugins и профиль
# /opt/iskra/.dsh/profiles/web — след подъёма Петровича описывал состав Искры. Базы Петровича заданы явно ниже — не меняются.
case "$sluzhba" in
  iskra.service) DOM_KLONA="";;
  *) DOM_KLONA="/opt/${sluzhba%.service}";;   # B-N-1476: любой агент области из реестра (dom=/opt/<имя> проверен выше)
esac
[ -n "$suhoj" ] && PROBA=${PROBA:-да}

# 🔴 В СУХОМ РЕЖИМЕ ОТКАЗ НЕ ОБРЫВАЕТ, А НАЗЫВАЕТСЯ (ворота В7: «печатает план»).
# ЗАЧЕМ. Сухой прогон нужен, чтобы увидеть, что будет. Первая редакция обрывалась на
# первом же отказе — и показывала одну причину из возможных пяти, а про остальные молчала:
# читатель чинил бы одно, запускал снова и получал следующее. Здесь считаются ВСЕ.
# ⚠️ Объявлена ВЫШЕ всех мест вызова намеренно: 05.09.2026 Михалыч уронил боевой сторож,
# поставив обращение к имени раньше его определения — грамматика чиста, падает в бою.
# A-N-1724 (07.10, Михалыч; рекомендация Вениамина к A-N-1707): след подъёмов — в каталоге ROOT, не в доме Искры.
#   Прежде /opt/iskra/workspace/procedury/zhurnal-podyomov.txt (iskra:iskra 644): bash агента мог дописать «ДО» (ложное
#   «ОБЪЯВЛЕН» ядра памяти) или стереть строку (ложное «МИМО ВОРОТ»). Каталог /var/log/podyom-uzla — root:root 0755, файл 0644:
#   читают все (ядро, kto-podnimal, прибор реестра), пишет только root (podyom-uzla бежит от root). Замки .podyom-*.lock
#   идут за dirname(SLED) и переезжают сюда же. Канон, снимок и манифест сверки переехали сюда же в A-N-1726.
SLED=${SLED:-/var/log/podyom-uzla/zhurnal-podyomov.txt}
# 🔴 B-N-844(б): строки «ДО/ПОСЛЕ» подъёма-заглушки — под СВОИМ тегом. kto-podnimal считает подъёмом строки программы
# «podyom-uzla» (точное имя); 25.09 06:54–06:59Z прогоны стенда оставили 11 ложных пар «iskra.service рука iskra, MainPID
# 1624301 → 1624301» — из журнала их не убрать. Тег заглушки kto-podnimal не посчитает, а след в журнале останется.
LOGGER_TEG=podyom-uzla; [ -n "${KOMANDA_PODYOMA:-}" ] && LOGGER_TEG=podyom-uzla-zaglushka
kto="${SUDO_USER:-${USER:-неизвестна}}"
otkaz_v_suhom=0
# B-N-1001 (26.09): причина ОТКАЗА — в журнал подъёмов и в logger, а не только вызывающему. Живой случай 26.09
# 06:17:33 и 06:20:23Z: zarya.service отказан дважды, следа нет ни в $SLED, ни в журнале — причину восстанавливали
# по косвенным. В сухом режиме НЕ пишем: он ничего не делает и следа не оставляет (как ДО/ПОСЛЕ).
# 🔴 Третье поле — «служба <имя>», а не голое имя: kto-podnimal считает подъём прошедшим ворота по строке, где
# минута совпала и поле 3 == служба; голое имя сделало бы отказ, за которым в ту же минуту подняли рукой, «воротами».
# Третий читатель журнала — dsh-pamyat-core svidetelZagruzki (A-N-1022): с a90 и он берёт только «ДО/ПОСЛЕ» с полем 3 == служба.
# ЧЕГО НЕ ЛОВИТ: отказ ДО разбора ключей и имени службы (неверный вызов, exit 2) — это ошибка вызова, не подъёма.
otkazat() {  # otkazat <код возврата в бою> <причина одной строкой>
  if [ -n "$suhoj" ]; then
    echo "   ⟹ В БОЮ ЗДЕСЬ БЫЛ БЫ ОТКАЗ (код $1); в сухом режиме считаю дальше" >&2
    otkaz_v_suhom=$((otkaz_v_suhom + 1))
    return 0
  fi
  { printf '%s | ОТКАЗ| служба %s | рука %s | код %s | %s\n' \
      "$(date -u '+%F %T UTC')" "$sluzhba" "$kto" "$1" "${2:-причина не названа}" >> "$SLED"; } 2>/dev/null \
    || echo "⚠️  строка ОТКАЗ не записалась в $SLED (отказ состоялся — это след, а не ворота)" >&2
  logger -t "$LOGGER_TEG" "ОТКАЗ: $sluzhba рука $kto код $1: ${2:-причина не названа}" 2>/dev/null || true
  exit "$1"
}

# 🔴 ПОДНИМАТЬ, ЕСЛИ ПРЕДМЕТ ТОТ ЖЕ, ЧТО ПРИ ЗАМЕРЕ (05.09.2026, находка Забавы).
# За сутки ДВАЖДЫ служба поднималась дважды подряд: iskra.service в 11:00:44 и 11:01:42,
# шлюз в 23:41:41 и 23:41:52. Оба раза второй подъём был лишним и оборвал чужой ход:
# поднимающий снял замер ДО, увидел «не перезапускался» — и не сравнил его с числом,
# на основании которого решил поднимать. Прибор сработал, читатель нет.
# 🔴 ПОЧЕМУ «СВЕРКА В ОДНОМ ЗАХОДЕ С ДЕЙСТВИЕМ» ЗДЕСЬ НЕ СПАСАЕТ: между её замером и
# командой прошло ОДИННАДЦАТЬ СЕКУНД. Заход защищает от устаревших часов, а не секунд.
# Спасает только условие ВНУТРИ команды: поднять, ЕСЛИ состояние то самое.
# ГРАНИЦА: ожидаемый MainPID необязателен. Не назвали — прибор об этом СКАЖЕТ и
# поднимет как раньше; молча сходить за «сверено» это не должно.
tekushchij=$(systemctl show "$sluzhba" -p MainPID --value 2>/dev/null)
if [ -n "$OZHIDAEMYJ_PID" ]; then
  if [ "$tekushchij" != "$OZHIDAEMYJ_PID" ]; then
    echo "🔴 ОТКАЗ: предмет уже не тот, что при вашем замере." >&2
    echo "   ожидали MainPID: $OZHIDAEMYJ_PID" >&2
    echo "   сейчас         : $tekushchij" >&2
    echo "   Значит службу подняли между вашим замером и этой командой." >&2
    echo "   Кто и когда: kto-podnimal $sluzhba '<окно>'" >&2
    echo "   Поднимать всё равно? Снимите замер заново и повторите с новым числом." >&2
    # 🔴 otkazat, А НЕ exit: в сухом режиме причина ДОЛЖНА СЧИТАТЬСЯ, а не обрывать прогон.
    # Поймано стендом (П8), не чтением: я перевела на otkazat четыре места из пяти —
    # «защита, применённая наполовину», класс Михалыча, тот же день.
    otkazat 1 "предмет уже не тот, что при замере (MainPID)"
  fi
  echo "сверка предмета: MainPID $tekushchij совпал с ожидаемым"
else
  echo "⚠️  ожидаемый MainPID НЕ НАЗВАН — подъём без сверки предмета (сейчас MainPID $tekushchij)"
fi

# 🔴 B-N-738 (29.09.2026, находка 10 репетиции Авроры): СЛУЖБА СТОИТ — КОМПАКТУ ИДТИ НЕГДЕ. Окно обновления держит службы
# остановленными дольше $OKNO; журнал за окно у стоящей службы пуст ПО ПОСТРОЕНИЮ, и проверка ниже называла это СЛЕПОТОЙ (код 2) —
# обходили PODNYAT_VSLEPUYU, а он гасит РАЗОМ и слепоту прибора состава. Главного процесса нет — компакт не идёт: это ответ, а не
# слепота; так же уже отвечают проверки хода и дистилляции ниже («нет главного процесса — идти негде»).
# ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: служба жива (MainPID есть) — проверка компакта прежняя, с окном $OKNO и прежней слепотой пустого журнала.
# 🔴 B-N-1189 (30.09.2026, low Вениамина): «MainPID пуст» — ДВА разных ответа. Удачный show с MainPID=0 — служба
# стоит, проверкам идти негде (как было). Сбой show (код ≠0 или не число) — systemctl НЕ ОТВЕТИЛ; прежде он читался
# так же, как «служба стоит», и компакт/ход/дистилляция молча пропускались. Теперь — СЛЕПОТА с причиной, отказ
# кодом 2 ДО подъёма; обход — PODNYAT_VSLEPUYU, как у прочих слепот. ЧЕГО НЕ ЛОВИТ: удачный show с MainPID,
# устаревшим к моменту подъёма (это сверка предмета выше); сбой show внутри прибора хода — его ловит сверка ниже.
zamer_mainpid() {  # zamer_mainpid <что меряется> → MAINPID (число); пусто — только при объявленном обходе
  local out kod
  out=$(systemctl show "$sluzhba" -p MainPID --value 2>&1); kod=$?
  if [ "$kod" -eq 0 ] && [[ "$out" =~ ^[0-9]+$ ]]; then MAINPID=$out; return 0; fi
  MAINPID=""
  echo "🔴 СЛЕПОТА: systemctl show $sluzhba -p MainPID не ответил (код $kod: «${out:0:120}») — $1 не измерен(а). Это не «служба стоит»." >&2
  echo "   Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: systemctl show MainPID не ответил (код $kod) — $1 не измерен(а)"
  echo "  обход объявлен: ${PODNYAT_VSLEPUYU:-—}"
}
zamer_mainpid компакт; glavnyj_k=$MAINPID
if [ -z "$glavnyj_k" ] || [ "$glavnyj_k" = 0 ]; then
  echo "компакт: у службы нет главного процесса — компакту идти негде (журнал за $OKNO не смотрю)"
else
zhurnal=$(sudo -n journalctl -u "$sluzhba" --since "-$OKNO" --no-pager -o short-iso 2>/dev/null)   # A-N-1948 №10 (№15): -n — без NOPASSWD слепота, а не ожидание пароля
# 🔴 «-- No entries --» ЭТО НЕ ПУСТОТА. journalctl для неизвестной службы печатает
# эту строку, и проверка `[ -z ]` считает её содержимым: слепота не срабатывала, и
# скрипт шёл дальше как ни в чём не бывало (замер 04.09.2026: длина вывода 16 знаков).
# Пустой ответ инструмента бывает НЕ ПУСТ — он бывает вежлив.
zhurnal=$(printf '%s' "$zhurnal" | grep -v '^-- No entries --$')
if [ -z "$zhurnal" ]; then
  echo "СЛЕПОТА: журнал службы «$sluzhba» за $OKNO пуст — идёт ли компакт, проверить нечем." >&2
  echo "  Это не «компакта нет»: это «не смотрели». Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: журнал службы пуст — компакт не измерен"
  echo "  обход объявлен: ${PODNYAT_VSLEPUYU:-—}"
fi

# 🔴 ВЕРДИКТ — ПО ПОСЛЕДНЕМУ СОБЫТИЮ, А НЕ ПО РАЗНОСТИ СЧЁТЧИКОВ (пойман прогоном 05.09).
# Первая редакция признака хода считала «стартов больше, чем концов». На живом прогоне она
# дала ЗЕЛЁНОЕ при идущем ходе: в окно попали КОНЕЦ предыдущего и НАЧАЛО текущего, счётчики
# сравнялись — 1 и 1. Разность счётчиков верна только если окно начинается на границе, а
# скользящее окно этого не гарантирует НИКОГДА.
# Годный признак: какое событие последнее. start — идёт, end — не идёт, ничего — слепота.
# Счётчики остаются в выводе как справка, но вердикт выносится не по ним.
# 🔴 РАЗЛИЧИТЕЛЬ ПО `type=`, А НЕ ПО ВХОЖДЕНИЮ СЛОВА (правка 14.09.2026, куплена делом).
# Прежний признак искал `compaction/start` где угодно в строке — и ловил РЕЧЬ О СОБЫТИИ:
# сторож [dsh-pamyat-storozha] печатает «область: события ЭТОГО процесса — compaction/start,
# /summary, /end, /prune, turn/start», перечисляя ИМЕНА событий своей области.
# Замер 14.09: в окне 2 ч по вхождению слова 2, по `type=` 1 — ровно одна лишняя, и она
# ОСТАНАВЛИВАЛА ПОДЪЁМ: 14.09 прибор трижды отказал «компакт начат и не завершён» при нуле
# настоящих событий (нашла Забава, воспроизведено мной). Ложно-красное, держало час работы.
# Событие платформы печатается как `[event] type=compaction/start …` — якорь `type=` есть
# у события и отсутствует у перечня. Это различение ПО ФОРМЕ ЗАПИСИ, а не по слову.
nachal=$(printf '%s\n' "$zhurnal" | grep -c 'type=compaction/start')
konchil=$(printf '%s\n' "$zhurnal" | grep -c 'type=compaction/end')
poslednee_k=$(printf '%s\n' "$zhurnal" | grep -oE 'type=compaction/(start|end)' | sed 's/^type=//' | tail -1)
echo "окно $OKNO: compaction/start $nachal · compaction/end $konchil · последнее «${poslednee_k:-нет событий}»"
if [ "$poslednee_k" = "compaction/start" ]; then
  echo "🔴 ОТКАЗ: компакт НАЧАТ и не завершён (последнее событие — старт) — подъём оборвёт его." >&2
  printf '%s\n' "$zhurnal" | grep 'type=compaction/start' | tail -1 | sed 's/^/   последний старт: /' >&2
  echo "   Дождитесь compaction/end либо объявите обход: PODNYAT_NESMOTRYA=«почему сейчас»" >&2
  [ -n "${PODNYAT_NESMOTRYA:-}" ] || otkazat 1 "компакт НАЧАТ и не завершён"
  echo "   обход объявлен: ${PODNYAT_NESMOTRYA:-—}"
fi
fi  # конец ветки «служба жива» (B-N-738)


# 🔴 ИДЁТ ЛИ ХОД АГЕНТА (ворота В7 приёмки). Компакт — не единственное, что рвёт подъём:
# ход рвётся тоже, и работа хода теряется целиком. Признак взят из журнала ЗАМЕРОМ, а не
# придуман: платформа печатает `type=turn/start` и `type=turn/end`. Ход идёт, если стартов
# больше, чем концов, — та же арифметика, что у компакта, и это не совпадение: оба предмета
# «начато и не кончено».
# 🔴 ОБЛАСТЬ — ГЛАВНЫЙ ПРОЦЕСС С ЕГО ЗАПУСКА, А НЕ ОКНО $OKNO (B-N-844, 25.09.2026). Окно было 15 мин, а шаг хода
# (turn/start … turn/end) бывает длиннее: у avrora ход 76 — последний шаг начат 06:29:31Z, подъём 06:44:48Z; в окне
# 06:29:48–06:44:48 событий turn/* 0 из 7 строк → «СЛЕПОТА по ходу» печаталась ПРЕДУПРЕЖДЕНИЕМ, подъём шёл кодом 0 и
# оборвал ход (receipt interrupted_unknown). Тот же приём уже держит дистилляцию (A-N-804, ниже): журнал по _PID главного
# процесса целиком. Раз область начинается с запуска процесса, «последнее событие turn/*» отвечает за всю его жизнь:
# start — ход идёт; end — не идёт; событий нет — ход с запуска процесса не начинался (это ответ, а не слепота).
# СЛЕПОТА теперь — только пустой журнал живого главного процесса, и она ОТКАЗЫВАЕТ (как у дистилляции), а не предупреждает.
# ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: строка turn/end потеряна журналом (ограничение частоты journald) → ложное «идёт», обход — ключ с
# причиной; платформа сменит печать событий — прибор ослепнет в сторону «не начинался» (ловит только сверка при обновлении DSH).
# Проверка компакта выше осталась на окне $OKNO: компакт длится секунды, но идущий дольше окна она не увидит (названо, не лечено).
# 🔴 B-N-1014 (26.09.2026, условие Вениамина): признак хода ВЫНЕСЕН в общий прибор hod-sluzhby — его же зовёт
# smontirovat-fajly перед правкой профиля. Здесь только толкование; меняешь признак — меняешь там, у обоих сразу.
HOD=${HOD_SLUZHBY:-/usr/local/libexec/agent-hod/hod-sluzhby}
[ -n "${HOD_SLUZHBY:-}" ] && echo "⚠️ ПОДМЕНА: HOD_SLUZHBY=$HOD"
hod_str=$("$HOD" "$sluzhba" 2>/dev/null); hod_kod=$?
hod_pole() { printf '%s\n' "$hod_str" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
glavnyj_h=$(hod_pole pid); nachal_hod=$(hod_pole start); konchil_hod=$(hod_pole end)
poslednee_h=$(hod_pole poslednee); [ -n "$poslednee_h" ] && poslednee_h="type=$poslednee_h"
zh_h=""; [ "$(hod_pole zhurnal)" = est ] && zh_h=est
if [ "$hod_kod" -ge 3 ] || [ -z "$hod_str" ]; then
  echo "🔴 прибор хода $HOD не ответил (код $hod_kod) — ниже это СЛЕПОТА по ходу, а не «ход не идёт»" >&2; glavnyj_h=${glavnyj_h:-?}
fi
echo "процесс ${glavnyj_h:-—} с запуска: turn/start $nachal_hod · turn/end $konchil_hod · последнее «${poslednee_h:-нет событий}»"
# 🔴 B-N-1189: прибор хода при сбое СВОЕГО show отвечает «pid=0» кодом 0. «Процесса нет» от него верю, только если
# мой замер MainPID выше тоже дал 0; иначе — слепота по ходу, а не «ходу идти негде».
if [ -n "$MAINPID" ] && [ "$MAINPID" != 0 ] && { [ -z "$glavnyj_h" ] || [ "$glavnyj_h" = 0 ]; }; then
  echo "🔴 СЛЕПОТА по ходу: прибор хода ответил «процесса нет» (${glavnyj_h:-пусто}), а MainPID $MAINPID — идёт ли ход, сказать нечем." >&2
  echo "   Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: прибор хода «процесса нет» при MainPID $MAINPID"
elif [ -z "$glavnyj_h" ] || [ "$glavnyj_h" = 0 ]; then
  echo "ход: у службы нет главного процесса — ходу идти негде"
elif [ -z "$zh_h" ]; then
  echo "🔴 СЛЕПОТА по ходу: журнал главного процесса $glavnyj_h пуст — идёт ли ход, сказать нечем." >&2
  echo "   Это не «ход не идёт». Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: ход не измерен"
elif [ -z "$poslednee_h" ]; then
  echo "ход: с запуска процесса $glavnyj_h событий turn/* нет — ход не начинался"
elif [ "$poslednee_h" = "type=turn/start" ]; then
  echo "🔴 ОТКАЗ: ход агента ИДЁТ (последнее событие — старт хода) — подъём оборвёт его." >&2
  echo "   Работа хода потеряется целиком: заход не переживает перезапуск службы." >&2
  echo "   Дождитесь turn/end либо объявите: --prervat-hod='почему сейчас'" >&2
  [ -n "$prervat_hod" ] || otkazat 1 "ход агента ИДЁТ"
  # 🔴 п.411 (09.09.2026): печатать «обрыв объявлен» ТОЛЬКО когда он объявлен.
  # В сухом режиме otkazat не выходит, а считает и возвращает 0 — и выполнение шло
  # на эту строку, печатая «обрыв хода объявлен, ПРИЧИНА:» с ПУСТОЙ причиной.
  # Две строки подряд противоречили друг другу, и вторая была ложной. В бою этого
  # не видно (там exit), то есть дефект жил ровно в том режиме, которым смотрят,
  # «что будет» — и сухой ноль читался как разрешение поднимать рукой.
  if [ -n "$prervat_hod" ]; then
    echo "   обрыв хода объявлен, ПРИЧИНА: $prervat_hod"
  else
    echo "   обрыв хода НЕ объявлен — в бою здесь отказ; ход не прерывается."
  fi
fi

# 🔴 НЕ ЗАКОНЧЕН ЛИ ПРИЁМ ВХОДЯЩЕГО (B-N-1815, 08.10.2026; находка Авроры, механизм подтвердил Вениамин). Канал telegram
# скачивает и расшифровывает голосовое ДО хода: квитанция уже «канал начат» (channel_started=1), а сообщения для хода ещё нет
# (message_json NULL) и квитанция не закрыта (finished_at NULL). Ход в это время «пуст» — проверка хода выше молчит, а подъём
# обрывает приём (случай e35d7f39 Марка 23:04:59Z). Признак — те же три поля в receipts.sqlite канала агента.
# Условие Вениамина (B-N-1815): удержание blocked='channel_interrupted' НЕ считается идущим приёмом — оно само не продолжится
# (закрывает оператор: receipt-admin discard, B-N-1814); иначе подъём ждал бы предел и отказывал на каждом таком удержании.
# ПОВЕДЕНИЕ: есть такие — ждём до PRIYOM_PREDEL с (умолчание 120) шагом PRIYOM_SHAG (5); кончились — дальше; нет — ОТКАЗ с id.
# СЛЕПОТА (базы нет / не прочиталась) — отказ кодом 2, обход PODNYAT_VSLEPUYU, как у прочих слепот.
# ⚠️ ЧЕГО НЕ ЛОВИТ: приём, ещё не дошедший до channel_started (файл только лёг в ящик), и приём в другом канале, не пишущем
# квитанции; база не своей рабочей области (workspace канала задан иначе, чем <дом>/workspace) — PRIYOM_BAZA.
PRIYOM_BAZA=${PRIYOM_BAZA:-${DOM_KLONA:-/opt/${sluzhba%.service}}/workspace/.message-receipts/receipts.sqlite}
PRIYOM_PREDEL=${PRIYOM_PREDEL:-120}; PRIYOM_SHAG=${PRIYOM_SHAG:-5}
priyom_ne_zakonchen() {  # печатает id незаконченных приёмов (по строке); код 0 — прочитано, 2 — слепота
  sudo -n python3 - "$PRIYOM_BAZA" <<'PYPR'
import sqlite3, sys
try:
    c = sqlite3.connect('file:%s?mode=ro' % sys.argv[1], uri=True, timeout=5)
    for (i,) in c.execute("SELECT id FROM receipts WHERE channel_started=1 AND message_json IS NULL AND finished_at IS NULL AND (blocked IS NULL OR blocked <> 'channel_interrupted') ORDER BY rowid"):
        print(i)
except Exception as e:
    print('СЛЕПОТА: ' + str(e)[:160], file=sys.stderr); sys.exit(2)
PYPR
}
if ! sudo -n test -f "$PRIYOM_BAZA"; then
  echo "🔴 СЛЕПОТА по приёму входящего: базы квитанций канала нет ($PRIYOM_BAZA) — идёт ли приём, сказать нечем." >&2
  echo "   Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: приём входящего не измерен (нет $PRIYOM_BAZA)"
else
  priyom_t0=$(date +%s); priyom_ids=""; priyom_slep=""; priyom_spala=""
  # A-N-1948 №10 (№4): файл ошибок проверки приёма — mktemp (своё случайное имя, 0600), а не предсказуемое имя по PID.
  priyom_err=$(mktemp "${TMPDIR:-/tmp}/podyom-priyom.XXXXXX") || otkazat 2 "слепота: не создан временный файл проверки приёма в ${TMPDIR:-/tmp}"
  while :; do
    priyom_ids=$(priyom_ne_zakonchen 2>"$priyom_err") || { priyom_slep=$(cat -- "$priyom_err"); break; }
    [ -z "$priyom_ids" ] && break
    [ $(( $(date +%s) - priyom_t0 )) -ge "$PRIYOM_PREDEL" ] && break
    echo "приём входящего идёт ($(printf '%s\n' "$priyom_ids" | grep -c .) квит.: $(printf '%s' "$priyom_ids" | tr '\n' ' ')) — жду, $(( $(date +%s) - priyom_t0 )) из ${PRIYOM_PREDEL} с"
    sleep "$PRIYOM_SHAG"; priyom_spala=да
  done
  rm -f -- "$priyom_err"
  priyom_zhdala=$(( $(date +%s) - priyom_t0 ))
  if [ -n "$priyom_slep" ]; then
    echo "🔴 СЛЕПОТА по приёму входящего: база $PRIYOM_BAZA не прочиталась — $priyom_slep" >&2
    echo "   Обход: PODNYAT_VSLEPUYU=да" >&2
    [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: приём входящего не измерен"
  elif [ -n "$priyom_ids" ]; then
    echo "🔴 ОТКАЗ: приём входящего не закончен за ${priyom_zhdala} с (предел ${PRIYOM_PREDEL}) — подъём оборвёт скачивание/расшифровку:" >&2
    printf '%s\n' "$priyom_ids" | sed 's/^/   квитанция /' >&2
    otkazat 1 "приём входящего не закончен: $(printf '%s' "$priyom_ids" | tr '\n' ' ')"
  elif [ -n "$priyom_spala" ]; then   # по факту ожидания, а не по разнице секунд: запрос мог пересечь границу секунды
    echo "приём входящего: дождалась окончания за ${priyom_zhdala} с — незаконченных 0"
  else
    echo "приём входящего: незаконченных 0 ($PRIYOM_BAZA)"
  fi
fi

# 🔴 ИДЁТ ЛИ ДИСТИЛЛЯЦИЯ (A-N-804, 24.09.2026). Секретарь памяти после компакта зовёт разбор
# знаний АСИНХРОННО, внутри процесса службы; ход к этому времени уже кончен, и проверка хода
# его не видит. Подъём убивает процесс — и разбор молча: 24.09 у avrora «ПОЗВАНА» 17:23:41Z,
# статьи до 17:29:36Z, «ЗАКОНЧЕНА» нет, процесс поднят в 17:30Z. У Искры так же (pid 2904246, 08:48Z).
# 🔴 ОБЛАСТЬ — ГЛАВНЫЙ ПРОЦЕСС СЛУЖБЫ С ЕГО ЗАПУСКА, А НЕ ОКНО $OKNO. Разбор длится 18–35 мин
# (замер 24.09: dsh 18, iskra 21,5, zarya 34,5) — окно в 15 мин его не видит по построению, а любое
# окно, снятое наблюдением, — оценка снизу. Разбор живёт в процессе: «ПОЗВАНА» прежнего процесса
# уже ничего не значит, поэтому журнал берётся по _PID главного процесса целиком.
# Раз область начинается ровно с запуска, СЧЁТ верен (довод против счётчиков у хода — скользящее
# окно — здесь не действует) и ловит два разбора подряд, где «последнее событие» соврало бы.
# Концы разбора — ВСЕ, что печатает секретарь (alpha.65, src/index.js:432/438/787/818):
# «ЗАКОНЧЕНА — исход …», «ЗАКОНЧЕНА — ОТКАЗ захода …» и «НЕ СОБРАЛАСЬ» (синхронный отказ сборки:
# «ЗАКОНЧЕНА» тогда нет вовсе — без неё прибор навсегда показывал бы «идёт»).
# Якорь `] дистилляция:` — по форме записи секретаря, а не по слову (урок compaction/start 14.09).
# ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: строки секретаря потеряны журналом (ограничение частоты journald) —
# потерянная «ЗАКОНЧЕНА» даст ложное «идёт», обход ключом с причиной; секретарь сменит формулировки —
# прибор ослепнет в сторону «не идёт» (это НЕ ловит ничто, кроме сверки строк при выпуске секретаря).
zamer_mainpid дистилляция; glavnyj=$MAINPID   # B-N-1189: сбой show — слепота, не «процесса нет»
if [ -z "$glavnyj" ] || [ "$glavnyj" = 0 ]; then
  echo "дистилляция: у службы нет главного процесса — разбору идти негде"
else
  zh_d=$(sudo -n journalctl _SYSTEMD_UNIT="$sluzhba" _PID="$glavnyj" --no-pager -o cat 2>/dev/null | grep -v '^-- No entries --$')   # №15
  if [ -z "$zh_d" ]; then
    echo "🔴 СЛЕПОТА по дистилляции: журнал главного процесса $glavnyj пуст — идёт ли разбор, сказать нечем." >&2
    echo "   Это не «разбор не идёт». Обход: PODNYAT_VSLEPUYU=да" >&2
    [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота: дистилляция не измерена"
  else
    pozvana=$(printf '%s\n' "$zh_d" | grep -ac '\] дистилляция: ПОЗВАНА —')
    konec=$(printf '%s\n' "$zh_d" | grep -acE '\] дистилляция: ЗАКОНЧЕНА —|\] дистилляция НЕ СОБРАЛАСЬ:')
    echo "процесс $glavnyj с запуска: дистилляция ПОЗВАНА $pozvana · закончена $konec"
    if [ "$pozvana" -gt "$konec" ]; then
      echo "🔴 ОТКАЗ: дистилляция ИДЁТ (позвана $pozvana, закончена $konec) — подъём оборвёт её молча." >&2
      printf '%s\n' "$zh_d" | grep -a '\] дистилляция: ПОЗВАНА —' | tail -1 | cut -c1-110 | sed 's/^/   последний позыв: /' >&2
      # B-N-1340 (в): срез и время позыва — из поля distill= прибора хода (метка секретаря razbor-idet-*).
      d_hod=$(hod_pole distill); case "$d_hod" in idet:*) echo "   срез по метке секретаря: ${d_hod#idet:}" >&2 ;; esac
      echo "   Знания среза не запишутся. Дождитесь «ЗАКОНЧЕНА» либо объявите: --prervat-distillyaciyu='почему сейчас'" >&2
      # B-N-1340 (в): СВОЙ код 5 (был 1 — общий с «ход/компакт идёт»): зовущий различает «ждать конца разбора» без чтения текста.
      [ -n "$prervat_distill" ] || otkazat 5 "дистилляция ИДЁТ (позвана $pozvana, закончена $konec)"
      if [ -n "$prervat_distill" ]; then
        echo "   обрыв дистилляции объявлен, ПРИЧИНА: $prervat_distill"
      else
        echo "   обрыв дистилляции НЕ объявлен — в бою здесь отказ; разбор не прерывается."
      fi
    fi
  fi
fi

# 🔴 ПОСЛЕДНЮЮ ПРИНЯТУЮ СПРАШИВАЕТ САМА КОМАНДА ДЕЙСТВИЯ (требование Забавы 05.09.2026).
# ЗАЧЕМ. Сегодня соседу положили core a34, когда принятой была уже a35: список сняли заранее,
# вердикт вышел МЕЖДУ снимком и действием. Условие «последняя принятая на момент действия»
# лечит устаревшее ЧИСЛО в решении и не лечит устаревший СНИМОК у исполнителя — промежуток
# между «посмотрел» и «сделал» остаётся, и расторопностью он не закрывается.
# Здесь промежутка нет ПО ПОСТРОЕНИЮ: прибор зовётся из этой же команды, за секунды до
# перезапуска, и обе стороны сверки — что лежит на диске и что принято — снимает здесь и сейчас.
#
# ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: прибор отвечает на вопрос «поедет ли ПРИНЯТОЕ», а не «поедет ли
# ЗАДУМАННОЕ». Нужно определённое число — называйте цель прибору явно (--cel), отдельным заходом.
# Боевое публичное имя, а не рабочая копия (A-N-676, шаг 2): боевые — root-файлы в /usr/local/bin,
# dorabotki — только разработка. Абсолютный путь, а не поиск по PATH: подмена PATH его не уведёт.
PRIBOR=${PRIBOR:-/usr/local/bin/pered-podyomom.mjs}
if [ -r "$PRIBOR" ]; then
  echo "── прибор перед подъёмом: цель снимается С ДИСКА СЕЙЧАС ──"
  vyvod_pribora=$(node "$PRIBOR" --cel-s-diska --sluzhba "$sluzhba" 2>&1); ishod_pribora=$?
  printf '%s\n' "$vyvod_pribora"
  echo "── исход прибора: $ishod_pribora (0 можно · 1 нельзя · 2 слепота) ──"
else
  echo "🔴 прибора перед подъёмом нет или он не читается: $PRIBOR" >&2
  echo "   Это «не смотрели», а не «сошлось»: что поедет — не сверено ни с чем." >&2
  ishod_pribora=2
  vyvod_pribora="СЛЕПОТА: прибора нет или он не читается: $PRIBOR"
fi
# 🔴 B-N-811 (24.09.2026, Аврора): ИСХОД ПРИБОРА 2 — СЛЕПОТА, И ОБХОД У НЕЁ СВОЙ.
# Было: любой ненулевой исход → один отказ и один обход PODNYAT_NESMOTRYA_NA_PRIBOR; «не смотрели» и
# «посмотрели — нельзя» различала только строка «исход прибора: N». Теперь 1 — как прежде; всё прочее
# ненулевое (2, нечитаемый прибор, падение node с иным кодом) — СЛЕПОТА с причиной из вывода прибора
# и обходом PODNYAT_VSLEPUYU — тем же, что у слепоты журнала и дистилляции выше (нового не завожу).
# ⚠️ ЦЕНА ОДНОГО СЛОВА: объявленный PODNYAT_VSLEPUYU снимает РАЗОМ все три слепоты, различить их можно
# только по строкам вывода. И обратно: PODNYAT_NESMOTRYA_NA_PRIBOR слепоту прибора больше НЕ снимает.
if [ "$ishod_pribora" -ne 0 ] && [ "$ishod_pribora" -ne 1 ]; then
  prichina=$(printf '%s\n' "${vyvod_pribora:-}" | grep -a 'СЛЕПОТА' | head -3 | paste -sd ' ')
  echo "🔴 СЛЕПОТА прибора (исход $ishod_pribora): ${prichina:-причина в выводе прибора не названа}" >&2
  echo "   Это «не смотрели», а не «нельзя»: о составе прибор не сказал ничего. Обход: PODNYAT_VSLEPUYU=да" >&2
  [ -n "${PODNYAT_VSLEPUYU:-}" ] || otkazat 2 "слепота прибора (исход $ishod_pribora)"
  echo "   обход объявлен: ${PODNYAT_VSLEPUYU:-—}"
elif [ "$ishod_pribora" -ne 0 ]; then
  echo "🔴 ОТКАЗ: прибор не сказал «можно» (исход $ishod_pribora). Причины названы поимённо выше." >&2
  echo "   Обход: PODNYAT_NESMOTRYA_NA_PRIBOR=«почему поднимаем всё равно»" >&2
  [ -n "${PODNYAT_NESMOTRYA_NA_PRIBOR:-}" ] || otkazat 1 "прибор не сказал «можно» (исход $ishod_pribora)"
  echo "   обход объявлен: ${PODNYAT_NESMOTRYA_NA_PRIBOR:-—}"
  # 🔴 ГОВОРЮ ВСЛУХ, ЧТОБЫ ОБХОД НЕ СТАЛ ОБРЯДОМ — И НАЗЫВАЮ, КАК ЭТО УЖЕ ЛЕЧИЛОСЬ.
  # 05.09.2026 до 20:52 прибор говорил «нельзя» ПОСТОЯННО: на пути стояли три пакета, которых
  # приёмка не смотрит и не собиралась (чужие предметы, не план памяти). Ворота, непроходимые
  # никогда, не защищают — они учат не смотреть; так у нас уже было с условием вердикта в
  # обёртке публикации, где обход стал обрядом.
  # ✅ Вылечено НЕ здесь: приёмка завела в файле сумм статус «vne-priemki» с причиной у
  # каждого такого пакета, и с 20:53 прибор даёт 0. Обход перестал быть ежедневным.
  # ⚠️ Поэтому если обход снова начнёт объявляться КАЖДЫЙ раз — чинить надо не эту строку, а
  # область приёмки: значит на путь пришёл предмет, которому статуса не назначили.
  echo "   ⚠️ обход, объявляемый каждый раз, — признак не этой строки, а области приёмки:"
  echo "      на пути появился предмет без статуса. Лечится статусом с причиной, а не обходом."
fi

# 🔴 РЕЖИМ ПРОБЫ. Заведён сразу, а не после: 04.09.2026 испытание ЭТОГО ЖЕ скрипта
# перезапустило живую службу соседа — прибор проверяли, а получилось применение.
# Час назад тот же класс был у обёртки публикации (сухой прогон писал в настоящий
# журнал выпусков). Урок не переносится сам: новый инструмент завели без режима пробы.
if [ -n "${PROBA:-}" ]; then
  echo "ПРОБА: службу НЕ поднимаю, показываю только вердикт проверки"
  # 🔴 ПРОБА НАЗЫВАЕТ И СНИМОК — ИНАЧЕ ЕГО ВЕТКА НЕ ПРОВЕРЯЕТСЯ НИКОГДА. Сам снимок в пробе
  # НЕ делается (это действие, создающее файл), но путь и наличие базы показываются: без
  # этого единственный способ узнать, что снимок вообще будет, — настоящий подъём.
  PB="${PODYOM_BAZA:-}"
  if [ -z "$PB" ]; then
    case "$sluzhba" in
      iskra.service) PB=/opt/iskra/pamyat/pamyat.db;;
      petrovich.service)   PB=/opt/petrovich/pamyat/pamyat.db;;
      *) PB="$DOM_KLONA/pamyat/pamyat.db";;   # B-N-1476: агенты области из реестра
    esac
  fi
  if [ -n "$PB" ] && sudo -n test -r "$PB" 2>/dev/null; then
    echo "  снимок базы БЫЛ БЫ сделан: ${PB%.db}-do-podyoma-<время>.db"
  else
    echo "  ⚠️ снимка НЕ было бы: база не найдена или не читается (искал: ${PB:-путь не задан})"
  fi
  if [ "$otkaz_v_suhom" -gt 0 ]; then
    echo "  🔴 В БОЮ ЭТОТ ПРОГОН ОТКАЗАЛ БЫ: причин $otkaz_v_suhom (перечислены выше)"
    echo "  Сухой режим их СЧИТАЕТ, а не глотает — и НЕСЁТ КОДОМ: ниже 1, а не 0."
  else
    echo "  ✅ в бою этот прогон дошёл бы до подъёма: отказов 0"
  fi
  # 🔴 КОД СУХОГО ПРОГОНА НЕСЁТ ТО ЖЕ, ЧТО ТЕКСТ (07.09.2026, находка Забавы).
  # ЗАЧЕМ. Прежняя редакция всегда возвращала 0 и объясняла строкой, что «код про
  # сухой прогон, а не про подъём». Объяснение не сработало: за одну ночь ДВОЕ
  # прочли 0 как разрешение — я в отчёте 05:34 и Забава, собравшаяся поднимать.
  # Предупреждение стояло там, где его не читают, а решали по коду.
  # ⚠️ ГДЕ НЕ ПРИМЕНЯЕТСЯ: 1 здесь значит «в бою был бы отказ», а НЕ «сухой прогон
  # не удался» — тот случай остаётся кодом 2 и не схлопывается с этим.
  # 🔴 КОД 3, А НЕ 1 — довод Вениамина 06:0x, принимаю: 1 у этой обёртки уже занят
  # смыслом «проба не удалась», и стенд поймал это сразу (П8 ждала 0 и покраснела).
  # 3 не путается ни с чем: «сухой прогон СОСТОЯЛСЯ и в бою был бы отказ».
  suhoj_ishod=0
  [ "$otkaz_v_suhom" -gt 0 ] && suhoj_ishod=3
  # 🔴 ДВА ИСХОДА В ОДНОМ ВЫВОДЕ, И ЧИТАЮЩИЙ СКЛАДЫВАЛ ИХ В ОДИН НОЛЬ (он же).
  # «исход: N» выше — это прибор СОСТАВА (что поедет). Здесь — ворота по ХОДУ и
  # прочим причинам. Предметы разные; печатаем порознь, чтобы не суммировались.
  echo "── podyom-uzla: состав (прибор): ${ishod_pribora:-не звался} · ворота (ход и прочее): $([ "$otkaz_v_suhom" -gt 0 ] && echo "ОТКАЗ, причин $otkaz_v_suhom" || echo 'чисто') ──"
  echo "── podyom-uzla: код=$suhoj_ishod (проба: 0 в бою дошло бы · 3 в бою отказ · 2 слепота) ──"
  exit "$suhoj_ishod"
fi
# B-N-1218 LOCK: acquire safely and re-exec before any snapshot/artifact writes.
PODYOM_LOCK_PATH_EXPECTED="$(dirname "$SLED")/.podyom-${sluzhba%.service}.lock"
SLED_PRIBOR="${SLED_PRIBOR:-/usr/local/libexec/podyom-uzla/check-sled.py}"
if [ -z "${PODYOM_LOCK_FD:-}" ]; then
  exec /usr/bin/python3 -I -S -B "$SLED_PRIBOR" --lock-run "$PODYOM_LOCK_PATH_EXPECTED" -- /bin/bash "$0" "${PODYOM_ORIGINAL_ARGS[@]}"
fi
[ "${PODYOM_LOCK_PATH:-}" = "$PODYOM_LOCK_PATH_EXPECTED" ] && /usr/bin/python3 -I -S -B "$SLED_PRIBOR" --lock-held "$PODYOM_LOCK_FD" "$PODYOM_LOCK_PATH_EXPECTED" || otkazat 1 "не подтверждена блокировка следа подъёма"
# B-N-1218 LOCK END

# 🔴 СНИМОК БАЗЫ ПАМЯТИ ДО ПОДЪЁМА (условие приёмки, 05.09.2026).
# ЗАЧЕМ. Подъём применяет миграцию схемы памяти, и делает это на ЖИВОЙ базе в тот миг,
# когда поднимающий уже ничего не видит. У соседа она прошла впервые при ОДНОЙ записи —
# цена нулевая; у меня записей восемьдесят, и цена будет другая.
# Правило приёмки «снимок до подъёма» жило в письме — здесь оно живёт в команде: снимок
# делает сама команда действия, а не память того, кто её зовёт.
#
# ⚠️ ГРАНИЦЫ, названные здесь, а не в памятке:
#   · снимок делается ТОЛЬКО если база найдена; нет базы — говорим вслух и поднимаем,
#     потому что «нет базы» это не отказ подъёма, а другое состояние;
#   · VACUUM INTO читает базу СВОИМ соединением и не мешает работающей службе;
#   · снимок НЕ проверяет, что миграция пройдёт, — он даёт куда откатиться, если не пройдёт.
# 🔴 B-N-1219 (30.09.2026, Аврора; решение Забавы N=5): СРОК СНИМКОВ «ДО ПОДЪЁМА».
# ЗАЧЕМ. Снимок делался перед каждым подъёмом и не удалялся никогда: на 30.09 их 405 шт., 1149.5 МБ = 58% копии sadik
# без рабочих зон (у iskra 82 шт. с 06.09); день окна (52 подъёма) дал +167 МБ и тревогу razmer-kopii-watch.
# КАК. После УДАЧНОГО снимка и записанного следа ДО — удалить снимки ЭТОЙ службы сверх SNIMKOV_HRANIT новейших.
# Порядок — по ВРЕМЕНИ В ИМЕНИ (ГГГГММДДTЧЧММССZ, затем хвост -наносекунды), не по mtime: mtime правится копированием.
# ⚠️ ГРАНИЦЫ: чужие службы не трогаются (имя строго pamyat-do-podyoma-<служба>-<время>[-нс].db); файлы иного вида в
#   каталоге — тоже; снимок не удался / обход без снимка / нет базы / след ДО не лёг — не удаляется НИЧЕГО.
#   Не удалось удалить файл — строка «не удалено», подъём не останавливается (это уборка, а не ворота).
SNIMKOV_HRANIT=5
srok_snimkov() { # srok_snimkov <каталог снимков> <служба без .service>
  local kat="$1" sl="$2" vse n lishnie f razm=0 udaleno=0 imena="" ne=""
  vse=$(sudo -n find "$kat" -maxdepth 1 -type f -name "pamyat-do-podyoma-${sl}-*.db" -printf '%f\n' 2>/dev/null \
        | grep -E "^pamyat-do-podyoma-${sl}-[0-9]{8}T[0-9]{6}Z(-[0-9]+)?\.db$" \
        | sed -E 's/^(pamyat-do-podyoma-.*-([0-9]{8}T[0-9]{6}Z)(-([0-9]+))?\.db)$/\2 \4 \1/' \
        | awk '{ if (NF == 2) { print $1, 0, $2 } else print }' | LC_ALL=C sort -k1,1 -k2,2n | awk '{print $3}')
  n=$(printf '%s' "$vse" | grep -c .)
  if [ "$n" -le "$SNIMKOV_HRANIT" ]; then
    echo "срок снимков: ${sl} — снимков $n ≤ $SNIMKOV_HRANIT, удалять нечего"
    return 0
  fi
  lishnie=$(printf '%s\n' "$vse" | head -n $((n - SNIMKOV_HRANIT)))
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    local r; r=$(sudo -n stat -c %s "$kat/$f" 2>/dev/null || echo 0)
    if sudo -n rm -f -- "$kat/$f" 2>/dev/null && ! sudo -n test -e "$kat/$f" 2>/dev/null; then
      udaleno=$((udaleno + 1)); razm=$((razm + r)); imena="$imena $f"
    else
      ne="$ne $f"
    fi
  done <<< "$lishnie"
  local mb; mb=$(awk -v b="$razm" 'BEGIN{printf "%.1f", b/1000000}')
  local stroka="удалено $udaleno из $n (оставлено $SNIMKOV_HRANIT новейших), ${mb} МБ:${imena:- —}${ne:+ · НЕ удалено:$ne}"
  echo "срок снимков: ${sl} — $stroka"
  { printf '%s | СРОК | служба %s | рука %s | %s\n' "$(date -u '+%F %T UTC')" "$sluzhba" "$kto" "$stroka" >> "$SLED"; } 2>/dev/null \
    || echo "⚠️  строка СРОК не записалась в $SLED" >&2
  logger -t "$LOGGER_TEG" "СРОК: $sluzhba $stroka" 2>/dev/null || true
}
BAZA="${PODYOM_BAZA:-}"
if [ -z "$BAZA" ]; then
  case "$sluzhba" in
    iskra.service) BAZA=/opt/iskra/pamyat/pamyat.db;;
    petrovich.service)   BAZA=/opt/petrovich/pamyat/pamyat.db;;
    *) BAZA="$DOM_KLONA/pamyat/pamyat.db";;   # B-N-1476: агенты области из реестра
  esac
fi
if [ -n "$BAZA" ] && sudo -n test -r "$BAZA" 2>/dev/null; then
  SNIMOK="$(dirname "$BAZA")/pamyat-do-podyoma-${sluzhba%.service}-$(date -u +%Y%m%dT%H%M%SZ).db"
  # 🔴 ИМЯ СНИМКА С ТОЧНОСТЬЮ ДО СЕКУНДЫ МОЖЕТ СТОЛКНУТЬСЯ, И VACUUM INTO В СУЩЕСТВУЮЩИЙ
  # ФАЙЛ НЕ ПИШЕТ. Поймано стендом: две пробы в одну секунду — и вторая получила «снимок не
  # сделан», то есть отказ ИНСТРУМЕНТА под видом отказа предмета. В бою два подъёма в одну
  # секунду невероятны, но «невероятно» — не «невозможно», а причина обязана быть названа.
  if sudo -n test -e "$SNIMOK" 2>/dev/null; then
    echo "⚠️  снимок с таким именем уже есть ($SNIMOK) — беру имя с наносекундами." >&2
    SNIMOK="${SNIMOK%.db}-$(date -u +%N).db"
  fi
  if sudo -n node /usr/local/libexec/podyom-uzla/snapshot.cjs "$BAZA" "$SNIMOK" 2>/dev/null; then
    echo "снимок базы ДО подъёма: $SNIMOK ($(sudo -n stat -c %s "$SNIMOK" 2>/dev/null || echo '?') б)"
  else
    # 🔴 СНИМОК НЕ УДАЛСЯ — ОТКАЗ, А НЕ ПРЕДУПРЕЖДЕНИЕ (ужесточение по воротам В2 приёмки).
    # Прежде здесь стояло «поднимаю без него». Довод приёмки сильнее моего: миграция схемы
    # памяти НЕОБРАТИМА, и подъём без снимка — это действие, у которого нет отката. А
    # предупреждение, после которого действие всё равно происходит, читается как порядок.
    # ⚠️ РАЗЛИЧЕНИЕ, которого в воротах нет и которое я называю сама: «база не найдена» —
    # это ДРУГОЕ состояние, а не неудача снимка, и оно отказом не становится (ветка ниже).
    echo "🔴 ОТКАЗ: снимок базы НЕ сделан ($BAZA) — службу не трогаю." >&2
    echo "   Миграция схемы памяти необратима: без снимка откатываться будет некуда." >&2
    echo "   Обход: PODNYAT_BEZ_SNIMKA=«почему сейчас можно без отката»" >&2
    [ -n "${PODNYAT_BEZ_SNIMKA:-}" ] || otkazat 1 "снимок базы не сделан ($BAZA)"
    echo "   обход объявлен: ${PODNYAT_BEZ_SNIMKA:-—}"
    SNIMOK=""
  fi
else
  echo "⚠️  база памяти не найдена или не читается (искал: ${BAZA:-путь не задан}) — снимка нет." >&2
fi



# 🔴 СЛЕД ДЕЙСТВИЯ — НА МАШИНЕ, А НЕ В ПИСЬМЕ (ворота В4 приёмки, 05.09.2026).
# ЗАЧЕМ. За сутки четыре раза подъём приписывали не той руке, и каждый раз на достоверном
# числе, взятом не у того автора: учётка на ферме общая, journal рук не различает. След,
# который пишет САМА команда, называет и руку, и состав, и путь снимка — в одном месте и
# в момент действия. Письмо приходит через часы и к тому времени описывает прошлое.
# 🔴 ДЕЙСТВИЕ БЕЗ СЛЕДА ЗАПРЕЩЕНО: не записалась строка ДО — отказ, службу не трогаем.
# Иначе подъём состоится, а спросить о нём будет некого — ровно то, из-за чего мы четыре
# раза спорили об авторстве.
# B-N-1218: do not erase a mismatching previous artifact on the next lift.
SLED_PRIBOR="${SLED_PRIBOR:-/usr/local/libexec/podyom-uzla/check-sled.py}"
# A-N-1726 (07.10, Михалыч; моя находка к A-N-1724, решение Забавы): БОЕВОЙ манифест сверки, канон и снимок — рядом со следом,
#   в каталоге root (dirname SLED = /var/log/podyom-uzla, root:root 0755, файлы 0644). Прежде — в доме Искры (procedury, dorabotki):
#   каталог её, значит bash агента мог переименовать/подменить даже root-файл, а учёт узаконивал правку по ДО/ПОСЛЕ.
#   Каталог тот же, что подставной режим и прежде брал для заглушек (dirname SLED); baseline.py берёт след, замки и канон из
#   ОДНОГО --directory — поэтому один каталог, а не /var/lib отдельно. Исходник манифеста Искры остаётся в dorabotki.
SLED_MANIFEST="${SLED_MANIFEST:-$(dirname "$SLED")/manifest.txt}"
sled_proverit_staryj() {
  local put="$1" faza="$2" otvet
  if ! otvet=$(/usr/bin/python3 -I -S -B "$SLED_PRIBOR" --file "$put" --journal "$SLED" --service "$sluzhba" --phase "$faza" --manifest "$SLED_MANIFEST" --allow-new 2>&1); then
    echo "🔴 ОТКАЗ ДО ПЕРЕЗАПИСИ: $otvet" >&2
    return 1
  fi
  case "$otvet" in journal\ *|legacy\ *|recovery\ *|new) return 0 ;; *) echo "🔴 ОТКАЗ: непонятный ответ проверки $put" >&2; return 1 ;; esac
}
sled_opublikovat() {
  local vrem="$1" cel="$2" faza="$3" summa actual field
  summa=$(md5sum -- "$vrem" | cut -d' ' -f1)
  [[ "$summa" =~ ^[0-9a-f]{32}$ ]] || return 1
  if [ -e "$cel" ]; then
    chmod --reference="$cel" "$vrem" && chown --reference="$cel" "$vrem" || return 1
  else chmod 644 "$vrem" || return 1
  fi
  sled_proverit_staryj "$cel" "$faza" || return 1
  field=kanon_md5; [ "$faza" = ПОСЛЕ ] && field=snimok_md5
  # The non-service prefix keeps intent records out of existing lift witnesses.
  printf '%s | ГОТОВ-%s | артефакт %s | %s %s\n' "$(date -u '+%F %T UTC')" "$faza" "$sluzhba" "$field" "$summa" >> "$SLED" || return 1
  mv -T -- "$vrem" "$cel" || return 1
  actual=$(md5sum -- "$cel" | cut -d' ' -f1)
  [ "$actual" = "$summa" ] || return 1
  printf '%s\n' "$summa"
}
# 🔴 п.327: КАНОН МОМЕНТА ПОДЪЁМА СНИМАЕТСЯ ЗДЕСЬ, А НЕ ПРИ ПРОВЕРКЕ (07.09.2026).
# ЗАЧЕМ. Квитанция в режиме «после» сверяла бой с ТЕКУЩИМ диском. Но выпускающий
# после подъёма кладёт на диск новые версии — и сверка расходится по построению,
# у него режим «после» непроходим ВСЕГДА. Тревога «подъём не подтверждён» висела вечно.
# Цель подъёма — то, что лежало на диске В МОМЕНТ подъёма, а не в момент вопроса.
# ГРАНИЦА: канон НЕ отвечает «законен ли состав» — это рука приёмки. Он отвечает
# только на «что именно уехало в бой ЭТИМ подъёмом».
KANON_MOMENTA="$(dirname "$SLED")/kanon-podyoma-${sluzhba%.service}.txt"   # A-N-1726: был /opt/iskra/workspace/procedury/
# 🔴 B-N-844(б): ПОДЪЁМ-ЗАГЛУШКА (KOMANDA_PODYOMA задан — стенд) НЕ ПИШЕТ БОЕВОЙ КАНОН. Канон — «что уехало в бой этим
# подъёмом»; у заглушки не уехало ничего. 25.09 06:59:25Z проба П9 стенда подъёма переписала боевой kanon-podyoma-iskra.txt
# («подъём 06:59:25, рука iskra» вместо настоящего 06:34:32, рука claude) — восстановлен побайтно (md5 = эталону 78c6e1d6).
# Канон заглушки кладётся рядом со следом SLED, который стенд уже изолирует. Тот же приём, что у квитанции ниже.
[ -n "${KOMANDA_PODYOMA:-}" ] && KANON_MOMENTA="$(dirname "$SLED")/kanon-podyoma-${sluzhba%.service}.zaglushka.txt"
SLED_SNIMOK_PUT="${SNIMOK_KANONOV:-$(dirname "$SLED")/snimok-kanonov-${sluzhba%.service}.txt}"   # A-N-1726
[ -n "${KOMANDA_PODYOMA:-}" ] && [ -z "${SNIMOK_KANONOV:-}" ] && SLED_SNIMOK_PUT="$(dirname "$SLED")/snimok-kanonov-${sluzhba%.service}.zaglushka.txt"
sled_proverit_staryj "$KANON_MOMENTA" ДО || otkazat 1 "канон не совпал с прежним следом"
sled_proverit_staryj "$SLED_SNIMOK_PUT" ПОСЛЕ || otkazat 1 "снимок не совпал с прежним следом"
# A-N-1948 №10: шов ТОЛЬКО для стенда — дом, из чьего plugins/ снимается канон момента (по образцу PROFIL_PUTI). Подмена печатается.
# Без подменённой команды подъёма (KOMANDA_PODYOMA) шов — отказ: подменённый дом не должен попасть в боевой канон.
if [ -n "${KANON_DOM:-}" ] && [ -z "${KOMANDA_PODYOMA:-}" ]; then
  otkazat 2 "KANON_DOM задан без KOMANDA_PODYOMA — подмена дома канона только для стенда"
fi
KANON_DOM="${KANON_DOM:-${DOM_KLONA:-/opt/iskra}}"
[ "$KANON_DOM" = "${DOM_KLONA:-/opt/iskra}" ] || echo "ПОДМЕНА: дом канона момента KANON_DOM=$KANON_DOM (только для стенда)"
KANON_VREM=$(mktemp "$(dirname "$KANON_MOMENTA")/.kanon-XXXXXX") || otkazat 1 "не создан временный канон"
{
  printf '# канон момента подъёма %s · служба %s · рука %s\n' "$(date -u '+%F %T UTC')" "$sluzhba" "$kto"
  for d in "$KANON_DOM"/plugins/*/ /opt/agent-plugins/*/; do
    [ -f "$d/package.json" ] || continue
    # A-N-1948 №10: путь — АРГУМЕНТОМ, текст программы постоянный (прежде вклеивался — кавычка в имени давала «?»).
    # package.json ЧИТАЕТСЯ как JSON (fs + JSON.parse), а не загружается require(): require выбирает загрузчик по
    # настоящему файлу за ссылкой. Не JSON или нет поля — «?» для версии и имя каталога вместо name, как прежде.
    nv=$(node -e 'const j=JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"));console.log((j.name||"")+"|"+(j.version||""))' "$d/package.json" 2>/dev/null) || nv=""
    n=${nv%%|*}; v=${nv#*|}
    [ -n "$nv" ] && [ -n "$n" ] || n=$(basename "$d")
    [ -n "$nv" ] && [ -n "$v" ] || v='?'
    printf '%s|%s\n' "$n" "$v"
  done
} > "$KANON_VREM" 2>/dev/null || { rm -f -- "$KANON_VREM"; otkazat 1 "канон момента не записан"; }
KANON_MD5=$(sled_opublikovat "$KANON_VREM" "$KANON_MOMENTA" ДО) || { rm -f -- "$KANON_VREM"; otkazat 1 "канон момента не опубликован"; }
echo "канон момента подъёма снят: $KANON_MOMENTA md5=$KANON_MD5"

do_pid=$(systemctl show "$sluzhba" -p MainPID --value 2>/dev/null)
# 🔴 B-N-1725 (07.10, Михалыч; наряд Забавы): ОБЪЯВЛЕННЫЙ ОБХОД — В СЛЕД, а не только на экран. Прежде причина
#   --prervat-hod/--prervat-distillyaciyu/PODNYAT_VSLEPUYU печаталась в stdout и терялась (в следе 0 таких отметок за всю
#   историю): «обрыв объявлен» нельзя было отличить от «прошёл мимо проверки». Поля — В КОНЦЕ строки ДО (ядро памяти
#   сверяет 2-е и 3-е поля, лишние ему не мешают); «|» и переводы строк в причине заменяются, чтобы не ломать поля.
_chist() { printf '%s' "$1" | tr '|\n\r' '/  '; }
obhody=""
[ -n "$prervat_hod" ] && obhody="$obhody | обрыв хода объявлен: $(_chist "$prervat_hod")"
[ -n "$prervat_distill" ] && obhody="$obhody | обрыв дистилляции объявлен: $(_chist "$prervat_distill")"
[ -n "${PODNYAT_VSLEPUYU:-}" ] && obhody="$obhody | вслепую: $(_chist "$PODNYAT_VSLEPUYU")"
if ! { printf '%s | ДО   | %s | рука %s | MainPID %s | прибор исход %s | снимок %s | kanon_md5 %s%s\n' \
        "$(date -u '+%F %T UTC')" "$sluzhba" "$kto" "$do_pid" "$ishod_pribora" "${SNIMOK:-нет}" "$KANON_MD5" "$obhody" >> "$SLED"; } 2>/dev/null; then
  echo "🔴 ОТКАЗ: строка ДО не записалась в $SLED — действие без следа запрещено." >&2
  echo "   Каталог недоступен на запись? Проверьте: ls -ld $(dirname "$SLED")" >&2
  otkazat 1 "строка ДО не записалась в $SLED"
fi
logger -t "$LOGGER_TEG" "ДО: $sluzhba рука $kto MainPID $do_pid прибор $ishod_pribora снимок ${SNIMOK:-нет} kanon_md5 $KANON_MD5$obhody" 2>/dev/null || true
echo "след ДО записан: $SLED"
# B-N-1219: уборка снимков — только после удачного снимка И записанного следа ДО (SNIMOK пуст при обходе/без базы)
[ -n "${SNIMOK:-}" ] && srok_snimkov "$(dirname "$SNIMOK")" "${sluzhba%.service}"
# 🔴 КОМАНДА ПОДЪЁМА ВЫНЕСЕНА В ПЕРЕМЕННУЮ РАДИ СТЕНДА — И ГОВОРИТ О ПОДМЕНЕ ГРОМКО.
# ЗАЧЕМ. Стенд обязан пройти скрипт ДО КОНЦА, но не имеет права трогать живую службу.
# Заглушка ставится ЦЕЛИКОМ вместо команды (приём Михалыча с send_alert): резать по строке
# нельзя — вышла бы проба про поломку заглушки, а не про предмет.
# ⚠️ ЦЕНА КРЮЧКА, названная здесь: подменивший переменную получит весь обычный вывод БЕЗ
# подъёма. Поэтому подмена кричит в stdout при каждом вызове — молчаливый крючок однажды
# оставил бы службу неподнятой при отчёте «поднято».
echo "── поднимаю $sluzhba ──"
if [ -n "${KOMANDA_PODYOMA:-}" ]; then
  echo "🔴 КОМАНДА ПОДЪЁМА ПОДМЕНЕНА ($KOMANDA_PODYOMA) — служба НЕ поднимается по-настоящему."
  $KOMANDA_PODYOMA "$sluzhba"
  k=$?
else
  sudo -n systemctl restart "$sluzhba"   # A-N-1948 №10 (№15)
  k=$?
fi
posle_pid=$(systemctl show "$sluzhba" -p MainPID --value 2>/dev/null)
echo "MainPID: было $do_pid · стало $posle_pid"

# 🔴 ПОСЛЕ — ГОЛОС ПРОЦЕССА, А НЕ ВРЕМЯ ФАЙЛОВ (ворота В5 приёмки).
# ЗАЧЕМ mtime ЗДЕСЬ НЕ ЧИТАЕТСЯ ВОВСЕ: npm распаковывает файлы с датой 1985 года, поэтому
# признак «файл старше старта» зелёный ВСЕГДА и про предмет не говорит ничего (находка
# Михалыча). Единственный свидетель того, что процесс взял, — строка, которую он сам о
# себе напечатал при подъёме.
# ⚠️ ЖДАТЬ ПРИХОДИТСЯ: пакеты называются не мгновенно. Предел ожидания — числом, и он
# назван здесь, а не подобран молча. Не дождались — это «не сказали», а не «не взяли».
PREDEL_OZHIDANIYA=${PREDEL_OZHIDANIYA:-60}
start_posle=$(systemctl show "$sluzhba" -p ActiveEnterTimestamp --value 2>/dev/null)
echo "── жду голоса пакетов (предел $PREDEL_OZHIDANIYA с) ──"
proshlo=0; nazvalos=0
while [ "$proshlo" -lt "$PREDEL_OZHIDANIYA" ]; do
  nazvalos=$(sudo -n journalctl -u "$sluzhba" --since "$start_posle" --no-pager 2>/dev/null \
             | grep -oE '\[[a-z][a-z0-9-]+ [0-9][0-9a-z.-]*\]' | sort -u | wc -l)
  [ "$nazvalos" -ge "${ZHDU_PAKETOV:-6}" ] && break
  sleep 3; proshlo=$((proshlo + 3))
done
echo "назвалось пакетов: $nazvalos (ждала не меньше ${ZHDU_PAKETOV:-6}, прошло ${proshlo} с)"
if [ -r "$PRIBOR" ]; then
  echo "── прибор ПОСЛЕ: бой против того же, с чем сверялись ДО ──"
  node "$PRIBOR" --posle --cel-s-diska --sluzhba "$sluzhba" 2>&1 | sed -n '/В БОЮ/,$p'
  echo "── (полный вывод прибора — отдельным заходом) ──"
else
  echo "⚠️  прибора нет: что взято в бой — не сверено." >&2
fi

# 🔴 РУБЕЖ ПОСЛЕ МИГРАЦИИ — ЧТЕНИЕМ БАЗЫ, А НЕ ВЫВОДОМ ПЛАГИНА (ворота В6 приёмки).
# Вывод плагина — его слово о себе; база — след на той стороне. При первом проходе рубеж
# обязан равняться числу записей на момент миграции, при повторном — не сдвигаться.
if [ -n "$BAZA" ] && sudo -n test -r "$BAZA" 2>/dev/null; then
  sudo -n node /usr/local/libexec/podyom-uzla/boundary.cjs "$BAZA" 2>/dev/null || echo "  ⚠️ рубеж прочитать не удалось — это «не смотрели», а не «сошлось»"
fi

# 🔴 ВЕРДИКТ СТРОИТСЯ ПО ТРЁМ ПРИЗНАКАМ, А НЕ ПО ОДНОМУ КОДУ restart (06.09.2026).
# ЗАЧЕМ. Координатор нашла у своего курьера подъёма: PID до/после и is-active он ПЕЧАТАЛ,
# а вердикт строил мимо них — отказ съедался, курьер объявлял «поднято» и возвращал 0.
# Проверила у себя тем же вопросом: код restart я использую (exit $k), но posle_pid и
# nazvalos ТОЛЬКО ПЕЧАТАЛИСЬ. То есть служба, поднявшаяся без единого нашего пакета,
# давала код 0 — данные для верного вердикта были на экране и в решении не участвовали.
# Её класс дословно: «сведение есть в выводе и нет в РЕШЕНИИ».
#
# ТРИ ПРИЗНАКА И ПОЧЕМУ У НИХ РАЗНЫЕ КОДЫ:
#   restart отказал        → код самого restart: это отказ ДЕЙСТВИЯ
#   MainPID не сменился    → 1: команда вернула успех, а процесс тот же — расхождение о ПРЕДМЕТЕ
#   пакеты не назвались    → 2 (слепота): служба поднялась, но что она взяла — мы не знаем.
#                            Это «не сказали», а не «не взяли»; слепота ведёт себя как «нельзя».
# ГДЕ НЕ ПРИМЕНЯЕТСЯ: при подменённой команде подъёма (KOMANDA_PODYOMA) PID законно не
# меняется — там проверка PID пропускается, иначе крючок для стенда всегда давал бы отказ.
ishod=$k
if [ "$k" -eq 0 ] && [ -z "${KOMANDA_PODYOMA:-}" ]; then
  if [ -n "$do_pid" ] && [ "$do_pid" != "0" ] && [ "$posle_pid" = "$do_pid" ]; then
    echo "🔴 ОТКАЗ: restart вернул 0, а MainPID НЕ СМЕНИЛСЯ ($do_pid) — служба не перезапустилась." >&2
    echo "   Это про ПРЕДМЕТ, не про команду: успех команды не есть смена процесса." >&2
    ishod=1
  elif [ "$nazvalos" -lt "${ZHDU_PAKETOV:-6}" ]; then
    echo "🔴 СЛЕПОТА: служба поднялась (MainPID $do_pid → $posle_pid), но назвалось только $nazvalos пакетов из ${ZHDU_PAKETOV:-6}." >&2
    echo "   Что взято в бой — НЕ ИЗВЕСТНО. Это «не сказали», а не «не взяли»: предел ожидания ${PREDEL_OZHIDANIYA} с." >&2
    echo "   Слепота ведёт себя как «нельзя»: смотрите журнал службы прежде, чем считать подъём удавшимся." >&2
    ishod=2
  fi
fi

# ── СНИМОК КАНОНОВ ДИСКА В МОМЕНТ ПОДЪЁМА (Б14, ворота В1 Вениамина, слово Забавы 18:02) ──
# ЗАЧЕМ. Режим «после» сверял бой с ТЕКУЩИМ диском — у выпускающего агента это непроходимо
# по построению: диск уходит вперёд боя через минуты, квитанция не выставится никогда, и
# тревога «подъём не подтверждён» становится фоном. Цель подъёма — не голос процесса
# (голос есть признак ОБЪЯВЛЕННОГО: 1.5.7 под номером 1.5.6 говорил «1.5.6»), а КАНОН
# ДИСКА, снятый ровно в этот момент.
#
# 🔴 ПОЧЕМУ ctime, А НЕ mtime (требование Забавы вписать в код, а не в переписку):
# mtime подделывается сохранением времени при подмене — `cp -a` и `git archive | tar -x`
# переносят время источника, и файл, положенный сегодня, показывает прошлую неделю.
# ctime ставит ЯДРО при любой замене inode, обычными средствами его не обойти.
# Значит выбор не вкусовой: следующий, кому «mtime читаемее», должен наткнуться здесь.
#
# ⚠️ ГРАНИЦА ПРИЗНАКА (тоже по слову Забавы, и она НАМЕРЕННАЯ):
# «ctime < ActiveEnter» доказывает, что файл был таким ДО подъёма. При ЛЕНИВОЙ загрузке
# модуля файл, заменённый после подъёма и прочитанный позже, даст ctime > ActiveEnter и
# строку «диск впереди» — то есть прибор ошибётся В БЕЗОПАСНУЮ СТОРОНУ. Это запас, а не
# дефект; кто примет его за дефект и «починит», сдвинет прибор в опасную сторону.
#
# ГДЕ НЕ ПРИМЕНЯЕТСЯ: снимок пишется ПОСЛЕ состоявшегося подъёма и ничего не решает о нём.
# Отказ записи не мешает подъёму и не меняет его исход — это след, а не ворота.
snimok_kanonov() {
  # 🔴 ИМЯ СЛУЖБЫ ПУСТО — ОТКАЗ, А НЕ ФАЙЛ «snimok-kanonov-.txt» (случай 09.09.2026, не гипотеза).
  # Аудитор вызвал эту функцию в ОТРЫВЕ от скрипта, подав придуманные имена входов; функция их
  # не увидела, взяла умолчания и трижды записала в чужой боевой каталог файл с ПУСТЫМ именем
  # службы. Ничего не затёрло — но запись в чужом хозяйстве произошла. В боевом ходе такое
  # невозможно (скрипт отказывает кодом 2 без аргумента), поэтому проверка стоит ЗДЕСЬ, где
  # проходит граница отдельного вызова, а не в начале скрипта, где она уже есть.
  # ГДЕ НЕ ПРИМЕНЯЕТСЯ: это НЕ ворота подъёма — отказ снимка по-прежнему ничего не роняет.
  if [ -z "${sluzhba:-}" ]; then
    echo "⚠️  снимок канонов НЕ пишется: имя службы пусто — вероятно, функция вызвана отдельно от скрипта." >&2
    echo "    Имена входов читаются ИЗ КОДА: SNIMOK_KANONOV и PROFIL_PUTI (не SNIMOK_DIR и не PROFIL)." >&2
    return 0
  fi
  local profil="${PROFIL_PUTI:-${DOM_KLONA:-/opt/iskra}/.dsh/profiles/web}"
  local snf="${SNIMOK_KANONOV:-$(dirname "$SLED")/snimok-kanonov-${sluzhba%.service}.txt}"   # A-N-1726
  # 🔴 B-N-844(б), условие Вениамина 07:05Z: при подъёме-заглушке (KOMANDA_PODYOMA) — снимок рядом со следом SLED, не боевой.
  # Боевой snimok-kanonov-<служба>.txt в эталоне; прогон стенда от root переписал бы его (от iskra запись молча падала: root:root 644).
  [ -n "${KOMANDA_PODYOMA:-}" ] && [ -z "${SNIMOK_KANONOV:-}" ] && snf="$(dirname "$SLED")/snimok-kanonov-${sluzhba%.service}.zaglushka.txt"
  local vhod ime kat kanon ver n=0
  # Боевое имя мерки с режимами (A-N-676, шаг 3); зовётся с --po-publikacii ниже.
  local PRIBOR_SUMM="${PRIBOR_SUMM:-/usr/local/bin/summa-predmeta-rezhim}"
  if [ ! -x "$PRIBOR_SUMM" ]; then
    echo "⚠️  снимок канонов НЕ пишется: прибора сумм нет ($PRIBOR_SUMM) — это «считать нечем», а не «сошлось»." >&2
    return 0
  fi
  vhod=$(sudo -n systemctl show -p ActiveEnterTimestamp --value "$sluzhba" 2>/dev/null || echo '')
  local vrem
  vrem=$(mktemp "$(dirname "$snf")/.snimok-XXXXXX") || return 1
  {
    printf '=== СНИМОК КАНОНОВ ДИСКА ПРИ ПОДЪЁМЕ ===
'
    printf 'служба: %s · ActiveEnter: %s · снято: %s
' "$sluzhba" "${vhod:-неизвестно}" "$(date -u '+%F %T UTC')"
    # Имя режима стоит РЯДОМ С ЧИСЛАМИ: вердикт без имени режима недействителен.
    printf 'канон снят: %s · режим po-publikacii
' "$PRIBOR_SUMM"
    for ime in $(sudo -n grep -hoE "^[[:space:]]*-?[[:space:]]*name:[[:space:]]*[A-Za-z0-9@/._-]+" \
                   "$profil/cordis.patch.yml" 2>/dev/null | sed 's/.*name:[[:space:]]*//' | sort -u); do
      kat=$(sudo -n readlink -f "$profil/node_modules/$ime" 2>/dev/null || echo '')
      [ -n "$kat" ] && [ -d "$kat" ] || continue
      # 🔴 КАНОН СЧИТАЕТСЯ ТЕМ ЖЕ ПРИБОРОМ И В ТОМ ЖЕ РЕЖИМЕ, ЧТО И ПРИНЯТЫЕ СУММЫ.
      # Замер 09.09.2026 на ряде из пяти пакетов: свой find|sha256sum давал ЧУЖОЕ число
      # (core: dfbb5d341385998f против cb9ae2bb6007d3ae у прибора). Снимок с несопоставимым
      # числом бесполезен для вопроса «поднятое ПРИНЯТО?» — сверять было бы нечего с чем.
      # Режим назван ЯВНО: по тому же замеру старый прибор ворот == po-publikacii во всех
      # пяти, а умолчание доработанного прибора (po-disku) расходится во всех пяти. Опора
      # на умолчание тут и есть способ однажды получить расхождение на ровном месте.
      kanon=$("$PRIBOR_SUMM" --po-publikacii "$kat" 2>/dev/null | awk '{print $2}')
      # ⚠️ ПРИБОР НЕ ОТВЕТИЛ — ПИШЕТСЯ СЛОВО, А НЕ ЧИСЛО. Выдуманное или пустое число в
      # снимке хуже отсутствия: оно молча не совпадёт с принятым и обвинит исправный пакет.
      [ -n "$kanon" ] || kanon='НЕ-СНЯТ'
      ver=$(sudo -n python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("version",""))' "$kat/package.json" 2>/dev/null || echo '?')   # A-N-1948 №10: путь аргументом
      printf '%-28s %-18s %s  %s\n' "$ime" "$ver" "$kanon" "$kat"
      n=$((n+1))
    done
    printf 'пакетов в снимке: %s\n' "$n"
    printf 'ЗАВЕРШЁН\n'
  } > "$vrem" 2>/dev/null || { rm -f -- "$vrem"; return 1; }
  SLED_SNIMOK_MD5=$(sled_opublikovat "$vrem" "$snf" ПОСЛЕ) || { rm -f -- "$vrem"; return 1; }
  echo "снимок канонов: $snf (пакетов $n) md5=$SLED_SNIMOK_MD5"
}
SLED_SNIMOK_MD5=НЕ-СНЯТ
snimok_kanonov || echo "⚠️ снимок канонов не записан" >&2
[[ "$SLED_SNIMOK_MD5" =~ ^[0-9a-f]{32}$ ]] || { [ "$ishod" -ne 0 ] || ishod=2; }
printf '%s | ПОСЛЕ| %s | рука %s | MainPID %s → %s | код %s | назвалось %s | снимок %s | snimok_md5 %s\n' \
  "$(date -u '+%F %T UTC')" "$sluzhba" "$kto" "$do_pid" "$posle_pid" "$k" "$nazvalos" "${SNIMOK:-нет}" "$SLED_SNIMOK_MD5" >> "$SLED" 2>/dev/null \
  || { echo "⚠️  строка ПОСЛЕ не записалась в $SLED (действие уже состоялось)" >&2; [ "$ishod" -ne 0 ] || ishod=2; }
logger -t "$LOGGER_TEG" "ПОСЛЕ: $sluzhba MainPID $do_pid → $posle_pid код $k назвалось $nazvalos snimok_md5 $SLED_SNIMOK_MD5" 2>/dev/null || true



# 🔴 B-N-751 (24.09.2026, Михалыч): КВИТАНЦИЯ ПОДЪЁМА — ТЕМ ЖЕ ХОДОМ, что и подъём.
# ЗАЧЕМ. kvitanciya-podyoma сверяет бой с ТЕКУЩИМ диском и поэтому выставляется только «сразу» —
# а звать её в порядке подъёма было некому: подъёмы 20.09 и 24.09 прошли без неё, и sadik-watch
# на aclaude повторял «ПЕРЕЗАПУСКАЛАСЬ» 130 тактов (45 отправок) с 22.09. Кто поднял — тот и квитирует.
# ОТ ЧЬЕГО ИМЕНИ — iskra: команда подменяет файл состояния через mv без chown, и от root файл Искры
# стал бы root:root (писать в него она бы больше не смогла).
# ГДЕ НЕ ПРИМЕНЯЕТСЯ: другие службы (квитанция есть только у Искры); неуспешный подъём (ishod≠0);
# подменённая команда подъёма (стенд). Исход квитанции НЕ меняет код подъёма — это след, а не ворота.
if [ "$ishod" -eq 0 ] && [ "$sluzhba" = "iskra.service" ] && [ -z "${KOMANDA_PODYOMA:-}" ]; then
  KVIT_CMD="${KVIT_CMD:-/usr/local/bin/kvitanciya-podyoma}"
  if [ -x "$KVIT_CMD" ]; then
    sudo -n -u iskra "$KVIT_CMD"; kvk=$?
    if [ "$kvk" -eq 0 ]; then echo "квитанция подъёма: выставлена (B-N-751)"
    else echo "⚠️  квитанция подъёма НЕ выставлена (код $kvk) — sadik-watch будет тревожить, пока её не поставят" >&2; fi
  else
    echo "⚠️  квитанция подъёма: $KVIT_CMD нет или не исполним — НЕ выставлена" >&2
  fi
fi

echo "── podyom-uzla: код=$ishod ── (restart $k · PID $do_pid→$posle_pid · назвалось $nazvalos)"
exit $ishod
