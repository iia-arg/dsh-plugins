# The `standard` agent preset: the full coding agent, mounted once per process.
#
# This file is an AGENT-PLANE composition. The roster mounts it ONCE under a
# standing scope; every session naming it joins by scope parentage, so the
# tools and prompt sections registered here cover each joined agent while a
# session's own state stays keyed per Session/Agent inside the plugins. The
# host composition (`base.cordis.yml` + `web.cordis.yml`) keeps everything a
# preset must not own: the registries themselves, the sandbox and approval
# stack, persistence, and the model route.
#
# A service row here MUST sit inside a group carrying an `isolate` realm.
# Without one it publishes into the root realm, where it is process-global —
# another preset publishing the same name collides, and a host reader would
# resolve one preset's instance for every session; `dsh-agent-presets` rejects
# that at mount. `true` means an entry-local realm: this standing mount's own
# private instance, apart from every other preset's. (A shared label does NOT
# pool instances — `provide()` throws on the second registration under the
# same realm symbol; labels join REALMS, and are not what this file needs.)

# ── identity ────────────────────────────────────────────────────────────────

# The preset's own persona, shadowing the deployment default for this agent.
# `{{model}}` and `{{cwd}}` resolve from the agent's own route and workspace.
- id: persona
  name: '@deepseek-ai/dsh-persona'
  config:
    @@PERSONA_KLYUCH@@: |-
      @@LICHNOST@@
- id: agent-instructions
  name: '@deepseek-ai/dsh-agent-instructions'
  config:
    maxBytes: 65536

# ── shell ───────────────────────────────────────────────────────────────────

# `shell-env` stays in the HOST composition: `apps/cli/src/web.ts` injects it to
# publish `DSH_WEB_URL`/`DSH_WEB_MODE`, and a host row that injects a service is
# the criterion for host-plane ownership — injection resolves before any session
# exists, so there is no agent to key by. Behind a preset realm those variables
# never reached the model's shell at all. Both shell tools consume the host
# registry from here; their executors (`bash-sandbox`/`pwsh-sandbox`) are
# host-plane too.
- id: tool-bash
  name: '@deepseek-ai/dsh-tool-bash'
  disabled: !!js process.platform === 'win32'

@@ESLI SVOJ@@
- id: tool-pwsh
  name: '@deepseek-ai/dsh-tool-pwsh'
  disabled: !!js process.platform !== 'win32'
@@/ESLI SVOJ@@

# ── filesystem ──────────────────────────────────────────────────────────────

# Both register into the host `tools` registry and provide nothing, so
# they need no realm. The `fs` service and its policy stay in the host.
- id: tool-fs
  name: '@deepseek-ai/dsh-tool-fs'

- id: tool-fs-search
  name: '@deepseek-ai/dsh-tool-fs-search'
  config:
    sampleOverCapGlobResults: false

# ── background jobs ────────────────────────────────────────────────────────

# Only the model-facing controls. The task REGISTRY stays on the host plane:
# its producers sit outside any realm this file could put it in — `tool-bash`
# above resolves it with `ctx.get`, and an entry-local realm here is invisible
# to every sibling row, so `run_in_background` would answer "background jobs
# unavailable" while these controls sat in the catalog. The registry is keyed by
# owning agent anyway, so one host instance serves every session. What a preset
# chooses is whether its agent can collect and stop background work at all.
@@ESLI SVOJ@@
- id: tool-jobs
  name: '@deepseek-ai/dsh-tool-jobs'
  # 🔴 ПОГАШЕНО 22.08.2026 (распоряжение главной). Инструменты job_* на маршруте
  # Искры (подписка через шлюз → движок Claude Code) до модели НЕ ДОХОДЯТ, а
  # наставление от них доходит — оно имеет форму СООБЩЕНИЯ. Агенту велят звать
  # то, чего у него нет. Гасится ТОЛЬКО модельный инструмент: реестр фоновых
  # заданий живёт в host plane и не задет.
  # 🔴 ГДЕ НЕ ПРИМЕНЯЕТСЯ: это правка ПО МАРШРУТУ, а не по машине. У Петровича
  # родной цикл dsh, инструменты доходят — ему не переносить.
  # КОГДА СНЯТЬ: когда заработает мост (инструменты придут через MCP).
  disabled: true
@@/ESLI SVOJ@@

# ── skills ──────────────────────────────────────────────────────────────────

# The skill REGISTRY lives in the host composition and is layered per scope:
# these rows register into THIS preset's layer of it, so they need no realm.
# `skill-filesystem` contributes local-root discovery for agents on this preset, and
# `tool-skill` gives them the catalog and loader; the merged catalog also
# carries whatever the deployment registered globally (repository plugins).
# Общий набор скиллов машины (ранг 300 — customSkillDirs). Каталог один на
# машину, root:root 755, правится в одном месте; кому прописан — тот и видит.
#
# 🔴 В ТЕКУЩЕМ МАРШРУТЕ ЭТА СТРОКА ИНЕРТНА (проверено 20.08.2026). Модель Искры
# идёт через claude-oauth → движок Claude Code, и инструменты исполняет ОН:
# каталог скиллов платформы до модели не доходит, как и любой её инструмент
# (о том же предупреждает комментарий в /opt/claude-oauth/gateway.mjs).
# /opt/agent-skills, каталог скиллов движка. Строку ниже держим потому, что
# она станет действующей, если маршрут модели вернётся на родной цикл dsh.
# У Петровича маршрут родной (DeepSeek), и у него работает именно она.
# 🔴 /opt/agent-skills-newserver сюда НЕ добавлять: он выключен намеренно,
# это скиллы развёртывания новой машины, и каждое описание оплачивается
# токенами в КАЖДОЙ сессии. Включается целиком на время установки сервера.
- id: skill-filesystem
  name: '@deepseek-ai/dsh-skill-filesystem'
  config:
    customSkillDirs:
      - @@KATALOG_NAVYKOV@@
      @@SPISOK DOP_KATALOGI_SKILLOV@@

- id: tool-skill
  name: '@deepseek-ai/dsh-tool-skill'

# ── goals ───────────────────────────────────────────────────────────────────

# Only the model-facing tool. The goal SERVICE, its session driver, and the
# `/goal` command stay on the host plane: the Gateway serves the goal domain as
# Remote endpoints whose receiver comes from a generated descriptor, so it
# resolves `goals` on the host and an entry-local realm here would hide it. The
# registry is keyed by session anyway, so one host instance serves every
# session. What a preset chooses is whether its agent can call the goal tool.
# B-H-081 Ш1 k7 (слово владельца 30.09 00:24 МСК «Все нужны»): заводская строка 0.2 command-goal — дословно из dsh-web-app presets/standard.patch.yml.
- id: command-goal
  name: '@deepseek-ai/dsh-command-goal'
- id: tool-goal
  name: '@deepseek-ai/dsh-tool-goal'
  # 🔴 ПОГАШЕНО 22.08.2026 (распоряжение главной), причина та же, что у tool-jobs.
  # Самопробуждение НЕ страдает: по комментарию выше сервис целей, доводчик
  # раундов и команда /goal живут в host plane, пресет решает только, есть ли у
  # агента модельный инструмент. Проверено замером промпта до/после.
  disabled: true

# ── plan mode ───────────────────────────────────────────────────────────────

# Plan state is per-agent by nature, so an entry-local realm is not a
# workaround here — it is the correct lifetime.
- id: planning
  name: cordis:group
  group: true
  isolate:
    planMode: true
  config:
    - id: plan-mode
      name: '@deepseek-ai/dsh-plan-mode'
      config:
        section: |
              You are in plan mode. Stay in plan mode until exit_plan_mode succeeds or the user switches the session mode. Imperative language to implement changes means plan the implementation, not execute it. A user's conversational agreement — including an answer confirming something you asked — approves nothing and does not end plan mode; fold the confirmed decision into the plan and submit it through exit_plan_mode.

              Explore first. Use non-mutating reads, searches, static analysis, and checks to ground the plan in the actual repository. Do not edit or write files, change configuration, run formatters or code generation that rewrites tracked files, commit, or otherwise carry out the plan. Prefer existing functions and patterns over new machinery.

              The tool catalog stays the same across modes for request-cache stability. These plan-mode rules override any later tool description or guidance that suggests using mutation tools; those tools remain listed to keep the tool catalog unchanged. Do not use todo_write to track this planning phase: it tracks implementation after an approved plan, while the plan itself belongs in exit_plan_mode.

              Resolve discoverable facts by inspection. Use ask_user_question only for user-owned choices or material ambiguity that inspection cannot answer. Do not ask the user where code lives or how current behavior works when you can find out.

              Make the plan decision-complete: state the goal and success criteria; group implementation changes by subsystem; identify public API, schema, and data-flow changes; cover edge cases, failure modes, tests, acceptance criteria, and explicit assumptions. Keep it concise enough to review but detailed enough that another engineer can implement it without making design decisions.

              When ready, call exit_plan_mode with the complete plan markdown, starting with a # title. Make exit_plan_mode the only and final tool call in that assistant response: it presents the plan for approval, and implementation begins only in a later step after approval. Do not paste the final plan as a plain reply or ask "should I proceed?" through prose or ask_user_question. If review rejects it, incorporate the feedback and present again. If the review channel is unavailable or aborted, stay in plan mode and ask the user to switch modes manually; do not proceed with implementation.

# ── compaction ──────────────────────────────────────────────────────────────

# `compaction-basic` reads `toolResultPrune` through `ctx.get`, so the pruner must
# share this realm rather than sit outside it.
#
# `tokenMeter` is deliberately NOT in this realm: the meter stays on the HOST
# plane, and the rows here resolve that one instance. It takes no configuration,
# keys every fold by Session, and owns the context-meter projection units the
# browser reads for every session — behind a realm those units would come and go
# with whichever presets happen to be mounted. What a preset chooses is whether
# its agent compacts at all, which is `compaction-basic` below.
- id: compaction
  name: cordis:group
  group: true
  isolate:
    compaction: true
    toolResultPruner: true
  config:
    # 🔴 07.09.2026, ПО ПРЯМОМУ СЛОВУ ВЛАДЕЛЬЦА (19:26 МСК). Механизм компакции
    # ПЛАТФОРМЫ ВЫКЛЮЧЕН ЦЕЛИКОМ. Сводку и урезание теперь делает НАШ шлюз
    # (claude-oauth) через PreCompact-хук Claude Agent SDK — той же схемой, что
    # год работает на aclaude: вход в сводку ограничен, длина задана промтом,
    # модель назначаем мы.
    #
    # Почему выключено, а не настроено. Замер дня: 466 файлов сессий SDK и НОЛЬ
    # границ компакта внутри них — платформа компактила СМЕНОЙ СЕССИИ. Пока
    # суммировщик не был задан, сводку делала модель агента и всё ехало. Как
    # только 11:43 сюда вписали summarizationProvider/Model (думающий v4-flash),
    # рассуждение стало съедать потолок вывода: сводка обрывалась на полуслове,
    # урезание в ядре НЕДЕЛИМО со сводкой (:302 бросок до checkpointMessage),
    # история не резалась, и каждый ход снова упирался в порог. Первый обрыв в
    # истории — 13:15:50, до него за трое суток 22 успешные сводки подряд.
    # Поднятие потолка 8192 -> 32768 не помогло: обрыв повторился на том же
    # контексте, только через 4 минуты вместо 80 секунд.
    #
    # Прежнее содержимое блока сохранено в страховке рядом (bak-*-pre-vykl-kompakcii-dsh).
    # 🔴 07.09.2026: СНЯТ ВМЕСТЕ С ДВИЖКОМ. command-compact ЖДЁТ службу compaction
    # и без неё виснет на «waiting for compaction» — набор не собирается, агент
    # не получает писем вовсе (поймано первым же опытом: письмо осталось в ящике).
    # Класс: снял механизм — проверь его ПОТРЕБИТЕЛЕЙ. Команда /compact теперь
    # не нужна: сжатие делает наш шлюз сам, по порогу.

    # ВОЗВРАЩЕНО 09.09.2026 ПО СЛОВУ ВЛАДЕЛЬЦА, НО ДВИЖОК ТЕПЕРЬ НАШ.
    #
    # Выше описано, почему 07.09 компакцию платформы выключили целиком: сводку
    # писала платформа думающей моделью, рассуждение съедало потолок вывода,
    # сводка обрывалась, а урезание в ядре НЕДЕЛИМО со сводкой — история не
    # резалась и каждый ход снова упирался в порог.
    #
    # Что изменилось и почему это не повтор той же беды: сводку пишет НАШ модуль
    # (dsh-pamyat-kompakt) с потолком вывода 393216 — в 12 раз больше того, на
    # котором она обрывалась. Предел сводки просится СЛОВАМИ в промте, механически
    # выход не режется. При отказе нашей модели отдаём работу родной сводке, то
    # есть компакт не срывается, а кричит в журнал.
    #
    # Что остаётся РОДНЫМ и потому переживает обновление платформы: момент компакта,
    # затенение узлов, границы, запись в журнал, возврат сводки в контекст и
    # проверка того, что сводка меньше затенённого. Наш — один объявленный крючок
    # summarize, платформа сама пишет о нём: Override this sole hook.
    #
    # ГРАНИЦА, НАЗВАННАЯ ДО ПРОБЫ: у Искры модель идёт через наш шлюз, и считает ли
    # счётчик платформы её токены — НЕ ПРОВЕРЕНО. Если не считает, порог не наступит
    # и компакта не будет вовсе. Это видно по журналу и лечится возвратом на шлюзовой
    # компакт, который сейчас работает и остаётся включённым.
    - id: compaction-basic
      name: dsh-pamyat-kompakt-dsh
      config:
        thresholdRatio: @@DOLYA@@
        # retainRatio 0.1 — решение владельца 14.09 14:18 «ставь 0,1 у обоих».
        # Было умолчание платформы 0.16 ≈ 160 000 токенов ≈ 641 644 знака вклеенной переписки
        # в контрольной точке (замер по боевому журналу 14.09). 0.1 уменьшает вклеиваемое.
        # Правило платформы validateRatioRetention (retainRatio < thresholdRatio) выполняется.
        retainRatio: 0.06
        # compactionRetries 0 — A-N-826 (24.09.2026, разбор Искры по коду dsh-compaction-basic :889–901): после сжатия
        # занятость перемеряется (отчёт провайдера + дельта поверхности) и при ≥ порога шёл ВТОРОЙ заход — он затенял
        # 0 ⇒ один заход на шаг; остаток выше порога — warn «step compaction failed: compaction still above threshold
        # after 1 compaction attempts (…)», ход продолжается, на следующем шаге — новое решение по свежему отчёту.
        compactionRetries: 0

    # A-N-1182 (29.09.2026, Заря): /compact — ВНУТРИ этой группы, как в стандартном пресете самой платформы
    #   (@deepseek-ai/dsh/config/agent-presets/standard/agent.cordis.yml :147). command-compact берёт ctx.compaction
    #   из СВОЕГО контекста (dsh-command-compact lib/index.js :54): вне группы он видит корневой compaction-basic из
    #   dsh-base (cordis.patch.yml :284–290) — родной движок на модели агента, наш сумматор обходится (замер 29.09
    #   15:35Z у Спартака: provider claude-oauth, maxTokens 8192). Условие 07.09 «ждёт службу compaction» здесь выполнено:
    #   движок — строкой выше, в той же группе.
    - id: command-compact
      name: '@deepseek-ai/dsh-command-compact'

    - id: tool-result-pruner
      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
      config:
        thresholdChars: 8192
        headChars: 4096
        tailChars: 1024

# ── delegation and workflows ────────────────────────────────────────────────

# The `subagents` registry and its spawn/fork backends live in the HOST
# composition: the registry is a process singleton whose cross-session queries
# the api-proxy serves to the browser, and a provider name may only be
# registered once. This preset contributes the delegation TOOLS, which resolve
# that host registry.
#
# `workflows` is different — nothing outside an agent reads it — so every row
# that reaches it shares one entry-local realm here, and a consumer left
# outside would resolve a host registry this preset does not populate.
#
# `tool-subagent-report` is host-plane for the same reason as the registry,
# not because a preset may not want it: it registers a CONTINUABLE SETUP on
# that singleton rather than a tool this agent calls, and the setup list is
# not scope-aware — one copy per mounted preset means every child gets
# `report` registered once per live session, which throws on the second.
- id: delegation
  name: cordis:group
  group: true
  isolate:
    workflowEngine: true
  config:
    - id: tool-subagent-control
      name: '@deepseek-ai/dsh-tool-subagent-control'

    - id: tool-subagent-list-agents
      name: '@deepseek-ai/dsh-tool-subagent-control/list-agents'

    - id: tool-subagent
      name: '@deepseek-ai/dsh-tool-subagent'
      config:
        provider: spawn
        toolName: subagent
        backgroundMode: continuable

    - id: tool-subagent-fork
      name: '@deepseek-ai/dsh-tool-subagent'
      config:
        provider: fork
        toolName: subagent_fork
        backgroundMode: continuable

    # Production dsh does not install these optional providers. An opting-in
    # Profile mounts each provider once on the host plane; copy this preset,
    # then remove `disabled` from the matching tool row.
@@ESLI SVOJ@@
    - id: tool-subagent-codex
      name: '@deepseek-ai/dsh-tool-subagent'
      disabled: true
      config:
        provider: codex
        toolName: subagent_codex
        backgroundMode: one-shot
        maxDepth: provider-managed

    - id: tool-subagent-claude-code
      name: '@deepseek-ai/dsh-tool-subagent'
      disabled: true
      config:
        provider: claude-code
        toolName: subagent_claude_code
        backgroundMode: one-shot
        maxDepth: provider-managed

@@ESLI DSH01@@
    - id: workflow-worker-thread
      name: '@deepseek-ai/dsh-workflow-worker-thread'
      config:
        provider: spawn
@@/ESLI DSH01@@
@@ESLI DSH02@@
    # DSH 0.2: dsh-workflow-worker-thread снят, на его месте dsh-workflow-ptc (заводской standard 0.2.0-rc.2) — B-N-738, живой подъём
    - id: workflow-ptc
      name: '@deepseek-ai/dsh-workflow-ptc'
      config:
        provider: spawn
@@/ESLI DSH02@@

    - id: tool-workflow
      name: '@deepseek-ai/dsh-tool-workflow'

    - id: tool-ralph
      name: '@deepseek-ai/dsh-tool-ralph'
      config:
        subagentProvider: spawn
        maxRounds: 64
@@/ESLI SVOJ@@

# ── remaining model-facing rows ─────────────────────────────────────────────

- id: tool-ask-user
  name: '@deepseek-ai/dsh-tool-ask-user'

- id: tool-todo
  name: '@deepseek-ai/dsh-tool-todo'
  config:
    allowParallelInProgress: true

# The `web` service and its search provider stay in the host composition; only
# the model-facing tool is per-session.
- id: tool-web
  name: '@deepseek-ai/dsh-tool-web'
  config:
    fetch: false
    searchTimeoutMs: 60000
# B-H-081 Ш1 k7 (слово владельца 30.09 00:24 МСК «Все нужны»): заводские строки 0.2 present и tool-plugin-manager — дословно из
# dsh-web-app presets/standard.patch.yml; tool-plugin-manager ВКЛЮЧЁН (у завода disabled: true): владелец 29.09 21:24:20Z «Все нужны» — на вопрос об установке плагинов агентом.
- id: present
  name: '@deepseek-ai/dsh-tool-present'
@@ESLI SVOJ@@
- id: tool-plugin-manager
  name: '@deepseek-ai/dsh-plugin-manager/tools'
@@/ESLI SVOJ@@

# Долговременная память как ИНСТРУМЕНТ АГЕНТА.
# 🔴 Строка обязана быть ЗДЕСЬ, в наборе агента, а не в слое профиля: в профиле
# web инструменты общего плана выключены намеренно, набор приходит отсюда.
# Стояла в слое профиля — состав собирался без ошибок, плагин числился
# подключённым, а инструментов памяти у агента не было вовсе.
- id: mcp-omega
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: omega
    transport: streamable-http
    url: @@OMEGA_MCP_URL@@
    # A-N-1173-ost (OMEGA ≥1.5.19 требует ключ): значение НЕ здесь — выражение берёт его из окружения службы
    # (EnvironmentFile /etc/omega/mcp-klyuch.env в drop-in 15-omega-mcp-klyuch.conf). Проверено живым dsh headless
    # 30.09: заголовок ушёл, в файлы дома и в журнал сессии значение не попало. 1.5.13 лишний заголовок принимает.
    headers:
      Authorization: !!js "'Bearer ' + process.env.@@OMEGA_KLYUCH_IMYA@@"
    failOnStartupError: false
@@ESLI SOCSETI@@
# B-N-1481: отдельный узкий ключ соцслужбы; значение только из окружения службы агента.
- id: mcp-socseti
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: socseti
    transport: streamable-http
    url: http://127.0.0.1:8381/mcp
    headers:
      Authorization: !!js "'Bearer ' + process.env.SOCSETI_MCP_KEY"
    failOnStartupError: false
@@/ESLI SOCSETI@@
