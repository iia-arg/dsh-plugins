[Unit]
Description=Сторож реестров: ежедневная сверка записанного с машиной
Documentation=file:///usr/local/sbin/registry-watchdog.sh
After=multi-user.target

[Service]
Type=oneshot
# 🔴 Рукой АГЕНТА, а не root. Проверки живости в реестре спрашивают про живые
# руки исполнителя и от чужого пользователя честно отвечают СЛЕПОТА (заведено
# 23.08 после того, как та же проверка от root дала ложно-зелёный ответ).
# Значит и прогон обязан идти той рукой, про которую записан реестр.
User=iskra
Group=iskra
# Дополнительные группы берутся из /etc/group по имени пользователя — сторожу
# нужна agent-button (общий файл токена тревог) и systemd-journal (чтение
# собственного журнала в проверках живости). Обе там есть; claudeoauth там нет
# и здесь не нужна — она живёт только в юните шлюза.
# Каталог состояния создаёт systemd, а не скрипт: агенту не дано писать в
# /var/lib, и его собственный mkdir там отказывает молча (измерено 23.08.2026).
StateDirectory=registry-watchdog
ExecStart=/usr/local/sbin/registry-watchdog.sh --avto-montazh
# Вывод идёт в журнал: вердикт и сырьё рядом, чтобы разбор был возможен потом.
StandardOutput=journal
StandardError=journal
