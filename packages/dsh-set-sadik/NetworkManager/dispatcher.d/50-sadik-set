#!/bin/bash
# Крючок NetworkManager: применить правила политики и маршруты после поднятия соединения.
#
# Заведён 02.09.2026 (Искра). Зачем именно dispatcher, а не PartOf у службы:
# PartOf ловит ПЕРЕЗАПУСК ЮНИТА NetworkManager, а правила смывает ПЕРЕСОЗДАНИЕ
# СОЕДИНЕНИЯ — это другое событие, и оно случается чаще. Защита, привязанная не к тому
# событию, выглядит рабочей и не срабатывает: ровно это случилось 02.09 с systemd-networkd
# (правила смыл его перезапуск, а туннели, к которым был привязан крючок, не рестартовали).
#
# 🔴 ГРАНИЦА. Ловит «соединение поднялось заново». НЕ ловит: смену точки подключения
# на той стороне, качество канала, и случай, когда NM вообще не запускался.
# Молчание этого крючка не значит «сеть здорова» — это проверяет sadik-set-proverka.sh.
IFACE="$1"; ACTION="$2"
EXT_IF=${SET_EXT_IF:-wan0}

# Только поднятие ВНЕШНЕГО интерфейса: dispatcher зовут на каждое событие каждого
# интерфейса, включая туннели, а полный прогон правил на каждый чих — лишняя работа
# и лишний риск.
case "$ACTION" in up|dhcp4-change|dhcp6-change) ;; *) exit 0 ;; esac
[ "$IFACE" = "$EXT_IF" ] || exit 0

logger -t sadik-nm-hook "событие $ACTION на $IFACE — применяю правила политики и маршруты"
/usr/local/sbin/sadik-reply-routing.sh || logger -t sadik-nm-hook "🔴 применение НЕ удалось"
/usr/local/sbin/sadik-set-proverka.sh 2>&1 | logger -t sadik-nm-hook
exit 0
