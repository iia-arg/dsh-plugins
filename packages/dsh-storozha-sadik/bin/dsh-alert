#!/bin/bash
# Канал тревог ОФИСНОГО СЕРВЕРА (sadik) — 24.08.2026, по слову Александра.
#
# ПРАВИЛО, ради которого он заведён (формулировка главной):
#   АДРЕСАТ ТРЕВОГИ ОПРЕДЕЛЯЕТСЯ ПРЕДМЕТОМ НАБЛЮДЕНИЯ, А НЕ МАШИНОЙ, ГДЕ СТОИТ СТОРОЖ.
# Сторожа живут у нас, а наблюдают sadik — значит и канал у них sadik'овский, бот @arg_dsh_alert_bot.
#
# ⚠️ НЕ ПЕРЕПУТАТЬ: запись `sadik/alert-bot-token` в хранилище ПУСТА. Нужная — `dsh/alert-bot-token`.
# Проверено 24.08 вызовом getMe: она отдаёт @arg_dsh_alert_bot (id 8675144966).
set -uo pipefail
MSG="${1:?текст тревоги обязателен}"
# 🔴 06.09.2026: ИСТОЧНИК ПРОГОНА — В КАЖДОЙ СТРОКЕ ЖУРНАЛА. Мои собственные пробы ложились
# теми же строками, что боевые отказы; через несколько часов я прочёл их как аварию и едва не
# поднял ложную тревогу на флот (10 «нет токена» за двое суток — все мои прогоны через sudo).
# След пробы правдоподобен ПО ПОСТРОЕНИЮ — он и должен так выглядеть, — поэтому отличить его
# может только сам инструмент, а не читающий. Юнит ходит под claude; всё, что не из юнита, — рука.
# ⚠️ ПЕРВАЯ РЕДАКЦИЯ ЭТОЙ ФУНКЦИИ БЫЛА НЕГОДНОЙ, ловится только пробой (06.09, стенд):
# она выносила вердикт «sluzhba/RUKA-PROBA» по наличию system.slice — а bash агента бежит
# ВНУТРИ раннера claudeclaw-<инстанс>.service, то есть тоже в system.slice. Ручная проба
# подписывалась как служба: ложная подпись хуже отсутствующей, читающему нечем усомниться.
# Поэтому вердикта здесь НЕТ: печатаем ИМЯ ЮНИТА и УЧЁТКУ — то, что инструмент знает точно.
# Боевой прогон опознаётся по имени (sadik-watch.service); всё, что названо claudeclaw-*, —
# вызвано из агентской сессии, то есть рукой. Различает читающий, по факту, а не по догадке.
_istochnik() {
  local _cg _u
  _cg=$(cat /proc/self/cgroup 2>/dev/null | head -1)
  _u=${_cg##*/}
  [ -n "$_u" ] || _u='cgroup-ne-prochitan'
  printf 'unit=%s uch=%s' "$_u" "$(id -un 2>/dev/null || echo '?')"
}
IST=$(_istochnik)

# 🔴 06.09.2026: РАЗЛИЧАТЬ «ЗАПИСИ НЕТ» И «ХРАНИЛИЩЕ НЕДОСТУПНО». Прежний текст «нет токена
# dsh/alert-bot-token» ЛГАЛ: запись есть и цела, недоступен КАТАЛОГ pass — он принадлежит claude,
# а ручной прогон через sudo идёт от root. Следующий пошёл бы заводить существующую запись.
# Правило: инструмент называет то, что ЗНАЕТ, а не то, о чём догадывается.
# 🔴 06.09.2026, ДВА ДЕФЕКТА В ОДНОЙ СТРОКЕ, ОБА НАШЛИСЬ ТОЛЬКО ПРИ ВЫЗОВЕ ИЗ ЮНИТА.
# (1) ПАДЕНИЕ: здесь стояло "${PASSWORD_STORE_DIR:-$HOME/.password-store}". У юнита systemd
#     HOME может быть не задан, при set -u это «unbound variable» и канал умирает С КОДОМ 1,
#     НЕ ОТПРАВИВ НИЧЕГО. Все мои сторожа зовут канал именно из юнитов — то есть ни одна
#     боевая тревога не ушла бы, а молчание читалось бы как «бед нет».
#     Почему не поймал раньше: ВСЕ пробы канала я гонял РУКОЙ (sudo), где HOME есть.
#     Это мой же урок «проба не той рукой» — на нём и наступил, проверяя как раз канал.
# (2) ЛОЖНАЯ ОБЛАСТЬ: диагностика ниже говорила «хранилище pass недоступно», хотя на sadik
#     токен берётся из /etc/dsh-alert.token и pass тут ни при чём. Инструмент называл область,
#     которой не владеет, — тот же класс, что я чинил сегодня в сканере секретов.
_ISTOCHNIK_TOKENA="/etc/dsh-alert.token"
if ! CHAT="$(timeout 3s /usr/local/bin/vladelec-tg-id)" || [ -z "$CHAT" ]; then
  echo "dsh-alert: владелец не установлен — тревога НЕ отправлена" >&2
  exit 2
fi
TOKEN=$(cat /etc/dsh-alert.token 2>/dev/null | head -1)

if [ -z "$TOKEN" ]; then
  if [ ! -r "$_ISTOCHNIK_TOKENA" ]; then
    logger -t dsh-alert "ERROR $IST: файл токена $_ISTOCHNIK_TOKENA недоступен этой учётке ($(id -un)) — это НЕ «токена нет», а нет доступа"
  else
    _pochemu=$(cat /etc/dsh-alert.token 2>&1 >/dev/null | head -1)
    # A-N-1948 №5 (№25): источник — файл, не pass; прежний текст называл чужую область (класс строк 44–46).
    logger -t dsh-alert "ERROR $IST: файл токена $_ISTOCHNIK_TOKENA читается, но пуст — cat сказал: ${_pochemu:-без объяснения}"
  fi
  exit 1
fi
# Адрес с токеном — через стандартный ввод, НЕ в аргументах: cmdline читает любой (правка 21.08).
# 🔴 06.09.2026: ТРЕВОГИ ТЕРЯЛИСЬ МОЛЧА — 4 за сутки. Причина: parse_mode=HTML, а в тексте
# сторожа стояли угловые скобки ПОДСКАЗКИ читателю (`PODYOM_PODTVERZHDEN=<время>`). Telegram
# читает `<время>` как незакрытый тег и отвечает 400. Забота о понятности убивала сообщение.
# 🔴 И причина была НЕ НАЙДЕНА ЧАС, потому что тело ответа уходило в >/dev/null: Telegram
# называет незакрытый тег в поле description КАЖДОГО отказа. Правило (Михалыч 06.09): проверять
# не «какой поток глушу», а «выбрасываю ли то, что объясняет отказ».
# ⚠️ Обрезка до 4000 — ПРЕДУСМОТРИТЕЛЬНОСТЬ: живого случая >4096 не было (доказано жизнью 0 из 1).
_ekran() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
# 🔴 06.09.2026, ПРЕДЛОЖЕНИЕ ЗАБАВЫ ПОСЛЕ МОЕГО ЖЕ ПРОМАХА: пометку «ПРОБА» нельзя держать
# в голове отправителя. Я записал это правило в 11:23 и нарушил его в 11:43 — Александр
# получил боевую по форме тревогу о перезапуске службы, которого не было.
# Признак точный и дешёвый: systemd ставит INVOCATION_ID КАЖДОМУ юниту. Нет её — зовут рукой
# (ssh, tty, /tmp), и это по построению не боевая тревога.
# ⚠️ ГРАНИЦА: признак говорит «звали не юнитом», а НЕ «это проба». Ручной боевой вызов
# (починил и хочу известить) тоже пометится. Цена принята сознательно: лишнее слово «ПРОБА»
# безобидно, непомеченная ложная тревога стоит доверия к каналу. Обойти намеренно:
# DSH_ALERT_BOEVOJ=1 — тогда пометки нет, и это видно в команде.
if [ -z "${INVOCATION_ID:-}" ] && [ -z "${DSH_ALERT_BOEVOJ:-}" ]; then
  set -- "ПРОБА (вызов рукой, не юнитом): $1"
  # A-N-1948 №5 (№3): в Telegram уходит $MSG, а не $1 — без этой строки пометка доставалась только журналу (SENT),
  # а владелец получал боевую по форме тревогу. Проба: test/stend-dsh-alert.sh П1.
  MSG="$1"
fi

# A-N-1948 №5 (№37): режем ИСХОДНЫЙ текст, до экранирования — иначе обрезка рвёт сущность (&am…) и разметку отвергают; и тот же
# обрезанный текст — в запасной ход (прежде он слал $MSG целиком и при >4096 тоже получал отказ). Предел Telegram — после разбора.
_MSG_KUS="$MSG"
if [ "${#MSG}" -gt 4000 ]; then
  _MSG_KUS="${MSG:0:4000}
…обрезано, полный текст в журнале (знаков всего ${#MSG})"
fi
_MSG_HTML=$(_ekran "$_MSG_KUS")
_otvet=$(printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TOKEN" | curl --config - -sS --max-time 20 -X POST \
  -d "chat_id=${CHAT}" --data-urlencode "text=${_MSG_HTML}" --data-urlencode "parse_mode=HTML" 2>&1)
if ! printf '%s' "$_otvet" | grep -q '"ok":true'; then
  _prichina=$(printf '%s' "$_otvet" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -1)
  logger -t dsh-alert "WARN $IST: разметка отвергнута — ${_prichina:-причина не названа ответом}"
  # 🔴 ЗАПАСНОЙ ХОД (решение Забавы 06.09): единственный пункт, спасающий СОДЕРЖАНИЕ при
  # НЕИЗВЕСТНОЙ будущей причине отказа. Экранирование лечит три знака, description объясняет
  # отказ, а этот держит канал живым, когда Telegram отвергнет то, чего мы не предвидели.
  _otvet2=$(printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$TOKEN" | curl --config - -sS --max-time 20 -X POST \
    -d "chat_id=${CHAT}" --data-urlencode "text=${_MSG_KUS}" 2>&1)
  if printf '%s' "$_otvet2" | grep -q '"ok":true'; then
    logger -t dsh-alert "SENT-PLAIN $IST: дошло БЕЗ разметки (запасной ход)"
  else
    _p2=$(printf '%s' "$_otvet2" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -1)
    logger -t dsh-alert "ERROR $IST: НЕ ДОШЛО ни с разметкой, ни без — ${_p2:-причина не названа ответом}"
    exit 1
  fi
fi
# 🔴 02.09.2026: журналируем УСПЕШНУЮ отправку, не только отказ. Прежде след существовал
# только у неудач, и на вопрос «что уходило в бота» не мог ответить никто — мы потратили
# на это полдня, разыскивая отправителя сообщения про версию платформы. Тот же дефект
# нашёлся у agent-alert на sadik; чиню класс, а не один экземпляр.
# 🔴 02.09.2026: обрезка ОБЪЯВЛЯЕТ СЕБЯ. Немая обрезка выглядит как полный текст —
# читающий не знает, что видит кусок. Приём взят у агента на sadik: всегда печатать
# полное число знаков рядом с обрезанным куском.
_vsego=$(printf '%s' "$1" | LC_ALL=C.utf8 wc -m | tr -d ' ')
_kusok=$(printf '%s' "$1" | tr '\n' ' ' | LC_ALL=C.utf8 sed -e 's/\(.\{0,120\}\).*/\1/')
logger -t dsh-alert "SENT $IST by=$(cat /proc/$PPID/comm 2>/dev/null || echo '?') знаков=$_vsego text=$_kusok"
exit 0
