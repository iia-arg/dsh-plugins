#!/bin/bash
# vladelec-tg-id — ЕДИНСТВЕННЫЙ читатель Telegram-ID владельца фермы на этой машине.
# B-N-2023, слово владельца 13.10.2026 09:32 МСК: «Убирать мой Telegram ID из кода везде, перенести его в настройки».
# Источник: /etc/vladelec/telegram-id (root:root 0644) — ровно одна строка из 5–15 цифр.
# Исход: ID в stdout и код 0; любая беда — код 2 и причина в stderr. УМОЛЧАНИЯ НЕТ НИГДЕ: без файла никто не получит «старый» ID.
# VLADELEC_TG_ID_FILE — путь для стендов; в бою не задаётся.
# Смена ID владельца: правка файла + подъём всех 10 инстансов claudeclaw (ядро читает при старте)
#   + перерегистрация личного чата (jid tg:<id> — данные регистрации, отсюда не берутся).
# Чего НЕ ловит: что ID по существу принадлежит владельцу — проверяется только форма.
# Читатель отказа: upavshie-sluzhby-watch зовёт эту команду каждый прогон и при коде ≠0 пишет координатору A2A.
set -u
F="${VLADELEC_TG_ID_FILE:-/etc/vladelec/telegram-id}"
otkaz() { echo "vladelec-tg-id: ОТКАЗ — $1" >&2; exit 2; }
[ $# -eq 0 ] || otkaz "доводов не принимаю: «${1:0:40}»"
[ -e "$F" ] || [ -L "$F" ] || otkaz "нет файла $F"
# ПРАВА (условие Вениамина 13.10 07:01Z): файл — ещё и источник ПОЛНОМОЧИЯ (domik-komandy исполняет команды только от этого ID).
# Подменивший файл получил бы все тревоги машины и право команд, поэтому отказ, если файл или его каталог можно переписать не-root'ом:
# символьная ссылка, не обычный файл, владелец не root, запись для группы или прочих — у файла И у каталога.
# Граница: проверка и чтение — два шага (stat, потом head); подмена между ними требует записи в каталог root без g/o-w, то есть root.
D=$(dirname -- "$F")
[ -L "$F" ] && otkaz "$F — символьная ссылка, ссылкам не верю"
[ -f "$F" ] || otkaz "$F — не обычный файл"
[ -L "$D" ] && otkaz "каталог $D — символьная ссылка"
read -r fu fm < <(stat -c '%u %a' -- "$F" 2>/dev/null) || otkaz "$F: stat не прочитал"
read -r du dm < <(stat -c '%u %a' -- "$D" 2>/dev/null) || otkaz "$D: stat не прочитал"
[ "$fu" = 0 ] || otkaz "$F: владелец uid $fu, жду root (0)"
(( (8#$fm & 8#022) == 0 )) || otkaz "$F: права $fm — запись группе/прочим запрещена (жду 644 или строже)"
[ "$du" = 0 ] || otkaz "каталог $D: владелец uid $du, жду root (0)"
(( (8#$dm & 8#022) == 0 )) || otkaz "каталог $D: права $dm — запись группе/прочим запрещена (жду 755 или строже)"
[ -r "$F" ] || otkaz "$F не читается учёткой $(id -un 2>/dev/null || echo '?')"
n=$(awk 'END{print NR}' "$F" 2>/dev/null) || otkaz "$F не прочитан"
[ "$n" -ge 1 ] || otkaz "$F пуст"
[ "$n" -eq 1 ] || otkaz "$F: строк $n, ожидаю ровно одну"
s=$(head -1 -- "$F")
[ -n "$s" ] || otkaz "$F: строка пуста"
[[ "$s" =~ ^[0-9]{5,15}$ ]] || otkaz "$F: «${s:0:30}» — не Telegram-ID (ожидаю 5–15 цифр, без пробелов)"
printf '%s\n' "$s"
