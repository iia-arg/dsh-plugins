# Образец /etc/default/chitatel-obhoda — EnvironmentFile юнита chitatel-obhoda.service (A-N-1948 №5, №8).
# Скопировать в /etc/default/chitatel-obhoda (root:root 0644) и вписать свои значения. Комментарий — только отдельной строкой:
# systemd не режет «#» в конце строки значения.
# Без CHO_KOREN и CHO_ADRESAT читатель отказывает кодом 2 («СЛЕПОТА: не настроено») и ничего не шлёт.
# Дом агента, через щель которого уходит письмо (обязательно):
CHO_KOREN=/opt/<агент-отправитель>
# Адресат в родительном падеже — имя файла письма dlya-<адресат>-… (обязательно):
CHO_ADRESAT=<адресат>
# Первая строка письма (необязательно; умолчание — «<узел> · chitatel-obhoda (root, щель …) → координатору · НОЧНОЙ ОБХОД СТЕНДОВ»):
#CHO_SHAPKA="<узел> · chitatel-obhoda → координатору · НОЧНОЙ ОБХОД СТЕНДОВ"
