#!/usr/bin/env bash
# sadik-watch — НЕЗАВИСИМЫЙ ОТ АГЕНТОВ срез машины sadik.
#
# ЗАЧЕМ. До 04.09.2026 наблюдения за sadik не было ВООБЩЕ: всё, что мы знали о той
# машине, приходило письмами её же агентов — то есть от тех, за кем надо наблюдать.
# Если бы Искра замолчала по поломке, а не по пределу сессии, мы узнали бы об этом
# от неё же, то есть никогда. (Я весь день числил свой сторож работающим — а его не
# существовало ни живого, ни мёртвого; в сводке стояла пометка «подтверждено по
# переписке». Подтверждение из письма, а не из состояния, и есть механизм ошибки.)
#
# 🔴 ЧТО МЕРЯЕТ И ЧЕГО НЕ ЛОВИТ — обязательные колонки, требование приёмки (В6):
#   предмет            | признак                        | ЧЕГО НЕ ЛОВИТ
#   служба жива        | свежесть УСПЕШНОГО события в    | «процесс есть, работы нет»
#                      | журнале, НЕ systemctl is-active | ловится только через рост базы
#   память наполняется | рост числа записей в pamyat.db  | качество записей; их осмысленность
#   место на диске     | df по корню                     | место внутри контейнеров/томов
#   связь с машиной    | сам факт ssh                    | НЕ отличает «машина легла» от
#                      |                                 | «наш канал/ключ сломан» — см. ниже
#
# 📌 Ищешь графу «ЧЕГО НЕ ЛОВИТ» грепом — она в КОЛОНКЕ 3 таблицы выше, четыре записи;
# сами записи сформулированы содержательно, без слов «не ловит», поэтому маска по этим
# словам даёт одну строку вместо четырёх (Вениамин так и посчитала 04.09). Считать по области.
#
# 🔴 ЧТО ЗНАЧИТ МОЛЧАНИЕ СТОРОЖА: «за последний такт беды не найдено». Молчание при
# СЛОМАННОМ стороже выглядит так же — поэтому раз в SADIK_GOLOS_SUTOK суток (7) он говорит
# человеку через канал тревог «жив» (B-N-988, ниже раздел 3). Молчание дольше — сторож умер.
#
# 🔴 ПРИ ВЫВОДЕ aclaude ИЗ РАБОТЫ снять ЯВНО: systemctl disable --now sadik-watch.timer
# Иначе сторож замолчит вместе с машиной, и последний отчёт будет зелёным (правило фермы).

# 🔴 КАК ПРОГНАТЬ ПРОБОЙ, НЕ ТРОНУВ БОЕВОЕ (правило фермы 122 от 05.09.2026: прогон рукой
# обязан иметь режим, где наружу не делается ничего). Отдельного ключа заводить не нужно —
# все три точки внешнего действия параметризованы:
#   SADIK_WATCH_SOST=/tmp/proba-sost SADIK_ALERT_BIN=/bin/true SADIK_VLADELEC_WATCH_BIN=/bin/true /usr/local/sbin/sadik-watch
# Первое уводит состояние (иначе проба затрёт боевые рубежи), второе гасит канал тревог.
# Проверять надо ВСЕ ТРИ (с B-N-2023 независимая A2A-проверка отдельно): без первого проба молча съест рубеж и настоящая тревога не прозвучит.
set -uo pipefail
HOST="${SADIK_HOST:-sadik}"
# 🔴 Состояние ЗДЕСЬ, а не в /var/lib: сторож работает под claude (User=claude в юните),
# потому что имя хоста sadik и ключ к нему живут в ~/.ssh/config ПОЛЬЗОВАТЕЛЯ claude.
# Первый же прогон из-под root дал ЛОЖНУЮ тревогу «машина недоступна» — root не смог
# даже разрешить имя. Проба моей рукой не равна пробе рукой службы (урок 31.08.2026).
# A-N-1948 №5 (№23): «${HOME:-}» — без HOME (env -i, cron, чужой юнит) set -u падал здесь кодом 1, раньше отказа кодом 2 ниже;
# пустой путь состояния ловит тот же отказ (условие с SADIK_WATCH_SOST и HOME).
SOST="${SADIK_WATCH_SOST:-${HOME:-}/.local/state/sadik-watch}"
LOG_TAG="sadik-watch"
PORog_TISHINY_MIN="${POROG_TISHINY_MIN:-120}"   # столько минут без строк в журнале службы = тревога
PORog_MESTA_PROC="${POROG_MESTA_PROC:-90}"
# Окно поиска отказа по длине. Переменной — НЕ для удобства: без неё проба не доходит
# до ветки (за 3 часа отказов обычно нет) и молча возвращает «проверено», ничего не проверив.
OKNO_OTKAZA="${OKNO_OTKAZA:-3h}"
# ⚠️ Адрес канала — через переменную с ТЕМ ЖЕ умолчанием. Нужен для стенда: иначе проверить
# ограничение частоты (Г3) можно только рассылкой настоящих сообщений владельцу.
ALERT="${SADIK_ALERT_BIN:-/usr/local/bin/sadik-alert}"

# 🔴 06.09.2026, ПОРУЧЕНИЕ АЛЕКСАНДРА ГОЛОСОМ 11:33: тревоги про sadik уходят С САМОГО SADIK.
# Сторож должен уметь работать ДВУМЯ способами: снаружи (как жил на aclaude) и НА наблюдаемой
# машине. Различие — одна переменная; код проверок общий, иначе две редакции разъедутся молча.
#   MESTNO=0 (умолчание) — снимаем срез по ssh с чужой машины
#   MESTNO=1             — мы НА sadik, снимаем локально
MESTNO="${SADIK_WATCH_MESTNO:-0}"

# ⚠️ ЧТО ТЕРЯЕТСЯ ПРИ MESTNO=1, И ЭТО НЕ ЧИНИТСЯ ПРАВКОЙ:
# проба «машина недоступна» существует только у ВНЕШНЕГО наблюдателя. Сторож, живущий на
# наблюдаемой машине, молчит вместе с ней — его молчание неотличимо от порядка. Ровно то, о чём
# правило «когда машину выключат, сторожа замолчат, и это НЕ должно выглядеть как всё хорошо».
# Поэтому при MESTNO=1 ветка связи не притворяется работающей, а НАЗЫВАЕТ СЕБЯ снятой.
snyat() {
  if [ "$MESTNO" = "1" ]; then
    bash -c "$1"
  else
    ssh -n -o ConnectTimeout=15 -o BatchMode=yes "$HOST" "$1"
  fi
}

# 🔴 B-N-916 (25.09.2026): ЗАПУСК БЕЗ СРЕДЫ ЮНИТА — ОТКАЗ (код 2), А НЕ ТРЕВОГА. Умолчания выше — режим aclaude (срез по ssh,
# отправщик sadik-alert); на sadik голый запуск (`sudo sadik-watch --help`, ручная проба) снимал срез по ssh, падал кодом 255,
# основной канал отдавал 127 и запасной слал ЛОЖНУЮ тревогу агенту (25.09 15:36Z). Признак среды — обе переменные, которые даёт
# ТОЛЬКО юнит/стенд: SADIK_WATCH_MESTNO и SADIK_ALERT_BIN (заданы явно, хоть пустыми). Проверка — ДО первого побочного действия.
# Почему отказ, а не умолчания по имени хоста: умолчание спрятало бы ту же ошибку на другой машине, отказ её называет.
# ⚠️ Не ловит: запуск с этими двумя переменными, но без остальной среды (SADIK_WATCH_SOST и т.п.) — это осознанная подмена.
if [ -z "${SADIK_WATCH_MESTNO+x}" ] || [ -z "${SADIK_ALERT_BIN+x}" ]; then
  echo "ОТКАЗ: sadik-watch запущен без среды юнита (нет SADIK_WATCH_MESTNO и/или SADIK_ALERT_BIN) — сторож не работает, тревог нет. Штатно: systemctl start sadik-watch.service" >&2
  exit 2
fi
if [ -z "${SADIK_WATCH_SOST:-}" ] && [ -z "${HOME:-}" ]; then
  echo "ОТКАЗ: sadik-watch без SADIK_WATCH_SOST и без HOME — некуда писать состояние; сторож не работает, тревог нет. Штатно: systemctl start sadik-watch.service" >&2
  exit 2
fi
VLADELEC_WATCH="${SADIK_VLADELEC_WATCH_BIN-/usr/local/libexec/vladelec-tg-id-watch}"
[ -n "$VLADELEC_WATCH" ] || { echo 'ОТКАЗ: пустой SADIK_VLADELEC_WATCH_BIN' >&2; exit 2; }
mkdir -p "$SOST"
# B-N-2023: independent A2A notice; failure never uses the owner Telegram channel.
if [ "$MESTNO" = 1 ]; then "$VLADELEC_WATCH" || true; fi
# 🔴 Только echo, БЕЗ logger: под systemd stdout и так уходит в журнал с тегом службы.
# С обоими каждая строка попадала в журнал ДВАЖДЫ (проверено прогоном 20:07) — и любой,
# кто посчитает строки, получит удвоение. Наш класс «число, которое врёт вдвое».
log() { echo "$*"; }
# 🔴 06.09.2026: вывод канала БОЛЬШЕ НЕ ГЛУШИТСЯ. `sadik-alert` научен называть причину отказа
# (учётка, путь, запись, ответ Telegram), а этот вызов отправлял её в /dev/null — печатать стал
# тот, кого не слушают. Класс: ЛЕЧЕНИЕ В ОДНОМ ЗВЕНЕ, ОБЕСЦЕНЕННОЕ СОСЕДНИМ (формулировка Забавы).
# `|| true` остаётся намеренно: сторож не должен падать из-за канала.
# 🔴 B-N-886 (25.09.2026): ЗАПАСНОЙ КАНАЛ. Основной канал (dsh-alert, бот Telegram) отказал — тревога уходила только в журнал
# и повторялась каждый такт, видимая лишь тому, кто читает журнал. Теперь при отказе основного — письмо a2a в ящик агента этой
# машины (SADIK_ZAPASNOJ_ADRESAT, умолч. iskra; SADIK_A2A_BIN): транспорт ДРУГОЙ природы (файл в ящике, почтальон, ход агента),
# не тот бот. Коды a2a-send: 0 — лёг и видимость ушла; 4 — лёг, видимость не ушла (у root нет бота) — оба «доставлено в ящик».
# Отметка об отправке — при успехе ЛЮБОГО из двух; оба отказали — строка 🔴 в журнале, отметка не ставится, повтор в следующий такт.
# Одна функция на ВСЕ три места зова канала (trevoga, gruppa, подтверждение подъёма) — иначе запасной закрыл бы часть тревог.
# ⚠️ ЧЕГО НЕ ЛОВИТ: смерть самого sadik-watch; отказ обоих каналов (только журнал); ход агента-адресата не начнётся — письмо лежит.
ZAPASNOJ_ADRESAT="${SADIK_ZAPASNOJ_ADRESAT:-iskra}"; A2A="${SADIK_A2A_BIN:-/usr/local/bin/a2a-send}"
kanal() { # kanal «текст» → 0, если тревога ушла основным ИЛИ запасным каналом
  local k=0 z=0 otv=""
  if [ -x "$ALERT" ]; then "$ALERT" "sadik-watch: $1" || k=$?; else k=127; fi
  [ "$k" -eq 0 ] && return 0
  log "⚠️ основной канал тревог отказал ($ALERT, код $k) — запасной: письмо a2a агенту $ZAPASNOJ_ADRESAT"
  if [ -x "$A2A" ]; then
    otv=$(printf 'sadik-watch: ОСНОВНОЙ КАНАЛ ТРЕВОГ ОТКАЗАЛ (%s, код %s). Тревога:\n%s\n' "$ALERT" "$k" "$1" | "$A2A" "$ZAPASNOJ_ADRESAT" 2>&1) || z=$?
  else z=127; fi
  if [ "$z" -eq 0 ] || [ "$z" -eq 4 ]; then log "   запасной канал: письмо в ящике $ZAPASNOJ_ADRESAT (a2a-send код $z)"; return 0; fi
  log "🔴 ЗАПАСНОЙ канал тоже отказал (a2a-send код $z: $(printf '%s' "$otv" | tail -1 | cut -c1-160)) — тревога только в журнале"
  return 1
}
trevoga() { log "🔴 $*"; kanal "$*" || true; }
# 🔴 B-N-860 (25.09.2026): ГРУППОВАЯ ТРЕВОГА — одна сводная строка на СМЕНУ СОСТАВА группы, повтор не чаще остывания.
# Было: «coder-gateway@… молчит N мин» по строке на шлюз каждый такт — 422 из 436 отправок с 24.09 20:00Z (кодеры на квоте
# Codex до 28.09), настоящие тревоги тонули. Журнал — каждый такт (журнал не устаёт); канал — смена состава либо истёк срок
# остывания (0 — без повторов). Отметка — ТОЛЬКО при успехе канала (приём Г3 ниже): отказ канала не прячет сам себя.
# Состав — имена БЕЗ минут (иначе он «менялся» бы каждый такт). Файл: $SOST/grp-<ключ> = «состав|время отправки».
gruppa() { # gruppa ключ «состав» «текст» остывание_с
  local f="$SOST/grp-$1" sost="$2" txt="$3" ost="$4" bylo="" posl=0 soob="" kod=0
  [ -r "$f" ] && IFS='|' read -r bylo posl < "$f"
  [ -n "$sost" ] && log "🔴 $txt"
  if [ "$sost" != "$bylo" ]; then
    if [ -n "$sost" ]; then soob="$txt${bylo:+ (было: $bylo)}"; else soob="снова в порядке: $bylo"; fi
  elif [ -n "$sost" ] && [ "$ost" -gt 0 ] && [ $(( SEYCHAS - ${posl:-0} )) -ge "$ost" ]; then
    soob="$txt (напоминание: не чаще раза в $(( ost / 60 )) мин)"
  fi
  [ -z "$soob" ] && return 0
  kanal "$soob" || kod=$?
  if [ "$kod" -eq 0 ]; then printf '%s|%s' "$sost" "$SEYCHAS" > "$f"
  else log "⚠️ канал тревог НЕ принял групповую тревогу $1 (код $kod) — отметка НЕ обновлена, повтор в следующий такт"; fi
}

# ── ПОДТВЕРЖДЕНИЕ ПОДЪЁМА ───────────────────────────────────────────────────────
# 🔴 ЗАЧЕМ (04.09.2026, находка при разборе моего же подъёма a27): до этой правки сторож
# обновлял отметку старта В ТОМ ЖЕ ПРОГОНЕ, где кричал о перезапуске. Тревога звучала
# РОВНО ОДИН РАЗ и гасила сама себя — наблюдение, гасящее собственный сигнал. При живом
# автоперезапуске это одно сообщение в телеграм и тишина навсегда.
# Теперь ожидаемый старт кладёт РУКА, сделавшая подъём. Автоперезапуск отметки не кладёт
# ПО ПОСТРОЕНИЮ — не по договорённости, поэтому крик не гаснет сам.
#
# 🔴 ЧЕГО ЗДЕСЬ ПОКА НЕТ, И ЭТО НАДО ЗНАТЬ ДО ТОГО, КАК ПОЛОЖИТЬСЯ НА МЕХАНИЗМ:
# ПОСТОЯННОГО скрипта подъёма со сверкой сумм НЕ СУЩЕСТВУЕТ (проверено 04.09 поиском по
# /usr/local/{bin,sbin}). Подъём a27 делался разовым скриптом внутри сессии, он не сохранён.
# В /tmp/zabava-podyem-iskry.sh лежит ДРУГОЙ, от 03.09: он делает рестарт БЕЗ сверки сумм
# и без отметки — брать его как «скрипт подъёма» нельзя, и /tmp вдобавок чистится.
# СЛЕДСТВИЕ: пока подтверждение кладётся ТОЛЬКО руками — `sadik-watch --podtverdit` сразу
# после подъёма. То есть половина схемы держится на памяти поднимающего, а не на устройстве.
# Это честное состояние, а не недоделка втихую: оформление скрипта подъёма — отдельная
# работа и отдельное решение, здесь она не сделана.
# ⚠️ Пустое значение НЕ подтверждаем: пустая переменная узаконила бы любой старт.
if [ "${1:-}" = "--podtverdit" ]; then
  _s="$(snyat 'systemctl show iskra.service -p ActiveEnterTimestamp --value')"
  [ -n "$_s" ] || { echo "НЕ подтверждаю: не смог снять старт с $HOST (пустое значение узаконило бы что угодно)"; exit 1; }
  printf '%s' "$_s" > "$SOST/ozhidaemyj-start-iskra.txt"
  rm -f "$SOST/trevoga-start-iskra.txt"
  echo "подтверждено: ожидаемый старт iskra.service = «$_s»"
  exit 0
fi

# B-N-1443 (02.10.2026, Заря): курсоры журнала для поиска квоты Codex (ветка SVEZH в теле среза). Строка: служба|курсор|время отказа|срок.
# В тело уходят только строки строгого вида (значение попадает внутрь команды сбора) и base64 без переносов — кавычкам тела не мешает.
KURSORY_F="$SOST/kvota-kursory.txt"
KURSORY_B64=$(grep -E '^[A-Za-z0-9@._-]+\|[a-z]=[0-9a-f]+(;[a-z]=[0-9a-f]+)*\|[0-9]*\|[A-Za-z0-9 ,:]*$' "$KURSORY_F" 2>/dev/null | base64 -w0)
# Битый файл не роняет сторож: его строки отбрасываются, у этих служб — полный проход 7 суток; число отброшенных — в журнал.
_kurs_vsego=$(grep -c . "$KURSORY_F" 2>/dev/null); _kurs_prinyato=$(printf '%s' "$KURSORY_B64" | base64 -d 2>/dev/null | grep -c .)
[ "${_kurs_vsego:-0}" -gt "${_kurs_prinyato:-0}" ] && log "   ⚠️ файл курсоров квоты $KURSORY_F: отброшено $(( _kurs_vsego - _kurs_prinyato )) строк из $_kurs_vsego (неверный вид) — у этих служб полный проход 7 суток"

# ── 1. СВЯЗЬ. Отличаем «машина недоступна» от «сторож не смог спросить» ──────────
SREZ="$(snyat '
  # B-N-961 (25.09, Михалыч): sudo — только если сценарий исполняется НЕ под root. Бой (MESTNO=1, юнит root) — без sudo
  # (было ~12,6 тыс. вызовов/сутки); срез по ssh с aclaude (claude) — с sudo, как прежде. Решает uid ТОЙ стороны, где исполняется.
  S=sudo; [ "$(id -u)" = 0 ] && S=
  _kursory=$(printf "%s" "'"$KURSORY_B64"'" | base64 -d 2>/dev/null)
  _ramka=$(agent-registry pokrytie --json --s-nepolnymi)
  _kod_reestra=$?
  if [ "$_kod_reestra" -ne 0 ] && [ "$_kod_reestra" -ne 4 ]; then
    printf "REGISTRY_ERROR|agent-registry pokrytie --json --s-nepolnymi: код %s; JSON рамки не получен\n" "$_kod_reestra"
    exit 1
  fi
  if ! printf "%s" "$_ramka" | jq -e --argjson code "$_kod_reestra" ".format == \"pokrytie-s-nepolnymi-v1\" and (.doma|type==\"object\") and (.nepolnye|type==\"array\") and (all(.nepolnye[]; (.imya|type==\"string\") and (.prichiny|type==\"array\"))) and (if \$code == 0 then .polnoe == true and (.nepolnye|length)==0 else .polnoe == false and (.nepolnye|length)>0 end)" >/dev/null; then
    printf "REGISTRY_ERROR|agent-registry pokrytie: код %s; JSON не соответствует договору\n" "$_kod_reestra"
    exit 1
  fi
  printf "%s" "$_ramka" | jq -r ".nepolnye[] | \"UNCOVERED|\" + .imya + \"|\" + (.prichiny|join(\"; \"))"
  # ИСТОЧНИК ИМЁН — РЕЕСТР (15.09.2026, Михалыч). Был зашитый список, и сторож не видел
  # Альфу, боевую с 14.09. Пустой ответ реестра -> цикл пуст -> срез неполон -> сработает
  # ветка «не смог спросить», а не тишина. Мест со списком было ДВА, правлены оба.
  for u in $(agent-registry sluzhby); do
    printf "%s|%s|%s\n" "$u" "$(systemctl is-active $u 2>/dev/null)" \
      "$(systemctl show $u -p ActiveEnterTimestamp --value 2>/dev/null)"
  done
  # Дома — тоже из реестра: агент без базы честно даст ошибку чтения ниже, а не пропуск.
  while IFS= read -r d; do
    b="$d/pamyat/pamyat.db"
