  gruppa agent-alert-nastrojka "code=$_aa_rc" "Канал agent-alert ($AGENT_ALERT_PROVERKA): $_aa_sut — $(printf '%s' "$_aa_text" | tr '\n' ' ' | cut -c1-300) (код $_aa_rc)" 21600
fi
