# B-N-1646 BEGIN: ГОСТЕВЫЕ ПРАВИЛА ВАРВАРЫ (Искра; ворота Вениамина; сводный кандидат B-N-1657). Загрузчик инструкций гостевого
# пресета пропускает пропавший/нечитаемый файл МОЛЧА — гостю остаётся запасная строка персоны. Вставка varvara.service
# (80-gostevye-pravila.conf) кричит только при старте; здесь — каждый такт, плюс подмена содержимого: сумма сверяется с
# AGENTS.md.prinyato (sha256 последней ПРИНЯТОЙ редакции; кладёт рука, принявшая правку, — не сторож).
# Чтение — ОТ varvara (root прочтёт и то, что Варвара не может). Местная проверка, как A-N-1146/A-N-1549/2г: смысл только при MESTNO=1.
# ⚠️ ЧЕГО НЕ ЛОВИТ: правильную по сумме, но вредную по смыслу редакцию (её принимает человек); живую подачу файла моделью;
#   подмену самой отметки .prinyato рукой root (сумма сойдётся с подменённым файлом).
GP="${SADIK_GOSTI_PRAVILA:-/etc/varvara/gosti/AGENTS.md}"; GPP="$GP.prinyato"; _gp_sost=""
if ! runuser -u varvara -- test -r "$GP" 2>/dev/null; then _gp_sost="нет или не читается учёткой varvara"
elif [ "$(sha256sum "$GP" | cut -c1-64)" != "$(cut -c1-64 "$GPP" 2>/dev/null)" ]; then _gp_sost="сумма ≠ принятой ($GPP)"
fi
if [ -z "$_gp_sost" ]; then log "   гостевые правила Варвары: $GP читается учёткой varvara, сумма = принятой"; else BEDY=$((BEDY+1)); fi
gruppa gostevye-pravila "$_gp_sost" "Варвара: гостевые правила $GP — $_gp_sost (B-N-1646)" 86400
# B-N-1646 END

# ── 2г. РЕЕСТР ПЛАГИНОВ ПРАВЛЕН МИМО pravka (B-N-898, 25.09.2026) ────────────────────────────────────────────────────────
# 🔴 ЗАЧЕМ. 25.09 07:38–12:46Z plugins.yaml правили 25 раз install+mv мимо `agent-plugins pravka` — без её проверок (форма,
#   повторы ключей, разделы, убыль, копия, приёмка чтением), и этого не видел никто. С B-N-898 pravka пишет в журнал
#   «pravka: установлено <реестр> sha256 <полный> …» (logger -t agent-plugins).
# Признак: sha256 ЖИВОГО файла ≠ sha последней такой строки → «правлен мимо pravka» с последним коммитом git; строк нет вовсе →
#   «установок pravka в журнале нет». Состав группы — живой sha[:16]: новая правка мимо — новая тревога; вернули через
#   pravka — «снова в порядке».
# ⚠️ ЧЕГО НЕ ЛОВИТ: правку pravka-ой, а потом «откат руками» того же содержимого (sha совпадёт); правку, которую pravka
#   поставила неверно по смыслу (её судит verify); журнал, обрезанный ротацией journald до последней установки — тогда
#   ложное «нет установок» (громко, не тихо). Реестр агентов agents.yaml — не здесь (у него pravka нет).
# 🔴 ТОЛЬКО _UID=0 (условие Вениамина 25.09): тег -t agent-plugins поставит любая учётка (`logger -t agent-plugins …` от
#   iskra/zarya) и навсегда погасит тревогу. _UID journald пишет сам по отправителю; pravka ставит только под root.
#   Не ловит: подложную строку от root (любой sudo logger) — это рука с правом писать и сам реестр.
REESTR_PL="${SADIK_REESTR_PLAGINOV:-/etc/agent-registry/plugins.yaml}"
GR_PRAVKA=""; GR_PRAVKA_TXT=""
_zhiv=$(sha256sum "$REESTR_PL" 2>/dev/null | cut -d' ' -f1)
_posl=$(journalctl -t agent-plugins _UID=0 -o cat --no-pager -q 2>/dev/null | grep -aF "pravka: установлено $REESTR_PL sha256 " | tail -1 | sed -n 's/.* sha256 \([0-9a-f]\{64\}\).*/\1/p')
_kommit=$(git --no-optional-locks -C "$(dirname "$REESTR_PL")" log -1 --format='%h %ad «%s»' --date=format-local:%d.%m\ %H:%MZ -- "$(basename "$REESTR_PL")" 2>/dev/null | cut -c1-120)
if [ -z "$_zhiv" ]; then
  GR_PRAVKA="ne-prochitan"; GR_PRAVKA_TXT="реестр плагинов не прочитан: $REESTR_PL"; BEDY=$((BEDY+1))
elif [ -z "$_posl" ]; then
  GR_PRAVKA="${_zhiv:0:16}"; GR_PRAVKA_TXT="реестр плагинов: установок pravka в журнале НЕТ — живой ${_zhiv:0:16} поставлен мимо неё (последний коммит: ${_kommit:-не найден})"; BEDY=$((BEDY+1))
elif [ "$_zhiv" != "$_posl" ]; then
  GR_PRAVKA="${_zhiv:0:16}"; GR_PRAVKA_TXT="реестр плагинов ПРАВЛЕН МИМО pravka: живой ${_zhiv:0:16}, последняя установка pravka ${_posl:0:16} (последний коммит: ${_kommit:-не найден})"; BEDY=$((BEDY+1))
else
  log "   реестр плагинов: живой ${_zhiv:0:16} = последняя установка pravka"
fi
gruppa pravka "$GR_PRAVKA" "$GR_PRAVKA_TXT" 21600

# ── 2в. ROOT-КАТАЛОГ ГОЛОСА В /var/tmp (B-N-1822, 08.10.2026, Аврора; граница Зари B-N-1691b, оценка Вениамина) ──────
# Порча — по коду и замеру Зари (zamer-var-tmp.sh): VoiceTempStore без своего baseDirectory кладёт <база>/dsh-voice-<uid>
#   (dsh-telegram-multiagent src/voice-temp.js:29); стенд под root оставляет /var/tmp/dsh-voice-0. Стенды telegram этого
#   НЕ ловят (при порче зелёные). Рабочие каталоги агентов dsh-voice-<их uid> законны — идут в охват, не в беду.
# Признак: /var/tmp/dsh-voice-* с владельцем uid 0 или с именем dsh-voice-0. Журнал — каждый такт «охват N · root K»;
#   канал — через gruppa: смена состава, «снова в порядке» после уборки, напоминание раз в 6 ч. find отказал — СЛЕПОТА, не ноль.
# Номер «2в» совпадает с блоком «СТОРОЖ НАД СТОРОЖАМИ» — переименование отдельно (решение Забавы 08:51Z: стенд голоса ищет заголовок).
# ⚠️ ЧЕГО НЕ ЛОВИТ: root-остатки стендов под ДРУГИМИ именами и в /tmp; каталог, созданный и убранный между тактами (10 мин);
#   стенды ночного обхода — у него PrivateTmp=yes, их /var/tmp частный и в настоящий не попадает по построению.
VAR_TMP="${SADIK_VAR_TMP:-/var/tmp}"; GR_VOICE=""; GR_VOICE_TXT=""
_vt=$(snyat "find '$VAR_TMP' -maxdepth 1 -name 'dsh-voice-*' -printf '%U %f\n'"); _vk=$?
if [ "$_vk" -ne 0 ]; then
  GR_VOICE="slepo"; GR_VOICE_TXT="СЛЕПОТА: $VAR_TMP/dsh-voice-* не прочитан (find код $_vk) — это не «root-каталогов нет»"; BEDY=$((BEDY+1))
  log "   $VAR_TMP голоса: СЛЕПОТА (find код $_vk)"
else
  _vohv=$(printf '%s\n' "$_vt" | awk 'NF' | wc -l)
  GR_VOICE=$(printf '%s\n' "$_vt" | awk 'NF && ($1 == 0 || $2 == "dsh-voice-0") {print $2}' | sort | paste -sd' ')
  log "   $VAR_TMP голоса: охват $_vohv · root $(printf '%s' "$GR_VOICE" | wc -w)${GR_VOICE:+ — $GR_VOICE}"
  [ -n "$GR_VOICE" ] && { GR_VOICE_TXT="$VAR_TMP: каталог голоса от root — $GR_VOICE (стенд под root без своего каталога; убрать после сверки)"; BEDY=$((BEDY+1)); }
fi
gruppa voice-root "$GR_VOICE" "$GR_VOICE_TXT" 21600

# ── 3. Голос жизни: молчание сторожа должно быть отличимо от молчания беды ──────
# 🔴 B-N-988 (26.09.2026): прежде здесь раз в сутки писалась строка «жив» в СВОЙ журнал — читателя у неё не было (FARM п.8),
#   а за таймером sadik-watch снаружи не следит никто (его нет ни в watchdog.conf, ни в storozha-sutochnye.txt). Теперь —
#   голос человеку через kanal раз в GOLOS_SUTOK суток, по образцу registry-watchdog (HEARTBEAT_DAYS). Нет отметки — первый
#   такт говорит «голос заведён». Отметка — ТОЛЬКО при успехе канала: отказ повторяется каждый такт, не глушит себя на 7 суток.
# ⚠️ ЧЕГО НЕ ЛОВИТ: смерть сторожа видна лишь как ОТСУТСТВИЕ голоса — читатель этого отсутствия человек, не механизм;
#   «таймер активен, но не срабатывает» и выключенный таймер — до 7 суток тишины. Про здоровье машины голос не говорит.
GOLOS_SUTOK="${SADIK_GOLOS_SUTOK:-7}"; GOLOS="$SOST/posledniy-golos"
_golos_bylo=$(cat "$GOLOS" 2>/dev/null)
if ! [[ "$_golos_bylo" =~ ^[0-9]+$ ]]; then _golos_povod="голос жизни заведён"
elif [ $(( SEYCHAS - _golos_bylo )) -ge $(( GOLOS_SUTOK * 86400 )) ]; then _golos_povod="жив, молчал $(( (SEYCHAS - _golos_bylo) / 86400 )) сут."
else _golos_povod=""; fi
if [ -n "$_golos_povod" ]; then
  _kod=0
  kanal "🟢 $_golos_povod: такты идут (этот — $(date -u -d "@$SEYCHAS" '+%d.%m %H:%MZ'), бед в такте: $BEDY). Следующий голос — через $GOLOS_SUTOK сут.; молчание дольше — сторож умер. Это не отчёт о здоровье машины." || _kod=$?
  if [ "$_kod" -eq 0 ]; then printf '%s' "$SEYCHAS" > "$GOLOS"; log "голос жизни сказан ($_golos_povod)"
  else log "⚠️ голос жизни НЕ принят каналом (код $_kod) — отметка НЕ обновлена, повтор в следующий такт"; fi
fi
[ "$BEDY" -eq 0 ] && log "бед не найдено (это НЕ «на машине всё хорошо» — только по перечисленным выше признакам)"
exit 0
