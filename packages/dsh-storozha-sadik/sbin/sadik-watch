    if [ -n "$_en" ] && [ "$_en" -ge "$_st" ]; then printf "HOD|%s|0|0\n" "$_sl"; continue; fi
    _min=$(( ( $(date +%s) - _st ) / 60 ))
    _pisem=$($S journalctl -u $_sl --since "@$_st" --no-pager 2>/dev/null | grep -c "type=agent/inbox/spliced")
    # 🔴 ПРИЗНАК ЖИВОСТИ ХОДА (07.09.2026, постоянная санкция владельца 06.09 23:59:
    #   «сторож сработал — сразу улучшай, чтобы сообщение было честнее»).
    #   Было: сторож видел ТОЛЬКО длительность и честно писал «не знаю, полезен ли ход» —
    #   и владелец вынужден был спрашивать руками «работает или завис?».
    #   Признак РАЗЛИЧАЕТ, проверено на живых службах: без хода внешних соединений 0
    #   (только телеграм 149.154.* и localhost), при идущем ходе — соединение к провайдеру.
    _p=$(systemctl show -p MainPID --value "$_sl" 2>/dev/null)
    if [ -z "$_p" ] || [ "$_p" = "0" ]; then
      _pr="slepota|процесс службы не найден (MainPID пуст)"
    elif ! $S test -r "/proc/$_p/status"; then
      _pr="slepota|нет доступа к /proc/$_p"
    else
      # 🔴 ДВЕ ПРАВКИ ПОСЛЕ ЛОЖНО-КРАСНОГО 07.09 00:16 (поймала Забава):
      #  (1) считать по ВСЕЙ cgroup службы: работа может идти в потомке, у главного 0;
      #  (2) ОДНОМОМЕНТНЫЙ СРЕЗ НЕ ОТЛИЧАЕТ ПАУЗУ ОТ ЗАВИСАНИЯ. Соединение к провайдеру
      #      живёт только на время запроса; между вызовами внешних 0 при живом ходе.
      #      Поэтому при нуле — ВТОРАЯ проба через 20 с, и лишь два нуля подряд значат беду.
      _schet_vnesh() {
        local _c=0 _q
        for _q in $(cat "/sys/fs/cgroup/system.slice/$_sl/cgroup.procs" 2>/dev/null || echo "$_p"); do
          _c=$(( _c + $($S ss -tnp 2>/dev/null | grep "pid=$_q," | awk "{print \$5}" | grep -vcE "^127\.|^149\.154\.") ))
        done
        echo "$_c"
      }
      _vnesh=$(_schet_vnesh)
      # ноль — вторая проба после общей паузы (за циклом); строку HOD этого агента печатает она
      if [ "${_vnesh:-0}" -eq 0 ]; then _otlozh="$_otlozh $_sl|$_p|$_min|$_pisem"; continue; fi
      _pr_iz_vnesh
    fi
    # 🔴 ВЕЛИЧИНА СМЕНЕНА 07.09.2026 (нашла Забава замером): ДЛИТЕЛЬНОСТЬ ХОДА — ПРИЗНАК,
    #   А НЕ СОСТОЯНИЕ. Ход Петровича длился 65 мин и был ЗДОРОВ (123 события, 20 шагов,
    #   ответ доставлен). Длительность одинаково велика у полезного долгого запроса и у
    #   зависшего. Состояние говорит МОЛЧАНИЕ: пока строки идут, ход работает.
    #   ПОРОГ 900 с — снят по журналу за сутки, не назначен: тишина между строками
    #   dsh медиана 0 с, 99% 1 с, максимум 515 с; iskra медиана 0 с, 99% 99 с, максимум 518 с;
    #   разрывов >600 с за сутки НОЛЬ у обоих. 900 = запас 1,7х от наибольшего законного.
    _hod_pechat
  done
  if [ -n "$_otlozh" ]; then
    sleep 20
    for _z in $_otlozh; do
      IFS="|" read -r _sl _p _min _pisem <<< "$_z"
      _vnesh=$(_schet_vnesh); _pr_iz_vnesh; _hod_pechat
    done
  fi
  # 🔴 Однородность ОПОРЫ МОНТАЖА (заведено 05.09.2026 по решению Забавы).
  # Публикаций больше нет -> тарбол единственная опора восстановления боевого каталога.
  # Ссылка на номер из реестра означает: при восстановлении пакет пойдёт в сеть за тем,
  # что мы намеренно не публикуем. Заметить это можно было бы только ПРИ восстановлении.
  M=/opt/agent-plugins/package.json
  if [ -r "$M" ]; then
    printf "MANIFEST|%s/%s\n" "$(grep -c agent-plugins-tarbally "$M")" "$(grep -c dsh-pamyat "$M")"
  else
    printf "MANIFEST|?\n"
  fi
  # 🔴 Версия ядра В БОЮ — из СТРОКИ ПОДЪЁМА журнала, а не с диска (правка 05.09.2026).
  # Диск и бой расходятся: перезапуск в один момент, диск снимается в другой, между ними
  # диск успевает измениться. Утверждать про бой по диску — врать о предмете.
  # 🔴 cut, а НЕ awk: одинарные кавычки awk закрывают внешний блок ssh, и $2 уходит под
  # set -u локального шелла. Сломал этим сторож 05.09 в 22:33, откатил, переделал.
  # Пусто -> СЛЕПОТА, а не «версии нет»: строка подъёма могла уехать из окна журнала.
  # B-N-1443 (02.10.2026, Заря): журнал — от подъёма службы, а не весь (5,6 с → 0,08 с; строка версии пишется через 2 с после подъёма).
  # Нет метки подъёма (служба не активна) — весь журнал, как прежде.
  _iskra_ot=$(systemctl show iskra.service -p ActiveEnterTimestamp --value 2>/dev/null)
  printf "YADRO_BOJ|%s\n" "$($S journalctl -u iskra.service ${_iskra_ot:+--since "$_iskra_ot"} --no-pager -o cat 2>/dev/null \
    | grep -oE "dsh-pamyat-core [0-9]+\.[0-9]+\.[0-9]+[-a-z0-9.]*" | tail -1 | cut -d" " -f2)"
  # B-N-1462 (03.10.2026, Заря): пауза агента по /stop — договор ред. 2: /var/lib/dsh-pauza/<агент>/pauza.json; подкаталог — учётка службы
  # агента (поле реестра polzovatel), 755; файл 644; пока пауза стоит, канал обновляет updated не реже 5 мин; снятие — файл удалён.
  # Пауза — только если файлу можно верить: владелец каталога = учётка агента, файла = учётка агента или root, без записи g/o;
  # JSON разобран; updated не старше 15 мин и не из будущего (> +60 с). Иначе PAUZA_BEDA (тревога, это НЕ пауза). Каталог переменной — только для стенда.
  # ⚠️ ГРАНИЦА: «пишет только своя учётка» защищает от ошибки соседа, а НЕ от умысла — у агентов sudo ALL, подделать файл может любой.
  for _agent in $(printf "%s" "$_ramka" | jq -r ".doma | keys[]"); do
    _pd="${SADIK_WATCH_PAUZA_DIR:-/var/lib/dsh-pauza}/$_agent"; _pf="$_pd/pauza.json"
    $S test -e "$_pf" || continue
    _pu=$(agent-registry pole "$_agent" polzovatel --json 2>/dev/null | jq -r "strings")
    read -r _dv _dp <<< "$($S stat -c "%U %a" "$_pd" 2>/dev/null)"; read -r _fv _fp <<< "$($S stat -c "%U %a" "$_pf" 2>/dev/null)"
    _np=""
    [ -n "$_pu" ] && [ "${_dv:-}" = "$_pu" ] || _np="$_np каталог: владелец ${_dv:-?}, а не ${_pu:-? (нет в реестре)};"
    [ -n "$_pu" ] && { [ "${_fv:-}" = "$_pu" ] || [ "${_fv:-}" = root ]; } || _np="$_np файл: владелец ${_fv:-?}, а не ${_pu:-?};"
    case "${_dp:-}" in [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) [ $(( 8#$_dp & 8#022 )) -eq 0 ] || _np="$_np каталог: права $_dp (запись g/o);" ;; *) _np="$_np каталог: права не прочитаны;" ;; esac
    case "${_fp:-}" in [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) [ $(( 8#$_fp & 8#022 )) -eq 0 ] || _np="$_np файл: права $_fp (запись g/o);" ;; *) _np="$_np файл: права не прочитаны;" ;; esac
    if [ -n "$_np" ]; then printf "PAUZA_BEDA|%s|недоверен:%s\n" "$_agent" "$(printf "%s" "$_np" | tr "|" "/")"; continue; fi
    if ! _pj=$($S cat "$_pf" 2>&1); then
      printf "PAUZA_BEDA|%s|нечитаем: %s\n" "$_agent" "$(printf "%s" "$_pj" | head -1 | tr "|;" "//" | cut -c1-120)"; continue
    fi
    if ! _pz=$(printf "%s" "$_pj" | jq -r "if type != \"object\" then error(\"не объект\") elif (.paused|type) != \"boolean\" then error(\"поле paused не true/false\") elif .paused then [(.since // \"?\"), (.queue.letters // \"?\"), (.queue.tasks // \"?\"), (.updated // \"\")] | map(tostring | gsub(\"[|;\n]\"; \"/\")) | join(\";\") else \"\" end" 2>&1); then
      printf "PAUZA_BEDA|%s|нечитаем: %s\n" "$_agent" "$(printf "%s" "$_pz" | head -1 | tr "|;" "//" | cut -c1-120)"; continue
    fi
    [ -n "$_pz" ] || continue
    _pup="${_pz##*;}"; _pz="${_pz%;*}"
    # пустую строку date -d читает как полночь — пустоту проверяем ДО date
    _pus=""; [ -n "$_pup" ] && _pus=$(date -d "$_pup" +%s 2>/dev/null)
    if [ -z "$_pus" ]; then printf "PAUZA_BEDA|%s|нечитаем: поле updated «%s» не разобрано\n" "$_agent" "$_pup"; continue; fi
    if [ $(( _pus - $(date +%s) )) -gt 60 ]; then printf "PAUZA_BEDA|%s|недоверен: время из будущего (updated %s)\n" "$_agent" "$_pup"; continue; fi
    if [ $(( $(date +%s) - _pus )) -gt 900 ]; then printf "PAUZA_BEDA|%s|устарел с %s\n" "$_agent" "$_pup"; continue; fi
    _psv="$(agent-registry pole "$_agent" sluzhba --json 2>/dev/null | jq -r "strings") $(agent-registry pole "$_agent" zavisit_ot --json 2>/dev/null | jq -r ".[]?" | tr "\n" " ")"
    printf "PAUZA|%s|%s;%s\n" "$_agent" "$_pz" "$_psv"
  done
  # свежесть УСПЕШНОГО события: последняя строка журнала службы, не статус
  for u in $(agent-registry sluzhby); do
    t=$($S journalctl -u $u -n 1 --no-pager -o short-unix 2>/dev/null | awk "{print \$1}" | cut -d. -f1)
    # B-N-860 (25.09.2026): к свежести — состояние службы (обрыв кричит сразу, а не через порог тишины) и срок квоты Codex
    # из отказа «try again at <дата>» за 7 суток. Разделитель «;» ВНУТРИ третьего поля: число полей строки для чтения не меняется.
    st=$(systemctl is-active $u 2>/dev/null)
    # B-N-1443 (02.10.2026, Заря): квоту ищем по КУРСОРУ журнала службы — за прогон читается только новое; неделя по всем службам
    # стоила 190 из 245–285 с. Курсор и последняя найденная квота (время отказа, срок) живут в состоянии сторожа и приходят сюда
    # строкой _kursory. Курсора нет или journalctl его не принял — окно 7 суток, один раз. Квота старше 7 суток забывается, как прежде.
    _z=$(printf "%s\n" "$_kursory" | awk -F"|" -v u="$u" "\$1==u" | tail -1)
    IFS="|" read -r _x _kc _ke _kv <<< "$_z"
    _jk=1
    # B-N-1443 r4b: отказ — только из строк шлюза. Матч ПОЛЯ SYSLOG_IDENTIFIER=node: команда sudo агента, порождённого шлюзом, пишется в журнал
    # шлюза с идентификатором sudo и может нести полную строку срока (находка Искры: у @iskra 14 таких строк за 7 суток). Префикс шлюза — второй рубеж, ровно в одном месте: в строке, откуда берётся срок.
    [ -n "$_kc" ] && { _j=$($S journalctl -u $u SYSLOG_IDENTIFIER=node --after-cursor "$_kc" --show-cursor --no-pager -o short-unix 2>/dev/null | grep -E "^-- cursor: |try again at "; exit "${PIPESTATUS[0]}"); _jk=$?; }
    if [ "$_jk" -ne 0 ]; then
      _kp="kursora-net"; [ -n "$_kc" ] && _kp="kursor-sbroshen"
      _j=$($S journalctl -u $u SYSLOG_IDENTIFIER=node --since -7d --show-cursor --no-pager -o short-unix 2>/dev/null | grep -E "^-- cursor: |try again at "); _kc=""; _ke=""; _kv=""
      # строк node за 7 суток нет (petrovich.service: идентификатор dsh) — следить нечего, строки «курсора нет» не пишем: иначе она шла бы каждый прогон
      case "$_kp|$_j" in kursor-sbroshen*|*"-- cursor: "*) printf "KVOTA_PROHOD|%s|%s\n" "$u" "$_kp" ;; esac
    fi
    _n=$(printf "%s\n" "$_j" | sed -n "s/^-- cursor: //p" | tail -1); [ -n "$_n" ] && _kc="$_n"
    _n=$(printf "%s\n" "$_j" | grep -E "\[(dsh-)?subscription-gateway [^]]*\] .*сбой вызова: .*try again at [A-Z][a-z]+ [0-9]+(st|nd|rd|th)?, [0-9]{4} [0-9]{1,2}:[0-9]{2} [AP]M" | tail -1)
    [ -n "$_n" ] && { _ke=$(printf "%s" "$_n" | cut -d. -f1); _kv=$(printf "%s" "$_n" | grep -oE "try again at [A-Z][a-z]+ [0-9]+(st|nd|rd|th)?, [0-9]{4} [0-9]{1,2}:[0-9]{2} [AP]M" | tail -1 | cut -c14-); }
    case "$_ke" in ""|*[!0-9]*) _ke=""; _kv="" ;; *) [ "$_ke" -lt $(( $(date +%s) - 604800 )) ] && { _ke=""; _kv=""; } ;; esac
    # срок прошёл — квота гаснет. Разбор срока тот же, что снаружи у SVEZH (пояса нет — читаю как UTC); не разобрался — держит правило 7 суток.
    if [ -n "$_kv" ]; then
      _ks=$(TZ=UTC date -d "$(printf "%s" "$_kv" | sed -E "s/([0-9]+)(st|nd|rd|th)?,/\1/")" +%s 2>/dev/null)
      case "$_ks" in ""|*[!0-9]*) ;; *) [ "$_ks" -le "$(date +%s)" ] && { _ke=""; _kv=""; } ;; esac
    fi
    kv="$_kv"
    [ -n "$_kc" ] && printf "KURSOR|%s|%s|%s|%s\n" "$u" "$_kc" "$_ke" "$_kv"
    printf "SVEZH|%s|%s;%s;%s\n" "$u" "${t:-нет}" "${st:-?}" "$kv"
    # Отказ хода по длине промпта. Признак — СОБЫТИЕ, а не оценка: предупредить заранее
    # нечем (занятость известна ПОСЛЕ вызова, отказ происходит НА вызове — замер Искры
    # 05.09: отказ 07:06:27, ближайшая тревога о пороге за 9 часов до него).
    # 🔴 СЛЕПОТА ОТДЕЛЬНО ОТ «ОТКАЗОВ НЕТ» (05.09.2026, правило владельца 21:12).
    # Соседние ветки этого же сторожа (SVEZH, BAZA) слепоту называют вслух, а эта молчала:
    # недоступный журнал давал «нет», неотличимое от чистого окна. Сейчас журнал читается
    # и без sudo (замер: 2922 строки обоими способами) — беда не наступила, но признак
    # обязан различать сам, а не полагаться на нынешнюю раскладку прав.
    # 🔴 «-- No entries --» — ОДНА СТРОКА, А НЕ НОЛЬ. Первая редакция этой правки считала
    # её содержимым, и ветка слепоты была мертва: проба показала «рубеж поставлен» вместо
    # «журнал пуст». Та же грабля уже описана в podyom-uzla на sadik — отсеиваем явно.
    vsego=$($S journalctl -u $u --since "-'"$OKNO_OTKAZA"'" --no-pager 2>/dev/null | grep -cv "^-- No entries --$")
    d=$($S journalctl -u $u --since "-'"$OKNO_OTKAZA"'" --no-pager -o short-unix 2>/dev/null | grep -i "Prompt is too long" | tail -1 | awk "{print \$1}" | cut -d. -f1)
    if [ "${vsego:-0}" -eq 0 ]; then
      printf "OTKAZDLINA|%s|SLEPOTA\n" "$u"
    else
      printf "OTKAZDLINA|%s|%s\n" "$u" "${d:-нет}"
    fi
    # B-P-114 (25.09.2026, Заря): ОБРЫВ ПО ЛИМИТУ ПОДПИСКИ — событием из журнала шлюза, а не счётом в памяти шлюза: счёт «3 отказа подряд»
    # (gateway.mjs) обнуляется перезапуском — Марк упёрся в «usage limit» 4 раза за 24–25.09, тревога не ушла ни разу. Строка — только СВОЯ
    # строка шлюза («node[pid]: [subscription-gateway …] 🔴 сбой вызова: …»): чужие sudo-команды с тем же текстом в журнале шлюза не в счёт.
    # Длительность хода — от последнего «мост подключён»/«подсказка:» до отказа: лимит обрывает ход за секунды, а снаружи это похоже на работу.
    case "$u" in *gateway*)
      lim=$($S journalctl -u $u --since "-'"$OKNO_OTKAZA"'" --no-pager -o short-unix 2>/dev/null | awk -v IGNORECASE=1 "/node\\[[0-9]+\\]: \\[(dsh-)?subscription-gateway [^]]*\\] (мост подключён|подсказка:)/ {s=\$1} /node\\[[0-9]+\\]: \\[(dsh-)?subscription-gateway [^]]*\\] 🔴 сбой вызова: .*(hit your (session|usage|weekly)|usage limit|rate limit|try again at|resets [0-9])/ {f=\$1; st=s; t=\$0} END {if (f) {sub(/.*сбой вызова: /, \"\", t); gsub(/[|;]/, \"/\", t); printf \"%s;%s;%s\", f, st, substr(t, 1, 200)}}")
      printf "OTKAZLIMIT|%s|%s\n" "$u" "${lim:-нет}" ;;
    esac
  done
' 2>/dev/null)"; _kod_ssh=$?
if [ "$_kod_ssh" -ne 0 ]; then
  # 🔴 РАЗЛИЧАЕМ ЧУЖУЮ БЕДУ И СВОЮ (класс Искры 05.09: третий исход, заведённый ради
  # честности, укрыл поломку). 22:33:40 эта самая строка вышла НЕ из-за машины, а из-за
  # МОЕЙ ошибки в скрипте (line 150: $2: unbound variable) — и отправила бы проверять
  # канал и ключ, когда ломался наш собственный код. Ошибка была рядом в журнале,
  # но сама тревога о ней молчала.
  # Признак: ssh отвечает кодом 255 при беде связи; иной ненулевой код — беда НА той
  # стороне; а если мы сюда попали при коде 0, значит упали мы сами.
  # 🔴 06.09: тексты РАЗНЫЕ по режиму. В местном режиме «беда канала или ключа» была бы
  # ложью — канала нет вовсе; а код 255 не может появиться в принципе.
  _diagnostika=$(printf '%s\n' "$SREZ" | sed -n 's/^REGISTRY_ERROR|//p')
  trevoga "срез от $HOST не получен: режим local=$MESTNO, команда сбора вернула код $_kod_ssh. ${_diagnostika:-Подробная причина не установлена; stderr команды оставлен в журнале.}"

  exit 2
fi

[ -z "$SREZ" ] && { trevoga "срез от $HOST пуст: команда сбора вернула код 0, строк данных не получено. Причина не установлена."; exit 2; }

SEYCHAS=$(date +%s); BEDY=0
GR_OBRYV=""; GR_TISHINA=""; GR_TISHINA_MIN=""; GR_KVOTA=""; KVOTA_DO=""   # B-N-860: группы служб (set -u)
declare -A PAUZA_SL=()   # B-N-1462: служба → «<агент> на паузе по /stop с …»; строки PAUZA идут в срезе раньше SVEZH
GR_PAUZA=""; GR_PAUZA_TXT=""   # B-N-1462: агенты, чей файл паузы устарел / нечитаем / недоверен — тревога, это не пауза
KURSORY_NOV=""   # B-N-1443: новое состояние курсоров квоты, пишется после разбора
KV_SBROS=""; KV_NET=""   # B-N-1443: службы, у которых квота искалась полным проходом 7 суток, по причине
# B-N-1337: состав mesh по умолчанию «не мерено» — срез без строки MESH не должен давать ложный отбой; ветка MESH его перекрывает.
GR_MESH="не мерено"; GR_MESH_TXT="mesh awg9: строки MESH в срезе НЕТ — рукопожатие не мерено"
# D-N-1651: правило 72 по умолчанию «не мерено» — срез без строки RUTCP не должен давать ложный отбой (как MESH).
GR_RUTCP="не мерено"; GR_RUTCP_TXT="TCP на 46.19.64.6: строки RUTCP в срезе НЕТ — правило 72 не мерено"
# B-N-1660: RU split по умолчанию «не мерено» — срез без строки RUSPLIT не должен давать ложный отбой.
GR_RUSPLIT="не мерено"; GR_RUSPLIT_TXT="RU split: строки RUSPLIT в срезе НЕТ — не мерено"
# B-N-1675: белый список Варвары по умолчанию «не мерено» — срез без строки BELYJ не должен давать ложный отбой.
GR_BELYJ="не мерено"; GR_BELYJ_TXT="белый список Варвары: строки BELYJ в срезе НЕТ — не мерено"
# B-N-1679: немота песочницы по умолчанию «не мерено» — срез без строки NEMOTA не должен давать ложный отбой.
GR_NEMOTA="не мерено"; GR_NEMOTA_TXT="песочница Варвары: строки NEMOTA в срезе НЕТ — не мерено"

# Граница печатается КАЖДЫЙ прогон, а не однажды в шапке: журнал читают выборочно.
[ "$MESTNO" = "1" ] && log "   режим МЕСТНЫЙ (на sadik): проба «машина недоступна» НЕ ведётся — её может делать только внешний наблюдатель"

# ── 2. Службы: свежесть события, а не is-active ──────────────────────────────────
while IFS='|' read -r vid a b; do
  case "$vid" in
    UNCOVERED)
      log "⚠️ НЕПОКРЫТО: $a — $b; проверки дома/базы и хода этого агента не выполнены"
      BEDY=$((BEDY+1)) ;;
    iskra.service|petrovich.service)
      if [ "$a" != "active" ]; then
        # 🔴 07.09.2026: disabled/masked — это ЧЬЁ-ТО РЕШЕНИЕ, а не отказ службы.
        #    Без различения сторож кричит «не active» сутками (случай 07.09: запертая
        #    до 11.09 служба дала бы 4 суток крика), и тревогу перестают читать.
        #    Тревогу НЕ гасим — предмет другой, текст другой.
        _en="$(systemctl is-enabled "$vid" 2>/dev/null)"
        case "$_en" in
          disabled|masked)
            trevoga "$vid не active и ЗАПЕРТА НАМЕРЕННО ($_en) — это не отказ, а решение; проверить, кто и зачем" ;;
          *)
            trevoga "$vid не active (сейчас: ${a:-пусто})" ;;
        esac
        BEDY=$((BEDY+1))
      fi ;;
    SVEZH)
      IFS=';' read -r _t _st _kv <<<"$b"
      if [ -n "$_st" ] && [ "$_st" != "active" ] && [ "$_st" != "?" ] && [ "$a" != "iskra.service" ] && [ "$a" != "petrovich.service" ]; then
        # iskra/dsh — своя ветка «не active» выше; здесь остальные службы и шлюзы
        GR_OBRYV="$GR_OBRYV${GR_OBRYV:+, }$a ($_st)"; BEDY=$((BEDY+1))
      elif [ "$_t" = "нет" ]; then
        trevoga "$a: журнал пуст — событий не видно вовсе"; BEDY=$((BEDY+1))
      else
        MIN=$(( (SEYCHAS - _t) / 60 ))
        if [ "$MIN" -gt "$PORog_TISHINY_MIN" ] && [ "$_st" = "active" ] && [ -n "${PAUZA_SL[$a]:-}" ]; then
          log "   $a молчит $MIN мин — ${PAUZA_SL[$a]}; тревога не идёт"
        elif [ "$MIN" -gt "$PORog_TISHINY_MIN" ]; then
          _srok=0; [ -n "$_kv" ] && _srok=$(TZ=UTC date -d "$(printf '%s' "$_kv" | sed -E 's/([0-9]+)(st|nd|rd|th)?,/\1/')" +%s 2>/dev/null || echo 0)
          if [ "$_srok" -gt "$SEYCHAS" ]; then
            GR_KVOTA="$GR_KVOTA${GR_KVOTA:+, }$a"; KVOTA_DO="$_kv"
          else
            GR_TISHINA="$GR_TISHINA${GR_TISHINA:+, }$a"; GR_TISHINA_MIN="$GR_TISHINA_MIN${GR_TISHINA_MIN:+, }$a $MIN мин"
            BEDY=$((BEDY+1))
          fi
        fi
      fi ;;
    OTKAZDLINA)
      # Тревога только на НОВОЕ событие: храним время последнего виденного отказа.
      # 🔴 Первый прогон НЕ кричит об историческом отказе — он только запоминает рубеж
      # и говорит об этом. Иначе заведение сторожа само выглядит как авария.
      PRED_OD="$SOST/otkaz-dliny-$(printf '%s' "$a" | tr -c 'a-zA-Z0-9' '-').txt"
      # 🔴 РУБЕЖ СТАВИТСЯ ВРЕМЕНЕМ УСТАНОВКИ, А НЕ ВРЕМЕНЕМ ПЕРВОГО НАЙДЕННОГО ОТКАЗА.
      # Первая редакция писала рубеж при первом ОБНАРУЖЕНИИ события — и тем самым
      # проглатывала первый НАСТОЯЩИЙ отказ: файла ещё нет, значит «запомнил и промолчал».
      # Защита от крика о прошлом съедала ровно то событие, ради которого заведена.
      # Поймано приёмкой этой же правки, до боевого прогона.
      if [ ! -f "$PRED_OD" ]; then
        printf '%s' "$SEYCHAS" > "$PRED_OD"
        log "$a: рубеж отказов по длине поставлен по времени установки ($(date -d "@$SEYCHAS" '+%F %T')); всё, что случится позже, будет названо"
      fi
      if [ "$b" = "SLEPOTA" ]; then
        log "⚠️ $a: журнал за $OKNO_OTKAZA ПУСТ — отказы по длине проверить нечем. Это «не смотрели», а не «их нет»"
      elif [ "$b" = "нет" ]; then
        :   # за окно отказов нет — молчим, строки «нет отказов» не пишем
      else
        STAR_OD=$(cat "$PRED_OD" 2>/dev/null || echo 0)
        if [ "$b" -gt "$STAR_OD" ]; then
          # B-N-977: отметка «сказано» — ТОЛЬКО после успеха канала (как OTKAZLIMIT, класс B-H-105). Прежде trevoga глушила
          # отказ канала (|| true), отметка ставилась всё равно — несказанная тревога больше не повторялась.
          _td="$a: ход оборван ПО ДЛИНЕ ПРОМПТА в $(date -d "@$b" '+%F %T') — предупредить заранее нечем: занятость известна ПОСЛЕ вызова, а отказ происходит НА вызове"
          log "🔴 $_td"; BEDY=$((BEDY+1))
          if kanal "$_td"; then printf '%s' "$b" > "$PRED_OD"
          else log "🔴 тревога об обрыве по длине НЕ ушла ни одним каналом — отметку не ставлю, повторю в следующий такт"; fi
        fi
      fi ;;
    OTKAZLIMIT)
      # B-P-114: тревога на НОВОЕ событие (время отказа новее отметки); рубеж первого прогона — время установки (как OTKAZDLINA).
      # Отметка «сказано» — ТОЛЬКО после успеха канала (класс B-H-105): отказ канала — повтор в следующий такт, а не молчание.
      # ⚠️ НЕ ЛОВИТ: лимит, чей текст не подходит под маску (hit your … / usage limit / rate limit / try again at / resets N); отказ старше окна OKNO_OTKAZA.
      PRED_OL="$SOST/otkaz-limita-$(printf '%s' "$a" | tr -c 'a-zA-Z0-9' '-').txt"
      if [ ! -f "$PRED_OL" ]; then
        printf '%s' "$SEYCHAS" > "$PRED_OL"
        log "$a: рубеж обрывов по лимиту поставлен по времени установки ($(date -d "@$SEYCHAS" '+%F %T')); всё, что случится позже, будет сказано"
      fi
      if [ "$b" != "нет" ]; then
        IFS=';' read -r _lf _ls _lt <<<"$b"; _lf=${_lf%.*}; _ls=${_ls%.*}
        STAR_OL=$(cat "$PRED_OL" 2>/dev/null || echo 0)
        if [ "${_lf:-0}" -gt "$STAR_OL" ]; then
          _dl=""; [ -n "$_ls" ] && [ "$_ls" -le "$_lf" ] && _dl=" (ход длился $((_lf - _ls)) с: запрос → отказ)"
          _tl="$a: ход оборван ЛИМИТОМ ПОДПИСКИ в $(date -d "@$_lf" '+%F %T')$_dl — «$_lt». Это не работа и не тишина: до срока лимита каждый ход агента кончится так же"
          log "🔴 $_tl"; BEDY=$((BEDY+1))
          if kanal "$_tl"; then printf '%s' "$_lf" > "$PRED_OL"
          else log "🔴 тревога об обрыве по лимиту НЕ ушла ни одним каналом — отметку не ставлю, повторю в следующий такт"; fi
        fi
      fi ;;
    BAZA)
      # 🔴 Имя состояния — от ПОЛНОГО пути, а не от имени каталога.
      # Первый живой прогон дал ЛОЖНУЮ тревогу «база уменьшилась: было 31, стало 1»:
      # /opt/iskra/pamyat/ и /opt/petrovich/pamyat/ давали ОДНО имя baza-pamyat, и счёт одной
      # базы сравнивался с числом другой. Наш класс «одно имя — два разных предмета».
      PRED="$SOST/baza$(printf '%s' "$a" | tr -c 'a-zA-Z0-9' '-').txt"
      if [ "$b" = "?" ]; then
        log "   база $a: прочитать не смог (нет прав или файла) — это не «ноль записей»"
      else
        _zapisat=1
        if [ -f "$PRED" ]; then
          STAR=$(cat "$PRED")
          # B-N-977: прежний счёт перезаписывается после «уменьшилась» ТОЛЬКО при успехе канала — иначе следующий такт
          # сравнит с уже меньшим числом, и несказанная тревога больше не прозвучит (класс B-H-105).
          if [ "$b" -lt "$STAR" ]; then
            _tb="база $a УМЕНЬШИЛАСЬ: было $STAR, стало $b"
            log "🔴 $_tb"; BEDY=$((BEDY+1))
            kanal "$_tb" || { _zapisat=0; log "🔴 тревога об уменьшении базы НЕ ушла ни одним каналом — прежний счёт $STAR оставлен, повторю в следующий такт"; }
          fi
        fi
        [ "$_zapisat" = 1 ] && echo "$b" > "$PRED"
        log "   база $a: записей $b"
      fi ;;
    MESH)
      # 🔴 22.09.2026 (Михалыч; перенесено B-N-1337). ПОВОД: 22.09 туннель sadik→vps-ru встал ОДНОСТОРОННЕ, обрыв заметил
      # человек. Порог из предмета: PersistentKeepalive=25 ⇒ живое рукопожатие раз в ~2 мин; 600 с = пять пропущенных циклов.
      # ⚠️ ЧЕГО НЕ ЛОВИТ: рукопожатие живо, а SSH закрыт фильтром — другая беда; молчание здесь о ней ничего не говорит.
      # Тревога — через gruppa mesh-awg9 ниже (условие Вениамина 06:05Z по B-N-860): журнал каждый такт, канал — смена состава и раз в час.
      GR_MESH=""; GR_MESH_TXT=""
      if [ "$b" = "-1" ]; then
        GR_MESH="нет вовсе"; GR_MESH_TXT="mesh $a: рукопожатия с vps-ru (46.19.64.6) НЕТ ВОВСЕ — туннель не поднят или пира с этим адресом нет"; BEDY=$((BEDY+1))
      elif [ "$b" -gt 600 ]; then
        GR_MESH="встал"; GR_MESH_TXT="mesh $a: рукопожатие $((b/60)) мин назад (порог 10 мин) — канал sadik→vps-ru встал"; BEDY=$((BEDY+1))
      else
        log "   mesh $a: рукопожатие ${b} с назад — канал жив"
      fi ;;
    BELYJ)
      # 🔴 05.10.2026 B-N-1675 (Михалыч; ворота Вениамин). ТОЛЬКО ТРЕВОГА. ⚠️ ЧЕГО НЕ ЛОВИТ: строку, которая разобралась,
      # но НЕ ТА (опечатка в цифрах номера — пропустит чужой номер, а свой замаскирует); смысл списка; иные гостевые
      # Иностранные номера (тел: +<код≠7>, ≥8 цифр) — принятое состояние: в журнал строкой, НЕ тревога. Граница: «+7…» любой
      # длины — российский; иностранный номер с опечаткой не отличим от верного (оба «принятое»).
      # настройки. Маска при сломанном списке не слабеет (прячет больше) — поэтому остывание 6 ч, не час.
      GR_BELYJ=""; GR_BELYJ_TXT=""
      case "$a" in
        ok:*) log "   белый список Варвары: ${a#ok:}" ;;
        bad:*) GR_BELYJ="${a#bad:}"; GR_BELYJ_TXT="белый список Варвары: ${a#bad:} — маска ПДн шлюза varvara прячет эти значения от модели (гостю и рабочему режиму). Проверка: блок BELYJ sadik-watch (тем же разборщиком от учётки varvara)"; BEDY=$((BEDY+1)) ;;
        *) GR_BELYJ="не мерено"; GR_BELYJ_TXT="белый список Варвары: проверка не состоялась (${a#nemer:}) — состояние неизвестно" ;;
      esac ;;
    NEMOTA)
      # 🔴 06.10.2026 B-N-1679 сторож немоты песочницы Варвары. ТОЛЬКО ТРЕВОГА. ⚠️ ЧЕГО НЕ ЛОВИТ: (а) проба — свой профиль bwrap,
      # не точный профиль платформы (иные аргументы платформы не видны); сеть и абстрактные сокеты песочницы — не предмет;
      # (б) только отказы, которые мост печатает «🔴 bash для …: … bwrap: »; при 0 вызовов bash за час (б) молчит по построению.
      GR_NEMOTA=""; GR_NEMOTA_TXT=""; _nmo=${b%/*}; _nmu=${b#*/}
      if [ "$a" != "ok" ] && [ "${a#nemer:}" = "$a" ]; then
        GR_NEMOTA="(а) ${a%; }"; GR_NEMOTA_TXT="песочница Варвары НЕ в порядке: ${a%; }. Следствие: bash Варвары молча не работает или журнал снова открыт из песочницы. Принятая обёртка — файл метки выпуска из записи реестра, ставящей /usr/local/bin/bwrap-bez-zhurnala (B-N-1679; A-N-1948 №5)"; BEDY=$((BEDY+1))
      elif [ "${_nmo:-0}" -ge 3 ] 2>/dev/null && [ "${_nmu:-0}" -eq 0 ] 2>/dev/null; then
        GR_NEMOTA="(б) отказов ${_nmo}, успехов 0"; GR_NEMOTA_TXT="bash Варвары весь отказывает: за 1 ч отказов «bwrap:» ${_nmo}, успехов 0 (журнал varvara.service)"; BEDY=$((BEDY+1))
      elif [ "${a#nemer:}" != "$a" ]; then
        _nmn="${a%; }"; GR_NEMOTA="не мерено"; GR_NEMOTA_TXT="песочница Варвары: проверка ledger не состоялась (${_nmn#nemer:}) — состояние неизвестно, это НЕ здоровье"
      else
        log "   песочница Варвары: обёртка, профиль, проба — в порядке; за 1 ч bash: отказов bwrap ${_nmo}, успехов ${_nmu}"
      fi ;;
    RUSPLIT)
      # 🔴 05.10.2026 B-N-1660. ТОЛЬКО ТРЕВОГА. ⚠️ ЧЕГО НЕ ЛОВИТ: метка есть, а awg-ru мёртв (рукопожатие — не здесь);
      # строку «ct direction reply return» не требую; полноту набора сверх порога; IPv6; форвард.
      GR_RUSPLIT=""; GR_RUSPLIT_TXT=""
      if [ "$a" = "ok" ]; then
        log "   RU split: пометка, набор, правило 60, таблица 225, список — в порядке"
      else
        GR_RUSPLIT="$a"; GR_RUSPLIT_TXT="RU split НЕ работает: ${a%; } — российские сети идут не через awg-ru. Лечение: systemctl restart ru-split.service (пуст/стар список — сначала systemctl start ru-cidr-update.service)"; BEDY=$((BEDY+1))
      fi ;;
    RUTCP)
      # 🔴 05.10.2026 D-N-1651. ПОВОД: PostUp awg-ru.conf ставит правило 72 с «|| true» — отказ молчит (Вениамин 09:47Z).
      # Без правила TCP на 46.19.64.6 упирается в REJECT killswitch: сайты на vps-ru (ostrov.center) и SSH на его
      # внешний адрес с sadik недоступны — Варвара теряет сайт как источник знаний. Признак двойной: правило ровно одно
      # И маршрут TCP → awg-ru (второе ловит пустую таблицу 225, когда awg-ru упал). ТОЛЬКО ТРЕВОГА, не чиню.
      # ⚠️ ЧЕГО НЕ ЛОВИТ: маршрут верен, а vps-ru не отвечает; IPv6; другие адреса RU; чужое правило рядом в pref 72.
      GR_RUTCP=""; GR_RUTCP_TXT=""
      if [ "$a" = "1" ] && [ "$b" = "awg-ru" ]; then
        log "   правило 72: TCP на 46.19.64.6 через awg-ru — в порядке"
      else
        GR_RUTCP="правил $a, выход $b"; GR_RUTCP_TXT="TCP на внешний адрес vps-ru (46.19.64.6) НЕ через awg-ru: правил $a (норма 1), выход $b (норма awg-ru) — сайты на vps-ru и SSH на его внешний адрес упираются в killswitch. Лечение: systemctl restart awg-quick@awg-ru или ip -4 rule add to 46.19.64.6/32 ipproto tcp iif lo lookup 225 priority 72"; BEDY=$((BEDY+1))
      fi ;;
    MESTO)
      [ "$a" -ge "$PORog_MESTA_PROC" ] && { trevoga "место на / занято ${a}% (порог ${PORog_MESTA_PROC}%)"; BEDY=$((BEDY+1)); } ;;
    PAUZA)
      # B-N-1462: a = агент, b = «с;писем;заданий;службы»
      IFS=";" read -r _ps _pl _pt _psv <<<"$b"
      log "   ⏸ $a на паузе по /stop с $_ps, в очереди писем $_pl, заданий $_pt — тишина его служб ($_psv) тревоги не даёт"
      for _x in $_psv; do PAUZA_SL[$_x]="$a на паузе по /stop с $_ps, в очереди писем $_pl, заданий $_pt"; done ;;
    PAUZA_BEDA)
      GR_PAUZA="$GR_PAUZA${GR_PAUZA:+, }$a"; GR_PAUZA_TXT="$GR_PAUZA_TXT${GR_PAUZA_TXT:+; }$a — $b"; BEDY=$((BEDY+1)) ;;
    KVOTA_PROHOD)
      case "$b" in kursor-sbroshen) KV_SBROS="$KV_SBROS${KV_SBROS:+, }$a" ;; *) KV_NET="$KV_NET${KV_NET:+, }$a" ;; esac ;;
    KURSOR)
      # B-N-1443: a = служба, b = «курсор|время отказа|срок» — в новое состояние курсоров
      KURSORY_NOV="$KURSORY_NOV$a|$b"$'\n' ;;
    HOD)
      # строка среза читается как «IFS=| read -r vid a b»: a = служба, b = «минуты|письма»
      _sl="$a"; _min="${b%%|*}"; _ost="${b#*|}"; _pisem="${_ost%%|*}"
      # признак живости хода: <вид>|<пояснение>; вида нет — старый формат строки
      _prv="${_ost#*|}"; _vid="${_prv%%|*}"; _poyas="${_prv#*|}"
      _tiho="${_poyas##*|}"; _poyas="${_poyas%|*}"
      case "$_tiho" in *[!0-9]*) _tiho="?" ;; esac
      [ -z "$_tiho" ] && _tiho="?"
      case "$_prv" in "$_pisem") _vid=""; _poyas="" ;; esac
      case "$_vid" in
        rabota)    _hvost_zhiv="✅ признак жизни: $_poyas" ;;
        zavisanie) _hvost_zhiv="🔴 признак жизни: $_poyas" ;;
        slepota)   _hvost_zhiv="⚠️ признак снять не удалось: $_poyas" ;;
        *)         _hvost_zhiv="⚠️ признак живости не пришёл" ;;
      esac
      if [ "$_min" = "?" ]; then
        trevoga "ход $_sl: журнал НЕ ЧИТАЕТСЯ — это про ДОСТУП, а не про ход"
        BEDY=$((BEDY+1))
      elif [ "$_tiho" = "?" ] && [ "$_min" -ge 25 ]; then
        # 🔴 СЛЕПОТА НЕ МОЛЧИТ (07.09.2026, нашёл сам четвёртой порчей): если величина
        #   молчания не снялась, прежняя правка просто НЕ КРИЧАЛА — то есть слепота
        #   выглядела как «всё в порядке». Порог 25 мин здесь только чтобы не кричать
        #   о каждом коротком ходе: короткий ход без величины безвреден.
        trevoga "⚠️ СТОРОЖ СЛЕП ПО МОЛЧАНИЮ у $_sl: величину тишины снять не удалось (ход идёт $_min мин, писем $_pisem). Это про ДОСТУП к журналу, а не про состояние хода. $_hvost_zhiv"
        BEDY=$((BEDY+1))
      elif [ "$_tiho" != "?" ] && [ "$_tiho" -ge 900 ]; then
        # 🔴 ТРЕВОГА ПО МОЛЧАНИЮ, а не по длительности (07.09.2026).
        trevoga "🔴 ХОД МОЛЧИТ у $_sl: ни строки $_tiho с (порог 900), сам ход идёт $_min мин, писем $_pisem. $_hvost_zhiv"
        BEDY=$((BEDY+1))
      elif [ "$_min" -ge 180 ]; then
        # 🔴 ДЛИТЕЛЬНОСТЬ БОЛЬШЕ НЕ ПОВОД ДЛЯ ТРЕВОГИ САМА ПО СЕБЕ (07.09.2026).
        #   Было 25 мин — и кричало на ЗДОРОВОМ ходе в 65 мин (замер Забавы: 123 события,
        #   ответ доставлен). Осталась только страховка от бесконечного хода, который
        #   ПИШЕТ строки (молчания нет, поэтому ветка выше не сработает). 180 мин — втрое
        #   больше самого длинного наблюдённого законного хода (65 мин).
        trevoga "⚠️ ОЧЕНЬ ДОЛГИЙ ХОД у $_sl: идёт $_min мин, но НЕ молчит (тишина $_tiho с) — это не зависание, проверьте смысл вручную. Писем $_pisem. $_hvost_zhiv"
        BEDY=$((BEDY+1))
      fi ;;
    MANIFEST)
      if [ "$a" = "?" ]; then
        trevoga "манифест общего каталога НЕ ПРОЧИТАН — это про ДОСТУП, а не про однородность опоры"
        BEDY=$((BEDY+1))
      else
        _post=${a%%/*}; _vsego=${a##*/}
        if [ "$_post" != "$_vsego" ]; then
          trevoga "опора монтажа НЕОДНОРОДНА: из $_vsego пакетов памяти только $_post ссылаются на постоянный каталог тарболов. Остальные при восстановлении пойдут в реестр, которого для нас больше нет — и это вскроется в худший момент"
          BEDY=$((BEDY+1))
        fi
      fi ;;
    YADRO_DISK)
      # 🔴 ЗАЧЕМ: у Искры боевой путь идёт ссылками прямо в рабочий каталог, между правкой файла
      # и боем нет ни одного шага. При Restart=on-failure ПАДЕНИЕ процесса поднимает то, что
      # лежит на диске — то есть решение о подъёме перестаёт быть чьим-либо (находка Вениамин
      # и Искры 04.09). Сторож обязан заметить такой подъём и назвать его вслух.
      OZHID="$SOST/ozhidaemyj-start-iskra.txt"
      TREV="$SOST/trevoga-start-iskra.txt"   # формат: тактов|первый_такт_unix|последний_алерт_unix
      NOV_START="$(printf '%s\n' "$SREZ" | awk -F'|' '$1=="iskra.service"{print $3}')"
      if [ -z "$NOV_START" ]; then
        # Г2: пустота — ответ ПРО КАНАЛ, а не про предмет. Молчание тут соврало бы «перезапуска не было».
        log "   старт iskra.service: снять не смог — исход НЕИЗВЕСТЕН (это НЕ «перезапуска не было»)"
      elif [ ! -f "$OZHID" ]; then
        # Г1: первый такт после правки состояния — ОПОРНЫЙ. Не тревога и НЕ молчание.
        # Молча принять текущее за эталон нельзя: сторож, заведённый после ЧУЖОГО подъёма,
        # узаконил бы его. Поэтому строка с прямым предупреждением.
        printf '%s' "$NOV_START" > "$OZHID"
        log "   ОПОРНЫЙ ТАКТ: принят старт «$NOV_START» как ожидаемый, сравнивать было не с чем. Если этот подъём НЕ наш — разбирать руками."
      elif [ "$NOV_START" = "$(cat "$OZHID")" ]; then
        rm -f "$TREV"
      # 🔴 п.125: квитанция читалась ТОЛЬКО из файла Искры, а подъёмы её узла делаю Я.
      # Тревога висела у того, кто не может её закрыть (26 тактов к моменту находки).
      # Второй источник — МОЯ квитанция: кто поднял, тот и подтверждает.
      elif [ -f "$SOST/moya-kvitanciya.txt" ] \
           && MOYA="$(cat "$SOST/moya-kvitanciya.txt" 2>/dev/null)" \
           && MOYA_S="$(date -d "$MOYA" +%s 2>/dev/null)" && [ -n "$MOYA_S" ] \
           && NOV_S2="$(date -d "$NOV_START" +%s 2>/dev/null)" && [ -n "$NOV_S2" ] \
           && [ "$MOYA_S" = "$NOV_S2" ]; then
        log "   подъём подтверждён МОЕЙ квитанцией ($MOYA) — поднимал я, тревога снята"
        printf '%s' "$NOV_START" > "$OZHID"
        rm -f "$TREV"
      elif KVIT="$(snyat "sed -n 's/^PODYOM_PODTVERZHDEN=//p' /opt/iskra/workspace/SOSTOYANIE-ISKRY.txt")" \
           && KVIT="$(printf '%s' "$KVIT" | sed 's/[[:space:]]*#.*$//; s/[[:space:]]*$//')" \
           && [ -n "$KVIT" ] \
           && KVIT_S="$(date -d "$KVIT" +%s 2>/dev/null)" && [ -n "$KVIT_S" ] \
           && NOV_S="$(date -d "$NOV_START" +%s 2>/dev/null)" && [ -n "$NOV_S" ] \
           && [ "$KVIT_S" = "$NOV_S" ]; then
        # 🔴 КВИТАНЦИЯ ИСКРЫ (05.09.2026, её половина + моя). До этого подтверждение клалось
        # ТОЛЬКО рукой (--podtverdit), и половина схемы держалась на памяти поднимающего.
        # Теперь тот, кто пережил подъём, сам пишет строку в свой файл состояния, а сторож
        # её читает. Предмет не новый: файл уже существовал и уже читался.
        # 🔴 ЧЕГО КВИТАНЦИЯ НЕ ДОКАЗЫВАЕТ — АВТОРСТВА (найдено Забавой 05.09 на моём же случае).
        # Строка «PODTVERDILA=iskra» ставится в обычный файл на sadik, а sudo там есть у всех
        # троих. Я сам 05.09 испортил её пробой и ВОССТАНОВИЛ своей рукой — содержимое верное,
        # а подпись после этого недостоверна. Значит механизм проверяет НАЛИЧИЕ СТРОКИ, а не
        # ФАКТ РАЗБОРА, и защиты от подделки у него нет по устройству прав.
        # Оставляем как есть НАМЕРЕННО: неподделываемого признака у нас нет (sudo общий), а
        # выдуманная защита была бы хуже — она создала бы видимость доказанного авторства.
        # Держится на добросовестности, и это сказано вслух, а не подразумевается.
        # ⚠️ ГРАНИЦЫ, названные ЕЮ и соблюдаемые здесь буквально:
        #   квитанция значит «подъём РАЗОБРАН ИСКРОЙ» — и только;
        #   она НЕ значит «подъём был законным» (это решает координатор);
        #   она НЕ значит «состав верный» (это решает приёмка).
        # Поэтому в журнал пишем именно то, что подтверждено, а не «всё хорошо».
        printf '%s' "$NOV_START" > "$OZHID"
        rm -f "$TREV"
        log "   подъём «$NOV_START» ПОДТВЕРЖДЁН квитанцией Искры (разобран ЕЮ; законность — за координатором, состав — за приёмкой)"
      else
        # ⚠️ Сюда попадаем и когда квитанции НЕТ, и когда её НЕ УДАЛОСЬ ПРОЧЕСТЬ — это разные
        # вещи, и различаем их вслух: молчание строки = «Искра ещё не смотрела», отказ канала
        # = «спросить не смогли». Ни то, ни другое не гасит тревогу — гасит только совпадение.
        if [ -z "${KVIT+x}" ]; then
          log "   квитанция: канал до $HOST не ответил — это НЕ «не подтверждено»"
        elif [ -z "$KVIT" ]; then
          log "   квитанция: строки нет — Искра ещё не разбирала этот подъём"
        else
          log "   квитанция: есть, но про ДРУГОЙ старт («$KVIT») — этот подъём ею не разобран"
          # 🔴 формы времени РАЗНЫЕ: она пишет ISO (2026-09-05T11:01:42Z), systemd отдаёт
          # «Sat 2026-09-05 11:01:42 UTC». Сравнение строк не сошлось бы НИКОГДА — сверяем
          # обе через date +%s. И срезаем комментарий после значения: она пишет пояснение
          # в той же строке, и без среза оно уезжало в значение.
        fi
        # Тревога ПОВТОРЯЕТСЯ каждый такт, пока подъём не подтверждён рукой.
        # 🔴 06.09.2026, ЧЕТВЁРТОЕ ПОЛЕ — СЧЁТ УСПЕШНЫХ ОТПРАВОК (решение Вениамина, принято Забавой).
        # Прежде «первые 3 подряд» считались по ТАКТАМ: канал лежал три первых такта — все три
        # бесплатных окна съедены отказами, дальше раз в час. Та же природа, что у отметки времени.
        # Счёт ведётся ОТДЕЛЬНЫМ полем, `_n` НЕ переопределяется: на первое число опирается формат
        # файла и текст тревоги, менять его смысл значит соврать всем, кто его читает.
        # Старый файл из трёх полей читается как есть: пустое четвёртое = ноль успехов.
        _n=1; _perv="$SEYCHAS"; _posl=0; _usp=0
        if [ -f "$TREV" ]; then
          IFS='|' read -r _n _perv _posl _usp < "$TREV"
          _n=$((_n+1))
          [ -n "$_usp" ] || _usp=0
        fi
        # Г4: текст «ПЕРЕЗАПУСКАЛАСЬ» НЕ МЕНЯЕТСЯ — на нём может стоять чужой измеритель.
        # Счётчик приписывается ОТДЕЛЬНОЙ частью строки, после разделителя.
        _boj="$(printf "%s\n" "$SREZ" | awk -F"|" "\$1==\"YADRO_BOJ\"{print \$2}")"
        _txt="iskra.service ПЕРЕЗАПУСКАЛАСЬ (было «$(cat "$OZHID")», стало «$NOV_START»). Если это не наш подъём — сработал автоперезапуск. В бою (строка подъёма): ${_boj:-СЛЕПОТА: строки подъёма в окне журнала нет} · на диске сейчас: ${a:-?} — при следующем перезапуске уедет он"
        _txt="$_txt · закрывается: строкой PODYOM_PODTVERZHDEN=<время> в файле Искры ЛИБО моей квитанцией (<SOST>/moya-kvitanciya.txt), если поднимал я · не подтверждено $_n тактов, с $(date -d "@$_perv" '+%F %T' 2>/dev/null || echo '?')"
        # 🔴 07.09.2026: ПОРОГ СЕРИИ. Такт 10 мин, подавление уже «раз в час».
        #    36 тактов = 6 часов, за которые НИ ОДИН из двух закрывающих путей
        #    не сработал ни разу ⇒ это не «ещё не разобрали», а неработающий
        #    механизм закрытия. Число назначено ПО УСТРОЙСТВУ (период подавления
        #    x6), а не по ряду: ряда законных серий нет — за всю глубину журнала
        #    закрытие ровно одно. Граница названа, число пересмотреть по ряду,
        #    когда он появится.
        [ "$_n" -ge 36 ] && _txt="$_txt · 🔴 НЕ ЗАКРЫТО $_n ТАКТОВ ПОДРЯД (>6 ч) — закрывающий механизм НЕ РАБОТАЕТ"
        log "🔴 $_txt"
        # Г3: в ЖУРНАЛ каждый такт (журнал не устаёт), в ТЕЛЕГРАМ первые 3 подряд, дальше
        # не чаще раза в час. Без этого 72 сообщения в сутки — тревогу замьютят, и мы
        # получим обратную беду: сигнал есть, а его перестали читать.
        if [ "$_usp" -lt 3 ] || [ $(( SEYCHAS - _posl )) -ge 3600 ]; then
          # 🔴 06.09.2026: ОТМЕТКА ТОЛЬКО ПРИ УСПЕХЕ. Прежде `_posl` ставился по факту ПОПЫТКИ:
          # канал отказал — сторож записывал «я сообщил» и молчал час, и следующий отказ снова
          # продлевал молчание. Отказ САМ СЕБЯ прятал; механизм становился тем тише, чем хуже
          # предмет. Цена нового поведения названа и принята (Забава, 06.09): при долгом отказе
          # попытки идут каждый такт — шум в журнале, но не в телеграме, туда и так ничего не шло.
          _kod=0
          kanal "$_txt" || _kod=$?
          if [ "$_kod" -eq 0 ]; then
            _posl="$SEYCHAS"; _usp=$(( _usp + 1 ))
          else
            log "⚠️ канал тревог НЕ принял сообщение (код $_kod) — отметка об отправке НЕ обновлена, следующий такт попробует снова"
          fi
        fi
        printf '%s|%s|%s|%s' "$_n" "$_perv" "$_posl" "$_usp" > "$TREV"
        BEDY=$((BEDY+1))
      fi
      log "   ядро на диске (главный вход): ${a:-?}" ;;
  esac
done <<< "$SREZ"
# B-N-1443: курсоры квоты — новым файлом рядом и mv; срез без строк KURSOR прежний файл не стирает.
[ -n "$KURSORY_NOV" ] && printf '%s' "$KURSORY_NOV" > "$KURSORY_F.nov" && mv -f "$KURSORY_F.nov" "$KURSORY_F"
[ -n "$KV_SBROS" ] && log "   квота Codex: курсор сброшен (journalctl его не принял) — полный проход 7 суток: $KV_SBROS"
[ -n "$KV_NET" ] && log "   квота Codex: курсора нет (первый прогон, новая служба или строка отброшена) — полный проход 7 суток: $KV_NET"

# ── 2б. Группы служб (B-N-860): обрыв — сразу и раз в час; тишина — на смену состава и раз в 6 ч; квота — только на смену.
gruppa obryv   "$GR_OBRYV"   "ОБРЫВ: служба не active — $GR_OBRYV" 3600
gruppa pauza   "$GR_PAUZA"   "файл паузы: $GR_PAUZA_TXT — это НЕ пауза, тишина судится как прежде" 3600
gruppa tishina "$GR_TISHINA" "молчат дольше $PORog_TISHINY_MIN мин (процесс жив, событий нет): $GR_TISHINA_MIN" 21600
# B-N-1337: mesh awg9 — как обрыв службы, раз в час (канал встал — та же срочность, что служба не active).
gruppa mesh-awg9 "$GR_MESH" "$GR_MESH_TXT" 3600
# D-N-1651: правило 72 — как mesh: сразу на смену состава и раз в час, пока не в порядке.
gruppa ru-tcp-72 "$GR_RUTCP" "$GR_RUTCP_TXT" 3600
# B-N-1660: RU split — сразу на смену состава и раз в час, пока не в порядке.
gruppa ru-split "$GR_RUSPLIT" "$GR_RUSPLIT_TXT" 3600
# B-N-1675: белый список Варвары — на смену состава и раз в 6 ч, пока не в порядке (маска при поломке прячет больше, не меньше).
gruppa belyj-varvary "$GR_BELYJ" "$GR_BELYJ_TXT" 21600
# B-N-1679: немота песочницы Варвары — сразу на смену состава и раз в час, пока не в порядке.
gruppa nemota-varvary "$GR_NEMOTA" "$GR_NEMOTA_TXT" 3600
gruppa kvota   "$GR_KVOTA"   "молчат ПО КВОТЕ Codex до $KVOTA_DO (срок из отказа «usage limit», пояс не указан — читаю как UTC): $GR_KVOTA — не беда, до срока не повторяю" 0

# ── 2в. СТОРОЖ НАД СТОРОЖАМИ (B-N-884, 25.09.2026): свежесть последнего УСПЕШНОГО прогона суточных сторожей ─────────────
# 🔴 ЗАЧЕМ. vse-stendy-boevye (03:40Z) и dve-kopii-watch (06:47Z) ходят раз в сутки, и их собственной жизни никто не видел:
#   (а) таймер не сработал вовсе — тишина неотличима от «всё зелёное»; (б) юнит failed (у обёртки обходчика — немой канал
#   тревог) — тревоги нет по построению, а ветка 2 выше смотрит только службы агентов из agent-registry sluzhby.
# Перечень — ДАННЫМИ: /etc/agent-registry/storozha-sutochnye.txt (SADIK_SUTOCHNYE), «юнит срок_часов».
# Признак — ЖУРНАЛ systemd, не ExecMainExitTimestamp: тот обнуляется перезагрузкой, журнал постоянный (/var/log/journal).
#   последний «done» (JOB_TYPE=start) старше срока → «просрочен»; «done» нет вовсе → «прогона нет»; is-failed → «failed».
#   ⚠️ «done» = прогон СОСТОЯЛСЯ, не «был зелёным»: у сторожей с SuccessExitStatus=1 2 красный итог тоже «done» (INFO Вениамина).
# ЗОВУЩИЙ СТЕНДА ЭТОЙ ВЕТКИ: dorabotki/stendy/stend-storozha-nad-storozhami.sh — рука при правке sadik-watch (в ночной обход не
#   входит: ~10 мин, сам sadik-watch ~74 с, при пределе обходчика 120 с на стенд).
#   Юнит в activating (прогон идёт) — свежесть этого такта не судится, НО (B-N-1828, 08.10.2026, Аврора; ворота Вениамина 08:51Z):
#   activating дольше срок_часов от ВХОДА в него (InactiveExitTimestamp; у oneshot ActiveEnter пуст, StateChange сдвигается на смене
#   подсостояния — проверено на живом oneshot 08:48Z) → «застрял»; метка не прочитана → «zastryal-slepo», не тишина. Пока юнит висит,
#   таймер следующий прогон не начнёт — за сроком прогон уже пропущен. Дыра реальная: 37 из 77 сторожей перечня без TimeoutStartSec.
# Тревога — групповая (gruppa): смена состава сразу, напоминание раз в 6 ч; отметка — только при успехе канала.
# ⚠️ ЧЕГО НЕ ЛОВИТ: застрявшего в activating — ДО срока от входа: худший случай от последнего «done» ≈ (вход − done) + срок, до ~2×срок —
#   суточный 26 ч → до ~52 ч, недельный 170 ч → до ~340 ч (решение Забавы 08:51Z: ловим «застрял навсегда», без новой настройки);
#   deactivating/reloading; петлю перезапусков (каждый старт — новая метка входа); прыжок часов (метка realtime); «успешный» прогон, ничего не проверивший; отказ ОБОИХ —
#   канала тревог и самого sadik-watch (его жизнь видна только голосом «жив» раз в 7 суток, раздел 3). При отказе канала
#   тревога остаётся в журнале и повторяется каждый такт до успеха — второго канала здесь нет (см. П7 B-N-884).
SUTOCHNYE="${SADIK_SUTOCHNYE:-/etc/agent-registry/storozha-sutochnye.txt}"
GR_SUT=""; GR_SUT_TXT=""; V_PERECHNE=" "; NE_VNESENY=" "
if ! sut_spisok=$(grep -vE '^[[:space:]]*(#|$)' "$SUTOCHNYE" 2>/dev/null) || [ ! -r "$SUTOCHNYE" ]; then
  GR_SUT="ПЕРЕЧЕНЬ"; GR_SUT_TXT="перечень суточных сторожей не прочитан: $SUTOCHNYE — чью жизнь проверять, неизвестно"; BEDY=$((BEDY+1))
else
  while read -r _u _srok _; do
    [ -n "$_u" ] || continue
    # B-N-1068: «!<юнит> <причина>» — осознанно НЕ внесён (для проверки полноты ниже); срока у такой строки нет.
    case "$_u" in '!'*) NE_VNESENY="$NE_VNESENY${_u#!} "; continue ;; esac
    V_PERECHNE="$V_PERECHNE$_u "
    if ! [[ "$_srok" =~ ^[1-9][0-9]*s?$ ]]; then
      GR_SUT="$GR_SUT${GR_SUT:+ }$_u:строка"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — строка перечня негодна (срок «${_srok}»)"; BEDY=$((BEDY+1)); continue
    fi
    case "$_srok" in *s) _srok_s=${_srok%s}; _srok_label="$_srok_s с" ;; *) _srok_s=$(( _srok * 3600 )); _srok_label="$_srok ч" ;; esac
    if systemctl is-failed --quiet "$_u" 2>/dev/null; then
      # 4 не зелёное. Общий helper сам проверяет запись, срок и текущую invocation юнита.
      case "$_u" in registry-watchdog.service|vypusk-okno-watch.service|zhivaya-versiya-watch.service|dve-kopii-watch.service)
        _mo_out=$(timeout -k 1s 10s "${MONTAZH_OKNO_BIN:-/usr/local/sbin/montazh-okno}" yunit-otlozheno --avto-montazh "$_u" 2>/dev/null); _mo_code=$?
        if [ "$_mo_code" = 4 ] || [ "$_mo_code" = 6 ]; then log "   $_u — $_mo_out (не зелёный исход прежнего прогона)"; continue; fi ;;
      esac
      GR_SUT="$GR_SUT${GR_SUT:+ }$_u:failed"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — FAILED"; BEDY=$((BEDY+1)); continue
    fi
    if [ "$(systemctl show "$_u" -p ActiveState --value 2>/dev/null)" = activating ]; then
      _vh=$(systemctl show "$_u" -p InactiveExitTimestamp --timestamp=unix --value 2>/dev/null); _vh="${_vh#@}"
      if ! [[ "$_vh" =~ ^[1-9][0-9]*s?$ ]]; then
        GR_SUT="$GR_SUT${GR_SUT:+ }$_u:zastryal-slepo"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — в activating, момент входа не прочитан (InactiveExitTimestamp «${_vh}») — застрял ли, неизвестно"; BEDY=$((BEDY+1))
      elif [ $(( SEYCHAS - _vh )) -gt "$_srok_s" ]; then
        GR_SUT="$GR_SUT${GR_SUT:+ }$_u:zastryal"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — прогон идёт $(( (SEYCHAS - _vh) / 3600 )) ч (с $(TZ=Europe/Moscow date -d "@$_vh" '+%d.%m %H:%M') МСК) при сроке $_srok_label — застрял в activating"; BEDY=$((BEDY+1))
      else
        log "   $_u — прогон идёт $(( (SEYCHAS - _vh) / 60 )) мин (срок $_srok_label), свежесть в этом такте не сужу"
      fi
      continue
    fi
    _t=$(journalctl UNIT="$_u" JOB_TYPE=start JOB_RESULT=done -o json -n 1 --no-pager -q 2>/dev/null | jq -r '.__REALTIME_TIMESTAMP // empty' 2>/dev/null | tail -1)
    if [ -z "$_t" ]; then
      GR_SUT="$GR_SUT${GR_SUT:+ }$_u:net-progona"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — состоявшегося прогона в журнале НЕТ"; BEDY=$((BEDY+1)); continue
    fi
    _vozr=$(( SEYCHAS - _t / 1000000 ))
    if [ "$_vozr" -gt "$_srok_s" ]; then
      GR_SUT="$GR_SUT${GR_SUT:+ }$_u:prosrochen"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_u — последний прогон состоялся $(( _vozr / 3600 )) ч назад при сроке $_srok_label"; BEDY=$((BEDY+1))
    else
      log "   суточный сторож $_u: прогон состоялся $(( _vozr / 3600 )) ч назад (срок $_srok_label)"
    fi
  done <<< "$sut_spisok"
  # ── B-N-1068 (26.09.2026, Заря; слово Забавы 14:40Z): ПОЛНОТА ПЕРЕЧНЯ. Перечень — данные, руками: новый таймер без строки молчал бы
  #   (dsh-compact-watch был failed 6 ч, читателя не было — B-N-1060/1062). Наш таймер = файл юнита в /etc/systemd/system (шаблон
  #   @.timer — тоже); его служба обязана иметь строку перечня либо «!<служба> <причина>». Иначе — красное в той же группе.
  #   Список таймеров пуст/не получен — СЛЕПОТА полноты, не «всё внесено».
  # ⚠️ НЕ ЛОВИТ: таймеры вне /etc/systemd/system (дистрибутивные, /usr/lib); службы без таймера (зовут руками, cron, Wants=);
  #   «!»-строку, чья служба давно исчезла (молча лишняя).
  # A-N-1948 №5 (дельта Забавы 04:12Z): ЗАМАСКИРОВАННЫЙ таймер — решение, а не забытая строка. list-timers --all его ДАЁТ, но вместо
  #   службы «-» (прежний комментарий «не даёт» был неверен), и сторож требовал «!- причина». Теперь masked (LoadState или
  #   UnitFileState) — отдельный счёт «замаскировано N: <имена>» в строке полноты, не красное. Служба «-» БЕЗ маски (юнит битый
  #   или не загрузился; LOW Вениамина 04:27Z) — не маска: красная строка «служба не определена: <таймер>».
  #   ⚠️ НЕ ЛОВИТ: маску, поставленную не тем таймером (решение — человека); размаскировку без строки перечня — она снова краснеет.
  _tmr=$(systemctl list-timers --all --no-legend --plain 2>/dev/null | awk 'NF>=2 {print $(NF-1), $NF}')
  if [ -z "$_tmr" ]; then
    GR_SUT="$GR_SUT${GR_SUT:+ }ПОЛНОТА:slepo"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }полнота перечня НЕ проверена: список таймеров пуст или не получен (это не «всё внесено»)"; BEDY=$((BEDY+1))
  else
    declare -A _akt=(); _nashih=0; _isk=0; _bez=0; _mask=0; _mask_im=""; _neopr=0
    while read -r _tm _sv; do [ -n "$_tm" ] && _akt["$_tm"]="$_sv"; done <<< "$_tmr"
    while read -r _id _fr _ls; do
      case "$_fr" in /etc/systemd/system/*) ;; *) continue ;; esac
      _sv="${_akt[$_id]:-}"; [ -n "$_sv" ] || continue
      _nashih=$((_nashih+1))
      if [ "$_ls" = masked ]; then _mask=$((_mask+1)); _mask_im="$_mask_im${_mask_im:+, }$_id"; continue; fi
      if [ "$_sv" = - ]; then
        _neopr=$((_neopr+1))
        GR_SUT="$GR_SUT${GR_SUT:+ }$_id:sluzhba-neopr"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }служба не определена: $_id — таймер наш ($_fr), в list-timers службы нет («-»), маски нет: юнит битый или не загрузился"; BEDY=$((BEDY+1))
        continue
      fi
      case "$V_PERECHNE" in *" $_sv "*) continue ;; esac
      case "$NE_VNESENY" in *" $_sv "*) _isk=$((_isk+1)); continue ;; esac
      _bez=$((_bez+1))
      GR_SUT="$GR_SUT${GR_SUT:+ }$_sv:net-stroki"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }$_sv — таймер $_id наш ($_fr), строки в перечне НЕТ (и нет «!$_sv причина»)"; BEDY=$((BEDY+1))
    done < <(systemctl show -p Id -p FragmentPath -p LoadState -p UnitFileState -- "${!_akt[@]}" 2>/dev/null \
             | awk 'BEGIN{RS=""; FS="\n"} {id=""; fr=""; ms="-"; for (i=1; i<=NF; i++) { if ($i ~ /^Id=/) id=substr($i,4); if ($i ~ /^FragmentPath=/) fr=substr($i,14); if ($i == "LoadState=masked" || $i == "UnitFileState=masked") ms="masked" } if (id != "") print id, (fr == "" ? "-" : fr), ms}')
    log "   полнота перечня: наших таймеров $_nashih · исключено «!» $_isk · замаскировано $_mask${_mask_im:+: $_mask_im} · служба не определена $_neopr · без строки $_bez"
    if [ "$_nashih" -eq 0 ]; then   # таймеры есть, а наших 0 — не прочитаны пути юнитов (show отказал), это слепота
      GR_SUT="$GR_SUT${GR_SUT:+ }ПОЛНОТА:slepo"; GR_SUT_TXT="$GR_SUT_TXT${GR_SUT_TXT:+; }полнота перечня НЕ проверена: таймеров ${#_akt[@]}, а наших (файл в /etc/systemd/system) 0 — пути юнитов не прочитаны"; BEDY=$((BEDY+1))
    fi
  fi
fi
gruppa sutochnye "$GR_SUT" "СТОРОЖ НАД СТОРОЖАМИ: $GR_SUT_TXT" 21600

# A-N-1146 BEGIN: independent reader; masked timer is an explicit disabled state.
