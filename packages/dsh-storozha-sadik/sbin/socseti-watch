#!/usr/bin/python3
"""B-N-1496: one bounded status poll, daily alert per reason; no service changes."""
import argparse
import fcntl
import hashlib
import http.client
import json
import math
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import time

VERSION = 'B-N-1496-r1'
COOLDOWN = 86400
MAX_RESPONSE = 65536


class Blind(Exception):
    pass


def private_key(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as stream:
            st = os.fstat(stream.fileno())
            if (not stat.S_ISREG(st.st_mode) or st.st_uid not in (0, os.geteuid())
                    or stat.S_IMODE(st.st_mode) not in (0o600, 0o640)
                    or st.st_nlink != 1 or st.st_size > 128):
                raise Blind('monitor_key_invalid')
            raw = stream.read(129).strip()
        if not re.fullmatch(rb'[a-f0-9]{64}', raw):
            raise Blind('monitor_key_invalid')
        return raw.decode('ascii')
    except OSError:
        raise Blind('monitor_key_unreadable') from None


def parse_status(raw, key):
    try:
        rpc = json.loads(raw)
        if (rpc['jsonrpc'] != '2.0' or type(rpc['id']) is not int or rpc['id'] != 1
                or 'error' in rpc or rpc['result'].get('isError', False) is not False):
            raise ValueError()
        content = rpc['result']['content']
        if len(content) != 1 or content[0]['type'] != 'text':
            raise ValueError()
        value = json.loads(content[0]['text'])
        telegram = value['telegram']
        if (type(value['stage']) is not int or value['stage'] != 2
                or type(telegram['halted']) is not bool
                or type(value['publishing']) is not bool or type(value['external_io']) is not bool):
            raise ValueError()
        reason = telegram['reason']
        if telegram['halted']:
            if (value['publishing'] or value['external_io'] or not isinstance(reason, str)
                    or not re.fullmatch(r'[a-z][a-z0-9_]{0,95}', reason) or key in reason):
                raise ValueError()
            return 'halted', reason
        if value['publishing'] and value['external_io'] and reason is None:
            return 'ready', None
        return 'blind', 'telegram_not_ready'
    except (ValueError, KeyError, TypeError, IndexError, AttributeError, UnicodeError, RecursionError):
        raise Blind('status_invalid') from None


def poll(args):
    key = private_key(args.key_file)
    connection = http.client.HTTPConnection('127.0.0.1', args.port, timeout=args.timeout)
    def expired(*_):
        raise Blind('status_timeout')
    old = signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, args.timeout)
    try:
        request = {'jsonrpc': '2.0', 'id': 1, 'method': 'tools/call',
                   'params': {'name': 'status', 'arguments': {}}}
        connection.request('POST', '/mcp', json.dumps(request), {
            'Authorization': 'Bearer ' + key, 'Content-Type': 'application/json',
            'Accept': 'application/json, text/event-stream'})
        response = connection.getresponse()
        if response.status != 200:
            raise Blind('status_http_' + str(response.status))
        raw = response.read(MAX_RESPONSE + 1)
        if len(raw) > MAX_RESPONSE:
            raise Blind('status_too_large')
        return parse_status(raw, key)
    except TimeoutError:
        raise Blind('status_timeout') from None
    except (OSError, http.client.HTTPException):
        raise Blind('status_unavailable') from None
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, old)
        connection.close()


def send(channel, message):
    # Key stays in this process. The channel receives only a fixed label/reason via stdin.
    env = dict(os.environ, AGENT_ALERT_POPYTOK='1', AGENT_ALERT_TAJMAUT='10')
    try:
        p = subprocess.Popen([channel, '--plain'], stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             text=True, env=env, start_new_session=True)
        try:
            p.communicate(message, timeout=15)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            p.communicate()
            return False
        return p.returncode == 0
    except OSError:
        return False


def load_state(path, now):
    try:
        raw = path.read_bytes()
    except FileNotFoundError:
        return {}, False
    except OSError:
        raise Blind('state_unreadable') from None
    try:
        if len(raw) > 131072:
            raise ValueError()
        state = json.loads(raw)
        if not isinstance(state, dict):
            raise ValueError()
        for k, entry in state.items():
            if (not re.fullmatch(r'[a-f0-9]{64}', k) or not isinstance(entry, dict)
                    or set(entry) != {'at', 'delivered'} or type(entry['delivered']) is not bool
                    or type(entry['at']) not in (int, float) or not math.isfinite(entry['at'])
                    or entry['at'] < 0 or entry['at'] > now + 60):
                raise ValueError()
        return {k: v for k, v in state.items() if now - v['at'] < COOLDOWN}, False
    except (ValueError, TypeError, RecursionError, OverflowError):
        return {}, True


def save_state(path, state):
    tmp = path.with_name('state.json.new')
    with tmp.open('w') as stream:
        json.dump(state, stream)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, path)
    fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def tick(args):
    folder = Path(args.state_dir)
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    # The systemd service serializes scheduled runs; lock also protects manual invocations.
    with (folder / 'lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print(VERSION + ': another poll holds state lock')
            return 3
        path = folder / 'state.json'
        now = time.time()
        state, corrupt = load_state(path, now)
        if corrupt:
            kind, reason = 'blind', 'state_invalid_history_lost'
        else:
            try:
                kind, reason = poll(args)
            except Blind as error:
                kind, reason = 'blind', str(error)
        code = {'ready': 0, 'halted': 10, 'blind': 2}[kind]
        sent = False
        if kind != 'ready':
            identity = hashlib.sha256((kind + ':' + reason).encode()).hexdigest()
            if identity not in state:
                # Reserve BEFORE delivery. A crash/unknown delivery must not cause a duplicate.
                state[identity] = {'at': now, 'delivered': False}
                save_state(path, state)
                label = 'telegram halted' if kind == 'halted' else 'СЛЕПОТА'
                if not send(args.kanal, f'sadik: socseti.service — {label}: {reason}'):
                    print(VERSION + ': alert unconfirmed; retry after 86400s; failed for sadik-watch')
                    return 3
                state[identity]['delivered'] = True
                sent = True
        save_state(path, state)
        pending = any(not entry['delivered'] for entry in state.values())
        print(f'{VERSION}: {kind}; reason={reason}; alert_sent={int(sent)}; delivery_unconfirmed={int(pending)}')
        return 3 if pending else code


def main():
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    parser.add_argument('--version', action='version', version=VERSION)
    parser.add_argument('--port', type=int, default=8381)
    parser.add_argument('--key-file', default='/etc/socseti/monitor.key')
    parser.add_argument('--state-dir', default='/var/lib/socseti-watch')
    parser.add_argument('--kanal', default='/usr/local/bin/agent-alert')
    parser.add_argument('--timeout', type=float, default=5)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535 or not 0 < args.timeout <= 10:
        parser.error('port or timeout out of range')
    os.umask(0o077)
    try:
        return tick(args)
    except (OSError, Blind):
        # No trustworthy state means cooldown cannot be persisted. Exit failed for sadik-watch.
        print(VERSION + ': СЛЕПОТА state_io; cooldown unavailable', file=sys.stderr)
        return 3


if __name__ == '__main__':
    sys.exit(main())
