[Unit]
Description=Registry-wide sadik memory filling observer
After=systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/libexec/pamyat-fill-watch.py --run
ExecStopPost=/usr/bin/python3 -B /usr/local/libexec/pamyat-fill-watch.py --failure
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=pamyat-fill-watch
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=8min
TimeoutStopSec=100s
MemoryMax=512M
Nice=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadOnlyPaths=/opt
