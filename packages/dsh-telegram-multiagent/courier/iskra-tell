#!/usr/bin/env bash
# Положить письмо агенту на sadik (платформа DSH) в его входящий ящик.
#   iskra-tell     → Искра   (/opt/iskra/a2a/in)
#   petrovich-tell → Петрович (/opt/petrovich/a2a/in)
#   marc-tell      → Марк     (/opt/marc/a2a/in)
#   anna-tell      → Анна     (/opt/anna/a2a/in)   B-N-1837, 08.10.2026
#   zarya-tell     → Заря     (/opt/zarya/a2a/in)   клон Искры, B-N-749 24.09
#   avrora-tell    → Аврора   (/opt/avrora/a2a/in)  клон Искры, B-N-749 24.09
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ КУРЬЕР. Через a2a-send Искре слать НЕЛЬЗЯ: она живёт на другой машине,
# и в a2a-send для имён z-i-* стоит заглушка '__sadik_iskra__', которая не совпадёт ни с
# каким инстансом — то есть попытка отправки штатно отбивается, но чем слать вместо этого,
# нигде не сказано. 30.08.2026 я потратила четыре подхода, выясняя это заново.
# Чиним в инструменте, а не в инструкции.
#
#   iskra-tell <файл>        отправить содержимое файла
#   iskra-tell - < текст     отправить со стандартного входа
#
# Ответы Искры забирает sadik-tell-poll из /opt/iskra/a2a/{tell,out}.
#
# 🔴 ОТПРАВИТЕЛЬ В ИМЕНИ ФАЙЛА (правка 03.09.2026 по находке Михалыча).
# Первая редакция хардкодила 'zabava-' — и письмо ЛЮБОГО агента ложилось Искре как моё.
# Это хуже пустоты: пустота заставляет проверять, ложная подпись — НЕ заставляет, у
# получателя нет причины сомневаться. И это подмена полномочий: «рекомендация главной» и
# «вопрос серверного» имеют разный вес. Атрибуция держалась на дисциплине пишущего —
# теперь на инструменте.
# Определяется как в a2a-send (одна конвенция на ферму), можно перекрыть OT=<имя>.
# Не определилось — пишем 'neizvesten', НИКОГДА чужое имя.
set -euo pipefail
HOST=sadik

# 🔴 ОДИН КУРЬЕР НА ДВУХ ПОЛУЧАТЕЛЕЙ, а не две копии (03.09.2026).
# Второй экземпляр для Петровича был бы ДВОЙНИКОМ: правку внесут в один, забудут в другом,
# и снаружи это неотличимо (класс «копия живёт своей жизнью, а выглядит как оригинал»).
# Получатель берётся из ИМЕНИ вызова: iskra-tell → Искра, petrovich-tell → Петрович.
# petrovich-tell — символьная ссылка на этот же файл, отдельного кода у неё нет.
KOMU=""
case "$(basename "$0")" in
  iskra-tell)     IN=/opt/iskra/a2a/in; KOMU=iskra ;;
  petrovich-tell) IN=/opt/petrovich/a2a/in; KOMU=petrovich ;;
  # 🔴 22.09.2026 (Михалыч, прямое поручение владельца 20:41): ТРЕТИЙ ПОЛУЧАТЕЛЬ — МАРК.
  # ПОВОД: Марк пишет мне сам (его письма доходят), а ответить я мог только через
  # главную — связь была ОДНОСТОРОННЕЙ. Владелец: «хочу, чтобы вы общались напрямую».
  # Каталог взят НЕ по аналогии с именем, а проверен на месте: /opt/marc/a2a/{in,out,tell}
  # существует, владелец marc:marc, служба marc.service active (замер 22.09 20:45).
  marc-tell)      IN=/opt/marc/a2a/in; KOMU=marc ;;
  # B-N-749 (24.09.2026, Михалыч): ящики проверены на месте — zarya:zarya 775, avrora:avrora 775,
  # службы zarya.service/avrora.service active (замер 24.09 ~08:55Z).
  zarya-tell)     IN=/opt/zarya/a2a/in; KOMU=zarya ;;
  avrora-tell)    IN=/opt/avrora/a2a/in; KOMU=avrora ;;
  # B-N-1476 r14b (03.10.2026, Искра; наряд Забавы 14:11Z, слово владельца 17:10 МСК): ГОСТЬ Варвара — подписанные письма
  # координатора; ящик проверен на месте: /opt/varvara/a2a/in varvara:varvara, varvara.service active (замер 03.10 14:2xZ).
  varvara-tell)   IN=/opt/varvara/a2a/in; KOMU=varvara ;;
  anna-tell)      IN=/opt/anna/a2a/in; KOMU=anna ;;   # B-N-1837, 08.10.2026, Забава
  *) echo "OTKAZ: неизвестное имя вызова '$(basename "$0")'; жду iskra-tell, petrovich-tell, marc-tell, zarya-tell, avrora-tell, varvara-tell либо anna-tell" >&2
     exit 2 ;;
esac
# B-N-1359: coder-tell delegates to the same courier and publication path.
if [ "${1:-}" = --coder ] && { [ "${3:-}" = --stop-pause ] || [ "${3:-}" = --stop-replace ] || [ "${3:-}" = --new ]; }; then
  case "${2:-}" in alfa|beta|gamma) KOMU="$2" ;; *) echo 'OTKAZ: unknown coder' >&2; exit 2 ;; esac
  shift 2
fi
case "${1:-}" in
  --stop-pause)
    [ "$#" = 1 ] || { echo 'OTKAZ: --stop-pause takes no additional arguments' >&2; exit 2; }
    exec node "${DSH_MAIL_STOP_SENDER:-/usr/local/lib/dsh-mail-stop/src/send-mail-stop.mjs}" --recipient "$KOMU" --mode pause ;;
  --stop-replace)
    [ "$#" = 3 ] && [ "$2" = -f ] || { echo 'OTKAZ: --stop-replace -f <file>' >&2; exit 2; }
    exec node "${DSH_MAIL_STOP_SENDER:-/usr/local/lib/dsh-mail-stop/src/send-mail-stop.mjs}" --recipient "$KOMU" --mode replace --body-file "$3" ;;
  --new)
    if [ "$#" = 1 ]; then
      exec node "${DSH_MAIL_STOP_SENDER:-/usr/local/lib/dsh-mail-stop/src/send-mail-stop.mjs}" --recipient "$KOMU" --mode new
    fi
    [ "$#" = 3 ] && [ "$2" = -f ] || { echo 'OTKAZ: --new [-f <file>]' >&2; exit 2; }
    exec node "${DSH_MAIL_STOP_SENDER:-/usr/local/lib/dsh-mail-stop/src/send-mail-stop.mjs}" --recipient "$KOMU" --mode new --body-file "$3" ;;
esac
if [ "${1:-}" = --coder ]; then
  [ "$#" = 4 ] && [ "$3" = -f ] || { echo 'OTKAZ: coder-tell <alfa|beta|gamma> -f <file>' >&2; exit 2; }
  case "$2" in alfa|beta|gamma) KOMU="$2"; IN="/opt/coders/$2/a2a/in" ;; *) echo 'OTKAZ: unknown coder' >&2; exit 2 ;; esac
  shift 3
fi
# 🔴 СРОЧНЫЙ КАНАЛ (--srochno, 06.09.2026). Её замер: письма из ящика приходят к ней ПО ОДНОМУ
# НА ХОД и читаются вперемешку с чужими — то есть ящик это ОЧЕРЕДЬ, и «повторить письмо» её
# не лечит: копия встанет в тот же хвост. Файл в рабочем каталоге читается ВНЕ очереди —
# она берёт его, когда он ей нужен. Это разные каналы ПО УСТРОЙСТВУ, а не по надёжности.
# ⚠️ Граница, без которой канал вреден: срочное НЕ ЗОВЁТ. Она узнает о файле, только если
# пойдёт смотреть. Значит сюда кладут то, что нужно ей В МОМЕНТ её работы; позвать может
# только обычный ящик. Оба нужны, ни один не заменяет другого.
# У Петровича срочного каталога я не знаю и ВЫДУМЫВАТЬ не буду — отказ с причиной.
SROCHNO=""
SUHO=""
case "${1:-}" in
  --srochno)
     # 🔴 СНЯТ 06.09.2026 (Михалыч, санкция Забавы 15:18, ворота Вениамина).
     # Канал складывал письма в /opt/iskra/workspace/srochnoe, но МЕХАНИЗМА-ЧИТАТЕЛЯ там нет:
     # получатель забирал их только руками и не удаляя. Отправитель видел «доставлено: <путь>»
     # — путь настоящий, артефакт на месте, — и не мог отличить доставку от лежания.
     # Цена: три стопа по публикации 06.09 (11:15, 11:19, 11:23) до адресата НЕ ДОШЛИ,
     # выпуски продолжились. Самый быстрый канал оказался самым медленным — бесконечным.
     # Граница честная (поправка Вениамина): «письма не читались НИКЕМ» — неверно, она читала
     # руками; неверен был признак «файлы не убывают», он не отличает «не читали» от
     # «читали не удаляя». Верно другое: читателя-МЕХАНИЗМА нет, и потому доставка не
     # доказуема отправителем.
     # Вернуть можно только вместе с признаком ПРОЧИТАНО (перекладывание в отдельный
     # каталог), а не «лежит»: иначе отправитель снова не отличит успех от потери.
     echo "OTKAZ: --srochno снят 06.09.2026 — у срочного каталога нет читателя-механизма," >&2
     echo "       доставка через него не доказуема. Шлите обычным: iskra-tell <файл>." >&2
     exit 2 ;;
  --suho)
     # 🔴 СУХОЙ РЕЖИМ, 06.09.2026 (Михалыч, санкция Забавы 15:35).
     # ЗАЧЕМ: проверить доставку было нельзя, не отправив НАСТОЯЩЕЕ письмо в чужой ящик.
     # Я сам записал это хвостом в 15:21 — и через 15 минут повторил, проверяя правку.
     # Не по забывчивости: помнил, но другого способа не было. Инструкция БЫЛА, инструмента
     # НЕТ — и она не удержала даже автора, написавшего её четвертью часа раньше.
     # Значит это дефект оснастки, а не невнимательность (формулировка Забавы 15:35).
     # Печатает, КУДА и ЧТО легло бы, и НЕ кладёт. Признак приёмки: после сухого прогона
     # в чужом ящике НОЛЬ новых файлов.
     SUHO=1; shift ;;
  -) : ;;   # ОДИНОЧНЫЙ ДЕФИС — законный источник (stdin), описан в шапке. 🔴 Первая редакция
            # --srochno 06.09 съела его маской -* и сломала документированный способ вызова:
            # защита без границы отняла то, что защищала. Поймано ЖИВЫМ прогоном через минуту
            # после правки, пробами — нет: контроль зрячести был на ./файл, а на «-» не был.
  -*) echo "OTKAZ: неизвестный ключ '$1'. Известны: --suho (показать и не отправлять). --srochno СНЯТ 06.09. Файл с дефисом в начале имени передай как ./$1" >&2; exit 2 ;;
esac

# Имя инстанса = компонент пути сразу после my-assistant/. Обе переменные имеют эту форму:
#   CLAUDECLAW_PROJECT_DIR=/home/claude/my-assistant/<инстанс>
#   CLAUDE_CONFIG_DIR=/home/claude/my-assistant/<инстанс>/data/sessions/<группа>/.claude
# 🔴 Порядок расширен 03.09.2026 (вторая находка Михалыча): CLAUDECLAW_PROJECT_DIR есть НЕ У ВСЕХ —
# у него она пуста, и письмо ушло как 'neizvesten'. CLAUDE_CONFIG_DIR есть у КАЖДОГО агента
# (на нём держится вся работа со скиллами), поэтому он запасной источник.
# ⚠️ Первую проверку правки прогнал он ИЗ СВОЕГО окружения: чужое окружение из своего не
# моделируется — как раз то, чем оно отличается, и не воспроизведёшь.
_OT="${OT:-}"
if [ -z "$_OT" ]; then
  for _p in "${CLAUDECLAW_PROJECT_DIR:-}" "${CLAUDE_CONFIG_DIR:-}"; do
    case "$_p" in
      */my-assistant/*) _OT="${_p#*/my-assistant/}"; _OT="${_OT%%/*}"; [ -n "$_OT" ] && break ;;
    esac
  done
fi
case "$_OT" in
  claudeclaw) _OT=zabava ;;          # моё историческое имя в её ящике — не ломаю ей разбор
  ""|"."|"/") _OT=neizvesten ;;
esac
_OT="$(printf '%s' "$_OT" | tr -cd 'A-Za-z0-9_-')"
[ -z "$_OT" ] && _OT=neizvesten
SRC="${1:-}"
[ -z "$SRC" ] && { echo "Usage: [OT=<имя>] $(basename "$0") <файл|->" >&2; exit 2; }
TMP=$(mktemp)
trap 'rm -f "$TMP" "${TMP}.signed" "${TMP}.konv" "${ERRF:-}"' EXIT
if [ "$SRC" = "-" ]; then cat > "$TMP"; else
  [ -r "$SRC" ] || { echo "ERROR: файл не читается: $SRC" >&2; exit 2; }
  cat "$SRC" > "$TMP"
fi
[ -s "$TMP" ] || { echo "ERROR: пустое письмо — не отправляю" >&2; exit 2; }

# 🔴 20.09.2026. КОНВЕРТ УЧЁТА: id снимается ЗДЕСЬ, с ИСХОДНОГО тела, до всех дописок.
# Ниже (:~136) в конец файла дописывается строка со ВРЕМЕНЕМ — считай id после неё, и он
# станет разным при каждой отправке того же письма: воспроизводимость умрёт МОЛЧА.
# Формула согласована с курьером sadik дословно: sha256(имя_получателя + "\n" + тело), 64 знака.
# ⚠️ Конверт НЕ ЗАЩИТА ПОДЛИННОСТИ — чужой id можно написать первой строкой руками. Это только УЧЁТ.
# ⚠️ И id плагина с id курьера НЕСРАВНИМЫ: плагин хэширует идентификатор квитанции, мы —
# адресата и тело. Формат один, смысл разный; сверять их между собой нельзя.
KONVERT_ID="$(printf '%s\n%s' "$KOMU" "$(cat "$TMP")" | sha256sum | cut -c1-64)"

# ── ШАПКА ОБЕЩАЕТ КОПИИ, А КУРЬЕР БЕРЁТ ОДНОГО (07.09.2026, п.334, санкция Забавы 03:31)
# То же, что вписано в a2a-send. Здесь курьер тем более одноадресный: он кладёт ОДИН файл
# ОДНОМУ узлу. Замер по общей щели: 918 писем из 5292 обещали копии в первой строке.
# 🔴 ГРАНИЦА: напоминание печатается ВСЕГДА при «копи» в первых трёх строках, включая честный
# второй вызов. Отличить «забыл» от «сейчас пошлю» курьер не может: памяти между вызовами нет.
# Это НАПОМИНАНИЕ, а не обвинение — оно не утверждает, что копия не ушла.
if head -3 "$TMP" | grep -qiE '\(\s*копи|копия|копии'; then
  {
    echo "ВНИМАНИЕ: шапка называет копии, а курьер кладёт письмо ОДНОМУ узлу."
    echo "          Нужны копии — отдельный вызов на каждого адресата."
    echo "          (печатается всегда: курьер не знает о ваших других вызовах)"
  } >&2
fi

# Штамп УКЛАДКИ в ТЕЛО письма (просьба Искры 05.09 15:31Z, её замер трёх слоёв).
# Зачем: имя файла до получателя НЕ доживает — платформа при приёме пишет только
# «принято (N знаков)», ящик пустеет за секунды. Тело доживает. Без этой строки
# «путь до укладки» и «очередь чтения» неразличимы, и мы их путали полдня.
# Время снимает КОМАНДА в момент укладки, не рука автора — рукописный штамп врёт.
# 🔴 20.09.2026 #237, ОДИН ИСТОЧНИК ФОРМАТА — как у конверта на :~156, и по той же причине.
# Штамп раньше писался printf'ом прямо здесь, а его длина (96) не была известна НИКОМУ:
# ни коду, ни автору письма. Теперь строка строится функцией и ЕЮ ЖЕ меряется.
# ⚠️ Константы 96 здесь НЕТ НАМЕРЕННО и сверки тоже: длина снимается с той самой строки,
# которая уезжает, поэтому разойтись ей не с чем. У конверта иначе (константа + сверка),
# потому что его длина нужна ДО того, как он построен.
shtamp_stroka() { printf '\n--\nположено в щель: %s (снято командой в момент укладки, не рукой автора)\n' "$1"; }
_SHTAMP_TS="$(date -u '+%Y-%m-%d %H:%M:%S UTC')"
# ⚠️ мерить КОНВЕЙЕРОМ, не через $( ): подстановка съест завершающий перевод строки (см. :158).
DLINA_SHTAMPA=$(shtamp_stroka "$_SHTAMP_TS" | wc -m | tr -d ' ')
TELO_ZNAKOV=$(wc -m < "$TMP" | tr -d ' ')
shtamp_stroka "$_SHTAMP_TS" >> "$TMP"
# A-N-1948 №21: имя на той стороне — случайное (16 шестн. знаков из /dev/urandom), а не pid: /tmp там общий, $$ угадывается
# (тот же довод, что у ERRF ниже). Дефиса в случайной части нет — шаблон диагностики ${REMOTE%-*}-*.txt цел.
REMOTE=/tmp/iskra-tell-$(od -An -N8 -tx1 /dev/urandom | tr -d ' \n').txt
# 🔴 20.09.2026 #233. Конверт учёта вписывается НИЖЕ (перед scp) и в этот счёт НЕ ПОПАДАЕТ.
# Без поправки порог мерил бы тело БЕЗ конверта, а уезжало бы С ним — расхождение 91 знак,
# и предупреждение «ДЛИННОЕ ПИСЬМО» врало бы ровно на эту величину.
# Длина конверта: «[delivery-v1 id=» 16 + id 64 + « reply=no]» 10 + перевод строки 1 = 91.
# 🔴 20.09.2026 #234, требование Вениамина: ОДИН ИСТОЧНИК ФОРМАТА.
# Конверт строится ТОЛЬКО этой функцией — и в сверке ниже, и при вставке (:~181).
# Два printf с одним текстом дали бы прибор, который проверяет САМ СЕБЯ: сменят формат
# при вставке — сверка померит свою старую копию, получит 91 и промолчит ровно тогда,
# ради чего заводилась.
# petrovich-ask requires a result; normal tell keeps reply=no.
TELL_REPLY="${A2A_TELL_REPLY:-no}"
case "$TELL_REPLY" in yes|no) ;; *) echo 'OTKAZ: A2A_TELL_REPLY must be yes or no' >&2; exit 2 ;; esac
konvert_stroka() { printf '[delivery-v1 id=%s reply=%s]\n' "$1" "$TELL_REPLY"; }
DLINA_KONVERTA=91
if [ "$TELL_REPLY" = yes ]; then DLINA_KONVERTA=92; fi
# ⚠️ мерить КОНВЕЙЕРОМ, не через $( ): подстановка съедает завершающий перевод строки
# и дала бы 90 вместо 91 — ложная тревога на КАЖДОМ письме.
_dl=$(konvert_stroka "$KONVERT_ID" | wc -m | tr -d ' ')
# ⚠️ set -euo pipefail на :25 — сверка НЕ СМЕЕТ ронять курьер и НЕ блокирует отправку.
if [ "$_dl" != "$DLINA_KONVERTA" ]; then
  echo "⚠️  СВЕРКА КОНВЕРТА: ожидалось $DLINA_KONVERTA, конверт даёт $_dl — формат сменился, а константа нет" >&2
  logger -t "${KOMU}-tell-sverka" "konvert dlina=$_dl ozhidalos=$DLINA_KONVERTA komu=$KOMU" 2>/dev/null || true
fi
# An explicit v2 envelope is already part of the body; no delivery-v1 is added.
if [ "$(head -1 "$TMP")" = '[a2a-envelope version=2]' ]; then DLINA_KONVERTA=0; fi
ZNAKOV=$(( $(wc -m < "$TMP" | tr -d ' ') + DLINA_KONVERTA ))

# 🔴 ПРЕДУПРЕЖДЕНИЕ О ПРЕДЕЛЕ — ОТПРАВИТЕЛЮ (12.09.2026, находка Искры и Вениамина).
# Длину мы считали и раньше, но говорили о ней ТОЛЬКО в журнале при отказе. На приёмной
# стороне длинное письмо режется и помечается — получатель видит отметку, а ОТПРАВИТЕЛЬ
# не видит ничего и считает письмо ушедшим целиком.
# Цена доказана: 7 писем Вениамина за сутки были длиннее предела, среди них ДВА ВЕРДИКТА,
# и он узнал об этом только от Искры. У неё инструмент предупреждает, у него — нет.
# Ворота Искры на 4864 знака оборвались ровно на разделе «чего я не проверила»: до адресата
# дошла бы часть, где всё доказано, БЕЗ ЕДИНОЙ ОГОВОРКИ — письмо увереннее, чем написано.
# Поэтому предупреждаем, но НЕ блокируем: решать автору, резать на части или слать как есть.
PREDEL_ZNAKOV="${PREDEL_ZNAKOV:-3500}"
if [ "$ZNAKOV" -gt "$PREDEL_ZNAKOV" ]; then
  # 🔴 #237: называем СОСТАВ, а не одно число. Частично названный состав ХУЖЕ неназванного
  # (формулировка Вениамина): неназванный заставляет спросить, частичный закрывает вопрос
  # неверным ответом. Автор видит, ЧТО резать — резать можно только тело.
  echo "⚠️  ДЛИННОЕ ПИСЬМО: $ZNAKOV знаков = тело $TELO_ZNAKOV + штамп $DLINA_SHTAMPA + конверт $DLINA_KONVERTA" >&2
  echo "    (справочный порог $PREDEL_ZNAKOV; резать можно только ТЕЛО, потолок тела $((PREDEL_ZNAKOV - DLINA_SHTAMPA - DLINA_KONVERTA)))" >&2
  echo "    ЗДЕСЬ НЕ РЕЖЕТСЯ: приёмная сторона принимает до 40 000 знаков и НЕ усекает —" >&2
  echo "    длинное уходит отдельной подачей, и об этом говорится в её журнале." >&2
  echo "    Режет ОБРАТНЫЙ путь (sadik->aclaude, сборщик, 3500, середина, С ПОМЕТКОЙ)." >&2
  echo "    Свыше 40 000 — режь сам на части." >&2
  logger -t "${KOMU}-tell" "dlinnoe komu=$KOMU ot=$_OT znakov=$ZNAKOV predel=$PREDEL_ZNAKOV" 2>/dev/null || true
fi
# 🔴 scp ОБЁРНУТ НАМЕРЕННО: при недоступном хосте падение происходит ЗДЕСЬ, и без обёртки
# set -e убивает скрипт ДО журнала — самый вероятный отказ не оставлял следа вовсе.
# Найдено НЕГАТИВНОЙ пробой 05.09 (код 255, строки в журнале нет). Позитивная это не ловит.
# 🔴 mktemp, а НЕ предсказуемое имя (замечание Вениамина 05.09): /tmp общий, $$ угадывается,
# и чужой файл того же имени лёг бы поверх — ровно то, на чём сегодня обожглась Искра.
ERRF=$(mktemp)
# 🔴 КОД БЕРЁМ ОТ scp, А НЕ ОТ ЕГО ОТРИЦАНИЯ: внутри `if ! cmd` переменная $? равна коду
# `!cmd`, то есть НУЛЮ при отказе. Поймано пробой 05.09: журнал написал «kod=0» при code 255.
# 🔴 Конверт вписывается ЗДЕСЬ — ПОСЛЕ проверки шапки о копиях (она читает head -3) и
# ПОСЛЕ счёта знаков (иначе +91 знак в каждом письме двигал бы предел молча).
# Preserve an explicit v2 control envelope as the first line for the receiver.
if [ "$(head -1 "$TMP")" != '[a2a-envelope version=2]' ]; then
  { konvert_stroka "$KONVERT_ID"; cat "$TMP"; } > "${TMP}.konv"
  mv "${TMP}.konv" "$TMP"
fi

# 🔴 СУХОЙ ПРОГОН СТОИТ ЗДЕСЬ — ВЫШЕ scp, И ЭТО ВЕСЬ СМЫСЛ ПРАВКИ (#235, 20.09.2026).
# Нашёл Вениамин чтением кода: блок стоял НИЖЕ scp, то есть письмо УЖЕ уезжало на чужую
# машину в /tmp и оставалось там навсегда — ssh, который его убирает, при --suho не звался.
# Инструмент печатал «ничего не отправлено» и «ни ssh, ни copy», когда copy уже случился.
# Цена, снятая замером 20.09: sadik:/tmp хранит 11 файлов iskra-tell-*.txt, 60 КБ,
# с 06.09 по 13.09. Ни одного с конвертом ⇒ все старше 19.09.
# 🔴 И ПОЧЕМУ ЭТО НЕ ЗАМЕТИЛИ ПОЛМЕСЯЦА: признак приёмки смотрел ТОЛЬКО в ящик получателя,
# а ящик был честно пуст. Годный контроль зрячести на ОДНО место узаконивает слепоту
# во ВТОРОМ. Поэтому проверка ниже называет ОБА места.
# Печатается ПОСЛЕ счёта знаков и ПОСЛЕ вставки конверта — иначе числа врали бы.
if [ -n "$SUHO" ]; then
  echo "СУХО: ничего не отправлено. Чужая машина не тронута: ни scp, ни ssh."
  echo "  кому:   $KOMU ($HOST)"
  echo "  каталог: $IN"
  echo "  имя:    $_OT-<время>.txt   (владелец каталога, права 644)"
  echo "  знаков: $ZNAKOV = тело $TELO_ZNAKOV + штамп $DLINA_SHTAMPA + конверт $DLINA_KONVERTA"
  echo "  проверка приёмки — ОБА места, одного мало:"
  echo "    1) в каталоге получателя $IN ..... НОЛЬ новых файлов"
  # 🔴 ПЕЧАТАЕМ ИЗ ТОГО ЖЕ ИСТОЧНИКА, КУДА КЛАДЁТ scp (поправка Вениамина 20.09).
  # Было «/tmp/${KOMU}-tell-*.txt» — а REMOTE на :146 жёсткий, БЕЗ ${KOMU}. Для
  # petrovich-tell признак смотрел бы в /tmp/petrovich-tell-*.txt, где не лежит
  # НИЧЕГО НИКОГДА, и сошёлся бы зелёным при живой регрессии — ровно тот дефект,
  # который эта правка и чинит, повторённый внутри неё же.
  echo "    2) на $HOST в ${REMOTE%-*}-*.txt ... НОЛЬ новых файлов"
  exit 0
fi

# Only the coordinator label signs. Ordinary senders keep their unsigned route.
if [ "$_OT" = zabava ]; then
  # Signature is the LAST content operation. Never fall back after signer failure.
  if ! node "$HOME/.local/lib/dsh-coordinator-signer/prepare-coordinator.mjs" "$KOMU" "$IN" "$TMP" "${TMP}.signed"; then
    echo 'OTKAZ: подпись не получена; ничего не отправлено' >&2
    exit 2
  fi
  mv "${TMP}.signed" "$TMP"
fi
# B-N-1609 (05.10.2026, Заря; замечание Вениамина к 2.5.79): публикацию в ящик делает этот публикатор под root на той стороне,
# а не «sudo cp» в имя внутри ящика — ящик принадлежит агенту (775), и подложенная им ссылка на предсказуемое имя увела бы
# запись root по ссылке. Как publish-mail-stop.py: ящик — дескриптором (O_DIRECTORY|O_NOFOLLOW), временный — O_CREAT|O_EXCL|
# O_NOFOLLOW со случайным именем «.<отправитель>-<hex>.part» (опрос его пропускает), запись/владелец/права — через дескриптор,
# fsync, renameat2 NOREPLACE в итоговое имя. Источник в /tmp — O_NOFOLLOW и владелец = SUDO_UID (тот, кто положил его scp).
PUBLISH_LETTER_PY=$(cat <<'PY'
import ctypes,os,secrets,stat,sys,time
def otkryt_yashchik(put,sozdat=False):
    # B-N-1615: ящик — проходом openat от «/» по звеньям, O_DIRECTORY|O_NOFOLLOW на КАЖДОМ (прежде — только на последнем:
    # промежуточное звено агентского дома можно было увести ссылкой). Звенья root (/, /opt) — без записи группе/прочим (sticky
    # допустим — /tmp стендов); первое не-root звено (/opt/<дом>) задаёт владельца, все глубже — только его. Нет ПОСЛЕДНЕГО
    # звена и sozdat — mkdir через дескриптор родителя, владелец родителя, 755 (прежде «mkdir -p … chown» по путям).
    chasti=put.split('/')[1:]
    if not put.startswith('/') or not chasti or any(c in ('','.','..') for c in chasti):raise ValueError('mailbox_path')
    fl=os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW
    fd=os.open('/',fl);st=os.fstat(fd);vlad=None
    try:
        if st.st_uid!=0 or (st.st_mode&0o022 and not st.st_mode&0o1000):raise ValueError('mailbox_link_untrusted')
        for i,c in enumerate(chasti):
            try:nfd=os.open(c,fl,dir_fd=fd)
            except FileNotFoundError:
                if not sozdat or i!=len(chasti)-1 or vlad is None:raise
                os.mkdir(c,0o755,dir_fd=fd);nfd=os.open(c,fl,dir_fd=fd)
                if os.geteuid()==0 and os.fstat(nfd).st_uid==0:os.fchown(nfd,st.st_uid,st.st_gid)
                os.fchmod(nfd,0o755)
            os.close(fd);fd=nfd;st=os.fstat(fd)
            if vlad is not None:
                if st.st_uid!=vlad:raise ValueError('mailbox_link_untrusted')
            elif st.st_uid!=0:vlad=st.st_uid
            elif st.st_mode&0o022 and not st.st_mode&0o1000:raise ValueError('mailbox_link_untrusted')
        if vlad is None:raise ValueError('mailbox_link_untrusted')
        return fd
    except BaseException:
        os.close(fd);raise
src,box,ot=sys.argv[1:4]
sfd=os.open(src,os.O_RDONLY|os.O_NOFOLLOW);st=os.fstat(sfd);caller=os.environ.get('SUDO_UID')
if not stat.S_ISREG(st.st_mode) or (caller is not None and st.st_uid!=int(caller)):sys.exit('source_untrusted')
data=b''
while True:
    chunk=os.read(sfd,1<<16)
    if not chunk:break
    data+=chunk
os.close(sfd)
dfd=otkryt_yashchik(box,sozdat=True);bst=os.fstat(dfd);uid,gid=bst.st_uid,bst.st_gid;tmp='.'+ot+'-'+secrets.token_hex(8)+'.part'
fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=dfd);done=False
try:
    view=memoryview(data)
    while view:view=view[os.write(fd,view):]
    os.fchown(fd,uid,gid);os.fchmod(fd,0o644);os.fsync(fd)
    final=ot+'-'+str(time.time_ns())+'.txt'
    libc=ctypes.CDLL(None,use_errno=True);rename=libc.renameat2
    rename.argtypes=[ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint];rename.restype=ctypes.c_int
    if rename(dfd,tmp.encode(),dfd,final.encode(),1)!=0:raise OSError(ctypes.get_errno(),'publication refused')
    done=True;os.fsync(dfd);print(os.path.join(box,final))
finally:
    os.close(fd)
    if not done:
        try:os.unlink(tmp,dir_fd=dfd)
        except OSError:pass
    os.close(dfd)
PY
)
set +e; scp -q -o ConnectTimeout=10 "$TMP" "$HOST:$REMOTE" 2>"$ERRF"; RC=$?; set -e
if [ "$RC" -ne 0 ]; then
  logger -t "${KOMU}-tell" "OTKAZ-scp komu=$KOMU ot=$_OT znakov=$ZNAKOV kod=$RC prichina=$(tr -d '\n' < "$ERRF" | cut -c1-120)" 2>/dev/null || true
  echo "OTKAZ: scp не смог положить файл на $HOST (код $RC): $(cat "$ERRF")" >&2
  rm -f "$ERRF"; exit "$RC"
fi
rm -f "$ERRF"
# 🔴 ЖУРНАЛ ДОСТАВКИ (05.09.2026). Раньше курьер не оставлял следа ВООБЩЕ: задержку писем
# мерили только с той стороны, а «сколько шло от нас» было неизмеримо в принципе. Полдня
# споров 05.09 (очередь до ящика или после) стоили ровно этой слепоты.
# Пишем ИСХОД, а не факт вызова: безусловное «доставлено» в журнале — это тот самый класс
# «данные собраны и не участвуют в вердикте», который мы весь день ловим друг у друга.
if OUT=$(ssh -o ConnectTimeout=10 "$HOST" "
  # B-N-1615: ящик создаёт и открывает сам публикатор (проход по звеньям, владелец — от дескриптора ящика);
  # прежние «mkdir -p … chown» и «stat» по путям убраны — между ними и записью звено можно было подменить.
  # 06.09.2026 (Михалыч, санкция Забавы 15:32, разбор Вениамина п.93): кладём под
  # ВРЕМЕННЫМ именем и переименовываем ПОСЛЕ смены владельца. Было: файл появлялся сразу
  # под итоговым именем как root:root, и читатель, успевший взять его до chown, получал
  # EACCES. На sadik это стоило 35 секунд задержки (04.09, dsh.service) — потери не было,
  # но отправителю всё это время печаталось «доставлено».
  # ⚠️ И помнить: «доставлено» здесь означает «положено», а не «принято читателем».
  # B-N-1583 (05.10.2026, Заря): временное имя «<итог>.part» опрос ящика ВИДЕЛ — он пропускает только имена с точкой.
  # B-N-1609: публикует PUBLISH_LETTER_PY (выше) — скрытое случайное временное имя, O_EXCL|O_NOFOLLOW, renameat2. Отказ
  # публикации — ОТКАЗ и выход 1: прежде «доставлено» печаталось, даже если внутренний sudo sh упал.
  # B-N-1994 (11.10.2026, Заря): на отказе письмо в /tmp адресата тоже убирается — прежде rm стоял только в ветке успеха,
  #   и каждый отказ оставлял /tmp/iskra-tell-<hex>.txt навсегда (права 0600 учётки входа: scp без -p, источник mktemp — замер).
  #   Не ловит: обрыв ssh до этой строки (соединение упало) — файл остаётся; убрать его тогда некому, кроме уборки /tmp.
  if f=\$(sudo python3 - $REMOTE $IN $_OT); then rm -f $REMOTE; echo \"доставлено: \$f\"; else rm -f $REMOTE; echo 'ОТКАЗ публикации в ящик'; exit 1; fi
" <<<"$PUBLISH_LETTER_PY" 2>&1); then
  printf '%s\n' "$OUT"
  case "$OUT" in
    *"доставлено: "*)
      logger -t "${KOMU}-tell" "ok komu=$KOMU ot=$_OT znakov=$ZNAKOV fayl=${OUT##*доставлено: }" 2>/dev/null || true ;;
    *)
      # ssh отработал, а признака укладки нет — это ОТКАЗ, и молчать о нём нельзя
      logger -t "${KOMU}-tell" "OTKAZ-bez-priznaka komu=$KOMU ot=$_OT znakov=$ZNAKOV otvet=${OUT//$'\n'/ }" 2>/dev/null || true
      echo "OTKAZ: ssh отработал, но строки «доставлено:» нет — письмо могло не лечь" >&2
      exit 3 ;;
  esac
else
  RC=$?
  logger -t "${KOMU}-tell" "OTKAZ-ssh komu=$KOMU ot=$_OT znakov=$ZNAKOV kod=$RC" 2>/dev/null || true
  echo "OTKAZ: ssh вернул $RC" >&2
  exit "$RC"
fi
