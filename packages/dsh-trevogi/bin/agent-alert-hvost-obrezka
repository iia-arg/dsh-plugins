#!/usr/bin/env bash
# RU: Вызывается часовым таймером; переписывает хвост под тем же inode/правами, flock до 30 с.
# EN: Called by an hourly timer; rewrites the tail preserving inode/permissions, waiting up to 30 s for flock.
# RU: Отсутствие вызова не обнаруживает; рост хвоста обнаруживает отправитель по пределу размера.
# EN: Does not detect missing invocations; the sender detects tail growth by its size limit.
set -uo pipefail
[ "$#" -eq 0 ] || { echo 'agent-alert-hvost-obrezka: неизвестный ввод / unexpected arguments' >&2; exit 2; }
# RU: Один читатель для всех утилит; конфиг не исполняется оболочкой.
# EN: One reader for all utilities; the shell never evaluates configuration.
LIB_DIR="$(dirname -- "$(readlink -f -- "$0")")/../lib/dsh-trevogi"
if ! settings="$(python3 "$LIB_DIR/nastrojki.py")"; then exit 2; fi
have_hvost=0; have_lines=0
while IFS= read -r setting; do
  key="${setting%%=*}"; value="${setting#*=}"
  case "$key" in AGENT_ALERT_HVOST) have_hvost=1;; AGENT_ALERT_HVOST_STROK) have_lines=1;; esac
  export "$key=$value"
done <<< "$settings"
if [ "$have_hvost" -ne 1 ] || [ "$have_lines" -ne 1 ]; then
  echo "СЛЕПОТА: читатель не выдал путь/предел хвоста — запасное значение не применяется"; exit 2
fi
F="$AGENT_ALERT_HVOST"
N="$AGENT_ALERT_HVOST_STROK"
[ -f "$F" ] || { echo "СЛЕПОТА: хвоста $F нет — обрезать нечего, и agent-alert в него не пишет"; exit 2; }
(
  flock -w 30 9 || { echo "СЛЕПОТА: $F занят дольше 30 с"; exit 2; }
  [ -r "$F" ] || { echo "СЛЕПОТА: хвост $F не читается"; exit 2; }
  bylo=$(wc -l < "$F") || { echo "СЛЕПОТА: не посчитаны строки $F"; exit 2; }
  [[ "$bylo" =~ ^[0-9]+$ ]] || { echo "СЛЕПОТА: негодный счёт строк $F"; exit 2; }
  if [ "$bylo" -gt "$N" ]; then
    buffer="$(mktemp)" || { echo "СЛЕПОТА: буфер обрезки не создан"; exit 2; }
    trap 'rm -f -- "$buffer"' EXIT
    tail -n "$N" -- "$F" > "$buffer" || { echo "СЛЕПОТА: хвост $F не прочитан"; exit 2; }
    cat "$buffer" > "$F" || { echo "СЛЕПОТА: хвост $F не записан"; exit 2; }
  fi
  stalo=$(wc -l < "$F") || { echo "СЛЕПОТА: результат обрезки $F не прочитан"; exit 2; }
  echo "версия=3.1.1 хвост $F: строк было $bylo, стало $stalo (предел $N)"
) 9>>"$F"
exit $?
