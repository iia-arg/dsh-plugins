#!/usr/bin/python3
"""oom-watch — сторож за МОЛЧАЛИВЫМИ убийствами по памяти.

Сигнал — ЯДЕРНЫЙ лог: он переживает пересоздание cgroup. Счётчик
memory.events.oom_kill НЕ годится — он обнуляется, когда systemd пересоздаёт
cgroup после рестарта, и убийство проходило бы молча (поймано намеренным
испытанием).

🔴 Ядро печатает ОДНО убийство НЕСКОЛЬКИМИ строками: служба (oom_memcg) в одной,
числа (anon-rss) — в другой, «Memory cgroup out of memory: Killed process».
Склейка «последняя увиденная строка» при двух событиях подряд даёт ЛОЖНУЮ пару:
имя одной службы с числами другой. Поэтому строки связываются ПО НОМЕРУ ПРОЦЕССА
— он есть в обеих. Не связалось — «служба не определена», ближайшая НЕ
подставляется: молчание честнее уверенного вранья.

🔴 Убийств ДВА ВИДА, и опаснее — второй:
  ГРУППОВОЙ  (constraint=CONSTRAINT_MEMCG): служба вышла за СВОЙ предел. Локально,
             почти всегда переживаемо, виновник очевиден.
  ГЛОБАЛЬНЫЙ (CONSTRAINT_NONE / CPUSET / MEMORY_POLICY): память кончилась на ВСЕЙ
             машине, ядро выбрало жертву само. Жертвой становится что угодно —
             в том числе то, у чего пределов нет вовсе. У жертвы НЕТ «своего
             предела»: подставлять туда MemoryMax и считать процент — врать.
Различаются по полю constraint и по префиксу строки убийства (шаблон ядра
«%s: Killed process», где %s = «Memory cgroup out of memory» / «Out of memory» /
«Out of memory (oom_kill_allocating_task)» — проверено по образу ядра 6.8).
Имя службы: у группового — из oom_memcg (чей предел пробит), у глобального —
из task_memcg (в чьей cgroup жила жертва).

Настройка — только через окружение, чтобы файл был одинаков на всех машинах:
  OOM_WATCH_UNITS  — список юнитов через пробел; ПУСТО (умолчание) = тревожить на любой;
  OOM_WATCH_ALERT  — команда внешней тревоги, получает текст на stdin; пусто = только журнал;
  OOM_WATCH_STATE  — каталог состояния (умолчание /var/lib/oom-watch).
"""
import json
import os
import re
import socket
import subprocess
import sys
from datetime import datetime

# Номер версии живёт В САМОМ файле и спрашивается у него: «oom-watch --version».
# Причина: скрипт ставится копированием, и на машине не остаётся НИЧЕГО, по чему можно
# отличить установленную версию от выпущенной. Номер в отдельном файле метаданных для
# такого способа установки не доезжает вовсе.
__version__ = "1.1.0"

STATE_DIR = os.environ.get("OOM_WATCH_STATE", "/var/lib/oom-watch")
CURSOR = os.path.join(STATE_DIR, "cursor")
ALERT_CMD = os.environ.get("OOM_WATCH_ALERT", "")
# Пустой список = тревожим на ЛЮБОЙ memory-cgroup OOM. Так безопаснее по умолчанию:
# забытый в списке юнит — это молчание ровно там, где сторож и нужен.
UNITS = os.environ.get("OOM_WATCH_UNITS", "").split()
HOST = socket.gethostname()


if "--version" in sys.argv[1:]:
    print(f"oom-watch {__version__}")
    sys.exit(0)


def notify(text):
    # Громко в журнал — ВСЕГДА (главный канал, не зависящий от сети).
    print(text, file=sys.stderr, end="")
    if not ALERT_CMD:
        return
    # Тревога наружу — если канал есть. Нет канала / не сработал — НЕ падаем и НЕ молчим.
    if os.access(ALERT_CMD, os.X_OK):
        r = subprocess.run([ALERT_CMD], input=text, capture_output=True, text=True)
        if r.returncode != 0:
            print(f"🔴 OOM-KILL: канал тревоги {ALERT_CMD} не сработал — остаётся только журнал",
                  file=sys.stderr)
    else:
        print(f"🔴 OOM-KILL: канал тревоги {ALERT_CMD} недоступен — остаётся только журнал",
              file=sys.stderr)


def current_cursor():
    out = subprocess.run(["journalctl", "-k", "--no-pager", "-n", "1", "--show-cursor"],
                         capture_output=True, text=True)
    m = re.search(r"^-- cursor: (.*)$", out.stdout, re.M)
    return m.group(1).strip() if m else ""


def unit_of(msg, key):
    """Имя юнита из строки ядра по полю key (oom_memcg | task_memcg).

    🔴 Берём ПОСЛЕДНИЙ сегмент пути cgroup, а не «то, что сразу после /system.slice/».
    Юнит может лежать во вложенном slice — шаблонные юниты и всё, что systemd
    группирует: /system.slice/system-foo.slice/foo@bar.service. Привязка к первому
    сегменту давала бы для них неузнанное имя, фильтр по списку глушил бы тревогу,
    и сторож молчал бы ровно на тех службах, ради которых заведён.
    """
    m = re.search(r"\b" + key + r"=(\S+?)(?:,|$)", msg or "")
    if not m:
        return None
    seg = m.group(1).rstrip("/").split("/")[-1]
    return seg if seg.endswith(".service") else None


def host_mem():
    """Сколько памяти на машине СЕЙЧАС. Помечается как «сейчас», а не «на момент
    убийства»: в строках убийства этих чисел нет, а склеивать их с соседним
    Mem-Info — та же ошибка «последней увиденной строки», от которой мы ушли."""
    try:
        vals = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, _, v = line.partition(":")
                if k in ("MemTotal", "MemAvailable"):
                    vals[k] = int(v.split()[0]) * 1024
        if "MemTotal" in vals and "MemAvailable" in vals:
            return f"свободно {fmt_bytes(vals['MemAvailable'])} из {fmt_bytes(vals['MemTotal'])}"
    except Exception:
        pass
    return None


def prop(unit, name):
    """Прочитать свойство юнита; любая неудача — None, НЕ роняем тревогу."""
    try:
        r = subprocess.run(["systemctl", "show", unit, "-p", name, "--value"],
                           capture_output=True, text=True, timeout=3)
        v = r.stdout.strip()
        return v if v else None
    except Exception:
        return None


def fmt_bytes(b):
    if b >= 1024 ** 3:
        return f"{b / 1024 ** 3:.1f} ГБ"
    if b >= 1024 ** 2:
        return f"{b / 1024 ** 2:.1f} МБ"
    if b >= 1024:
        return f"{b / 1024:.0f} КБ"
    return f"{b} Б"


NO_LIMIT = ("", None, "infinity", "max", "18446744073709551615")


def fmt_kb(kb_str):
    try:
        return fmt_bytes(int(kb_str) * 1024)
    except Exception:
        return "не определено"


def fmt_memmax(val):
    if val in NO_LIMIT:
        return "не задан"
    try:
        return fmt_bytes(int(val))
    except Exception:
        return "не определено"


def fmt_restart(val):
    if val in ("", None, "no"):
        return f"не перезапустится сама (Restart={val or 'no'})"
    if val == "always":
        return "перезапустится сама (Restart=always)"
    if val == "on-failure":
        return "перезапустится сама при сбое (Restart=on-failure)"
    return f"Restart={val}"


def fmt_time(ts_us):
    try:
        return datetime.fromtimestamp(int(ts_us) / 1e6).strftime("%d.%m.%Y %H:%M:%S")
    except Exception:
        return "не определено"


def build_alert(kind, unit, task, pid, anon_kb, ts_us, constraint):
    """Текст тревоги. Отвечает на вопрос «ну и что?», а не только «кого убили».

    Два вида говорят РАЗНЫМИ словами: у группового виноват предел службы, у
    глобального предела нет вовсе и виновата машина целиком."""
    if kind == "global":
        lines = [f"🔴 ПАМЯТЬ КОНЧИЛАСЬ НА ВСЕЙ МАШИНЕ {HOST} — ядро выбрало жертву само"]
    else:
        lines = [f"🔴 Убийство по памяти на {HOST}: служба вышла за свой предел"]

    if unit:
        role = "Служба жертвы" if kind == "global" else "Служба"
        lines.append(f"{role}: {unit} — «{prop(unit, 'Description') or 'не определено'}»"
                     f" (от имени {prop(unit, 'User') or 'root'})")
    else:
        # Пара строк не сошлась по номеру процесса. Ближайшую службу НЕ подставляем.
        lines.append("Служба: не определена (строки ядра не сошлись по номеру процесса)")
    lines.append(f"Убит процесс: {task} (номер {pid}), занимал "
                 f"{fmt_kb(anon_kb) if anon_kb else 'не определено'}")

    if kind == "global":
        # 🔴 Никакого «предела службы» и никакого процента: жертва СВОЙ предел не
        # превышала, её выбрали за размер. Придуманный процент увёл бы разбор в
        # настройку невиновной службы.
        lines.append(f"Предела нет — убито при общей нехватке памяти ({constraint})")
        mem = host_mem()
        if mem:
            lines.append(f"Память машины: {mem} (сейчас, не на момент убийства)")
        lines.append("Причина НЕ в этой службе: ищите, кто съел память машины")
    elif unit:
        mm = prop(unit, "MemoryMax")
        pct = None
        if anon_kb and mm not in NO_LIMIT:
            try:
                pct = int(anon_kb) * 1024 / int(mm) * 100
            except Exception:
                pct = None
        lines.append(f"Предел службы: {fmt_memmax(mm)}"
                     + (f" — выбран на {pct:.0f}%" if pct is not None else ""))
    if unit:
        lines.append(f"Дальше: {fmt_restart(prop(unit, 'Restart'))}")
    lines.append(f"Время: {fmt_time(ts_us)}")
    return "\n".join(lines) + "\n"


os.makedirs(STATE_DIR, exist_ok=True)

# ПЕРВЫЙ запуск: зафиксировать позицию журнала и НЕ трубить о прошлом.
if not os.path.exists(CURSOR):
    c = current_cursor()
    if c:
        with open(CURSOR, "w") as f:
            f.write(c)
        print("🔴 OOM-KILL: сторож поднят, слежу за ядерным логом с этой позиции", file=sys.stderr)
    sys.exit(0)

with open(CURSOR) as f:
    cur = f.read().strip()

out = subprocess.run(["journalctl", "-k", "--no-pager", "--output=json", "--after-cursor=" + cur],
                     capture_output=True, text=True)
if out.returncode != 0:
    # 🔴 Курсор нечитаем (журнал вычищен, позиция устарела, битый файл состояния).
    # Оставить его как есть — значит ослепнуть НАВСЕГДА: каждый запуск будет падать
    # на том же месте, жаловаться только в журнал службы, которого никто не читает,
    # и сам себя не починит. Поэтому: тревога НАРУЖУ один раз и сдвиг курсора на
    # текущую позицию — сторож снова видит. Цена названа прямо: окно между старой
    # позицией и текущей не проверено. Граница: сдвигаем ТОЛЬКО при ошибке чтения,
    # пустой ответ журнала — это не ошибка и курсор не трогает.
    c = current_cursor()
    notify(f"🔴 OOM-KILL: не удалось прочитать ядерный лог (rc={out.returncode}).\n"
           f"Позиция сброшена на текущую — сторож снова видит, но окно до этого момента\n"
           f"НЕ проверено: убийства в нём, если были, пропущены.\n"
           + ("" if c else "Текущую позицию тоже получить не удалось — сторож слеп, разберитесь руками.\n"))
    if c:
        with open(CURSOR, "w") as f:
            f.write(c)
    sys.exit(0)

entries = []
for line in out.stdout.splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        entries.append(json.loads(line))
    except Exception:
        continue

# Карта «номер процесса -> событие» из строк «oom-kill:constraint=…»: в них есть и
# путь cgroup, и pid. Берём ВСЕ виды constraint, а не только MEMCG.
kill_map = {}
for e in entries:
    msg = e.get("MESSAGE", "")
    c = re.search(r"oom-kill:constraint=(\S+?),", msg)
    if not c:
        continue
    p = re.search(r"\bpid=(\d+)", msg)
    if not p:
        continue
    constraint = c.group(1)
    memcg = constraint == "CONSTRAINT_MEMCG"
    t = re.search(r"\btask=([^,]+)", msg)
    kill_map[p.group(1)] = {
        # У группового виноват тот, чей предел пробит (oom_memcg); у глобального
        # такого поля нет вовсе (ядро печатает global_oom), и единственное, что
        # известно про жертву, — её собственная cgroup (task_memcg).
        "unit": unit_of(msg, "oom_memcg" if memcg else "task_memcg"),
        "kind": "memcg" if memcg else "global",
        "constraint": constraint,
        "task": t.group(1) if t else None,
        "ts": e.get("__REALTIME_TIMESTAMP"),
    }

# Строки «…: Killed process …» — в них числа. Связь ПО PID.
# 🔴 Ловим по «: Killed process», а не по конкретному префиксу: ядро подставляет
# туда три разных текста, и «Out of memory (oom_kill_allocating_task)» пропал бы.
for e in entries:
    msg = e.get("MESSAGE", "")
    m = re.search(r"^(.*?): Killed process (\d+) \((\S+?)\)", msg)
    if not m:
        continue
    prefix, pid, name = m.group(1), m.group(2), m.group(3)
    a = re.search(r"anon-rss:(\d+)kB", msg)
    anon_kb = a.group(1) if a else None
    info = kill_map.get(pid) or {}
    unit = info.get("unit")
    # Вид берём из строки constraint, а если её потеряли — из префикса.
    kind = info.get("kind") or ("memcg" if prefix.startswith("Memory cgroup") else "global")
    # Фильтр по списку — только для УЗНАННОЙ службы и только для ГРУППОВОГО убийства.
    # Неузнанная тревожит ВСЕГДА: иначе дефект разбора превращается в молчание.
    # Глобальное тревожит ВСЕГДА: жертвой стало что попало, а список составлялся
    # под «чьи пределы мы стережём» — к общей нехватке памяти он отношения не имеет.
    if kind == "memcg" and unit and UNITS and unit not in UNITS:
        continue
    notify(build_alert(kind, unit, info.get("task") or name, pid, anon_kb,
                       info.get("ts") or e.get("__REALTIME_TIMESTAMP"),
                       info.get("constraint") or "constraint не определён"))

c = current_cursor()
if c:
    with open(CURSOR, "w") as f:
        f.write(c)
