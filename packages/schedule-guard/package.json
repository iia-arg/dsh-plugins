{
  "name": "dsh-schedule-guard",
  "version": "0.4.0",
  "description": "Behavioral guard for DeepSeek Harness self-wakeups: caps autonomous schedule reminders (consecutive, per-day, minimum repeat interval), deletes runaway repeats, and tells the owner why.",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md",
    "test-preemptive-refusal.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "schedule",
    "reminder",
    "self-wakeup",
    "guard",
    "runaway-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iia-arg/dsh-plugins.git",
    "directory": "packages/schedule-guard"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-schedule": ">=0.1.0-rc.8",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8"
  }
}
