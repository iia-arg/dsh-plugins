    "test-schema-adapter.mjs",
    "systemd",
    "README.md",
    "README.ru.md"
  ],
  "keywords": [
    "deepseek-harness",
    "subscription",
    "gateway",
    "agent-sdk",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iia-arg/dsh-plugins.git",
    "directory": "packages/subscription-gateway"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
