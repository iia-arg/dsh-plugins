[Unit]
Description=sage warm daemon — RU ASR-transcript corrector (sage-95m + glossary), unix socket
After=network.target

[Service]
Type=simple
User=claude
Group=claude
RuntimeDirectory=sage-corrector
RuntimeDirectoryMode=0755
Environment=HF_HUB_OFFLINE=1
Environment=SAGE_SOCK=/run/sage-corrector/sage.sock
Environment=SAGE_MODEL_DIR=/opt/sage-corrector/model
Environment=SAGE_GLOSSARY=/opt/sage-corrector/glossary.txt
Environment=SAGE_THREADS=4
ExecStart=/opt/sage-corrector/venv/bin/python3 /opt/sage-corrector/sage_warm_server.py
ExecStartPost=/bin/sh -c 'for i in $(seq 1 60); do [ -S /run/sage-corrector/sage.sock ] && exit 0; sleep 1; done; exit 1'
Restart=always
RestartSec=3
MemoryMax=2G

[Install]
WantedBy=multi-user.target
