[Unit]
Description=Warm Whisper Server (whisper.cpp large-v3 on Vulkan/GPU, model resident in memory)
# Голосовая цепочка sadik: профиль (transcribeCommand) → transcribe-local-shared → transcribe-whispercpp-core → этот сервер
# (127.0.0.1:18790); настройка — /etc/voice-archive.conf. B-N-1011: прежняя строка «Documentation=садик voice stack» не URL —
# systemd на каждом daemon-reload писал 3 × «Invalid URL, ignoring».
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=claude
Group=claude
# large-v3 на AMD Radeon 780M (RADV PHOENIX), Vulkan. Память общая с CPU (UMA).
Environment=GGML_VK_VISIBLE_DEVICES=0
ExecStart=/opt/whisper.cpp/build-vulkan/bin/whisper-server \
  --model /opt/whisper.cpp/models/ggml-large-v3.bin \
  --host 127.0.0.1 --port 18790 \
  --language auto \
  --threads 4 \
  --convert
# Не отдаём active, пока порт не отвечает. Модель 2.9G грузится ~10-20 с.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 90); do curl -sf -m 2 http://127.0.0.1:18790/ >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
MemoryMax=8G
Nice=-5

[Install]
WantedBy=multi-user.target
